// A small original pedestal for origin-relative and box-relative placement.
@meta { archetype: block_multipart, target_profile: bbmodel_5, texel_density: 16 }
@palette {
  stone: ramp(base_lch=[0.65, 0.02, 250], steps=4)
  accent: ramp(base_lch=[0.75, 0.08, 150], steps=4)
}
@rig {
  root bone pedestal {
    pivot_local: [8, 4, 8]
    box base { size: [12, 4, 12], material: stone }
    box stem place(base_box=base, anchor=[0,1,0], align=[0,-1,0]) {
      size: [6, 6, 6], material: accent
    }
    box cap place(base_box=stem, anchor=[0,1,0], align=[0,-1,0]) {
      size: [10, 2, 10], material: stone
    }
  }
}
