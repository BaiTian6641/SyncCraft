# Environment variables & secrets (never commit real credentials)
.env
.env.*
!.env.example
.secrets
secrets/
*.pem
*.key

# Python virtual environments & caches
.venv/
venv/
env/
.conda/
__pycache__/
*.py[cod]
*$py.class
*.so

# Python packaging & build artifacts
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
src/*.egg-info/
.installed.cfg
*.egg

# Test, lint & type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Jupyter / Google Colab notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# SyncCraft generated datasets, large training runs, checkpoints & model weights
# (Only deterministic starter runs/demo/ fixtures remain tracked; never commit checkpoints,
#  runs/published/, runs/gate_g2_report.json, or agent logs)
datasets/
runs/*
!runs/demo/
runs/published/
runs/gate_g2_report.json
checkpoints/
wandb/
mlruns/
lightning_logs/
tensorboard/
.cache/
hf_cache/
huggingface_cache/
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.onnx
*.parquet
*.arrow

# Multi-agent / IDE / OS scratch files (always ignored)
.agents/
.vscode/
.idea/
node_modules/
editors/vscode-blockdsl/*.vsix
*.swp
*.swo
.DS_Store
._*
Thumbs.db
