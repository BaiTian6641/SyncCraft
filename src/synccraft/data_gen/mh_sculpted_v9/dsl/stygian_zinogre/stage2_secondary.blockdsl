// Stygian Zinogre (Hellwolf Fanged Wyvern) — Stage 2 Secondary Anatomy, Upward-Hooked Dragon Horns & Barbed Tail Club
// Hand-authored progressive Block-DSL v4.1 with distinct Hellwolf crouch, wide volcanic carapace blades, & 30 bones.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 260
  budget max_bones = 80
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  obsidian_hide: ramp(base_lch=[0.28, 0.058, 285], steps=6, hue_shift=[24, -18])
  volcanic_armor: ramp(base_lch=[0.35, 0.072, 18], steps=6, hue_shift=[26, -16])
  stygian_slate: ramp(base_lch=[0.46, 0.068, 268], steps=6, hue_shift=[22, -16])
  dark_silver: ramp(base_lch=[0.66, 0.052, 255], steps=6, hue_shift=[22, -14])
  ash_charcoal: ramp(base_lch=[0.24, 0.052, 12], steps=6, hue_shift=[20, -14])
  alabaster_fur: ramp(base_lch=[0.90, 0.032, 250], steps=6, hue_shift=[22, -14])
  ash_belly: ramp(base_lch=[0.54, 0.065, 16], steps=6, hue_shift=[20, -12])
  crimson_talon: ramp(base_lch=[0.56, 0.195, 24], steps=6, hue_shift=[18, -14])
  draco_crimson: ramp(base_lch=[0.68, 0.235, 22], steps=6, hue_shift=[16, -14], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 19.20, -14.0]) {
      rest_euler: [10, 0, 0]
      box pelvis_core { size: [13.0, 10.5, 13.5], material: obsidian_hide }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.40, 0]) {
        size: [9.5, 2.0, 11.0], material: ash_belly
      }
      box sacrum_volcanic_plate place(base_box=pelvis_core, anchor=[0, 0.98, -0.08], align=[0, -0.58, 0]) {
        size: [8.0, 2.5, 10.5], material: volcanic_armor, rotate: [6, 0, 0], blend_with: [lumbar_volcanic_plate, tail_1_seg, tail_1_plate]
      }
      box haunch_armor_l place(base_box=pelvis_core, anchor=[0.98, 0.22, -0.05], align=[-0.52, 0, 0]) {
        size: [3.5, 7.5, 10.0], material: volcanic_armor, rotate: [5, 8, -14], blend_with: [thigh_mass, waist_core]
      }
      box haunch_armor_r place(base_box=pelvis_core, anchor=[-0.98, 0.22, -0.05], align=[0.52, 0, 0]) {
        size: [3.5, 7.5, 10.0], material: volcanic_armor, rotate: [5, -8, 14], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.12, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-7, 0, 0]
        box waist_core { size: [15.0, 12.5, 12.5], material: obsidian_hide }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.40, 0]) {
          size: [11.0, 2.0, 10.5], material: ash_belly, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_volcanic_plate place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
          size: [9.0, 2.5, 10.5], material: volcanic_armor, rotate: [-6, 0, 0], blend_with: [pelvis_core, chest_core]
        }
        box flank_draco_shingle_l place(base_box=waist_core, anchor=[0.98, 0.28, 0.12], align=[-0.65, 0, 0]) {
          size: [2.5, 5.0, 6.5], material: stygian_slate, rotate: [8, 14, -14], blend_with: [chest_core, pelvis_core, haunch_armor_l]
        }
        box flank_draco_shingle_r place(base_box=waist_core, anchor=[-0.98, 0.28, 0.12], align=[0.65, 0, 0]) {
          size: [2.5, 5.0, 6.5], material: stygian_slate, rotate: [8, -14, 14], blend_with: [chest_core, pelvis_core, haunch_armor_r]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.18, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [-9, 0, 0]
          box chest_core { size: [20.5, 16.5, 16.5], material: obsidian_hide }
          // Stark silver-alabaster Hellwolf shoulder mantle wedges
          box stygian_mantle_c place(base_box=chest_core, anchor=[0, 0.98, 0.12], align=[0, -0.58, 0]) {
            size: [13.0, 4.5, 14.0], material: alabaster_fur, rotate: [-12, 0, 0], blend_with: [neck_base, lumbar_volcanic_plate]
          }
          box stygian_mantle_l place(base_box=chest_core, anchor=[0.70, 0.88, 0.08], align=[-0.15, -0.58, 0]) {
            size: [6.0, 4.5, 13.0], material: alabaster_fur, rotate: [-10, -14, -24], blend_with: [stygian_mantle_c, neck_base]
          }
          box stygian_mantle_r place(base_box=chest_core, anchor=[-0.70, 0.88, 0.08], align=[0.15, -0.58, 0]) {
            size: [6.0, 4.5, 13.0], material: alabaster_fur, rotate: [-10, 14, 24], blend_with: [stygian_mantle_c, neck_base]
          }
          // Ribbed volcanic-obsidian sternum & ventral chest armor (cracked with red Dracophage seams in Sketchfab anchor!)
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.34], align=[0, 0.40, 0]) {
            size: [13.5, 2.5, 8.5], material: ash_belly, rotate: [4, 0, 0], blend_with: [waist_belly]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.96, 0.56], align=[0, 0.48, -0.25]) {
            size: [12.0, 2.5, 8.0], material: volcanic_armor, rotate: [-18, 0, 0], blend_with: [chest_scute_rear, fore_bracer, fore_shoulder_r__fore_bracer]
          }
          box sternum_draco_keel place(base_box=chest_scute_front, anchor=[0, -0.95, 0.25], align=[0, 0.72, 0]) {
            size: [5.0, 2.5, 6.0], material: alabaster_fur, rotate: [-12, 0, 0], blend_with: [chest_core, neck_throat_shield, fore_bicep, fore_shoulder_r__fore_bicep]
          }

          // Wide Jagged Volcanic & Dark-Silver Dracophage Shoulder Pylons
          bone draco_pylon_l attach(parent_box=chest_core, anchor=[0.58, 1.0, -0.16], align=[0, -0.92, 0]) mirror_x(draco_pylon_r) {
            rest_euler: [22, -16, -22]
            box pylon_obsidian_front { size: [3.5, 11.5, 5.0], material: volcanic_armor, blend_with: [stygian_mantle_c, stygian_mantle_l, neck_base, neck_collar_blade_l] }
            box pylon_silver_outer place(base_box=pylon_obsidian_front, anchor=[0.96, 0.14, -0.18], align=[-0.58, 0, 0]) {
              size: [2.5, 10.0, 4.5], material: dark_silver, rotate: [8, -14, -20], blend_with: [chest_core, stygian_mantle_l]
            }
            box pylon_volcanic_rear place(base_box=pylon_obsidian_front, anchor=[0, -0.10, -0.96], align=[0, 0, 0.50]) {
              size: [3.0, 8.5, 5.0], material: stygian_slate, rotate: [14, 0, 0], blend_with: [chest_core, stygian_mantle_c, stygian_mantle_l, waist_core, lumbar_volcanic_plate, pylon_silver_outer]
            }
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.28, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-20, 0, 0]
            box neck_base { size: [14.0, 12.0, 9.5], material: obsidian_hide }
            box neck_throat_shield place(base_box=neck_base, anchor=[0, -0.96, 0.12], align=[0, 0.48, 0]) {
              size: [10.0, 2.5, 8.0], material: volcanic_armor, rotate: [-6, 0, 0], blend_with: [chest_scute_front, chest_core, sternum_draco_keel]
            }
            box neck_collar_blade_c place(base_box=neck_base, anchor=[0, 1.0, 0.40], align=[0, -0.86, 0]) {
              size: [4.5, 9.0, 3.5], material: dark_silver, rotate: [18, 0, 0], blend_with: [stygian_mantle_c, chest_core, neck_upper, nape_fur_crest]
            }
            box neck_collar_blade_l place(base_box=neck_base, anchor=[0.70, 0.96, 0.36], align=[-0.35, -0.86, 0]) {
              size: [3.5, 8.5, 3.5], material: volcanic_armor, rotate: [18, -18, -28], blend_with: [neck_collar_blade_c, stygian_mantle_l, stygian_mantle_c, chest_core, pylon_obsidian_front, neck_upper]
            }
            box neck_collar_blade_r place(base_box=neck_base, anchor=[-0.70, 0.96, 0.36], align=[0.35, -0.86, 0]) {
              size: [3.5, 8.5, 3.5], material: volcanic_armor, rotate: [18, 18, 28], blend_with: [neck_collar_blade_c, stygian_mantle_r, stygian_mantle_c, chest_core, draco_pylon_r__pylon_obsidian_front, neck_upper]
            }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.14, 1], align=[0, 0, -1], seat=0.26) {
              rest_euler: [16, 0, 0]
              box neck_upper { size: [10.5, 9.5, 8.5], material: alabaster_fur }
              box nape_fur_crest place(base_box=neck_upper, anchor=[0, 0.96, -0.15], align=[0, -0.58, 0.35]) {
                size: [5.0, 3.5, 8.5], material: alabaster_fur, rotate: [14, 0, 0], blend_with: [neck_base, stygian_mantle_c]
              }

              bone head attach(parent_box=neck_upper, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                rest_euler: [18, 0, 0]
                box skull_core { size: [10.0, 6.5, 8.0], material: obsidian_hide }
                box brow_ridge_l place(base_box=skull_core, anchor=[0.84, 0.78, 0.56], align=[-0.15, -0.50, -0.30]) {
                  size: [2.5, 2.0, 6.0], material: volcanic_armor, rotate: [10, -14, -16]
                }
                box brow_ridge_r place(base_box=skull_core, anchor=[-0.84, 0.78, 0.56], align=[0.15, -0.50, -0.30]) {
                  size: [2.5, 2.0, 6.0], material: volcanic_armor, rotate: [10, 14, 16]
                }
                box cheek_jowl_l place(base_box=skull_core, anchor=[0.96, -0.22, 0.14], align=[-0.48, 0, 0]) {
                  size: [2.5, 4.0, 6.0], material: stygian_slate, rotate: [6, -15, 8], blend_with: [brow_ridge_l, neck_upper]
                }
                box cheek_jowl_r place(base_box=skull_core, anchor=[-0.96, -0.22, 0.14], align=[0.48, 0, 0]) {
                  size: [2.5, 4.0, 6.0], material: stygian_slate, rotate: [6, 15, -8], blend_with: [brow_ridge_r, neck_upper]
                }
                // Searing crimson Dracophage predator slit eyes
                box eye_slit_l place(base_box=skull_core, anchor=[0.98, 0.46, 0.58], align=[-0.72, 0, 0]) {
                  size: [1.0, 1.5, 2.5], material: draco_crimson, rotate: [8, -12, 0], blend_with: [brow_ridge_l, cheek_jowl_l]
                }
                box eye_slit_r place(base_box=skull_core, anchor=[-0.98, 0.46, 0.58], align=[0.72, 0, 0]) {
                  size: [1.0, 1.5, 2.5], material: draco_crimson, rotate: [8, 12, 0], blend_with: [brow_ridge_r, cheek_jowl_r]
                }

                // Sharp 3D Wedged Hellwolf Snout (10u skull -> 3u nose tip!)
                box snout_core place(base_box=skull_core, anchor=[0, -0.16, 1], align=[0, 0, -0.78]) {
                  size: [4.5, 3.5, 7.0], material: obsidian_hide, rotate: [10, 0, 0], blend_with: [brow_ridge_l, brow_ridge_r, eye_slit_l, eye_slit_r]
                }
                box nasal_bridge place(base_box=snout_core, anchor=[0, 0.88, 0.05], align=[0, -0.48, 0]) {
                  size: [3.5, 2.0, 7.0], material: volcanic_armor, rotate: [6, 0, 0], blend_with: [skull_core, brow_ridge_l, brow_ridge_r]
                }
                box maxilla_wedge_l place(base_box=snout_core, anchor=[0.96, -0.10, -0.05], align=[-0.48, 0, 0]) {
                  size: [2.0, 3.0, 6.5], material: stygian_slate, rotate: [8, -19, 8], blend_with: [skull_core, cheek_jowl_l, nasal_bridge, eye_slit_l]
                }
                box maxilla_wedge_r place(base_box=snout_core, anchor=[-0.96, -0.10, -0.05], align=[0.48, 0, 0]) {
                  size: [2.0, 3.0, 6.5], material: stygian_slate, rotate: [8, 19, -8], blend_with: [skull_core, cheek_jowl_r, nasal_bridge, eye_slit_r]
                }
                box nose_tip place(base_box=snout_core, anchor=[0, 0.16, 0.96], align=[0, 0, -0.58]) {
                  size: [3.0, 2.5, 2.5], material: ash_charcoal, rotate: [12, 0, 0], blend_with: [nasal_bridge, maxilla_wedge_l, maxilla_wedge_r]
                }

                // Swept obsidian-silver Hellwolf ears
                bone ear_l attach(parent_box=skull_core, anchor=[0.92, 0.46, -0.22], align=[0, 0, 0.88]) mirror_x(ear_r) {
                  rest_euler: [20, -34, 14]
                  box ear_blade { size: [2.0, 2.5, 8.0], material: dark_silver, blend_with: [cheek_jowl_l, neck_upper, brow_ridge_l] }
                }

                // Sharper Upward-Hooked Dark-Silver Dragon Horns (-Rx pitches forward-extending horn UPWARD!)
                bone horn_l attach(parent_box=skull_core, anchor=[0.54, 0.98, 0.78], align=[0, -0.62, -0.95], seat=0.05) mirror_x(horn_r) {
                  rest_euler: [-18, 17, -10]
                  box horn_seg_1 { size: [3.0, 2.5, 5.5], material: dark_silver, blend_with: [brow_ridge_l, snout_core, nasal_bridge, horn_r__horn_seg_1] }
                  bone horn_mid_l attach(parent_box=horn_seg_1, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.22) {
                    rest_euler: [-14, -4, 0]
                    box horn_seg_2 { size: [2.5, 2.0, 5.0], material: dark_silver, blend_with: [nasal_bridge] }
                    bone horn_tip_l attach(parent_box=horn_seg_2, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.22) {
                      rest_euler: [-18, -4, 0]
                      box horn_seg_3 { size: [1.5, 1.5, 4.5], material: ash_charcoal }
                    }
                  }
                }

                bone jaw attach(parent_box=skull_core, anchor=[0, -0.72, 0.22], align=[0, 0, -1], seat=0.16) {
                  rest_euler: [12, 0, 0]
                  box jaw_core { size: [4.0, 2.5, 8.5], material: ash_charcoal, blend_with: [cheek_jowl_l, cheek_jowl_r, snout_core] }
                  box chin_fur_wedge place(base_box=jaw_core, anchor=[0, -0.92, -0.10], align=[0, 0.45, 0]) {
                    size: [3.5, 2.5, 6.5], material: alabaster_fur, rotate: [-18, 0, 0], blend_with: [neck_upper]
                  }
                  box mandible_tusk_l place(base_box=jaw_core, anchor=[0.90, -0.35, 0.18], align=[-0.15, 0.72, 0]) {
                    size: [1.5, 4.0, 2.0], material: dark_silver, rotate: [26, -16, 18], blend_with: [chin_fur_wedge]
                  }
                  box mandible_tusk_r place(base_box=jaw_core, anchor=[-0.90, -0.35, 0.18], align=[0.15, 0.72, 0]) {
                    size: [1.5, 4.0, 2.0], material: dark_silver, rotate: [26, 16, -18], blend_with: [chin_fur_wedge]
                  }
                }
              }
            }
          }

          // Wide-Planted Brawling Hellwolf Forelimbs with Serrated Volcanic/Silver Scythe-Spurs
          bone fore_shoulder_l attach(parent_box=chest_core, anchor=[0.96, -0.18, 0.44], align=[-0.55, 0.82, 0], seat=0.12) mirror_x(fore_shoulder_r) {
            rest_euler: [22, 8, 27]
            box fore_bicep { size: [8.5, 11.0, 9.0], material: obsidian_hide }
            box pauldron_volcanic place(base_box=fore_bicep, anchor=[0.98, 0.34, 0.08], align=[-0.50, 0, 0]) {
              size: [2.5, 7.0, 7.5], material: volcanic_armor, rotate: [-8, 10, -14], blend_with: [chest_core]
            }
            box elbow_silver_fur place(base_box=fore_bicep, anchor=[0.22, -0.78, -0.92], align=[0, 0, 0.65]) {
              size: [4.5, 5.0, 6.5], material: alabaster_fur, rotate: [24, 0, 0], blend_with: [fore_bracer]
            }

            bone fore_arm_l attach(parent_box=fore_bicep, anchor=[0.12, -1, -0.05], align=[0, 0.88, 0], seat=0.18) {
              rest_euler: [-34, 0, -18]
              box fore_bracer { size: [8.0, 11.5, 8.5], material: stygian_slate, blend_with: [chest_core] }
              box bracer_draco_spur_1 place(base_box=fore_bracer, anchor=[0.96, 0.54, 0.22], align=[-0.48, 0, 0.35]) {
                size: [3.5, 2.5, 8.0], material: volcanic_armor, rotate: [20, 32, -16], blend_with: [fore_bicep, pauldron_volcanic, elbow_silver_fur]
              }
              box bracer_draco_spur_2 place(base_box=fore_bracer, anchor=[0.96, 0.06, 0.22], align=[-0.48, 0, 0.35]) {
                size: [3.5, 2.5, 8.0], material: dark_silver, rotate: [20, 32, -16], blend_with: [bracer_draco_spur_1, elbow_silver_fur]
              }
              box bracer_draco_spur_3 place(base_box=fore_bracer, anchor=[0.96, -0.44, 0.20], align=[-0.65, 0, 0.35]) {
                size: [3.0, 2.5, 7.0], material: volcanic_armor, rotate: [20, 32, -16], blend_with: [bracer_draco_spur_2, fore_paw_pad]
              }

              bone fore_paw_l attach(parent_box=fore_bracer, anchor=[0, -1, 0.16], align=[0, 0.85, -0.45], seat=0.16) {
                rest_euler: [18, 0, -9]
                box fore_paw_pad { size: [9.0, 3.5, 8.0], material: ash_charcoal }
                box f_toe_1 place(base_box=fore_paw_pad, anchor=[-0.68, -0.15, 0.92], align=[0, 0, -0.75]) {
                  size: [2.0, 2.5, 4.5], material: crimson_talon, rotate: [4, 16, 0]
                }
                box f_toe_2 place(base_box=fore_paw_pad, anchor=[-0.22, -0.15, 0.96], align=[0, 0, -0.78]) {
                  size: [2.0, 2.5, 5.0], material: crimson_talon, rotate: [4, 5, 0], blend_with: [f_toe_1]
                }
                box f_toe_3 place(base_box=fore_paw_pad, anchor=[0.24, -0.15, 0.96], align=[0, 0, -0.78]) {
                  size: [2.0, 2.5, 5.0], material: crimson_talon, rotate: [4, -6, 0], blend_with: [f_toe_2]
                }
                box f_toe_4 place(base_box=fore_paw_pad, anchor=[0.70, -0.15, 0.90], align=[0, 0, -0.75]) {
                  size: [2.0, 2.5, 4.5], material: crimson_talon, rotate: [4, -18, 0], blend_with: [f_toe_3]
                }
              }
            }
          }
        }
      }

      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.96, -0.12, -0.06], align=[-0.55, 0.85, 0], seat=0.12) mirror_x(hind_thigh_r) {
        rest_euler: [-26, -6, 20]
        box thigh_mass { size: [7.0, 11.0, 8.5], material: obsidian_hide, blend_with: [waist_core, tail_1_seg] }
        box thigh_volcanic_plate place(base_box=thigh_mass, anchor=[0.98, 0.22, 0.08], align=[-0.48, 0, 0]) {
          size: [2.5, 6.5, 6.5], material: volcanic_armor, rotate: [6, -8, -12], blend_with: [pelvis_core, haunch_armor_l]
        }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [44, 0, -12]
          box shin_mass { size: [5.5, 10.0, 6.0], material: stygian_slate }
          box hock_silver_spur place(base_box=shin_mass, anchor=[0, 0.65, -0.90], align=[0, 0, 0.65]) {
            size: [3.5, 3.5, 4.5], material: dark_silver, rotate: [22, 0, 0], blend_with: [thigh_mass]
          }

          bone hind_paw_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.42], seat=0.14) {
            rest_euler: [-28, 0, -8]
            box hind_paw_pad { size: [7.0, 3.0, 7.0], material: ash_charcoal }
            box h_toe_1 place(base_box=hind_paw_pad, anchor=[-0.62, -0.12, 0.92], align=[0, 0, -0.75]) {
              size: [2.0, 2.0, 4.0], material: crimson_talon, rotate: [4, 14, 0]
            }
            box h_toe_2 place(base_box=hind_paw_pad, anchor=[0.0, -0.12, 0.96], align=[0, 0, -0.78]) {
              size: [2.0, 2.0, 4.5], material: crimson_talon, rotate: [4, 0, 0], blend_with: [h_toe_1]
            }
            box h_toe_3 place(base_box=hind_paw_pad, anchor=[0.62, -0.12, 0.92], align=[0, 0, -0.75]) {
              size: [2.0, 2.0, 4.0], material: crimson_talon, rotate: [4, -14, 0], blend_with: [h_toe_2]
            }
          }
        }
      }

      // Heavy Barbed Volcanic-Obsidian & Dark-Silver Dracophage Tail Club (`tail_1..tail_6`)
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.22, -1], align=[0, 0, 1], seat=0.24) {
        rest_euler: [-8, 0, 0]
        box tail_1_seg { size: [10.0, 8.5, 9.0], material: obsidian_hide }
        box tail_1_plate place(base_box=tail_1_seg, anchor=[0, 0.95, 0], align=[0, -0.48, 0]) {
