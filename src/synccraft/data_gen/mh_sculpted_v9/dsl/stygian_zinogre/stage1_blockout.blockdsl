// Stygian Zinogre (Hellwolf Fanged Wyvern) — Stage 1 Primary Masses & Low Predatory Hellwolf Blockout
// Distinct subspecies rig: lower coiled crouch, wider brawling forelimb stance, upward-hooked silver horns, & heavy club tail.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 128
  budget max_bones = 64
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  obsidian_hide: ramp(base_lch=[0.28, 0.058, 285], steps=6, hue_shift=[24, -18])
  volcanic_armor: ramp(base_lch=[0.35, 0.072, 18], steps=6, hue_shift=[26, -16])
  dark_silver: ramp(base_lch=[0.66, 0.052, 255], steps=6, hue_shift=[22, -14])
  alabaster_fur: ramp(base_lch=[0.90, 0.032, 250], steps=6, hue_shift=[22, -14])
  crimson_talon: ramp(base_lch=[0.56, 0.195, 24], steps=6, hue_shift=[18, -14])
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 18.80, -14.0]) {
      rest_euler: [10, 0, 0]
      box pelvis_core { size: [13.0, 10.5, 13.5], material: obsidian_hide }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.12, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-7, 0, 0]
        box waist_core { size: [15.0, 12.5, 12.5], material: obsidian_hide }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.18, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [-9, 0, 0]
          box chest_core { size: [20.5, 16.5, 16.5], material: volcanic_armor }
          box stygian_mantle_block place(base_box=chest_core, anchor=[0, 0.98, 0.08], align=[0, -0.45, 0]) {
            size: [16.0, 5.5, 14.5], material: alabaster_fur, rotate: [-10, 0, 0]
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.28, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-20, 0, 0]
            box neck_base { size: [14.0, 12.0, 9.5], material: volcanic_armor }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.14, 1], align=[0, 0, -1], seat=0.26) {
              rest_euler: [16, 0, 0]
              box neck_upper { size: [10.5, 9.5, 8.5], material: alabaster_fur }

              bone head attach(parent_box=neck_upper, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                rest_euler: [18, 0, 0]
                box skull_core { size: [10.0, 6.5, 8.0], material: obsidian_hide }
                box snout_core place(base_box=skull_core, anchor=[0, -0.16, 1], align=[0, 0, -0.78]) {
                  size: [4.5, 3.5, 7.0], material: obsidian_hide, rotate: [10, 0, 0]
                }
                bone horn_l attach(parent_box=skull_core, anchor=[0.56, 0.94, 0.84], align=[0, -0.35, -0.95], seat=0.08) mirror_x(horn_r) {
                  rest_euler: [-34, 17, -10]
                  box horn_beam { size: [2.5, 2.5, 11.5], material: dark_silver, blend_with: [snout_core] }
                }
                bone jaw attach(parent_box=skull_core, anchor=[0, -0.72, 0.22], align=[0, 0, -1], seat=0.16) {
                  rest_euler: [10, 0, 0]
                  box jaw_core { size: [4.0, 2.5, 8.5], material: volcanic_armor }
                }
              }
            }
          }

          // Wide-planted predatory Hellwolf forelimbs (+Rz splays wide outward!)
          bone fore_shoulder_l attach(parent_box=chest_core, anchor=[0.96, -0.18, 0.44], align=[-0.55, 0.82, 0], seat=0.12) mirror_x(fore_shoulder_r) {
            rest_euler: [22, 8, 27]
            box fore_bicep { size: [8.5, 10.5, 9.0], material: obsidian_hide }

            bone fore_arm_l attach(parent_box=fore_bicep, anchor=[0.12, -1, -0.05], align=[0, 0.88, 0], seat=0.18) {
              rest_euler: [-34, 0, -18]
              box fore_bracer { size: [8.0, 11.0, 8.5], material: volcanic_armor, blend_with: [chest_core] }

              bone fore_paw_l attach(parent_box=fore_bracer, anchor=[0, -1, 0.16], align=[0, 0.85, -0.45], seat=0.16) {
                rest_euler: [18, 0, -9]
                box fore_paw_pad { size: [9.0, 3.5, 8.5], material: crimson_talon }
              }
            }
          }
        }
      }

      // Deeply coiled digitigrade wolf hindlimbs planted flat on Y = 0
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.96, -0.12, -0.06], align=[-0.55, 0.85, 0], seat=0.12) mirror_x(hind_thigh_r) {
        rest_euler: [-26, -6, 20]
        box thigh_mass { size: [7.0, 11.0, 8.5], material: obsidian_hide, blend_with: [waist_core, tail_1_tail_seg] }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [44, 0, -12]
          box shin_mass { size: [5.5, 9.5, 6.0], material: obsidian_hide }

          bone hind_paw_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.42], seat=0.14) {
            rest_euler: [-28, 0, -8]
            box hind_paw_pad { size: [7.0, 3.0, 7.5], material: crimson_talon }
          }
        }
      }

      // Heavy S-curved Dracophage tail club (+Rx lifts -Z tail then levels tip!)
      chain tail attach(parent_box=pelvis_core, anchor=[0, 0.22, -1], align=[0, 0, 1], seat=0.24) segments=6 taper=0.92 bend=[-8, 14, 18, 16, 6, -8] {
        box tail_seg { size: [10.0, 8.5, 9.5], material: volcanic_armor }
      }
    }
  }
}
