// Stygian Zinogre (Hellwolf Fanged Wyvern) — Stage 3 Sculpted Blockbench Masterwork (V9)
// Hand-authored progressive Block-DSL v4.1 modeled from Sketchfab sculpted Stygian Zinogre anchor
// & Capcom Monster Hunter World: Iceborne references: low predatory Hellwolf crouch, sharper upward-hooked
// dark-silver dragon horns, volcanic obsidian-garnet carapace cracked with crimson Dracophage veins,
// stark silver-alabaster shock-fur cowl & forearm ruffs, crimson-charged talons, & barbed Dracophage tail club.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 420
  budget max_bones = 96
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  obsidian_hide: ramp(base_lch=[0.28, 0.058, 285], steps=6, hue_shift=[24, -18])
  volcanic_armor: ramp(base_lch=[0.35, 0.072, 18], steps=6, hue_shift=[26, -16])
  stygian_slate: ramp(base_lch=[0.46, 0.068, 268], steps=6, hue_shift=[22, -16])
  dark_silver: ramp(base_lch=[0.66, 0.052, 255], steps=6, hue_shift=[22, -14])
  ash_charcoal: ramp(base_lch=[0.24, 0.052, 12], steps=6, hue_shift=[20, -14])
  alabaster_fur: ramp(base_lch=[0.90, 0.032, 250], steps=6, hue_shift=[22, -14])
  ash_belly: ramp(base_lch=[0.33, 0.068, 16], steps=6, hue_shift=[22, -14])
  crimson_talon: ramp(base_lch=[0.56, 0.195, 24], steps=6, hue_shift=[18, -14])
  maw_scarlet: ramp(base_lch=[0.42, 0.165, 20], steps=6, hue_shift=[16, -12])
  ivory_fang: ramp(base_lch=[0.89, 0.038, 84], steps=6, hue_shift=[18, -10])
  draco_crimson: ramp(base_lch=[0.68, 0.235, 22], steps=6, hue_shift=[16, -14], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 20.36, -14.0]) {
      rest_euler: [10, 0, 0]
      box pelvis_core { size: [13.0, 10.5, 13.5], material: obsidian_hide }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.40, 0]) {
        size: [9.5, 2.0, 11.0], material: ash_belly
      }
      box sacrum_volcanic_plate place(base_box=pelvis_core, anchor=[0, 0.98, -0.08], align=[0, -0.58, 0]) {
        size: [8.0, 2.5, 10.5], material: volcanic_armor, rotate: [6, 0, 0], blend_with: [lumbar_volcanic_plate, tail_1_seg, tail_1_plate]
      }
      box sacrum_draco_spire_1 place(base_box=sacrum_volcanic_plate, anchor=[0, 0.96, 0.36], align=[0, -0.76, 0]) {
        size: [2.5, 3.0, 3.5], material: dark_silver, rotate: [18, 0, 0], blend_with: [pelvis_core, lumbar_volcanic_plate]
      }
      box sacrum_draco_spire_2 place(base_box=sacrum_volcanic_plate, anchor=[0, 0.96, -0.38], align=[0, -0.76, 0]) {
        size: [2.5, 3.0, 3.5], material: dark_silver, rotate: [20, 0, 0], blend_with: [pelvis_core, tail_1_plate]
      }
      box haunch_armor_l place(base_box=pelvis_core, anchor=[0.98, 0.22, -0.05], align=[-0.52, 0, 0]) {
        size: [3.5, 7.5, 10.0], material: volcanic_armor, rotate: [5, 8, -14], blend_with: [thigh_mass, waist_core]
      }
      box haunch_armor_r place(base_box=pelvis_core, anchor=[-0.98, 0.22, -0.05], align=[0.52, 0, 0]) {
        size: [3.5, 7.5, 10.0], material: volcanic_armor, rotate: [5, -8, 14], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }
      box hip_draco_spur_l place(base_box=haunch_armor_l, anchor=[0.92, 0.44, -0.36], align=[-0.68, 0, 0.38]) {
        size: [2.0, 2.5, 6.0], material: dark_silver, rotate: [16, 26, -14], blend_with: [pelvis_core, thigh_mass, thigh_volcanic_plate]
      }
      box hip_draco_spur_r place(base_box=haunch_armor_r, anchor=[-0.92, 0.44, -0.36], align=[0.68, 0, 0.38]) {
        size: [2.0, 2.5, 6.0], material: dark_silver, rotate: [16, -26, 14], blend_with: [pelvis_core, hind_thigh_r__thigh_mass, hind_thigh_r__thigh_volcanic_plate]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.12, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-7, 0, 0]
        box waist_core { size: [15.0, 12.5, 12.5], material: obsidian_hide }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.40, 0]) {
          size: [11.0, 2.0, 10.5], material: ash_belly, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_volcanic_plate place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
          size: [9.0, 2.5, 10.5], material: volcanic_armor, rotate: [-6, 0, 0], blend_with: [pelvis_core, chest_core]
        }
        box lumbar_draco_spire_1 place(base_box=lumbar_volcanic_plate, anchor=[0, 0.96, 0.34], align=[0, -0.78, 0]) {
          size: [3.0, 3.5, 3.5], material: dark_silver, rotate: [20, 0, 0], blend_with: [waist_core, chest_core, stygian_mantle_c]
        }
        box lumbar_draco_spire_2 place(base_box=lumbar_volcanic_plate, anchor=[0, 0.96, -0.36], align=[0, -0.78, 0]) {
          size: [2.5, 3.0, 3.5], material: dark_silver, rotate: [22, 0, 0], blend_with: [waist_core, pelvis_core, sacrum_volcanic_plate]
        }
        box lumbar_crimson_core place(base_box=lumbar_volcanic_plate, anchor=[0, 0.98, 0], align=[0, -0.88, 0]) {
          size: [2.0, 2.0, 2.5], material: draco_crimson, rotate: [12, 0, 0], blend_with: [waist_core, lumbar_draco_spire_1, lumbar_draco_spire_2]
        }
        box flank_draco_shingle_l place(base_box=waist_core, anchor=[0.98, 0.34, 0.24], align=[-0.66, 0, 0]) {
          size: [2.5, 5.0, 5.5], material: volcanic_armor, rotate: [8, 14, -14], blend_with: [chest_core]
        }
        box flank_draco_shingle_r place(base_box=waist_core, anchor=[-0.98, 0.34, 0.24], align=[0.66, 0, 0]) {
          size: [2.5, 5.0, 5.5], material: volcanic_armor, rotate: [8, -14, 14], blend_with: [chest_core]
        }
        box flank_lower_shingle_l place(base_box=waist_core, anchor=[0.98, -0.12, -0.22], align=[-0.68, 0, 0]) {
          size: [2.0, 4.5, 5.5], material: stygian_slate, rotate: [6, 16, -10], blend_with: [flank_draco_shingle_l, pelvis_core, haunch_armor_l, thigh_mass]
        }
        box flank_lower_shingle_r place(base_box=waist_core, anchor=[-0.98, -0.12, -0.22], align=[0.68, 0, 0]) {
          size: [2.0, 4.5, 5.5], material: stygian_slate, rotate: [6, -16, 10], blend_with: [flank_draco_shingle_r, pelvis_core, haunch_armor_r, hind_thigh_r__thigh_mass]
        }
        plane waist_fur_plume_l place(base_box=waist_core, anchor=[1.0, 0.66, -0.10], align=[-1.0, -0.5, 0]) {
          size: [5.0, 8.5], normal: x, material: alabaster_fur, rotate: [8, 14, -24],
          edge: spikes(width=4, min_len=3, max_len=7, side=top, seed=11), layer: 1,
          blend_with: [lumbar_volcanic_plate, flank_draco_shingle_l, chest_core, pelvis_core]
        }
        plane waist_fur_plume_r place(base_box=waist_core, anchor=[-1.0, 0.66, -0.10], align=[1.0, -0.5, 0]) {
          size: [5.0, 8.5], normal: x, material: alabaster_fur, rotate: [8, -14, 24],
          edge: spikes(width=4, min_len=3, max_len=7, side=top, seed=11), layer: 1,
          blend_with: [lumbar_volcanic_plate, flank_draco_shingle_r, chest_core, pelvis_core]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.18, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [-9, 0, 0]
          box chest_core { size: [20.5, 16.5, 16.5], material: obsidian_hide }
          // Stark silver-alabaster Hellwolf shoulder mantle wedges
          box stygian_mantle_c place(base_box=chest_core, anchor=[0, 0.98, 0.12], align=[0, -0.58, 0]) {
            size: [13.0, 4.5, 14.0], material: alabaster_fur, rotate: [-12, 0, 0], blend_with: [neck_base, lumbar_volcanic_plate, lumbar_draco_spire_1]
          }
          box stygian_mantle_l place(base_box=chest_core, anchor=[0.70, 0.88, 0.08], align=[-0.15, -0.58, 0]) {
            size: [6.0, 4.5, 13.0], material: alabaster_fur, rotate: [-10, -14, -24], blend_with: [stygian_mantle_c, neck_base]
          }
          box stygian_mantle_r place(base_box=chest_core, anchor=[-0.70, 0.88, 0.08], align=[0.15, -0.58, 0]) {
            size: [6.0, 4.5, 13.0], material: alabaster_fur, rotate: [-10, 14, 24], blend_with: [stygian_mantle_c, neck_base]
          }
          // Glowing crimson Dracophage conduit nestled between shoulder pylons
          box dorsal_draco_conduit place(base_box=stygian_mantle_c, anchor=[0, 0.98, -0.18], align=[0, -0.78, 0]) {
            size: [3.5, 3.0, 8.5], material: draco_crimson, rotate: [6, 0, 0], blend_with: [chest_core, pylon_obsidian_front, draco_pylon_r__pylon_obsidian_front]
          }
          // Spiky silver-alabaster shock-fur plane crests & crimson Dracophage lightning arcs!
          plane mantle_fur_crest_c place(base_box=stygian_mantle_c, anchor=[0, 0.92, 0.46], align=[0, -0.80, 0]) {
            size: [11.5, 6.5], normal: z, material: alabaster_fur, rotate: [18, 0, 0],
            edge: spikes(width=4, min_len=4, max_len=9, side=top, seed=19), layer: 1,
            blend_with: [dorsal_draco_conduit, pylon_obsidian_front, draco_pylon_r__pylon_obsidian_front, neck_base, neck_collar_blade_c]
          }
          plane mantle_fur_crest_rear place(base_box=stygian_mantle_c, anchor=[0, 0.90, -0.78], align=[0, -0.80, 0]) {
            size: [10.0, 6.0], normal: z, material: alabaster_fur, rotate: [26, 0, 0],
            edge: spikes(width=4, min_len=4, max_len=9, side=top, seed=23), layer: 2,
            blend_with: [dorsal_draco_conduit, pylon_volcanic_rear, draco_pylon_r__pylon_volcanic_rear, waist_core, lumbar_volcanic_plate, lumbar_draco_spire_1]
          }
          plane mantle_fur_plume_l place(base_box=stygian_mantle_l, anchor=[0.85, 1.0, -0.10], align=[0, -1.0, 0]) {
            size: [6.0, 10.5], normal: x, material: alabaster_fur, rotate: [10, -14, -28],
            edge: spikes(width=4, min_len=4, max_len=9, side=top, seed=29), layer: 2,
            blend_with: [stygian_mantle_c, chest_core, pylon_obsidian_front, pylon_silver_outer, pylon_volcanic_rear]
          }
          plane mantle_fur_plume_r place(base_box=stygian_mantle_r, anchor=[-0.85, 1.0, -0.10], align=[0, -1.0, 0]) {
            size: [6.0, 10.5], normal: x, material: alabaster_fur, rotate: [10, 14, 28],
            edge: spikes(width=4, min_len=4, max_len=9, side=top, seed=29), layer: 2,
            blend_with: [stygian_mantle_c, chest_core, draco_pylon_r__pylon_obsidian_front, draco_pylon_r__pylon_silver_outer, draco_pylon_r__pylon_volcanic_rear]
          }
          plane draco_lightning_arc_l place(base_box=dorsal_draco_conduit, anchor=[0.88, 0.92, -0.10], align=[0, -0.88, 0]) {
            size: [5.5, 8.0], normal: x, material: draco_crimson, rotate: [14, -10, -18],
            edge: spikes(width=4, min_len=4, max_len=9, side=top, seed=31), layer: 1,
            blend_with: [stygian_mantle_c, pylon_obsidian_front, pylon_volcanic_rear]
          }
          plane draco_lightning_arc_r place(base_box=dorsal_draco_conduit, anchor=[-0.88, 0.92, -0.10], align=[0, -0.88, 0]) {
            size: [5.5, 8.0], normal: x, material: draco_crimson, rotate: [14, 10, 18],
            edge: spikes(width=4, min_len=4, max_len=9, side=top, seed=31), layer: 2,
            blend_with: [stygian_mantle_c, draco_pylon_r__pylon_obsidian_front, draco_pylon_r__pylon_volcanic_rear, draco_lightning_arc_l]
          }

          // Ribcage volcanic-garnet & dark-silver carapace flank shingles
          box rib_volcanic_shingle_l_1 place(base_box=chest_core, anchor=[0.99, 0.26, -0.22], align=[-0.72, 0, 0]) {
            size: [2.5, 5.5, 6.0], material: volcanic_armor, rotate: [8, 14, -10], blend_with: [stygian_mantle_l, fore_bicep, flank_draco_shingle_l, waist_core]
          }
          box rib_volcanic_shingle_r_1 place(base_box=chest_core, anchor=[-0.99, 0.26, -0.22], align=[0.72, 0, 0]) {
            size: [2.5, 5.5, 6.0], material: volcanic_armor, rotate: [8, -14, 10], blend_with: [stygian_mantle_r, fore_shoulder_r__fore_bicep, flank_draco_shingle_r, waist_core]
          }
          box rib_volcanic_shingle_l_2 place(base_box=chest_core, anchor=[0.99, -0.24, -0.34], align=[-0.72, 0, 0]) {
            size: [2.0, 5.0, 6.0], material: stygian_slate, rotate: [6, 16, -8], blend_with: [rib_volcanic_shingle_l_1, fore_bicep, fore_bracer, flank_draco_shingle_l, flank_lower_shingle_l, waist_core]
          }
          box rib_volcanic_shingle_r_2 place(base_box=chest_core, anchor=[-0.99, -0.24, -0.34], align=[0.72, 0, 0]) {
            size: [2.0, 5.0, 6.0], material: stygian_slate, rotate: [6, -16, 8], blend_with: [rib_volcanic_shingle_r_1, fore_shoulder_r__fore_bicep, fore_shoulder_r__fore_bracer, flank_draco_shingle_r, flank_lower_shingle_r, waist_core]
          }
          box rib_silver_stud_l_1 place(base_box=rib_volcanic_shingle_l_1, anchor=[0.96, 0.20, 0], align=[-0.78, 0, 0]) {
            size: [1.5, 2.0, 3.5], material: dark_silver, rotate: [12, 18, -16], blend_with: [chest_core, fore_bicep]
          }
          box rib_silver_stud_r_1 place(base_box=rib_volcanic_shingle_r_1, anchor=[-0.96, 0.20, 0], align=[0.78, 0, 0]) {
            size: [1.5, 2.0, 3.5], material: dark_silver, rotate: [12, -18, 16], blend_with: [chest_core, fore_shoulder_r__fore_bicep]
          }
          box rib_silver_stud_l_2 place(base_box=rib_volcanic_shingle_l_2, anchor=[0.96, 0.15, -0.15], align=[-0.78, 0, 0]) {
            size: [1.5, 2.0, 3.5], material: dark_silver, rotate: [12, 18, -14], blend_with: [chest_core, waist_core, fore_bicep]
          }
          box rib_silver_stud_r_2 place(base_box=rib_volcanic_shingle_r_2, anchor=[-0.96, 0.15, -0.15], align=[0.78, 0, 0]) {
            size: [1.5, 2.0, 3.5], material: dark_silver, rotate: [12, -18, 14], blend_with: [chest_core, waist_core, fore_shoulder_r__fore_bicep]
          }

          // Ribbed volcanic-obsidian & crimson-fissured sternum armor (Sketchfab Stygian signature!)
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.34], align=[0, 0.40, 0]) {
            size: [13.5, 2.5, 8.5], material: ash_belly, rotate: [4, 0, 0], blend_with: [waist_belly]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.96, 0.56], align=[0, 0.48, -0.25]) {
            size: [12.0, 2.5, 8.0], material: volcanic_armor, rotate: [-18, 0, 0], blend_with: [chest_scute_rear, fore_bracer, fore_shoulder_r__fore_bracer]
          }
          box sternum_draco_keel place(base_box=chest_scute_front, anchor=[0, -0.95, 0.25], align=[0, 0.72, 0]) {
            size: [5.0, 2.5, 6.0], material: alabaster_fur, rotate: [-12, 0, 0], blend_with: [chest_core, neck_throat_shield, fore_bicep, fore_shoulder_r__fore_bicep]
          }
          box sternum_fissure_l place(base_box=chest_scute_front, anchor=[0.65, -0.88, 0.18], align=[-0.35, 0.78, 0]) {
            size: [2.5, 1.5, 4.5], material: crimson_talon, rotate: [-16, -12, -8], blend_with: [chest_core, sternum_draco_keel, fore_bicep]
          }
          box sternum_fissure_r place(base_box=chest_scute_front, anchor=[-0.65, -0.88, 0.18], align=[0.35, 0.78, 0]) {
            size: [2.5, 1.5, 4.5], material: crimson_talon, rotate: [-16, 12, 8], blend_with: [chest_core, sternum_draco_keel, fore_shoulder_r__fore_bicep]
          }
          plane chest_ruff_plane_l place(base_box=chest_core, anchor=[0.66, -0.82, 0.92], align=[0, 0.65, -0.85]) {
            size: [6.5, 5.0], normal: z, material: alabaster_fur, rotate: [-24, -18, -12],
            edge: spikes(width=4, min_len=3, max_len=7, side=bottom, seed=37), layer: 1,
            blend_with: [chest_scute_front, sternum_draco_keel, neck_throat_shield, fore_bicep]
          }
          plane chest_ruff_plane_r place(base_box=chest_core, anchor=[-0.66, -0.82, 0.92], align=[0, 0.65, -0.85]) {
            size: [6.5, 5.0], normal: z, material: alabaster_fur, rotate: [-24, 18, 12],
            edge: spikes(width=4, min_len=3, max_len=7, side=bottom, seed=37), layer: 1,
            blend_with: [chest_scute_front, sternum_draco_keel, neck_throat_shield, fore_shoulder_r__fore_bicep]
          }

          // Wide Jagged Volcanic & Dark-Silver Dracophage Shoulder Pylons
          bone draco_pylon_l attach(parent_box=chest_core, anchor=[0.58, 1.0, -0.16], align=[0, -0.92, 0]) mirror_x(draco_pylon_r) {
            rest_euler: [22, -16, -22]
            box pylon_obsidian_front { size: [3.5, 11.5, 5.0], material: volcanic_armor, blend_with: [stygian_mantle_c, stygian_mantle_l, neck_base, neck_collar_blade_l] }
            box pylon_silver_outer place(base_box=pylon_obsidian_front, anchor=[0.96, 0.14, -0.18], align=[-0.58, 0, 0]) {
              size: [2.5, 10.0, 4.5], material: dark_silver, rotate: [8, -14, -20], blend_with: [chest_core, stygian_mantle_l]
            }
            box pylon_volcanic_rear place(base_box=pylon_obsidian_front, anchor=[0, -0.10, -0.96], align=[0, 0, 0.50]) {
              size: [3.0, 8.5, 5.0], material: stygian_slate, rotate: [14, 0, 0], blend_with: [chest_core, stygian_mantle_c, stygian_mantle_l, waist_core, lumbar_volcanic_plate, pylon_silver_outer]
            }
            box pylon_draco_crystal_1 place(base_box=pylon_obsidian_front, anchor=[-0.88, 0.36, 0.10], align=[0.68, 0, 0]) {
              size: [1.5, 5.5, 2.5], material: draco_crimson, rotate: [4, 0, 8], blend_with: [dorsal_draco_conduit, stygian_mantle_c]
            }
            box pylon_outer_scythe place(base_box=pylon_silver_outer, anchor=[0.92, 0.36, -0.25], align=[-0.78, 0, 0]) {
              size: [1.5, 6.0, 3.0], material: volcanic_armor, rotate: [10, -16, -24]
            }
            box pylon_draco_crystal_2 place(base_box=pylon_volcanic_rear, anchor=[-0.86, 0.32, -0.10], align=[0.76, 0, 0]) {
              size: [1.5, 4.5, 2.5], material: draco_crimson, rotate: [8, 0, 6], blend_with: [dorsal_draco_conduit, stygian_mantle_c, pylon_obsidian_front]
            }
            plane pylon_shock_plume place(base_box=pylon_volcanic_rear, anchor=[0.20, 0.92, -0.85], align=[0, -0.85, 0.85]) {
              size: [6.0, 7.0], normal: x, material: alabaster_fur, rotate: [22, 0, -8],
              edge: spikes(width=4, min_len=4, max_len=9, side=top, seed=41), layer: 2,
              blend_with: [pylon_obsidian_front, pylon_silver_outer, stygian_mantle_l]
            }
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.28, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-20, 0, 0]
            box neck_base { size: [14.0, 12.0, 9.5], material: obsidian_hide }
            box neck_throat_shield place(base_box=neck_base, anchor=[0, -0.96, 0.12], align=[0, 0.48, 0]) {
              size: [10.0, 2.5, 8.0], material: volcanic_armor, rotate: [-6, 0, 0], blend_with: [chest_scute_front, chest_core, sternum_draco_keel]
            }
            box neck_throat_draco_rib place(base_box=neck_throat_shield, anchor=[0, -0.96, 0.32], align=[0, 0.74, 0]) {
              size: [7.0, 1.5, 5.5], material: stygian_slate, rotate: [-8, 0, 0], blend_with: [neck_base, chest_scute_front, sternum_draco_keel]
