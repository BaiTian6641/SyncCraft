                bone tail_6 attach(parent_box=tail_5_seg, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.22) {
                  rest_euler: [-8, 0, 0]
                  box tail_6_club { size: [5.0, 4.5, 9.0], material: volcanic_armor }
                  box tail_6_scythe_l place(base_box=tail_6_club, anchor=[0.96, 0.12, -0.15], align=[-0.65, 0, 0.45]) {
                    size: [3.0, 2.5, 8.0], material: volcanic_armor, rotate: [10, 26, -12], blend_with: [tail_5_seg, tail_5_scythe_l, tail_tip_barb_l]
                  }
                  box tail_6_scythe_r place(base_box=tail_6_club, anchor=[-0.96, 0.12, -0.15], align=[0.65, 0, 0.45]) {
                    size: [3.0, 2.5, 8.0], material: volcanic_armor, rotate: [10, -26, 12], blend_with: [tail_5_seg, tail_5_scythe_r, tail_tip_barb_r]
                  }
                  box tail_tip_barb_l place(base_box=tail_6_club, anchor=[0.68, 0.10, -0.92], align=[-0.35, 0, 0.72]) {
                    size: [2.0, 2.5, 7.0], material: dark_silver, rotate: [6, 16, -8], blend_with: [tail_5_seg, tail_5_scythe_l]
                  }
                  box tail_tip_barb_r place(base_box=tail_6_club, anchor=[-0.68, 0.10, -0.92], align=[0.35, 0, 0.72]) {
                    size: [2.0, 2.5, 7.0], material: dark_silver, rotate: [6, -16, 8], blend_with: [tail_5_seg, tail_5_scythe_r, tail_tip_barb_l]
                  }
                  box tail_tip_crimson_lance place(base_box=tail_6_club, anchor=[0, 0.88, -0.65], align=[0, -0.78, 0.55]) {
                    size: [1.5, 2.5, 5.5], material: draco_crimson, rotate: [16, 0, 0], blend_with: [tail_tip_barb_l, tail_tip_barb_r]
                  }
                  plane tail_6_fur_l place(base_box=tail_6_club, anchor=[0.35, 0.94, 0], align=[0, -0.85, 0]) {
                    size: [4.5, 7.0], normal: x, material: alabaster_fur, rotate: [10, 0, -16],
                    edge: spikes(width=4, min_len=3, max_len=7, side=top, seed=149), layer: 1,
                    blend_with: [tail_5_fur_l, tail_5_crimson_core, tail_tip_barb_l, tail_tip_crimson_lance]
                  }
                  plane tail_6_fur_r place(base_box=tail_6_club, anchor=[-0.35, 0.94, 0], align=[0, -0.85, 0]) {
                    size: [4.5, 7.0], normal: x, material: alabaster_fur, rotate: [10, 0, 16],
                    edge: spikes(width=4, min_len=3, max_len=7, side=top, seed=149), layer: 2,
                    blend_with: [tail_5_fur_r, tail_5_crimson_core, tail_tip_barb_r, tail_tip_crimson_lance, tail_6_fur_l]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
@materials {
  obsidian_hide: process(family=keratin_scales, coat=scale_rows, roughness=0.56)
  volcanic_armor: process(family=keratin_scales, coat=scale_rows, roughness=0.42)
  stygian_slate: process(family=keratin_scales, coat=banded_limb, roughness=0.52)
  dark_silver: process(family=brushed_metal, coat=striped, roughness=0.32)
  ash_charcoal: process(family=weathered_stone, coat=plain, roughness=0.58)
  alabaster_fur: process(family=woven_fabric, coat=striped, roughness=0.74)
  ash_belly: process(family=patterned_skin, coat=plain, roughness=0.64)
  crimson_talon: process(family=painted_metal, coat=striped, roughness=0.28)
  maw_scarlet: process(family=patterned_skin, coat=plain, roughness=0.45)
  ivory_fang: process(family=polymer_dielectric, coat=plain, roughness=0.26)
  draco_crimson: process(family=thin_film_iridescence, coat=plain, roughness=0.16, emissive=0.96)
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
@stamps {
  stamp draco_eye_glare on skull_core.east { at: [0.72, 0.35], size: [1.5, 1.0], color: draco_crimson, emissive: 0.96, mirror: true }
  stamp throat_draco_vein on neck_throat_shield.down { at: [0.50, 0.28], size: [4.5, 1.0], rows: 3, spacing: 1.8, color: draco_crimson, emissive: 0.94 }
  stamp chest_draco_ribs on chest_scute_front.down { at: [0.50, 0.30], size: [5.5, 1.0], rows: 2, spacing: 2.2, color: draco_crimson, emissive: 0.92 }
  stamp sternum_draco_ribs on chest_scute_rear.down { at: [0.50, 0.32], size: [6.0, 1.0], rows: 2, spacing: 2.4, color: draco_crimson, emissive: 0.90 }
  stamp waist_draco_ribs on waist_belly.down { at: [0.50, 0.35], size: [5.0, 1.0], rows: 2, spacing: 2.5, color: draco_crimson, emissive: 0.88 }
  stamp bracer_draco_crack on bracer_front_shield.south { at: [0.50, 0.42], size: [2.0, 2.5], color: draco_crimson, emissive: 0.90, mirror: true }
}
@behavior {
  spring ear_l { stiffness: 44, damping: 6 }
  spring ear_r { stiffness: 44, damping: 6 }
  spring draco_pylon_l { stiffness: 50, damping: 7 }
  spring draco_pylon_r { stiffness: 50, damping: 7 }
  spring tail_6 { stiffness: 38, damping: 5 }

  // 1. Low predatory Hellwolf breathing, menacing head scan & barbed Dracophage tail sway
  clip idle {
    duration_s: 3.0, loop: true
    key root.position { 0.0: [0, 0, 0], 0.75: [0, -0.5, 0], 1.5: [0, 0.35, 0], 2.25: [0, -0.5, 0], 3.0: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.75: [2.8, 1.8, 0], 1.5: [-2.2, 0, 0], 2.25: [2.8, -1.8, 0], 3.0: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.75: [-3, 7, 2], 1.5: [2, 0, 0], 2.25: [-3, -7, -2], 3.0: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.75: [4, 12, -5], 1.5: [-3, 0, 0], 2.25: [4, -12, 5], 3.0: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 1.5: [8, 0, 0], 3.0: [0, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=9, freq_hz=0.3333, phase_deg=0)
    track tail_2: wave(axis=y, amp_deg=12, freq_hz=0.3333, phase_deg=-35)
    track tail_3: wave(axis=y, amp_deg=15, freq_hz=0.3333, phase_deg=-70)
    track tail_4: wave(axis=y, amp_deg=17, freq_hz=0.3333, phase_deg=-105)
    track tail_5: wave(axis=y, amp_deg=19, freq_hz=0.3333, phase_deg=-140)
  }

  // 2. Menacing low-slung Hellwolf prowl with heavy rolling volcanic shoulders
  clip walk {
    duration_s: 1.5, loop: true
    key root.position { 0.0: [0, 0, 0], 0.38: [0, 1.0, 0], 0.75: [0, 0, 0], 1.12: [0, 1.0, 0], 1.5: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, -7, 3], 0.38: [2, 0, 0], 0.75: [0, 7, -3], 1.12: [2, 0, 0], 1.5: [0, -7, 3], catmullrom }
    key chest.rotation { 0.0: [0, 9, -7], 0.38: [-2, 0, 0], 0.75: [0, -9, 7], 1.12: [-2, 0, 0], 1.5: [0, 9, -7], catmullrom }
    key neck_1.rotation { 0.0: [0, -7, 4], 0.75: [0, 7, -4], 1.5: [0, -7, 4], catmullrom }
    key head.rotation { 0.0: [3, -5, 3], 0.75: [3, 5, -3], 1.5: [3, -5, 3], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [-26, 0, 0], 0.38: [6, 0, 5], 0.75: [24, 0, 0], 1.12: [-10, 0, 6], 1.5: [-26, 0, 0], catmullrom }
    key fore_arm_l.rotation { 0.0: [12, 0, 0], 0.38: [4, 0, 0], 0.75: [18, 0, 0], 1.12: [-26, 0, 0], 1.5: [12, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [24, 0, 0], 0.38: [-10, 0, 6], 0.75: [-26, 0, 0], 1.12: [6, 0, 5], 1.5: [24, 0, 0], catmullrom }
    key fore_shoulder_r__fore_arm_l.rotation { 0.0: [18, 0, 0], 0.38: [-26, 0, 0], 0.75: [12, 0, 0], 1.12: [4, 0, 0], 1.5: [18, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [22, 0, 0], 0.38: [-10, 0, 4], 0.75: [-24, 0, 0], 1.12: [6, 0, 0], 1.5: [22, 0, 0], catmullrom }
    key hind_shin_l.rotation { 0.0: [-14, 0, 0], 0.38: [26, 0, 0], 0.75: [8, 0, 0], 1.12: [-6, 0, 0], 1.5: [-14, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [-24, 0, 0], 0.38: [6, 0, 0], 0.75: [22, 0, 0], 1.12: [-10, 0, 4], 1.5: [-24, 0, 0], catmullrom }
    key hind_thigh_r__hind_shin_l.rotation { 0.0: [8, 0, 0], 0.38: [-6, 0, 0], 0.75: [-14, 0, 0], 1.12: [26, 0, 0], 1.5: [8, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=13, freq_hz=0.6667, phase_deg=0)
    track tail_3: wave(axis=y, amp_deg=19, freq_hz=0.6667, phase_deg=-60)
    track tail_5: wave(axis=y, amp_deg=24, freq_hz=0.6667, phase_deg=-120)
  }

  // 3. Bounding crimson-charged Hellwolf rotary sprint
  clip run {
    duration_s: 0.85, loop: true
    key root.position { 0.0: [0, 1.5, 0], 0.21: [0, 6.0, 3.0], 0.43: [0, 0.5, 0], 0.64: [0, -1.4, -1.5], 0.85: [0, 1.5, 0], catmullrom }
    key pelvis.rotation { 0.0: [-14, 0, 0], 0.21: [-20, 0, 0], 0.43: [10, 0, 0], 0.64: [18, 0, 0], 0.85: [-14, 0, 0], catmullrom }
    key waist.rotation { 0.0: [-8, 0, 0], 0.21: [-14, 0, 0], 0.43: [10, 0, 0], 0.64: [15, 0, 0], 0.85: [-8, 0, 0], catmullrom }
    key chest.rotation { 0.0: [-12, 0, 0], 0.21: [10, 0, 0], 0.43: [18, 0, 0], 0.64: [-8, 0, 0], 0.85: [-12, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [14, 0, 0], 0.21: [-12, 0, 0], 0.43: [-18, 0, 0], 0.64: [10, 0, 0], 0.85: [14, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [-44, 0, 5], 0.26: [-18, 0, 0], 0.52: [38, 0, 0], 0.85: [-44, 0, 5], catmullrom }
    key fore_arm_l.rotation { 0.0: [-20, 0, 0], 0.26: [12, 0, 0], 0.52: [30, 0, 0], 0.85: [-20, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [-32, 0, 5], 0.20: [-46, 0, 5], 0.48: [34, 0, 0], 0.85: [-32, 0, 5], catmullrom }
    key fore_shoulder_r__fore_arm_l.rotation { 0.0: [-14, 0, 0], 0.20: [-22, 0, 0], 0.48: [30, 0, 0], 0.85: [-14, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [38, 0, 0], 0.24: [44, 0, 0], 0.55: [-38, 0, 4], 0.85: [38, 0, 0], catmullrom }
    key hind_shin_l.rotation { 0.0: [-24, 0, 0], 0.24: [20, 0, 0], 0.55: [34, 0, 0], 0.85: [-24, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [30, 0, 0], 0.30: [42, 0, 0], 0.60: [-36, 0, 4], 0.85: [30, 0, 0], catmullrom }
    key hind_thigh_r__hind_shin_l.rotation { 0.0: [-18, 0, 0], 0.30: [18, 0, 0], 0.60: [32, 0, 0], 0.85: [-18, 0, 0], catmullrom }
    track tail_1: wave(axis=x, amp_deg=20, freq_hz=1.1765, phase_deg=0)
    track tail_3: wave(axis=x, amp_deg=26, freq_hz=1.1765, phase_deg=-55)
    track tail_5: wave(axis=x, amp_deg=30, freq_hz=1.1765, phase_deg=-110)
  }

  // 4. Stygian Hellwolf Dragon Roar — coils low, hurls hooked silver horns skyward, Dracophage pylons flare!
  clip roar {
    duration_s: 2.4, loop: false
    key root.position { 0.0: [0, 0, 0], 0.45: [0, -3.0, -2.5], 0.95: [0, 3.5, 1.5], 1.70: [0, 2.8, 1.0], 2.4: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.45: [14, 0, 0], 0.95: [-20, 0, 0], 1.70: [-16, 0, 0], 2.4: [0, 0, 0], catmullrom }
    key waist.rotation { 0.0: [0, 0, 0], 0.45: [12, 0, 0], 0.95: [-18, 0, 0], 1.70: [-14, 0, 0], 2.4: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.45: [16, 0, 0], 0.95: [-24, 0, 0], 1.32: [-22, 6, 0], 1.70: [-24, -6, 0], 2.4: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.45: [20, 0, 0], 0.95: [-30, 0, 0], 1.32: [-28, 10, 0], 1.70: [-30, -10, 0], 2.4: [0, 0, 0], catmullrom }
    key neck_2.rotation { 0.0: [0, 0, 0], 0.45: [14, 0, 0], 0.95: [-26, 0, 0], 1.70: [-24, 0, 0], 2.4: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.45: [18, 0, 0], 0.95: [-34, 0, 0], 1.32: [-32, 12, -8], 1.70: [-34, -12, 8], 2.4: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.45: [-6, 0, 0], 0.90: [44, 0, 0], 1.75: [42, 0, 0], 2.4: [0, 0, 0], catmullrom }
    key draco_pylon_l.rotation { 0.0: [0, 0, 0], 0.95: [-18, 10, -22], 1.75: [-20, 10, -24], 2.4: [0, 0, 0], catmullrom }
    key draco_pylon_r.rotation { 0.0: [0, 0, 0], 0.95: [-18, 10, -22], 1.75: [-20, 10, -24], 2.4: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.45: [20, 0, 12], 0.95: [-16, 0, 18], 1.70: [-14, 0, 18], 2.4: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.45: [20, 0, 12], 0.95: [-16, 0, 18], 1.70: [-14, 0, 18], 2.4: [0, 0, 0], catmullrom }
    key tail_2.rotation { 0.0: [0, 0, 0], 0.95: [20, 0, 0], 1.70: [24, 14, 0], 2.4: [0, 0, 0], catmullrom }
    key tail_4.rotation { 0.0: [0, 0, 0], 0.95: [24, 0, 0], 1.70: [28, -16, 0], 2.4: [0, 0, 0], catmullrom }
  }

  // 5. SIGNATURE GIF CLIP: Airborne Acrobatic Dracophage Backflip Barbed Tail Slam!
  clip dracophage_backflip_slam {
    duration_s: 2.1, loop: false
    key root.position { 0.0: [0, 0, 0], 0.34: [0, -4.0, -3.5], 0.75: [0, 24.0, 4.5], 1.18: [0, 14.5, 12.5], 1.48: [0, -2.5, 16.5], 2.1: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.34: [20, 0, 0], 0.75: [-78, 32, 24], 1.18: [58, -16, -12], 1.48: [26, 0, 0], 2.1: [0, 0, 0], catmullrom }
    key waist.rotation { 0.0: [0, 0, 0], 0.34: [14, 0, 0], 0.75: [-26, 16, 8], 1.18: [24, 0, 0], 1.48: [12, 0, 0], 2.1: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.34: [18, 0, 0], 0.75: [-28, 22, 14], 1.18: [26, -10, 0], 1.48: [16, 0, 0], 2.1: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.75: [-24, 12, 0], 1.18: [24, 0, 0], 2.1: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.75: [42, 0, 0], 1.48: [14, 0, 0], 2.1: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.34: [28, 0, 10], 0.75: [-54, 0, 28], 1.18: [-22, 0, 16], 1.48: [18, 0, 6], 2.1: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.34: [28, 0, 10], 0.75: [-54, 0, 28], 1.18: [-22, 0, 16], 1.48: [18, 0, 6], 2.1: [0, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [0, 0, 0], 0.34: [-26, 0, 6], 0.75: [44, 0, 18], 1.18: [-24, 0, 10], 1.48: [-16, 0, 4], 2.1: [0, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [0, 0, 0], 0.34: [-26, 0, 6], 0.75: [44, 0, 18], 1.18: [-24, 0, 10], 1.48: [-16, 0, 4], 2.1: [0, 0, 0], catmullrom }
    // Barbed Dracophage tail club whips overhead and crashes violently into Y=0 in front!
    key tail_1.rotation { 0.0: [0, 0, 0], 0.34: [-20, 0, 0], 0.75: [42, 14, 0], 1.18: [-46, 0, 0], 1.48: [-40, 0, 0], 2.1: [0, 0, 0], catmullrom }
    key tail_2.rotation { 0.0: [0, 0, 0], 0.34: [-18, 0, 0], 0.75: [40, 12, 0], 1.18: [-44, 0, 0], 1.48: [-38, 0, 0], 2.1: [0, 0, 0], catmullrom }
    key tail_3.rotation { 0.0: [0, 0, 0], 0.34: [-16, 0, 0], 0.75: [38, 10, 0], 1.18: [-42, 0, 0], 1.48: [-36, 0, 0], 2.1: [0, 0, 0], catmullrom }
    key tail_4.rotation { 0.0: [0, 0, 0], 0.34: [-14, 0, 0], 0.75: [34, 8, 0], 1.18: [-40, 0, 0], 1.48: [-34, 0, 0], 2.1: [0, 0, 0], catmullrom }
    key tail_5.rotation { 0.0: [0, 0, 0], 0.34: [-12, 0, 0], 0.75: [28, 6, 0], 1.18: [-34, 0, 0], 1.48: [-28, 0, 0], 2.1: [0, 0, 0], catmullrom }
  }

  // 6. Advancing 3-Hit Crimson Claw Dragon-Lightning Crush Combo!
  clip crimson_claw_triple_crush {
    duration_s: 2.6, loop: false
    key root.position { 0.0: [0, 0, 0], 0.38: [-2.0, 5.5, 2.5], 0.65: [1.5, -2.5, 7.0], 1.08: [2.5, 6.0, 9.5], 1.36: [-1.5, -3.0, 14.5], 1.78: [0, 8.5, 16.0], 2.08: [0, -3.5, 21.0], 2.6: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.38: [-22, -14, 8], 0.65: [14, 16, -6], 1.08: [-24, 16, -8], 1.36: [16, -16, 6], 1.78: [-28, 0, 0], 2.08: [22, 0, 0], 2.6: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.38: [-28, -24, 16], 0.65: [22, 26, -14], 1.08: [-30, 26, -16], 1.36: [24, -26, 14], 1.78: [-36, 0, 0], 2.08: [28, 0, 0], 2.6: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.38: [28, 0, 0], 1.08: [32, 0, 0], 1.78: [44, 0, 0], 2.08: [12, 0, 0], 2.6: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.38: [-70, -16, 28], 0.65: [20, 8, -8], 1.08: [24, 0, 10], 1.78: [-74, 0, 30], 2.08: [22, 0, -6], 2.6: [0, 0, 0], catmullrom }
    key fore_arm_l.rotation { 0.0: [0, 0, 0], 0.38: [-28, 0, 0], 0.65: [26, 0, 0], 1.78: [-32, 0, 0], 2.08: [28, 0, 0], 2.6: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.65: [24, 0, 10], 1.08: [-72, -18, 30], 1.36: [22, 8, -10], 1.78: [-74, 0, 30], 2.08: [22, 0, -6], 2.6: [0, 0, 0], catmullrom }
    key fore_shoulder_r__fore_arm_l.rotation { 0.0: [0, 0, 0], 1.08: [-30, 0, 0], 1.36: [26, 0, 0], 1.78: [-32, 0, 0], 2.08: [28, 0, 0], 2.6: [0, 0, 0], catmullrom }
  }

  // 7. Dracophage Homing Dragon-Orb Summoning Howl
  clip dracophage_homing_howl {
    duration_s: 2.8, loop: false
    key root.position { 0.0: [0, 0, 0], 0.55: [0, -2.5, -2.0], 1.15: [0, 2.5, 0], 2.15: [0, 2.8, 0], 2.8: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.55: [16, 0, 0], 1.15: [-16, 0, 0], 2.15: [-16, 0, 0], 2.8: [0, 0, 0], catmullrom }
