    key fore_shoulder_l.rotation { 0.0: [-42, 0, 4], 0.28: [-18, 0, 0], 0.55: [36, 0, 0], 0.9: [-42, 0, 4], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [-30, 0, 4], 0.22: [-44, 0, 4], 0.50: [32, 0, 0], 0.9: [-30, 0, 4], catmullrom }
    key hind_thigh_l.rotation { 0.0: [36, 0, 0], 0.25: [42, 0, 0], 0.58: [-36, 0, 4], 0.9: [36, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [28, 0, 0], 0.32: [40, 0, 0], 0.65: [-34, 0, 4], 0.9: [28, 0, 0], catmullrom }
    track tail_2: wave(axis=x, amp_deg=20, freq_hz=1.111, phase_deg=-45)
    track tail_5: wave(axis=x, amp_deg=28, freq_hz=1.111, phase_deg=-105)
  }

  // 4. Frenzy Eclipse Awakening Roar — rears up, unfurls full Reaper cloak canopy, SNAPS feelers upright!
  clip roar {
    duration_s: 2.6, loop: false
    key root.position { 0.0: [0, 0, 0], 0.42: [0, -2.5, -2.0], 0.95: [0, 7.5, -1.0], 1.85: [0, 7.0, -1.0], 2.6: [0, 0, 0], catmullrom }
