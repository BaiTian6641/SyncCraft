    key wing_shoulder_r.rotation { 0.0: [0, 0, 0], 0.42: [8, 12, -14], 0.95: [-12, -24, 34], 1.85: [-10, -22, 32], 2.6: [0, 0, 0], catmullrom }
    key wing_shoulder_r__wing_arm_l.rotation { 0.0: [0, 0, 0], 0.95: [-24, 28, 18], 1.85: [-22, 26, 16], 2.6: [0, 0, 0], catmullrom }
    key wing_shoulder_r__cloak_panel_1_l.rotation { 0.0: [0, 0, 0], 0.95: [26, -18, 0], 1.85: [24, -16, 0], 2.6: [0, 0, 0], catmullrom }
    key wing_shoulder_r__cloak_panel_2_l.rotation { 0.0: [0, 0, 0], 0.95: [24, -14, 0], 1.85: [22, -12, 0], 2.6: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.95: [-34, 0, 18], 1.85: [-30, 0, 16], 2.6: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.95: [-34, 0, 18], 1.85: [-30, 0, 16], 2.6: [0, 0, 0], catmullrom }
