              size: [3.5, 3.5, 5.5], material: eclipse_plum, rotate: [20, 0, 0], blend_with: [fore_bracer]
            }

            bone fore_arm_l attach(parent_box=fore_bicep, anchor=[0.10, -1, -0.05], align=[0, 0.88, 0], seat=0.18) {
              rest_euler: [-30, 0, -14]
              box fore_bracer { size: [7.0, 11.5, 7.5], material: obsidian_indigo, blend_with: [chest_core] }
              box bracer_front_guard place(base_box=fore_bracer, anchor=[0.10, 0.05, 0.98], align=[0, 0, -0.72]) {
                size: [5.0, 8.5, 2.0], material: visor_chitin, rotate: [4, -6, 0], blend_with: [fore_bicep, fore_paw_pad]
              }
              box bracer_plate_1 place(base_box=fore_bracer, anchor=[0.96, 0.45, 0.18], align=[-0.52, 0, 0.30]) {
                size: [2.5, 3.0, 6.5], material: shadow_slate, rotate: [16, 24, -14], blend_with: [fore_bicep, fore_pauldron, fore_elbow_spur]
              }
              box bracer_plate_2 place(base_box=fore_bracer, anchor=[0.96, 0.0, 0.18], align=[-0.56, 0, 0.30]) {
                size: [2.5, 3.0, 6.0], material: shadow_slate, rotate: [16, 24, -14], blend_with: [bracer_plate_1, fore_elbow_spur]
              }
              box bracer_plate_3 place(base_box=fore_bracer, anchor=[0.96, -0.45, 0.16], align=[-0.62, 0, 0.30]) {
                size: [2.5, 2.5, 5.5], material: visor_chitin, rotate: [16, 24, -14], blend_with: [bracer_plate_2, fore_paw_pad]
              }
              box bracer_frenzy_seam place(base_box=bracer_plate_1, anchor=[0.96, 0.10, 0], align=[-0.78, 0, 0]) {
                size: [1.0, 1.5, 4.0], material: frenzy_violet, rotate: [16, 24, -14]
              }
              plane forearm_tatter_fringe place(base_box=fore_bracer, anchor=[0.42, -0.10, -1.0], align=[0, 0, 0.88]) {
                size: [9.0, 6.0], normal: x, material: cloak_tatter, rotate: [8, 16, 0],
                edge: ragged(depth=4, holes=1, side=right, seed=163), layer: 1,
                blend_with: [fore_elbow_spur, bracer_plate_1, bracer_plate_2, bracer_plate_3, fore_paw_pad]
              }

              bone fore_paw_l attach(parent_box=fore_bracer, anchor=[0, -1, 0.15], align=[0, 0.85, -0.45], seat=0.16) {
                rest_euler: [15, 0, -8]
                box fore_paw_pad { size: [8.0, 3.5, 7.5], material: obsidian_indigo }
                box f_knuckle_guard place(base_box=fore_paw_pad, anchor=[0, 0.98, 0.60], align=[0, -0.82, 0]) {
                  size: [6.5, 1.5, 3.5], material: visor_chitin, rotate: [10, 0, 0], blend_with: [fore_bracer, bracer_front_guard, f_toe_1, f_toe_2, f_toe_3, f_toe_4]
                }
                box f_toe_1 place(base_box=fore_paw_pad, anchor=[-0.68, -0.08, 0.92], align=[0, 0, -0.76]) {
                  size: [2.0, 2.5, 4.0], material: shadow_slate, rotate: [3, 16, 0]
                }
                box f_claw_1 place(base_box=f_toe_1, anchor=[0, 0.08, 0.96], align=[0, 0, -0.82]) {
                  size: [1.5, 1.5, 3.5], material: wing_talon_crimson, rotate: [6, 4, 0]
                }
                box f_toe_2 place(base_box=fore_paw_pad, anchor=[-0.22, -0.08, 0.96], align=[0, 0, -0.78]) {
                  size: [2.0, 2.5, 4.5], material: shadow_slate, rotate: [3, 5, 0], blend_with: [f_toe_1]
                }
                box f_claw_2 place(base_box=f_toe_2, anchor=[0, 0.08, 0.96], align=[0, 0, -0.82]) {
                  size: [1.5, 1.5, 4.0], material: wing_talon_crimson, rotate: [6, 0, 0], blend_with: [f_claw_1]
                }
                box f_toe_3 place(base_box=fore_paw_pad, anchor=[0.24, -0.08, 0.96], align=[0, 0, -0.78]) {
                  size: [2.0, 2.5, 4.5], material: shadow_slate, rotate: [3, -6, 0], blend_with: [f_toe_2]
                }
                box f_claw_3 place(base_box=f_toe_3, anchor=[0, 0.08, 0.96], align=[0, 0, -0.82]) {
                  size: [1.5, 1.5, 4.0], material: wing_talon_crimson, rotate: [6, 0, 0], blend_with: [f_claw_2]
                }
                box f_toe_4 place(base_box=fore_paw_pad, anchor=[0.70, -0.08, 0.90], align=[0, 0, -0.76]) {
                  size: [2.0, 2.5, 4.0], material: shadow_slate, rotate: [3, -18, 0], blend_with: [f_toe_3]
                }
                box f_claw_4 place(base_box=f_toe_4, anchor=[0, 0.08, 0.96], align=[0, 0, -0.82]) {
                  size: [1.5, 1.5, 3.5], material: wing_talon_crimson, rotate: [6, -4, 0], blend_with: [f_claw_3]
                }
                box f_dewclaw place(base_box=fore_paw_pad, anchor=[-0.96, 0.22, -0.35], align=[0.68, 0, 0.35]) {
                  size: [1.5, 2.0, 3.0], material: wing_talon_crimson, rotate: [10, -28, 0], blend_with: [fore_bracer]
                }
              }
            }
          }
        }
      }

      // Terrestrial Digitigrade Hindlimbs (Legs 3 & 4 — planted squarely on Y = 0)
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.96, -0.10, -0.05], align=[-0.55, 0.85, 0], seat=0.12) mirror_x(hind_thigh_r) {
        rest_euler: [-22, -6, 18]
        box thigh_mass { size: [6.5, 11.5, 8.5], material: obsidian_indigo, blend_with: [waist_core, tail_1_seg] }
        box thigh_plate place(base_box=thigh_mass, anchor=[0.98, 0.22, 0.08], align=[-0.48, 0, 0]) {
          size: [2.5, 6.5, 6.0], material: shadow_slate, rotate: [6, -8, -10], blend_with: [pelvis_core, haunch_muscle_l]
        }
        box thigh_spur place(base_box=thigh_plate, anchor=[0.92, 0.25, -0.42], align=[-0.68, 0, 0.45]) {
          size: [2.0, 2.5, 5.5], material: visor_chitin, rotate: [16, 24, -12], blend_with: [thigh_mass, hip_spur_l]
        }
        box knee_guard place(base_box=thigh_mass, anchor=[0.15, -0.82, 0.96], align=[0, 0, -0.72]) {
          size: [4.0, 3.5, 2.5], material: visor_chitin, rotate: [-14, 0, 0], blend_with: [shin_mass, waist_core, waist_belly]
        }
        plane thigh_tatter_fringe place(base_box=thigh_mass, anchor=[0.45, -0.15, -1.0], align=[0, 0, 0.88]) {
          size: [7.5, 5.5], normal: x, material: cloak_tatter, rotate: [-12, 14, 0],
          edge: ragged(depth=4, holes=1, side=right, seed=173), layer: 1,
          blend_with: [thigh_plate, thigh_spur, shin_mass, hock_spur]
        }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [40, 0, -10]
          box shin_mass { size: [5.0, 10.5, 5.5], material: obsidian_indigo }
          box shin_front_plate place(base_box=shin_mass, anchor=[0.18, 0.05, 0.96], align=[0, 0, -0.68]) {
            size: [3.5, 7.0, 2.0], material: shadow_slate, rotate: [4, 0, 0], blend_with: [thigh_mass, knee_guard, hind_paw_pad]
          }
          box hock_spur place(base_box=shin_mass, anchor=[0, 0.65, -0.92], align=[0, 0, 0.68]) {
            size: [3.0, 3.5, 4.5], material: eclipse_plum, rotate: [20, 0, 0], blend_with: [thigh_mass]
          }
          plane ankle_tatter_fringe place(base_box=shin_mass, anchor=[0.25, -0.32, -0.98], align=[0, 0, 0.88]) {
            size: [5.0, 4.5], normal: x, material: cloak_tatter, rotate: [10, 10, 0],
            edge: spikes(width=2, min_len=3, max_len=6, side=right, seed=179), layer: 1,
            blend_with: [hock_spur, hind_paw_pad]
          }

          bone hind_paw_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.42], seat=0.14) {
            rest_euler: [-25, 0, -8]
            box hind_paw_pad { size: [6.5, 3.0, 7.0], material: obsidian_indigo }
            box h_knuckle_guard place(base_box=hind_paw_pad, anchor=[0, 0.98, 0.60], align=[0, -0.82, 0]) {
              size: [5.0, 1.0, 3.0], material: visor_chitin, rotate: [10, 0, 0], blend_with: [shin_mass, shin_front_plate, h_toe_1, h_toe_2, h_toe_3]
            }
            box h_toe_1 place(base_box=hind_paw_pad, anchor=[-0.62, -0.06, 0.92], align=[0, 0, -0.76]) {
              size: [2.0, 2.0, 3.5], material: shadow_slate, rotate: [3, 14, 0]
            }
            box h_claw_1 place(base_box=h_toe_1, anchor=[0, 0.08, 0.96], align=[0, 0, -0.82]) {
              size: [1.5, 1.5, 3.0], material: wing_talon_crimson, rotate: [6, 4, 0]
            }
            box h_toe_2 place(base_box=hind_paw_pad, anchor=[0.0, -0.06, 0.96], align=[0, 0, -0.78]) {
              size: [2.0, 2.0, 4.0], material: shadow_slate, rotate: [3, 0, 0], blend_with: [h_toe_1]
            }
            box h_claw_2 place(base_box=h_toe_2, anchor=[0, 0.08, 0.96], align=[0, 0, -0.82]) {
              size: [1.5, 1.5, 3.5], material: wing_talon_crimson, rotate: [6, 0, 0], blend_with: [h_claw_1]
            }
            box h_toe_3 place(base_box=hind_paw_pad, anchor=[0.62, -0.06, 0.92], align=[0, 0, -0.76]) {
              size: [2.0, 2.0, 3.5], material: shadow_slate, rotate: [3, -14, 0], blend_with: [h_toe_2]
            }
            box h_claw_3 place(base_box=h_toe_3, anchor=[0, 0.08, 0.96], align=[0, 0, -0.82]) {
              size: [1.5, 1.5, 3.0], material: wing_talon_crimson, rotate: [6, -4, 0], blend_with: [h_claw_2]
            }
            box h_heel_spur place(base_box=hind_paw_pad, anchor=[0, 0.25, -0.96], align=[0, 0, 0.80]) {
              size: [2.0, 1.5, 3.0], material: visor_chitin, rotate: [12, 0, 0], blend_with: [shin_mass]
            }
          }
        }
      }

      // 6-Segment Scythe-Spined Eclipse Whip Tail
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.18, -1], align=[0, 0, 1], seat=0.24) {
        rest_euler: [-10, 0, 0]
        box tail_1_seg { size: [9.0, 8.0, 8.5], material: obsidian_indigo }
        box tail_1_belly place(base_box=tail_1_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
          size: [6.5, 1.5, 7.5], material: abyssal_belly, blend_with: [pelvis_belly, pelvis_core]
        }
        box tail_1_spine place(base_box=tail_1_seg, anchor=[0, 0.96, -0.10], align=[0, -0.68, 0]) {
          size: [3.5, 3.0, 6.0], material: eclipse_plum, rotate: [16, 0, 0], blend_with: [pelvis_core, sacrum_ridge]
        }

        bone tail_2 attach(parent_box=tail_1_seg, anchor=[0, 0.08, -1], align=[0, 0, 1], seat=0.24) {
          rest_euler: [-2, 0, 0]
          box tail_2_seg { size: [8.0, 7.0, 8.5], material: obsidian_indigo }
          box tail_2_belly place(base_box=tail_2_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
            size: [5.5, 1.5, 7.5], material: abyssal_belly, blend_with: [tail_1_belly, tail_1_seg]
          }
          box tail_2_spine place(base_box=tail_2_seg, anchor=[0, 0.96, -0.10], align=[0, -0.68, 0]) {
            size: [3.0, 3.0, 5.5], material: eclipse_plum, rotate: [18, 0, 0], blend_with: [tail_1_seg, tail_1_spine]
          }
          box tail_2_keel_l place(base_box=tail_2_seg, anchor=[0.96, 0.16, -0.16], align=[-0.58, 0, 0.40]) {
            size: [2.5, 2.5, 6.5], material: shadow_slate, rotate: [10, 22, -10], blend_with: [tail_1_seg, tail_3_seg, tail_3_keel_l]
          }
          box tail_2_keel_r place(base_box=tail_2_seg, anchor=[-0.96, 0.16, -0.16], align=[0.58, 0, 0.40]) {
            size: [2.5, 2.5, 6.5], material: shadow_slate, rotate: [10, -22, 10], blend_with: [tail_1_seg, tail_3_seg, tail_3_keel_r]
          }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.08, -1], align=[0, 0, 1], seat=0.24) {
            rest_euler: [12, 0, 0]
            box tail_3_seg { size: [7.0, 6.5, 8.5], material: obsidian_indigo }
            box tail_3_belly place(base_box=tail_3_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
              size: [4.5, 1.5, 7.5], material: abyssal_belly, blend_with: [tail_2_belly, tail_2_seg]
            }
            box tail_3_spine place(base_box=tail_3_seg, anchor=[0, 0.96, -0.10], align=[0, -0.72, 0]) {
              size: [2.5, 3.0, 5.5], material: visor_chitin, rotate: [20, 0, 0], blend_with: [tail_2_seg, tail_2_spine]
            }
            box tail_3_keel_l place(base_box=tail_3_seg, anchor=[0.96, 0.18, -0.18], align=[-0.52, 0, 0.45]) {
              size: [2.5, 2.5, 7.0], material: shadow_slate, rotate: [12, 24, -12], blend_with: [tail_2_seg, tail_4_seg]
            }
            box tail_3_keel_r place(base_box=tail_3_seg, anchor=[-0.96, 0.18, -0.18], align=[0.52, 0, 0.45]) {
              size: [2.5, 2.5, 7.0], material: shadow_slate, rotate: [12, -24, 12], blend_with: [tail_2_seg, tail_4_seg]
            }
            plane tail_3_veil_plane place(base_box=tail_3_seg, anchor=[0, -0.92, 0], align=[0, 0.85, 0]) {
              size: [4.5, 7.5], normal: x, material: cloak_tatter, rotate: [-6, 0, 0],
              edge: ragged(depth=4, holes=1, side=bottom, seed=181), layer: 1,
              blend_with: [tail_3_belly, tail_2_seg, tail_4_seg]
            }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.08, -1], align=[0, 0, 1], seat=0.24) {
              rest_euler: [18, 0, 0]
              box tail_4_seg { size: [6.0, 5.5, 8.0], material: obsidian_indigo }
              box tail_4_spine place(base_box=tail_4_seg, anchor=[0, 0.96, -0.10], align=[0, -0.75, 0]) {
                size: [2.0, 3.0, 5.5], material: visor_chitin, rotate: [22, 0, 0], blend_with: [tail_3_seg, tail_3_spine]
              }
              box tail_4_keel_l place(base_box=tail_4_seg, anchor=[0.96, 0.18, -0.18], align=[-0.55, 0, 0.48]) {
                size: [3.0, 2.5, 7.5], material: eclipse_plum, rotate: [14, 28, -14], blend_with: [tail_3_seg, tail_3_keel_l, tail_5_seg]
              }
              box tail_4_keel_r place(base_box=tail_4_seg, anchor=[-0.96, 0.18, -0.18], align=[0.55, 0, 0.48]) {
                size: [3.0, 2.5, 7.5], material: eclipse_plum, rotate: [14, -28, 14], blend_with: [tail_3_seg, tail_3_keel_r, tail_5_seg]
              }
              box tail_4_frenzy_seam_l place(base_box=tail_4_keel_l, anchor=[0.92, 0.20, 0], align=[-0.78, 0, 0]) {
                size: [1.0, 1.5, 4.5], material: frenzy_violet, rotate: [14, 28, -14]
              }
              box tail_4_frenzy_seam_r place(base_box=tail_4_keel_r, anchor=[-0.92, 0.20, 0], align=[0.78, 0, 0]) {
                size: [1.0, 1.5, 4.5], material: frenzy_violet, rotate: [14, -28, 14]
              }
              plane tail_4_veil_plane place(base_box=tail_4_seg, anchor=[0, -0.92, 0], align=[0, 0.85, 0]) {
                size: [5.0, 7.5], normal: x, material: cloak_tatter, rotate: [-6, 0, 0],
                edge: ragged(depth=5, holes=1, side=bottom, seed=191), layer: 2,
                blend_with: [tail_3_veil_plane, tail_3_seg, tail_5_seg]
              }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.22) {
                rest_euler: [20, 0, 0]
                box tail_5_seg { size: [5.0, 4.5, 7.5], material: eclipse_plum }
                box tail_5_spine place(base_box=tail_5_seg, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
                  size: [2.0, 2.5, 5.0], material: frenzy_violet, rotate: [20, 0, 0], blend_with: [tail_4_seg, tail_4_spine, tail_6_seg]
                }
                box tail_5_keel_l place(base_box=tail_5_seg, anchor=[0.96, 0.15, -0.18], align=[-0.58, 0, 0.48]) {
                  size: [2.5, 2.0, 7.0], material: shadow_slate, rotate: [14, 26, -14], blend_with: [tail_4_seg, tail_4_keel_l, tail_6_seg]
                }
                box tail_5_keel_r place(base_box=tail_5_seg, anchor=[-0.96, 0.15, -0.18], align=[0.58, 0, 0.48]) {
                  size: [2.5, 2.0, 7.0], material: shadow_slate, rotate: [14, -26, 14], blend_with: [tail_4_seg, tail_4_keel_r, tail_6_seg]
                }
                plane tail_5_veil_plane place(base_box=tail_5_seg, anchor=[0, -0.92, 0], align=[0, 0.85, 0]) {
                  size: [5.0, 7.0], normal: x, material: cloak_tatter, rotate: [-8, 0, 0],
                  edge: ragged(depth=5, holes=1, side=bottom, seed=197), layer: 1,
                  blend_with: [tail_4_veil_plane, tail_4_seg, tail_6_seg]
                }

                bone tail_6 attach(parent_box=tail_5_seg, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.20) {
                  rest_euler: [14, 0, 0]
                  box tail_6_seg { size: [3.5, 3.5, 8.0], material: shadow_slate }
                  box tail_6_keel_l place(base_box=tail_6_seg, anchor=[0.96, 0.10, -0.18], align=[-0.65, 0, 0.45]) {
                    size: [2.0, 2.0, 6.5], material: wing_talon_crimson, rotate: [12, 24, -12], blend_with: [tail_5_seg, tail_5_keel_l, tail_tip_scythe]
                  }
                  box tail_6_keel_r place(base_box=tail_6_seg, anchor=[-0.96, 0.10, -0.18], align=[0.65, 0, 0.45]) {
                    size: [2.0, 2.0, 6.5], material: wing_talon_crimson, rotate: [12, -24, 12], blend_with: [tail_5_seg, tail_5_keel_r, tail_tip_scythe]
                  }
                  box tail_tip_scythe place(base_box=tail_6_seg, anchor=[0, 0.25, -0.94], align=[0, 0, 0.72]) {
                    size: [2.5, 3.0, 6.5], material: wing_talon_crimson, rotate: [16, 0, 0]
                  }
                  box tail_tip_frenzy_barb place(base_box=tail_tip_scythe, anchor=[0, 0.90, -0.35], align=[0, -0.78, 0.35]) {
                    size: [1.5, 2.0, 4.5], material: frenzy_violet, rotate: [18, 0, 0], blend_with: [tail_6_seg]
                  }
                  plane tail_6_tatter_plume place(base_box=tail_tip_scythe, anchor=[0, -0.88, -0.20], align=[0, 0.80, 0]) {
                    size: [5.5, 7.5], normal: x, material: cloak_tatter, rotate: [-10, 0, 0],
                    edge: drip(width=2, min_len=3, max_len=7, side=bottom, seed=199), layer: 2,
                    blend_with: [tail_6_seg, tail_5_veil_plane]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
@materials {
  obsidian_indigo: process(family=keratin_scales, coat=scale_rows, roughness=0.52)
  eclipse_plum: process(family=keratin_scales, coat=scale_rows, roughness=0.46)
  shadow_slate: process(family=keratin_scales, coat=banded_limb, roughness=0.48)
  visor_chitin: process(family=painted_metal, coat=striped, roughness=0.34)
  abyssal_belly: process(family=patterned_skin, coat=plain, roughness=0.64)
  cloak_membrane: process(family=woven_fabric, coat=mottled, roughness=0.72)
  cloak_tatter: process(family=woven_fabric, coat=striped, roughness=0.78)
  wing_talon_crimson: process(family=polymer_dielectric, coat=plain, roughness=0.28)
  fang_ivory: process(family=polymer_dielectric, coat=plain, roughness=0.26)
  beak_dark: process(family=weathered_stone, coat=plain, roughness=0.44)
  frenzy_maw: process(family=patterned_skin, coat=plain, roughness=0.38, emissive=0.55)
  frenzy_violet: process(family=thin_film_iridescence, coat=plain, roughness=0.16, emissive=0.95)
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
@stamps {
  stamp crown_frenzy_seam on feeler_seg_1.up { at: [0.50, 0.55], size: [1.5, 2.5], color: frenzy_violet, emissive: 0.92, mirror: true }
  stamp wing_palm_frenzy_glow on wing_palm.up { at: [0.50, 0.58], size: [2.5, 1.5], color: frenzy_violet, emissive: 0.90, mirror: true }
  stamp chest_frenzy_core on sternum_fissure_keel.south { at: [0.50, 0.50], size: [2.5, 1.5], color: frenzy_violet, emissive: 0.94 }
}
@behavior {
  spring feeler_tip_l { stiffness: 38, damping: 5 }
  spring cloak_drape_1_l { stiffness: 32, damping: 5 }
  spring cloak_drape_2_l { stiffness: 34, damping: 5 }
  spring cloak_drape_3_l { stiffness: 36, damping: 6 }
  spring tail_6 { stiffness: 36, damping: 5 }

  // 1. Eerie blind-visor scent-scanning prowl, rhythmic breathing & billowing Reaper cloak
  clip idle {
    duration_s: 3.2, loop: true
    key root.position { 0.0: [0, 0, 0], 0.8: [0, -0.5, 0], 1.6: [0, 0.4, 0], 2.4: [0, -0.5, 0], 3.2: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.8: [2.5, 1.5, 0], 1.6: [-2.5, 0, 0], 2.4: [2.5, -1.5, 0], 3.2: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.8: [-3, 7, 2], 1.6: [2, 0, 0], 2.4: [-3, -7, -2], 3.2: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.8: [5, 12, -6], 1.6: [-3, 0, 0], 2.4: [5, -12, 6], 3.2: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 1.6: [8, 0, 0], 3.2: [0, 0, 0], catmullrom }
    key wing_shoulder_l.rotation { 0.0: [0, 0, 0], 1.6: [0, -4, 6], 3.2: [0, 0, 0], catmullrom }
    key wing_shoulder_r.rotation { 0.0: [0, 0, 0], 1.6: [0, -4, 6], 3.2: [0, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=8, freq_hz=0.3125, phase_deg=0)
    track tail_3: wave(axis=y, amp_deg=14, freq_hz=0.3125, phase_deg=-65)
    track tail_5: wave(axis=y, amp_deg=18, freq_hz=0.3125, phase_deg=-130)
  }

  // 2. Looming 6-Limbed Reaper Prowl — heavy quadruped leg stride + menacing dorsal wing-arm sway
  clip walk {
    duration_s: 1.6, loop: true
    key root.position { 0.0: [0, 0, 0], 0.4: [0, 1.2, 0], 0.8: [0, 0, 0], 1.2: [0, 1.2, 0], 1.6: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, -6, 3], 0.4: [2, 0, 0], 0.8: [0, 6, -3], 1.2: [2, 0, 0], 1.6: [0, -6, 3], catmullrom }
    key chest.rotation { 0.0: [0, 8, -5], 0.4: [-2, 0, 0], 0.8: [0, -8, 5], 1.2: [-2, 0, 0], 1.6: [0, 8, -5], catmullrom }
    key head.rotation { 0.0: [3, -5, 4], 0.8: [3, 5, -4], 1.6: [3, -5, 4], catmullrom }
    key wing_shoulder_l.rotation { 0.0: [4, -8, 6], 0.8: [-4, 8, -4], 1.6: [4, -8, 6], catmullrom }
    key wing_shoulder_r.rotation { 0.0: [-4, 8, -4], 0.8: [4, -8, 6], 1.6: [-4, 8, -4], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [-24, 0, 0], 0.4: [6, 0, 4], 0.8: [22, 0, 0], 1.2: [-8, 0, 6], 1.6: [-24, 0, 0], catmullrom }
    key fore_arm_l.rotation { 0.0: [12, 0, 0], 0.4: [4, 0, 0], 0.8: [18, 0, 0], 1.2: [-22, 0, 0], 1.6: [12, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [22, 0, 0], 0.4: [-8, 0, 6], 0.8: [-24, 0, 0], 1.2: [6, 0, 4], 1.6: [22, 0, 0], catmullrom }
    key fore_shoulder_r__fore_arm_l.rotation { 0.0: [18, 0, 0], 0.4: [-22, 0, 0], 0.8: [12, 0, 0], 1.2: [4, 0, 0], 1.6: [18, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [20, 0, 0], 0.4: [-10, 0, 4], 0.8: [-22, 0, 0], 1.2: [6, 0, 0], 1.6: [20, 0, 0], catmullrom }
    key hind_shin_l.rotation { 0.0: [-14, 0, 0], 0.4: [24, 0, 0], 0.8: [8, 0, 0], 1.2: [-6, 0, 0], 1.6: [-14, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [-22, 0, 0], 0.4: [6, 0, 0], 0.8: [20, 0, 0], 1.2: [-10, 0, 4], 1.6: [-22, 0, 0], catmullrom }
    key hind_thigh_r__hind_shin_l.rotation { 0.0: [8, 0, 0], 0.4: [-6, 0, 0], 0.8: [-14, 0, 0], 1.2: [24, 0, 0], 1.6: [8, 0, 0], catmullrom }
    track tail_2: wave(axis=y, amp_deg=14, freq_hz=0.625, phase_deg=-40)
    track tail_5: wave(axis=y, amp_deg=22, freq_hz=0.625, phase_deg=-110)
  }

  // 3. Ferocious 6-Limbed Gallop — wing-arms bound forward while Reaper cloak streams horizontally!
  clip run {
    duration_s: 0.9, loop: true
    key root.position { 0.0: [0, 1.5, 0], 0.22: [0, 6.0, 3.0], 0.45: [0, 0.5, 0], 0.68: [0, -1.2, -1.5], 0.9: [0, 1.5, 0], catmullrom }
    key pelvis.rotation { 0.0: [-12, 0, 0], 0.22: [-18, 0, 0], 0.45: [8, 0, 0], 0.68: [16, 0, 0], 0.9: [-12, 0, 0], catmullrom }
    key chest.rotation { 0.0: [-10, 0, 0], 0.22: [10, 0, 0], 0.45: [16, 0, 0], 0.68: [-6, 0, 0], 0.9: [-10, 0, 0], catmullrom }
