    key chest.rotation { 0.0: [0, 0, 0], 0.42: [14, 0, 0], 0.95: [-24, 0, 0], 1.40: [-22, 6, 0], 1.85: [-24, -6, 0], 2.6: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.42: [18, 0, 0], 0.95: [-24, 0, 0], 1.85: [-22, 0, 0], 2.6: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.42: [16, 0, 0], 0.95: [-26, 0, 0], 1.40: [-24, 10, -6], 1.85: [-26, -10, 6], 2.6: [0, 0, 0], catmullrom }
