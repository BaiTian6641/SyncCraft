// Gore Magala (Black Eclipse Wyvern) — Stage 3 Sculpted Blockbench Masterwork
// Hand-authored progressive Block-DSL v4.1 from official Capcom Monster Hunter 4U / Sunbreak / Wilds
// references & sculpted Blockbench style anchor: 100% BLIND eyeless faceted obsidian-indigo visor skull,
// 3-segment erectile luminescent violet Frenzy feelers, 4 grounded dragon legs, 2 massive dorsal
// prehensile 4-clawed wing-arms, and 3-column 2-tier tattered Reaper wing-cloak with spore-flecked bays.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 420
  budget max_bones = 96
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  obsidian_indigo: ramp(base_lch=[0.26, 0.096, 282], steps=6, hue_shift=[24, -16])
  eclipse_plum: ramp(base_lch=[0.33, 0.128, 296], steps=6, hue_shift=[26, -16])
  shadow_slate: ramp(base_lch=[0.35, 0.092, 274], steps=6, hue_shift=[22, -14])
  visor_chitin: ramp(base_lch=[0.39, 0.098, 270], steps=6, hue_shift=[22, -14])
  abyssal_belly: ramp(base_lch=[0.36, 0.094, 292], steps=6, hue_shift=[22, -14])
  cloak_membrane: ramp(base_lch=[0.25, 0.118, 294], steps=6, hue_shift=[28, -16])
  cloak_tatter: ramp(base_lch=[0.21, 0.102, 288], steps=6, hue_shift=[26, -14])
  wing_talon_crimson: ramp(base_lch=[0.46, 0.158, 346], steps=6, hue_shift=[20, -14])
  fang_ivory: ramp(base_lch=[0.84, 0.048, 86], steps=6, hue_shift=[18, -10])
  beak_dark: ramp(base_lch=[0.19, 0.064, 278], steps=6, hue_shift=[18, -12])
  frenzy_maw: ramp(base_lch=[0.46, 0.175, 316], steps=6, hue_shift=[18, -14])
  frenzy_violet: ramp(base_lch=[0.74, 0.225, 308], steps=6, hue_shift=[16, -18], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 20.35, -13.5]) {
      rest_euler: [7, 0, 0]
      box pelvis_core { size: [13.0, 11.5, 13.0], material: obsidian_indigo }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.35, 0]) {
        size: [9.5, 2.0, 11.0], material: abyssal_belly
      }
      box sacrum_ridge place(base_box=pelvis_core, anchor=[0, 0.96, -0.08], align=[0, -0.50, 0]) {
        size: [7.5, 2.5, 10.5], material: eclipse_plum, rotate: [6, 0, 0], blend_with: [lumbar_ridge, tail_1_seg]
      }
      box sacrum_spine_1 place(base_box=sacrum_ridge, anchor=[0, 0.96, 0.34], align=[0, -0.76, 0]) {
        size: [2.5, 2.5, 3.0], material: visor_chitin, rotate: [18, 0, 0], blend_with: [pelvis_core, lumbar_ridge]
      }
      box sacrum_spine_2 place(base_box=sacrum_ridge, anchor=[0, 0.96, -0.36], align=[0, -0.76, 0]) {
        size: [2.5, 2.5, 3.0], material: visor_chitin, rotate: [20, 0, 0], blend_with: [pelvis_core, tail_1_spine]
      }
      box haunch_muscle_l place(base_box=pelvis_core, anchor=[0.98, 0.24, -0.05], align=[-0.48, 0, 0]) {
        size: [3.5, 7.5, 9.5], material: shadow_slate, rotate: [4, 6, -12], blend_with: [thigh_mass, waist_core]
      }
      box haunch_muscle_r place(base_box=pelvis_core, anchor=[-0.98, 0.24, -0.05], align=[0.48, 0, 0]) {
        size: [3.5, 7.5, 9.5], material: shadow_slate, rotate: [4, -6, 12], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }
      box hip_spur_l place(base_box=haunch_muscle_l, anchor=[0.92, 0.42, -0.35], align=[-0.68, 0, 0.35]) {
        size: [2.0, 2.5, 5.5], material: visor_chitin, rotate: [14, 24, -14], blend_with: [pelvis_core, thigh_mass, thigh_plate]
      }
      box hip_spur_r place(base_box=haunch_muscle_r, anchor=[-0.92, 0.42, -0.35], align=[0.68, 0, 0.35]) {
        size: [2.0, 2.5, 5.5], material: visor_chitin, rotate: [14, -24, 14], blend_with: [pelvis_core, hind_thigh_r__thigh_mass, hind_thigh_r__thigh_plate]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.16, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-6, 0, 0]
        box waist_core { size: [15.0, 13.5, 12.5], material: obsidian_indigo }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.35, 0]) {
          size: [10.5, 2.0, 10.5], material: abyssal_belly, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_ridge place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.50, 0]) {
          size: [8.5, 2.5, 10.0], material: eclipse_plum, rotate: [-6, 0, 0], blend_with: [pelvis_core, chest_core, withers_girdle]
        }
        box lumbar_spine_1 place(base_box=lumbar_ridge, anchor=[0, 0.96, 0.32], align=[0, -0.78, 0]) {
          size: [2.5, 3.0, 3.5], material: visor_chitin, rotate: [20, 0, 0], blend_with: [waist_core, chest_core, withers_girdle]
        }
        box lumbar_spine_2 place(base_box=lumbar_ridge, anchor=[0, 0.96, -0.35], align=[0, -0.78, 0]) {
          size: [2.5, 2.5, 3.5], material: visor_chitin, rotate: [22, 0, 0], blend_with: [waist_core, pelvis_core, sacrum_ridge]
        }
        box flank_shingle_l_1 place(base_box=waist_core, anchor=[0.98, 0.34, 0.24], align=[-0.68, 0, 0]) {
          size: [2.0, 4.5, 4.5], material: shadow_slate, rotate: [8, 12, -14], blend_with: [chest_core]
        }
        box flank_shingle_r_1 place(base_box=waist_core, anchor=[-0.98, 0.34, 0.24], align=[0.68, 0, 0]) {
          size: [2.0, 4.5, 4.5], material: shadow_slate, rotate: [8, -12, 14], blend_with: [chest_core]
        }
        box flank_shingle_l_2 place(base_box=waist_core, anchor=[0.98, -0.12, -0.22], align=[-0.68, 0, 0]) {
          size: [2.0, 4.5, 4.5], material: shadow_slate, rotate: [6, 14, -10], blend_with: [flank_shingle_l_1, pelvis_core, haunch_muscle_l, thigh_mass]
        }
        box flank_shingle_r_2 place(base_box=waist_core, anchor=[-0.98, -0.12, -0.22], align=[0.68, 0, 0]) {
          size: [2.0, 4.5, 4.5], material: shadow_slate, rotate: [6, -14, 10], blend_with: [flank_shingle_r_1, pelvis_core, haunch_muscle_r, hind_thigh_r__thigh_mass]
        }
        plane waist_tatter_veil_l place(base_box=waist_core, anchor=[1.0, 0.22, -0.12], align=[-0.85, 0, 0]) {
          size: [5.5, 8.0], normal: x, material: cloak_tatter, rotate: [0, 12, -16],
          edge: ragged(depth=4, holes=1, side=bottom, seed=101), layer: 1,
          blend_with: [flank_shingle_l_1, flank_shingle_l_2, pelvis_core, haunch_muscle_l, thigh_mass]
        }
        plane waist_tatter_veil_r place(base_box=waist_core, anchor=[-1.0, 0.22, -0.12], align=[0.85, 0, 0]) {
          size: [5.5, 8.0], normal: x, material: cloak_tatter, rotate: [0, -12, 16],
          edge: ragged(depth=4, holes=1, side=bottom, seed=101), layer: 1,
          blend_with: [flank_shingle_r_1, flank_shingle_r_2, pelvis_core, haunch_muscle_r, hind_thigh_r__thigh_mass]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.22, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [-5, 0, 0]
          box chest_core { size: [20.0, 17.5, 16.5], material: obsidian_indigo }
          box withers_girdle place(base_box=chest_core, anchor=[0, 0.98, 0.05], align=[0, -0.48, 0]) {
            size: [15.5, 6.0, 14.5], material: eclipse_plum, rotate: [-8, 0, 0], blend_with: [neck_base, lumbar_ridge, lumbar_spine_1]
          }
          box dorsal_frenzy_fissure place(base_box=withers_girdle, anchor=[0, 0.98, -0.04], align=[0, -0.78, 0]) {
            size: [3.0, 2.5, 6.5], material: frenzy_violet, rotate: [6, 0, 0], blend_with: [chest_core, neck_base]
          }
          box withers_crest_spike_1 place(base_box=withers_girdle, anchor=[0, 0.98, 0.56], align=[0, -0.82, 0]) {
            size: [3.0, 3.5, 3.5], material: visor_chitin, rotate: [18, 0, 0], blend_with: [dorsal_frenzy_fissure, neck_base, cervical_crest_1]
          }
          box withers_crest_spike_2 place(base_box=withers_girdle, anchor=[0, 0.98, -0.68], align=[0, -0.82, 0]) {
            size: [2.5, 3.0, 3.5], material: visor_chitin, rotate: [22, 0, 0], blend_with: [dorsal_frenzy_fissure, lumbar_ridge, lumbar_spine_1]
          }
          box scapula_mount_l place(base_box=withers_girdle, anchor=[0.94, -0.15, -0.32], align=[-0.72, 0, 0]) {
            size: [3.5, 4.0, 9.0], material: shadow_slate, rotate: [-6, -10, -16], blend_with: [chest_core, wing_humerus]
          }
          box scapula_mount_r place(base_box=withers_girdle, anchor=[-0.94, -0.15, -0.32], align=[0.72, 0, 0]) {
            size: [3.5, 4.0, 9.0], material: shadow_slate, rotate: [-6, 10, 16], blend_with: [chest_core, wing_shoulder_r__wing_humerus]
          }

          // Hugged ventral sternum scutes & glowing Frenzy chest fissure (zero ladder planks!)
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.32], align=[0, 0.35, 0]) {
            size: [13.5, 2.5, 8.5], material: abyssal_belly, rotate: [4, 0, 0], blend_with: [waist_belly]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.96, 0.56], align=[0, 0.45, -0.25]) {
            size: [11.5, 2.5, 8.0], material: abyssal_belly, rotate: [-18, 0, 0], blend_with: [chest_scute_rear, fore_bracer, fore_shoulder_r__fore_bracer]
          }
          box sternum_fissure_keel place(base_box=chest_scute_front, anchor=[0, -0.96, 0.25], align=[0, 0.72, 0]) {
            size: [5.0, 2.0, 6.0], material: frenzy_maw, rotate: [-12, 0, 0], blend_with: [chest_core, neck_throat_plate, fore_bicep, fore_shoulder_r__fore_bicep]
          }

          // Tiered curved obsidian-slate pectoral rib armor shingles
          box pectoral_rib_l_1 place(base_box=chest_core, anchor=[0.99, 0.26, -0.16], align=[-0.72, 0, 0]) {
            size: [2.0, 5.5, 6.0], material: shadow_slate, rotate: [8, 12, -10], blend_with: [withers_girdle, scapula_mount_l, fore_bicep, flank_shingle_l_1, waist_core]
          }
          box pectoral_rib_r_1 place(base_box=chest_core, anchor=[-0.99, 0.26, -0.16], align=[0.72, 0, 0]) {
            size: [2.0, 5.5, 6.0], material: shadow_slate, rotate: [8, -12, 10], blend_with: [withers_girdle, scapula_mount_r, fore_shoulder_r__fore_bicep, flank_shingle_r_1, waist_core]
          }
          box pectoral_rib_l_2 place(base_box=chest_core, anchor=[0.99, -0.24, -0.32], align=[-0.72, 0, 0]) {
            size: [2.0, 5.0, 6.0], material: visor_chitin, rotate: [6, 14, -8], blend_with: [pectoral_rib_l_1, fore_bicep, fore_bracer, flank_shingle_l_1, flank_shingle_l_2, waist_core]
          }
          box pectoral_rib_r_2 place(base_box=chest_core, anchor=[-0.99, -0.24, -0.32], align=[0.72, 0, 0]) {
            size: [2.0, 5.0, 6.0], material: visor_chitin, rotate: [6, -14, 8], blend_with: [pectoral_rib_r_1, fore_shoulder_r__fore_bicep, fore_shoulder_r__fore_bracer, flank_shingle_r_1, flank_shingle_r_2, waist_core]
          }
          box pectoral_frenzy_stud_l place(base_box=pectoral_rib_l_1, anchor=[0.96, 0.10, 0], align=[-0.78, 0, 0]) {
            size: [1.5, 2.0, 3.5], material: frenzy_violet, rotate: [10, 16, -12], blend_with: [chest_core, fore_bicep]
          }
          box pectoral_frenzy_stud_r place(base_box=pectoral_rib_r_1, anchor=[-0.96, 0.10, 0], align=[0.78, 0, 0]) {
            size: [1.5, 2.0, 3.5], material: frenzy_violet, rotate: [10, -16, 12], blend_with: [chest_core, fore_shoulder_r__fore_bicep]
          }
          plane chest_cloak_collar_l place(base_box=chest_core, anchor=[0.66, -0.82, 0.92], align=[0, 0.65, -0.85]) {
            size: [6.5, 5.5], normal: z, material: cloak_tatter, rotate: [-22, -18, -12],
            edge: ragged(depth=5, holes=1, side=bottom, seed=107), layer: 1,
            blend_with: [chest_scute_front, sternum_fissure_keel, neck_throat_plate, fore_bicep]
          }
          plane chest_cloak_collar_r place(base_box=chest_core, anchor=[-0.66, -0.82, 0.92], align=[0, 0.65, -0.85]) {
            size: [6.5, 5.5], normal: z, material: cloak_tatter, rotate: [-22, 18, 12],
            edge: ragged(depth=5, holes=1, side=bottom, seed=107), layer: 1,
            blend_with: [chest_scute_front, sternum_fissure_keel, neck_throat_plate, fore_shoulder_r__fore_bicep]
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.28, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-20, 0, 0]
            box neck_base { size: [13.0, 12.0, 9.5], material: obsidian_indigo, blend_with: [withers_girdle] }
            box neck_throat_plate place(base_box=neck_base, anchor=[0, -0.96, 0.08], align=[0, 0.45, 0]) {
              size: [9.0, 2.0, 8.0], material: abyssal_belly, rotate: [-6, 0, 0], blend_with: [chest_scute_front, chest_core]
            }
            box neck_frenzy_throat place(base_box=neck_throat_plate, anchor=[0, -0.96, 0.30], align=[0, 0.75, 0]) {
              size: [5.0, 1.5, 5.0], material: frenzy_maw, rotate: [-8, 0, 0], blend_with: [neck_base, chest_scute_front, sternum_fissure_keel]
            }
            box cervical_crest_1 place(base_box=neck_base, anchor=[0, 0.98, 0.10], align=[0, -0.68, 0]) {
              size: [5.5, 4.0, 7.5], material: eclipse_plum, rotate: [12, 0, 0], blend_with: [withers_girdle, neck_upper]
            }
            box cervical_shingle_l place(base_box=neck_base, anchor=[0.88, 0.65, 0.22], align=[-0.55, -0.55, 0]) {
              size: [3.0, 5.0, 6.0], material: shadow_slate, rotate: [12, -16, -24], blend_with: [cervical_crest_1, withers_girdle, chest_core, neck_upper]
            }
            box cervical_shingle_r place(base_box=neck_base, anchor=[-0.88, 0.65, 0.22], align=[0.55, -0.55, 0]) {
              size: [3.0, 5.0, 6.0], material: shadow_slate, rotate: [12, 16, 24], blend_with: [cervical_crest_1, withers_girdle, chest_core, neck_upper]
            }
            box neck_frenzy_gill_l place(base_box=neck_base, anchor=[0.99, 0.05, 0.10], align=[-0.78, 0, 0]) {
              size: [1.5, 2.5, 5.0], material: frenzy_violet, rotate: [6, -10, -8], blend_with: [cervical_shingle_l, chest_core, fore_bicep]
            }
            box neck_frenzy_gill_r place(base_box=neck_base, anchor=[-0.99, 0.05, 0.10], align=[0.78, 0, 0]) {
              size: [1.5, 2.5, 5.0], material: frenzy_violet, rotate: [6, 10, 8], blend_with: [cervical_shingle_r, chest_core, fore_shoulder_r__fore_bicep]
            }
            plane neck_cloak_ruff_l place(base_box=neck_base, anchor=[1.0, -0.25, 0.10], align=[0, 0.55, 0]) {
              size: [5.5, 7.0], normal: x, material: cloak_tatter, rotate: [6, 16, 18],
              edge: spikes(width=2, min_len=3, max_len=7, side=bottom, seed=113), layer: 1,
              blend_with: [neck_frenzy_gill_l, neck_throat_plate, chest_core, fore_bicep]
            }
            plane neck_cloak_ruff_r place(base_box=neck_base, anchor=[-1.0, -0.25, 0.10], align=[0, 0.55, 0]) {
              size: [5.5, 7.0], normal: x, material: cloak_tatter, rotate: [6, -16, -18],
              edge: spikes(width=2, min_len=3, max_len=7, side=bottom, seed=113), layer: 1,
              blend_with: [neck_frenzy_gill_r, neck_throat_plate, chest_core, fore_shoulder_r__fore_bicep]
            }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.14, 1], align=[0, 0, -1], seat=0.26) {
              rest_euler: [16, 0, 0]
              box neck_upper { size: [10.0, 9.5, 8.5], material: eclipse_plum }
              box nape_armor_hood place(base_box=neck_upper, anchor=[0, 0.96, -0.10], align=[0, -0.58, 0.30]) {
                size: [6.0, 3.5, 8.0], material: obsidian_indigo, rotate: [12, 0, 0], blend_with: [neck_base, cervical_crest_1, skull_core]
              }
              box nape_shingle_l place(base_box=neck_upper, anchor=[0.96, 0.35, 0.05], align=[-0.68, 0, 0]) {
                size: [2.0, 4.5, 6.5], material: shadow_slate, rotate: [8, -12, -16], blend_with: [neck_base, cervical_shingle_l, skull_core, visor_cheek_l]
              }
              box nape_shingle_r place(base_box=neck_upper, anchor=[-0.96, 0.35, 0.05], align=[0.68, 0, 0]) {
                size: [2.0, 4.5, 6.5], material: shadow_slate, rotate: [8, 12, 16], blend_with: [neck_base, cervical_shingle_r, skull_core, visor_cheek_r]
              }
              plane nape_crest_plane place(base_box=nape_armor_hood, anchor=[0, 1.0, 0], align=[0, -0.90, 0]) {
                size: [4.5, 7.5], normal: x, material: cloak_tatter, rotate: [8, 0, 0],
                edge: spikes(width=2, min_len=3, max_len=7, side=top, seed=119), layer: 1,
                blend_with: [neck_upper, cervical_crest_1, skull_core, visor_helm_crest]
              }

              // Sinister BLIND Faceted Visor Skull (CRITICAL: ZERO EYES, ZERO SOCKETS, ZERO EYE STAMPS!)
              bone head attach(parent_box=neck_upper, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                rest_euler: [18, 0, 0]
                box skull_core { size: [10.0, 6.5, 8.0], material: obsidian_indigo }
                box visor_helm_crest place(base_box=skull_core, anchor=[0, 0.98, -0.10], align=[0, -0.62, 0]) {
                  size: [6.0, 2.5, 6.5], material: eclipse_plum, rotate: [6, 0, 0], blend_with: [neck_upper, nape_armor_hood, visor_brow_l, visor_brow_r]
                }
                box visor_median_hornlet place(base_box=visor_helm_crest, anchor=[0, 0.96, 0.38], align=[0, -0.80, 0]) {
                  size: [2.0, 2.0, 4.0], material: visor_chitin, rotate: [14, 0, 0], blend_with: [skull_core, visor_nasal_keel]
                }
                // Eyeless overlapping armored obsidian-chitin visor shields sealing the entire orbital region shut!
                box visor_brow_l place(base_box=skull_core, anchor=[0.88, 0.56, 0.48], align=[-0.48, -0.58, -0.25]) {
                  size: [3.0, 2.5, 6.5], material: visor_chitin, rotate: [14, -14, -18], blend_with: [visor_helm_crest, visor_cheek_l]
                }
                box visor_brow_r place(base_box=skull_core, anchor=[-0.88, 0.56, 0.48], align=[0.48, -0.58, -0.25]) {
                  size: [3.0, 2.5, 6.5], material: visor_chitin, rotate: [14, 14, 18], blend_with: [visor_helm_crest, visor_cheek_r]
                }
                // Dark blind-visor orbital seal plates (ZERO eyes, ZERO glow on lateral skull!)
                box visor_blind_seal_l place(base_box=visor_brow_l, anchor=[0.84, -0.68, 0.12], align=[-0.68, 0.58, 0]) {
                  size: [1.5, 2.0, 5.0], material: beak_dark, rotate: [10, -14, -12], blend_with: [skull_core, visor_cheek_l, visor_snout_core, maxilla_wedge_l]
                }
                box visor_blind_seal_r place(base_box=visor_brow_r, anchor=[-0.84, -0.68, 0.12], align=[0.68, 0.58, 0]) {
                  size: [1.5, 2.0, 5.0], material: beak_dark, rotate: [10, 14, 12], blend_with: [skull_core, visor_cheek_r, visor_snout_core, maxilla_wedge_r]
                }
                box visor_cheek_l place(base_box=skull_core, anchor=[0.96, -0.22, 0.08], align=[-0.48, 0, 0]) {
                  size: [2.5, 4.0, 6.0], material: obsidian_indigo, rotate: [6, -14, 10], blend_with: [neck_upper]
                }
                box visor_cheek_r place(base_box=skull_core, anchor=[-0.96, -0.22, 0.08], align=[0.48, 0, 0]) {
                  size: [2.5, 4.0, 6.0], material: obsidian_indigo, rotate: [6, 14, -10], blend_with: [neck_upper]
