  // 6. SIGNATURE WILD ATTACK (`signature_gif_clip`): Airborne Frenzy Eclipse Cloak Double Wing-Arm Slam!
  clip frenzy_eclipse_cloak_slam {
    duration_s: 2.2, loop: false
    key root.position { 0.0: [0, 0, 0], 0.35: [0, -3.5, -3.5], 0.88: [0, 22.0, 2.0], 1.18: [0, 20.0, 7.0], 1.48: [0, -3.0, 14.5], 1.78: [0, -2.0, 13.5], 2.2: [0, 0, 0], catmullrom }
