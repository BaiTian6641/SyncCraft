    key feeler_r__feeler_mid_l.rotation { 0.0: [0, 0, 0], 0.78: [24, 0, 0], 1.65: [22, 0, 0], 2.2: [0, 0, 0], catmullrom }
    // Wing-arms & Reaper cloak soar sky-high at t=0.88..1.18, then CRASH DOWNWARD into Y=0 at t=1.48!
