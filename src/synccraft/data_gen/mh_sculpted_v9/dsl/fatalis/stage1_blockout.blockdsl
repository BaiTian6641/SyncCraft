// Fatalis (The Black Dragon of Schrade) — Stage 1 Primary Masses & Rearing Serpentine Gesture
// Towering semi-upright Western Elder Dragon: steeply pitched pelvis->waist->chest, 5-bone S-neck,
// wedged 4-horned skull, 4 grounded dragon limbs on Y=0, colossal 4-finger arched wings, & 7-seg whip tail.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 128
  budget max_bones = 80
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  obsidian_scale: ramp(base_lch=[0.22, 0.036, 302], steps=6, hue_shift=[22, -20])
  slate_armor: ramp(base_lch=[0.30, 0.042, 294], steps=6, hue_shift=[20, -22])
  bronze_wing: ramp(base_lch=[0.46, 0.086, 54], steps=6, hue_shift=[20, -14])
  bone_ivory: ramp(base_lch=[0.84, 0.054, 82], steps=6, hue_shift=[18, -12])
  hellfire_orange: ramp(base_lch=[0.76, 0.198, 44], steps=6, hue_shift=[14, -18], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 19.52, -14.0]) {
      rest_euler: [-18, 0, 0]
      box pelvis_core { size: [12.0, 10.5, 12.5], material: obsidian_scale }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.12, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-16, 0, 0]
        box waist_core { size: [10.5, 9.5, 13.0], material: obsidian_scale }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.15, 1], align=[0, 0, -1], seat=0.26) {
          rest_euler: [-12, 0, 0]
          box chest_core { size: [16.5, 13.5, 15.5], material: obsidian_scale }
          box pectoral_hellfire_core place(base_box=chest_core, anchor=[0, -0.96, 0.15], align=[0, 0.55, 0]) {
            size: [6.0, 2.0, 11.0], material: hellfire_orange
          }

          // Long sinuous 5-bone serpentine S-neck (`neck_1..neck_5`)
          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.25, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-24, 0, 0]
            box neck_1_core { size: [10.5, 9.5, 9.0], material: obsidian_scale }

            bone neck_2 attach(parent_box=neck_1_core, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.24) {
              rest_euler: [-12, 0, 0]
              box neck_2_core { size: [9.0, 8.5, 8.5], material: obsidian_scale }

              bone neck_3 attach(parent_box=neck_2_core, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                rest_euler: [18, 0, 0]
                box neck_3_core { size: [8.0, 7.5, 8.0], material: obsidian_scale }

                bone neck_4 attach(parent_box=neck_3_core, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                  rest_euler: [28, 0, 0]
                  box neck_4_core { size: [7.0, 6.5, 7.5], material: obsidian_scale }

                  bone neck_5 attach(parent_box=neck_4_core, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                    rest_euler: [32, 0, 0]
                    box neck_5_core { size: [6.5, 6.0, 7.0], material: obsidian_scale }

                    bone head attach(parent_box=neck_5_core, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.22) {
                      rest_euler: [20, 0, 0]
                      box skull_core { size: [9.0, 6.0, 7.5], material: obsidian_scale }
                      box snout_core place(base_box=skull_core, anchor=[0, -0.12, 1], align=[0, 0, -0.78]) {
                        size: [4.5, 3.5, 7.0], material: obsidian_scale, rotate: [8, 0, 0]
                      }
                      box nose_tip place(base_box=snout_core, anchor=[0, 0.10, 0.96], align=[0, 0, -0.65]) {
                        size: [2.5, 2.5, 2.5], material: slate_armor, rotate: [12, 0, 0]
                      }

                      // 4 Swept-back Fatalis horns (-Ry splays -Z horns outward!)
                      bone horn_upper_l attach(parent_box=skull_core, anchor=[0.62, 0.92, -0.82], align=[0, 0, 1], seat=0.06) mirror_x(horn_upper_r) {
                        rest_euler: [30, -16, -8]
                        box horn_upper_beam { size: [2.5, 2.5, 13.5], material: bone_ivory, blend_with: [neck_5_core] }
                      }
                      bone horn_lower_l attach(parent_box=skull_core, anchor=[0.94, 0.02, -0.82], align=[0, 0, 1], seat=0.06) mirror_x(horn_lower_r) {
                        rest_euler: [2, -34, 8]
                        box horn_lower_beam { size: [2.0, 2.0, 9.0], material: bone_ivory, blend_with: [neck_5_core] }
                      }

                      bone jaw attach(parent_box=skull_core, anchor=[0, -0.68, 0.18], align=[0, 0, -1], seat=0.16) {
                        rest_euler: [8, 0, 0]
                        box jaw_core { size: [4.0, 2.5, 8.5], material: bone_ivory }
                      }
                    }
                  }
                }
              }
            }
          }

          // Symmetric dorsal wing shoulder mount -> soaring forearm -> 4 arched bat-wing fingers!
          bone wing_mount_l attach(parent_box=chest_core, anchor=[0.88, 0.85, 0.08], align=[-0.45, -0.45, 0], seat=0.10) mirror_x(wing_mount_r) {
            rest_euler: [8, 0, -10]
            box wing_root_mass { size: [5.5, 5.0, 8.5], material: slate_armor, blend_with: [neck_1_core] }

            bone wing_arm_l attach(parent_box=wing_root_mass, anchor=[0.96, 0.45, 0], align=[-1, 0, 0], seat=0.08) {
              rest_euler: [38, 22, 48]
              box wing_humerus { size: [15.5, 4.0, 4.5], material: obsidian_scale, blend_with: [chest_core] }

              bone wing_forearm_l attach(parent_box=wing_humerus, anchor=[1, 0.08, 0], align=[-1, 0, 0], seat=0.10) {
                rest_euler: [0, -30, 34]
                box wing_radius { size: [21.5, 3.5, 3.5], material: obsidian_scale }
                box wing_wrist_hub place(base_box=wing_radius, anchor=[0.98, 0, -0.05], align=[-0.55, 0, 0]) {
                  size: [4.0, 5.5, 6.5], material: slate_armor
                }

                bone wing_finger_1_l attach(parent_box=wing_wrist_hub, anchor=[0.96, 0.82, 0.78], align=[-1, 0, 0], seat=0.0) {
                  rest_euler: [0, 12, -40]
                  box wing_spar_1 { size: [30.0, 2.0, 2.0], material: bronze_wing, blend_with: [wing_radius] }
                }
                bone wing_finger_2_l attach(parent_box=wing_wrist_hub, anchor=[0.96, 0.24, 0.22], align=[-1, 0, 0], seat=0.0) {
                  rest_euler: [0, 26, -68]
                  box wing_spar_2 { size: [29.0, 2.0, 2.0], material: bronze_wing, blend_with: [wing_radius, wing_spar_1] }
                }
                bone wing_finger_3_l attach(parent_box=wing_wrist_hub, anchor=[0.92, -0.34, -0.34], align=[-1, 0, 0], seat=0.0) {
                  rest_euler: [0, 34, -96]
                  box wing_spar_3 { size: [27.0, 2.0, 2.0], material: bronze_wing, blend_with: [wing_radius, wing_spar_2] }
                }
                bone wing_finger_4_l attach(parent_box=wing_wrist_hub, anchor=[0.78, -0.92, -0.90], align=[-1, 0, 0], seat=0.0) {
                  rest_euler: [0, 34, -124]
                  box wing_spar_4 { size: [24.0, 2.0, 2.0], material: bronze_wing, blend_with: [wing_radius, wing_spar_2, wing_spar_3, wing_humerus] }
                }
              }
            }
          }

          // Long muscular dragon forelimbs reaching down from reared chest to Y = 0
          bone fore_shoulder_l attach(parent_box=chest_core, anchor=[0.96, -0.35, 0.18], align=[-0.55, 0.85, 0], seat=0.12) mirror_x(fore_shoulder_r) {
            rest_euler: [62, 6, 22]
            box fore_bicep { size: [6.5, 13.5, 7.0], material: obsidian_scale, blend_with: [waist_core, wing_root_mass] }

            bone fore_arm_l attach(parent_box=fore_bicep, anchor=[0.08, -1, -0.05], align=[0, 0.88, 0], seat=0.16) {
              rest_euler: [-34, 0, -14]
              box fore_bracer { size: [5.5, 13.5, 6.0], material: slate_armor, blend_with: [chest_core] }

              bone fore_hand_l attach(parent_box=fore_bracer, anchor=[0, -1, 0.15], align=[0, 0.88, -0.45], seat=0.14) {
                rest_euler: [18, 0, -8]
                box fore_hand_pad { size: [7.0, 3.0, 7.5], material: slate_armor }
              }
            }
          }
        }
      }

      // Coiled powerful dragon hindlimbs planted wide on Y = 0
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.96, -0.12, -0.05], align=[-0.55, 0.85, 0], seat=0.14) mirror_x(hind_thigh_r) {
        rest_euler: [-10, -6, 20]
        box thigh_mass { size: [6.5, 11.5, 8.0], material: obsidian_scale, blend_with: [waist_core, tail_1_tail_seg] }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [52, 0, -12]
          box shin_mass { size: [5.0, 10.5, 5.5], material: obsidian_scale }

          bone hind_foot_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.42], seat=0.14) {
            rest_euler: [-24, 0, -8]
            box hind_foot_pad { size: [6.5, 3.0, 7.5], material: slate_armor }
          }
        }
      }

      // Extra-long 7-segment serpentine whip tail sweeping down then skimming low far behind!
      chain tail attach(parent_box=pelvis_core, anchor=[0, -0.05, -1], align=[0, 0, 1], seat=0.20) segments=7 taper=0.88 bend=[-4, 10, 10, 4, 4, 8, 12] {
        box tail_seg { size: [8.5, 7.5, 12.5], material: obsidian_scale }
      }
    }
  }
}
