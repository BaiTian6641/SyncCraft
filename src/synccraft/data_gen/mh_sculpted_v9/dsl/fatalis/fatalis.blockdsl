    key neck_1.rotation { 0.0: [0, 0, 0], 0.42: [-22, -24, 0], 0.78: [36, 18, 0], 1.6: [0, 0, 0], catmullrom }
    key neck_2.rotation { 0.0: [0, 0, 0], 0.42: [-18, -18, 0], 0.78: [28, 14, 0], 1.6: [0, 0, 0], catmullrom }
    key neck_4.rotation { 0.0: [0, 0, 0], 0.42: [24, 22, 0], 0.78: [-18, -12, 0], 1.6: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.42: [18, 18, -18], 0.76: [-14, -10, 22], 0.94: [18, 0, -6], 1.6: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.42: [38, 0, 0], 0.76: [46, 0, 0], 0.90: [-4, 0, 0], 1.6: [0, 0, 0], catmullrom }
  }

  // 6. Sustained Downward Cone of Hellfire Breath Sweep!
  clip flamethrower_cone_breath {
    duration_s: 2.6, loop: false
    key root.position { 0.0: [0, 0, 0], 0.55: [0, 3.0, -3.0], 1.10: [0, 1.0, 2.0], 1.95: [0, 1.0, 2.0], 2.6: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.55: [-14, 0, 0], 1.10: [-6, -12, 0], 1.95: [-6, 12, 0], 2.6: [0, 0, 0], catmullrom }
