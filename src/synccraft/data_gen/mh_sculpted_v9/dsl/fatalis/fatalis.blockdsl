  // 9. Concussive Charged Hellfire Fireball Snipe & Wing-Braced Recoil
  clip charged_fireball_snipe {
    duration_s: 1.9, loop: false
    key root.position { 0.0: [0, 0, 0], 0.65: [0, 2.5, -4.5], 0.95: [0, -1.5, 6.0], 1.25: [0, 3.5, -6.5], 1.9: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.65: [-18, 0, 0], 0.95: [16, 0, 0], 1.25: [-14, 0, 0], 1.9: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.65: [-26, 0, 0], 0.95: [28, 0, 0], 1.25: [-16, 0, 0], 1.9: [0, 0, 0], catmullrom }
    key neck_3.rotation { 0.0: [0, 0, 0], 0.65: [22, 0, 0], 0.95: [-14, 0, 0], 1.25: [12, 0, 0], 1.9: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.65: [26, 0, 0], 0.95: [-22, 0, 0], 1.25: [14, 0, 0], 1.9: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.65: [8, 0, 0], 0.92: [46, 0, 0], 1.35: [18, 0, 0], 1.9: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 0.65: [0, 18, -14], 0.95: [0, -24, 24], 1.9: [0, 0, 0], catmullrom }
    key wing_mount_r__wing_arm_l.rotation { 0.0: [0, 0, 0], 0.65: [0, 18, -14], 0.95: [0, -24, 24], 1.9: [0, 0, 0], catmullrom }
  }

  // 10. Thunderous Dual-Wing Wind-Pressure Backstep Hover
  clip crimson_wing_gust_backstep {
    duration_s: 1.8, loop: false
    key root.position { 0.0: [0, 0, 0], 0.35: [0, -2.0, 2.0], 0.80: [0, 14.0, -14.0], 1.30: [0, 2.0, -16.0], 1.8: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.35: [14, 0, 0], 0.80: [-16, 0, 0], 1.8: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.35: [16, 0, 0], 0.80: [-14, 0, 0], 1.8: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 0.35: [-10, -22, 28], 0.78: [16, -32, -46], 1.30: [0, 12, 16], 1.8: [0, 0, 0], catmullrom }
    key wing_mount_r__wing_arm_l.rotation { 0.0: [0, 0, 0], 0.35: [-10, -22, 28], 0.78: [16, -32, -46], 1.30: [0, 12, 16], 1.8: [0, 0, 0], catmullrom }
    key wing_forearm_l.rotation { 0.0: [0, 0, 0], 0.35: [0, -14, 18], 0.78: [0, -22, -26], 1.8: [0, 0, 0], catmullrom }
    key wing_mount_r__wing_forearm_l.rotation { 0.0: [0, 0, 0], 0.35: [0, -14, 18], 0.78: [0, -22, -26], 1.8: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.80: [28, 0, 14], 1.8: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.80: [28, 0, 14], 1.8: [0, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [0, 0, 0], 0.80: [26, 0, 12], 1.8: [0, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [0, 0, 0], 0.80: [26, 0, 12], 1.8: [0, 0, 0], catmullrom }
  }

  // 11. Phase-3 Melted-Armor Molten Sternum Embrace & Skyward Eruption!
  clip hellfire_chest_pin_embrace {
    duration_s: 2.4, loop: false
    key root.position { 0.0: [0, 0, 0], 0.55: [0, 5.5, -2.0], 1.05: [0, -4.0, 6.0], 1.75: [0, 5.0, 0.0], 2.4: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.55: [-24, 0, 0], 1.05: [18, 0, 0], 1.75: [-22, 0, 0], 2.4: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.55: [-24, 0, 0], 1.05: [22, 0, 0], 1.75: [-26, 0, 0], 2.4: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.55: [-18, 0, 0], 1.05: [24, 0, 0], 1.75: [-24, 0, 0], 2.4: [0, 0, 0], catmullrom }
