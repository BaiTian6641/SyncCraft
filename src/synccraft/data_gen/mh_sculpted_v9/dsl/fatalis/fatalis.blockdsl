    // Dragon limbs tuck naturally while hovering high above Castle Schrade!
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.92: [32, 0, 12], 2.15: [30, 0, 12], 3.0: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.92: [32, 0, 12], 2.15: [30, 0, 12], 3.0: [0, 0, 0], catmullrom }
