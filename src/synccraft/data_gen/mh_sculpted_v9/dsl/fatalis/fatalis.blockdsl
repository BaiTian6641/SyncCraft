// Fatalis (The Black Dragon of Schrade) — Stage 3 Sculpted Blockbench Masterwork (V9)
// Hand-authored progressive Block-DSL v4.1: towering semi-upright Western Black Dragon with steeply
// pitched pelvis->waist->chest, 5-bone sinuous serpentine S-neck, 4-horned wedged draconic skull,
// incandescent molten-orange sternum fissure, 18-bone partitioned tattered bat wings, 4 clawed dragon
// limbs grounded on Y=0, 7-bone serpentine whip tail, & 12 vigorous Monster Hunter behavior clips.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 420
  budget max_bones = 96
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  obsidian_scale: ramp(base_lch=[0.22, 0.036, 302], steps=6, hue_shift=[22, -20])
  slate_armor: ramp(base_lch=[0.30, 0.042, 294], steps=6, hue_shift=[20, -22])
  deep_charcoal: ramp(base_lch=[0.17, 0.030, 308], steps=6, hue_shift=[18, -16])
  bronze_wing: ramp(base_lch=[0.46, 0.086, 54], steps=6, hue_shift=[20, -14])
  wing_umber: ramp(base_lch=[0.36, 0.076, 46], steps=6, hue_shift=[18, -14])
  belly_bronze: ramp(base_lch=[0.71, 0.068, 76], steps=6, hue_shift=[18, -12])
  bone_ivory: ramp(base_lch=[0.84, 0.054, 82], steps=6, hue_shift=[18, -12])
  horn_ochre: ramp(base_lch=[0.58, 0.092, 68], steps=6, hue_shift=[18, -12])
  mouth_crimson: ramp(base_lch=[0.36, 0.128, 22], steps=6, hue_shift=[16, -10])
  hellfire_orange: ramp(base_lch=[0.76, 0.198, 44], steps=6, hue_shift=[14, -18], emissive=true)
  eye_gold: ramp(base_lch=[0.85, 0.178, 78], steps=6, hue_shift=[12, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 19.52, -14.0]) {
      rest_euler: [-18, 0, 0]
      box pelvis_core { size: [12.0, 10.5, 12.5], material: obsidian_scale }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.40, 0]) {
        size: [9.0, 2.0, 10.5], material: belly_bronze
      }
      box sacrum_armor place(base_box=pelvis_core, anchor=[0, 0.96, -0.05], align=[0, -0.55, 0]) {
        size: [7.0, 2.5, 10.5], material: slate_armor, rotate: [4, 0, 0], blend_with: [waist_core, lumbar_armor, tail_1_seg]
      }
      box sacrum_spine_1 place(base_box=sacrum_armor, anchor=[0, 0.96, 0.30], align=[0, -0.78, 0]) {
        size: [2.0, 3.5, 3.0], material: bone_ivory, rotate: [22, 0, 0], blend_with: [pelvis_core, waist_core, lumbar_armor]
      }
      box sacrum_spine_2 place(base_box=sacrum_armor, anchor=[0, 0.96, -0.35], align=[0, -0.78, 0]) {
        size: [2.0, 3.5, 3.0], material: bone_ivory, rotate: [24, 0, 0], blend_with: [pelvis_core, tail_1_seg]
      }
      box haunch_muscle_l place(base_box=pelvis_core, anchor=[0.98, 0.20, -0.05], align=[-0.48, 0, 0]) {
        size: [3.5, 7.5, 9.0], material: slate_armor, rotate: [6, 6, -12], blend_with: [thigh_mass, waist_core]
      }
      box haunch_muscle_r place(base_box=pelvis_core, anchor=[-0.98, 0.20, -0.05], align=[0.48, 0, 0]) {
        size: [3.5, 7.5, 9.0], material: slate_armor, rotate: [6, -6, 12], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }
      box hip_osteoderm_l place(base_box=haunch_muscle_l, anchor=[0.92, 0.42, -0.32], align=[-0.68, 0, 0.35]) {
        size: [1.5, 2.5, 5.0], material: horn_ochre, rotate: [14, 22, -14], blend_with: [pelvis_core, thigh_mass, thigh_armor]
      }
      box hip_osteoderm_r place(base_box=haunch_muscle_r, anchor=[-0.92, 0.42, -0.32], align=[0.68, 0, 0.35]) {
        size: [1.5, 2.5, 5.0], material: horn_ochre, rotate: [14, -22, 14], blend_with: [pelvis_core, hind_thigh_r__thigh_mass, hind_thigh_r__thigh_armor]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.12, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-16, 0, 0]
        box waist_core { size: [10.5, 9.5, 13.0], material: obsidian_scale }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.40, 0]) {
          size: [8.0, 2.0, 11.0], material: belly_bronze, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box waist_hellfire_seam place(base_box=waist_belly, anchor=[0, -0.96, 0.25], align=[0, 0.78, 0]) {
          size: [2.5, 1.0, 6.5], material: hellfire_orange, blend_with: [waist_core, pectoral_hellfire_core]
        }
        box lumbar_armor place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
          size: [6.5, 2.5, 11.0], material: slate_armor, rotate: [-4, 0, 0], blend_with: [pelvis_core, sacrum_armor, chest_core]
        }
        box lumbar_spine_1 place(base_box=lumbar_armor, anchor=[0, 0.96, 0.32], align=[0, -0.78, 0]) {
          size: [2.0, 4.0, 3.0], material: bone_ivory, rotate: [20, 0, 0], blend_with: [waist_core, chest_core, thoracic_ridge]
        }
        box lumbar_spine_2 place(base_box=lumbar_armor, anchor=[0, 0.96, -0.32], align=[0, -0.78, 0]) {
          size: [2.0, 3.5, 3.0], material: bone_ivory, rotate: [22, 0, 0], blend_with: [waist_core, pelvis_core, sacrum_armor]
        }
        box flank_shingle_l place(base_box=waist_core, anchor=[0.99, 0.25, -0.18], align=[-0.75, 0, 0]) {
          size: [2.0, 4.5, 6.5], material: slate_armor, rotate: [6, 10, -10], blend_with: [pelvis_core, haunch_muscle_l, chest_core, fore_bicep, fore_elbow_spur, fore_elbow_fringe]
        }
        box flank_shingle_r place(base_box=waist_core, anchor=[-0.99, 0.25, -0.18], align=[0.75, 0, 0]) {
          size: [2.0, 4.5, 6.5], material: slate_armor, rotate: [6, -10, 10], blend_with: [pelvis_core, haunch_muscle_r, chest_core, fore_shoulder_r__fore_bicep, fore_shoulder_r__fore_elbow_spur, fore_shoulder_r__fore_elbow_fringe]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.15, 1], align=[0, 0, -1], seat=0.26) {
          rest_euler: [-12, 0, 0]
          box chest_core { size: [16.5, 13.5, 15.5], material: obsidian_scale }
          box thoracic_ridge place(base_box=chest_core, anchor=[0, 0.96, 0.05], align=[0, -0.55, 0]) {
            size: [9.5, 3.0, 13.5], material: slate_armor, rotate: [-6, 0, 0], blend_with: [waist_core, lumbar_armor, neck_1_core]
          }
          box thoracic_spine_1 place(base_box=thoracic_ridge, anchor=[0, 0.96, 0.28], align=[0, -0.78, 0]) {
            size: [2.0, 4.5, 3.5], material: bone_ivory, rotate: [20, 0, 0], blend_with: [chest_core, neck_1_core]
          }
          box thoracic_spine_2 place(base_box=thoracic_ridge, anchor=[0, 0.96, -0.32], align=[0, -0.78, 0]) {
            size: [2.0, 4.0, 3.5], material: bone_ivory, rotate: [22, 0, 0], blend_with: [chest_core, waist_core, lumbar_armor]
          }

          // Incandescent Phase-3 Schrade Hellfire Sternum Fissure & Melted Pectoral Carapace!
          box pectoral_hellfire_core place(base_box=chest_core, anchor=[0, -0.96, 0.08], align=[0, 0.50, 0]) {
            size: [4.5, 2.0, 12.0], material: hellfire_orange, blend_with: [waist_belly, waist_hellfire_seam]
          }
          box throat_hellfire_vent place(base_box=chest_core, anchor=[0, -0.82, 0.88], align=[0, 0.65, -0.55]) {
            size: [4.0, 2.0, 4.5], material: hellfire_orange, rotate: [-22, 0, 0], blend_with: [pectoral_hellfire_core, neck_1_core, neck_1_scute]
          }
          box pectoral_hellfire_plate_l place(base_box=chest_core, anchor=[0.56, -0.94, 0.05], align=[-0.15, 0.48, 0]) {
            size: [5.5, 2.5, 11.5], material: slate_armor, rotate: [0, 6, 14], blend_with: [pectoral_hellfire_core, throat_hellfire_vent, waist_belly, fore_bicep, fore_bracer]
          }
          box pectoral_hellfire_plate_r place(base_box=chest_core, anchor=[-0.56, -0.94, 0.05], align=[0.15, 0.48, 0]) {
            size: [5.5, 2.5, 11.5], material: slate_armor, rotate: [0, -6, -14], blend_with: [pectoral_hellfire_core, throat_hellfire_vent, waist_belly, fore_shoulder_r__fore_bicep, fore_shoulder_r__fore_bracer]
          }
          box hellfire_rib_vein_l place(base_box=pectoral_hellfire_plate_l, anchor=[0.82, -0.88, 0.15], align=[-0.65, 0.78, 0]) {
            size: [2.0, 1.5, 7.5], material: hellfire_orange, rotate: [4, 10, 18], blend_with: [chest_core, fore_bicep, fore_bracer]
          }
          box hellfire_rib_vein_r place(base_box=pectoral_hellfire_plate_r, anchor=[-0.82, -0.88, 0.15], align=[0.65, 0.78, 0]) {
            size: [2.0, 1.5, 7.5], material: hellfire_orange, rotate: [4, -10, -18], blend_with: [chest_core, fore_shoulder_r__fore_bicep, fore_shoulder_r__fore_bracer]
          }
          box rib_shingle_l_1 place(base_box=chest_core, anchor=[0.99, 0.28, -0.22], align=[-0.78, 0, 0]) {
            size: [2.0, 5.0, 6.0], material: slate_armor, rotate: [8, 12, -10], blend_with: [wing_root_mass, fore_bicep, fore_pauldron, waist_core, flank_shingle_l]
          }
          box rib_shingle_r_1 place(base_box=chest_core, anchor=[-0.99, 0.28, -0.22], align=[0.78, 0, 0]) {
            size: [2.0, 5.0, 6.0], material: slate_armor, rotate: [8, -12, 10], blend_with: [wing_mount_r__wing_root_mass, fore_shoulder_r__fore_bicep, fore_shoulder_r__fore_pauldron, waist_core, flank_shingle_r]
          }
          box rib_shingle_l_2 place(base_box=chest_core, anchor=[0.99, -0.05, -0.68], align=[-0.82, 0, 0]) {
            size: [2.0, 4.0, 5.0], material: slate_armor, rotate: [6, 14, -8], blend_with: [rib_shingle_l_1, fore_bicep, fore_elbow_spur, waist_core, flank_shingle_l]
          }
          box rib_shingle_r_2 place(base_box=chest_core, anchor=[-0.99, -0.05, -0.68], align=[0.82, 0, 0]) {
            size: [2.0, 4.0, 5.0], material: slate_armor, rotate: [6, -14, 8], blend_with: [rib_shingle_r_1, fore_shoulder_r__fore_bicep, fore_shoulder_r__fore_elbow_spur, waist_core, flank_shingle_r]
          }

          // Long sinuous 5-bone serpentine S-neck (`neck_1..neck_5`)
          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.25, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-24, 0, 0]
            box neck_1_core { size: [10.5, 9.5, 9.0], material: obsidian_scale }
            box neck_1_scute place(base_box=neck_1_core, anchor=[0, -0.96, 0.05], align=[0, 0.45, 0]) {
              size: [7.5, 2.0, 7.5], material: belly_bronze, blend_with: [chest_core, pectoral_hellfire_core, throat_hellfire_vent, pectoral_hellfire_plate_l, pectoral_hellfire_plate_r]
            }
            box neck_1_dorsal place(base_box=neck_1_core, anchor=[0, 0.96, 0], align=[0, -0.60, 0]) {
              size: [6.0, 2.0, 7.5], material: slate_armor, blend_with: [chest_core, thoracic_ridge, neck_2_core]
            }
            box neck_1_spine place(base_box=neck_1_dorsal, anchor=[0, 0.96, 0], align=[0, -0.80, 0]) {
              size: [2.0, 4.5, 3.5], material: bone_ivory, rotate: [20, 0, 0], blend_with: [neck_1_core, thoracic_ridge, chest_core]
            }
            box neck_1_shingle_l place(base_box=neck_1_core, anchor=[0.98, 0.18, 0], align=[-0.68, 0, 0]) {
              size: [2.0, 4.5, 6.5], material: slate_armor, rotate: [6, -8, -12], blend_with: [chest_core, wing_root_mass, neck_2_core]
            }
            box neck_1_shingle_r place(base_box=neck_1_core, anchor=[-0.98, 0.18, 0], align=[0.68, 0, 0]) {
              size: [2.0, 4.5, 6.5], material: slate_armor, rotate: [6, 8, 12], blend_with: [chest_core, wing_mount_r__wing_root_mass, neck_2_core]
            }
            plane neck_1_frill_plane place(base_box=neck_1_dorsal, anchor=[0.18, 0.96, 0], align=[0, -0.88, 0]) {
              size: [3.5, 7.0], normal: x, material: bronze_wing, rotate: [8, 0, -6],
              edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=51), layer: 1,
              blend_with: [neck_1_core, neck_1_spine, thoracic_ridge, thoracic_spine_1, neck_2_core, neck_2_spine]
            }

            bone neck_2 attach(parent_box=neck_1_core, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.24) {
              rest_euler: [-12, 0, 0]
              box neck_2_core { size: [9.0, 8.5, 8.5], material: obsidian_scale }
              box neck_2_scute place(base_box=neck_2_core, anchor=[0, -0.96, 0.05], align=[0, 0.45, 0]) {
                size: [6.5, 1.5, 7.0], material: belly_bronze, blend_with: [neck_1_core, neck_1_scute]
              }
              box neck_2_dorsal place(base_box=neck_2_core, anchor=[0, 0.96, 0], align=[0, -0.60, 0]) {
                size: [5.0, 2.0, 7.0], material: slate_armor, blend_with: [neck_1_core, neck_1_dorsal, neck_3_core]
              }
              box neck_2_spine place(base_box=neck_2_dorsal, anchor=[0, 0.96, 0], align=[0, -0.80, 0]) {
                size: [1.5, 4.5, 3.5], material: bone_ivory, rotate: [22, 0, 0], blend_with: [neck_2_core, neck_1_core]
              }
              box neck_2_shingle_l place(base_box=neck_2_core, anchor=[0.98, 0.18, 0], align=[-0.68, 0, 0]) {
                size: [1.5, 4.0, 6.0], material: slate_armor, rotate: [6, -8, -12], blend_with: [neck_1_core, neck_1_shingle_l, neck_3_core]
              }
              box neck_2_shingle_r place(base_box=neck_2_core, anchor=[-0.98, 0.18, 0], align=[0.68, 0, 0]) {
                size: [1.5, 4.0, 6.0], material: slate_armor, rotate: [6, 8, 12], blend_with: [neck_1_core, neck_1_shingle_r, neck_3_core]
              }

              bone neck_3 attach(parent_box=neck_2_core, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                rest_euler: [18, 0, 0]
                box neck_3_core { size: [8.0, 7.5, 8.0], material: obsidian_scale }
                box neck_3_scute place(base_box=neck_3_core, anchor=[0, -0.96, 0.05], align=[0, 0.45, 0]) {
                  size: [5.5, 1.5, 6.5], material: belly_bronze, blend_with: [neck_2_core, neck_2_scute]
                }
                box neck_3_dorsal place(base_box=neck_3_core, anchor=[0, 0.96, 0], align=[0, -0.60, 0]) {
                  size: [4.5, 1.5, 6.5], material: slate_armor, blend_with: [neck_2_core, neck_2_dorsal, neck_4_core]
                }
                box neck_3_spine place(base_box=neck_3_dorsal, anchor=[0, 0.96, 0], align=[0, -0.80, 0]) {
                  size: [1.5, 4.5, 3.5], material: bone_ivory, rotate: [24, 0, 0], blend_with: [neck_3_core, neck_2_core]
                }
                box neck_3_shingle_l place(base_box=neck_3_core, anchor=[0.98, 0.18, 0], align=[-0.68, 0, 0]) {
                  size: [1.5, 3.5, 5.5], material: slate_armor, rotate: [6, -8, -12], blend_with: [neck_2_core, neck_2_shingle_l, neck_4_core]
                }
                box neck_3_shingle_r place(base_box=neck_3_core, anchor=[-0.98, 0.18, 0], align=[0.68, 0, 0]) {
                  size: [1.5, 3.5, 5.5], material: slate_armor, rotate: [6, 8, 12], blend_with: [neck_2_core, neck_2_shingle_r, neck_4_core]
                }
                plane neck_3_frill_plane place(base_box=neck_3_dorsal, anchor=[-0.18, 0.96, 0], align=[0, -0.88, 0]) {
                  size: [3.5, 6.0], normal: x, material: bronze_wing, rotate: [8, 0, 6],
                  edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=57), layer: 2,
                  blend_with: [neck_3_core, neck_3_spine, neck_2_core, neck_2_spine, neck_4_core, neck_4_spine]
                }

                bone neck_4 attach(parent_box=neck_3_core, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                  rest_euler: [28, 0, 0]
                  box neck_4_core { size: [7.0, 6.5, 7.5], material: obsidian_scale }
                  box neck_4_scute place(base_box=neck_4_core, anchor=[0, -0.96, 0.05], align=[0, 0.45, 0]) {
                    size: [5.0, 1.5, 6.0], material: belly_bronze, blend_with: [neck_3_core, neck_3_scute]
                  }
                  box neck_4_dorsal place(base_box=neck_4_core, anchor=[0, 0.96, 0], align=[0, -0.60, 0]) {
                    size: [4.0, 1.5, 6.0], material: slate_armor, blend_with: [neck_3_core, neck_3_dorsal, neck_5_core]
                  }
                  box neck_4_spine place(base_box=neck_4_dorsal, anchor=[0, 0.96, 0], align=[0, -0.80, 0]) {
                    size: [1.5, 4.5, 3.0], material: bone_ivory, rotate: [24, 0, 0], blend_with: [neck_4_core, neck_3_core]
                  }
                  box neck_4_shingle_l place(base_box=neck_4_core, anchor=[0.98, 0.18, 0], align=[-0.68, 0, 0]) {
                    size: [1.5, 3.5, 5.0], material: slate_armor, rotate: [6, -8, -12], blend_with: [neck_3_core, neck_3_shingle_l, neck_5_core]
                  }
                  box neck_4_shingle_r place(base_box=neck_4_core, anchor=[-0.98, 0.18, 0], align=[0.68, 0, 0]) {
                    size: [1.5, 3.5, 5.0], material: slate_armor, rotate: [6, 8, 12], blend_with: [neck_3_core, neck_3_shingle_r, neck_5_core]
                  }

                  bone neck_5 attach(parent_box=neck_4_core, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                    rest_euler: [32, 0, 0]
                    box neck_5_core { size: [6.5, 6.0, 7.0], material: obsidian_scale }
                    box neck_5_scute place(base_box=neck_5_core, anchor=[0, -0.96, 0.05], align=[0, 0.45, 0]) {
                      size: [4.5, 1.5, 5.5], material: belly_bronze, blend_with: [neck_4_core, neck_4_scute]
                    }
                    box neck_5_dorsal place(base_box=neck_5_core, anchor=[0, 0.96, 0], align=[0, -0.60, 0]) {
                      size: [3.5, 1.5, 5.5], material: slate_armor, blend_with: [neck_4_core, neck_4_dorsal, skull_core]
                    }
                    box neck_5_spine place(base_box=neck_5_dorsal, anchor=[0, 0.96, 0], align=[0, -0.80, 0]) {
                      size: [1.5, 4.5, 3.0], material: bone_ivory, rotate: [26, 0, 0], blend_with: [neck_5_core, neck_4_core]
                    }
                    box neck_5_shingle_l place(base_box=neck_5_core, anchor=[0.98, 0.22, 0], align=[-0.68, 0, 0]) {
                      size: [1.5, 3.0, 5.0], material: slate_armor, rotate: [6, -10, -14], blend_with: [neck_4_core, neck_4_shingle_l, skull_core, cheek_jowl_l]
                    }
                    box neck_5_shingle_r place(base_box=neck_5_core, anchor=[-0.98, 0.22, 0], align=[0.68, 0, 0]) {
                      size: [1.5, 3.0, 5.0], material: slate_armor, rotate: [6, 10, 14], blend_with: [neck_4_core, neck_4_shingle_r, skull_core, cheek_jowl_r]
                    }

                    // Fierce 4-Horned Western Dragon Head & Wedged Snout (`snout_taper_ratio < 0.35`)
                    bone head attach(parent_box=neck_5_core, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.22) {
                      rest_euler: [20, 0, 0]
                      box skull_core { size: [9.0, 6.0, 7.5], material: obsidian_scale }
                      box skull_crown place(base_box=skull_core, anchor=[0, 0.96, -0.10], align=[0, -0.60, 0]) {
                        size: [5.5, 2.0, 6.5], material: slate_armor, rotate: [6, 0, 0], blend_with: [neck_5_core, neck_5_dorsal, brow_ridge_l, brow_ridge_r]
                      }
                      box skull_crest_spike place(base_box=skull_crown, anchor=[0, 0.96, -0.25], align=[0, -0.82, 0]) {
                        size: [1.0, 4.0, 3.0], material: bone_ivory, rotate: [34, 0, 0], blend_with: [skull_core, neck_5_core, neck_5_spine]
                      }
                      box occipital_frill_l place(base_box=skull_crown, anchor=[0.52, 0.55, -0.92], align=[-0.35, -0.65, 0.65]) {
                        size: [2.0, 1.5, 3.5], material: slate_armor, rotate: [14, -14, -14], blend_with: [skull_core, skull_crest_spike, neck_5_core, neck_5_dorsal, neck_5_spine, horn_u_seg_1]
                      }
