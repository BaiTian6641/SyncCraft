          }

          // Long muscular dragon forelimbs reaching down from reared chest to Y = 0
          bone fore_shoulder_l attach(parent_box=chest_core, anchor=[0.96, -0.35, 0.18], align=[-0.55, 0.85, 0], seat=0.12) mirror_x(fore_shoulder_r) {
            rest_euler: [62, 6, 22]
            box fore_bicep { size: [6.5, 13.5, 7.0], material: obsidian_scale, blend_with: [waist_core, wing_root_mass] }
            box fore_pauldron place(base_box=fore_bicep, anchor=[0.98, 0.35, 0.05], align=[-0.50, 0, 0]) {
              size: [2.5, 6.5, 6.0], material: slate_armor, rotate: [-8, 8, -12], blend_with: [chest_core, wing_root_mass]
            }
            box fore_pauldron_spur place(base_box=fore_pauldron, anchor=[0.88, 0.86, -0.25], align=[-0.68, -0.68, 0.35]) {
              size: [1.5, 3.0, 4.5], material: horn_ochre, rotate: [16, 20, -16], blend_with: [fore_bicep, chest_core, wing_root_mass]
            }
            box fore_elbow_spur place(base_box=fore_bicep, anchor=[0.15, -0.82, -0.96], align=[0, 0, 0.70]) {
              size: [3.0, 3.0, 4.5], material: bone_ivory, rotate: [20, 0, 0], blend_with: [fore_bracer]
            }
            plane fore_elbow_fringe place(base_box=fore_bicep, anchor=[0.45, -0.15, -0.98], align=[0, 0, 0.88]) {
              size: [6.5, 4.5], normal: x, material: wing_umber, rotate: [12, 12, 0],
              edge: ragged(depth=4, holes=1, side=right, seed=61), layer: 1,
              blend_with: [fore_pauldron, fore_elbow_spur, fore_bracer]
            }

            bone fore_arm_l attach(parent_box=fore_bicep, anchor=[0.08, -1, -0.05], align=[0, 0.88, 0], seat=0.16) {
              rest_euler: [-34, 0, -14]
              box fore_bracer { size: [5.5, 13.5, 6.0], material: obsidian_scale, blend_with: [chest_core] }
              box fore_bracer_guard place(base_box=fore_bracer, anchor=[0.85, 0.05, 0.65], align=[-0.55, 0, -0.55]) {
                size: [2.5, 9.5, 3.0], material: slate_armor, rotate: [4, -12, -6], blend_with: [fore_bicep, fore_hand_pad]
              }
              box fore_bracer_spur_1 place(base_box=fore_bracer, anchor=[0.96, 0.32, -0.25], align=[-0.65, 0, 0.35]) {
                size: [2.0, 2.5, 5.0], material: horn_ochre, rotate: [16, 24, -12], blend_with: [fore_bicep, fore_elbow_spur, fore_bracer_guard]
              }
              box fore_bracer_spur_2 place(base_box=fore_bracer, anchor=[0.96, -0.28, -0.25], align=[-0.65, 0, 0.35]) {
                size: [2.0, 2.0, 4.5], material: horn_ochre, rotate: [16, 24, -12], blend_with: [fore_bracer_spur_1, fore_bracer_guard, fore_hand_pad]
              }

              bone fore_hand_l attach(parent_box=fore_bracer, anchor=[0, -1, 0.15], align=[0, 0.88, -0.45], seat=0.14) {
                rest_euler: [18, 0, -8]
                box fore_hand_pad { size: [7.0, 3.0, 7.0], material: deep_charcoal }
                box hand_knuckle_plate place(base_box=fore_hand_pad, anchor=[0, 0.98, 0.58], align=[0, -0.82, 0]) {
                  size: [5.5, 1.0, 3.5], material: slate_armor, rotate: [10, 0, 0], blend_with: [fore_bracer, fore_bracer_guard, f_toe_1, f_toe_2, f_toe_3, f_toe_4]
                }
                box f_toe_1 place(base_box=fore_hand_pad, anchor=[-0.68, -0.10, 0.94], align=[0, 0, -0.78]) {
                  size: [1.5, 2.0, 4.0], material: slate_armor, rotate: [2, 16, 0]
                }
                box f_claw_1 place(base_box=f_toe_1, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
                  size: [1.0, 1.5, 3.0], material: bone_ivory, rotate: [8, 4, 0]
                }
                box f_toe_2 place(base_box=fore_hand_pad, anchor=[-0.22, -0.10, 0.98], align=[0, 0, -0.80]) {
                  size: [1.5, 2.0, 4.5], material: slate_armor, rotate: [2, 5, 0], blend_with: [f_toe_1]
                }
                box f_claw_2 place(base_box=f_toe_2, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
                  size: [1.0, 1.5, 3.5], material: bone_ivory, rotate: [8, 0, 0], blend_with: [f_claw_1]
                }
                box f_toe_3 place(base_box=fore_hand_pad, anchor=[0.24, -0.10, 0.98], align=[0, 0, -0.80]) {
                  size: [1.5, 2.0, 4.5], material: slate_armor, rotate: [2, -6, 0], blend_with: [f_toe_2]
                }
                box f_claw_3 place(base_box=f_toe_3, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
                  size: [1.0, 1.5, 3.5], material: bone_ivory, rotate: [8, 0, 0], blend_with: [f_claw_2]
                }
                box f_toe_4 place(base_box=fore_hand_pad, anchor=[0.70, -0.10, 0.92], align=[0, 0, -0.78]) {
                  size: [1.5, 2.0, 4.0], material: slate_armor, rotate: [2, -18, 0], blend_with: [f_toe_3]
                }
                box f_claw_4 place(base_box=f_toe_4, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
                  size: [1.0, 1.5, 3.0], material: bone_ivory, rotate: [8, -4, 0], blend_with: [f_claw_3]
                }
                box f_dewclaw place(base_box=fore_hand_pad, anchor=[-0.96, 0.15, -0.35], align=[0.68, 0, 0.35]) {
                  size: [1.0, 1.5, 3.0], material: bone_ivory, rotate: [12, -26, 0], blend_with: [fore_bracer]
                }
              }
            }
          }
        }
      }

      // Coiled powerful dragon hindlimbs planted wide on Y = 0
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.96, -0.12, -0.05], align=[-0.55, 0.85, 0], seat=0.14) mirror_x(hind_thigh_r) {
        rest_euler: [-10, -6, 20]
        box thigh_mass { size: [6.5, 11.5, 8.0], material: obsidian_scale, blend_with: [waist_core, tail_1_seg] }
        box thigh_armor place(base_box=thigh_mass, anchor=[0.98, 0.22, 0.08], align=[-0.48, 0, 0]) {
          size: [2.5, 6.5, 6.0], material: slate_armor, rotate: [6, -8, -10], blend_with: [pelvis_core, haunch_muscle_l]
        }
        box thigh_spur place(base_box=thigh_armor, anchor=[0.92, 0.22, -0.42], align=[-0.68, 0, 0.45]) {
          size: [1.5, 2.5, 5.0], material: horn_ochre, rotate: [16, 22, -12], blend_with: [thigh_mass, hip_osteoderm_l]
        }
        box knee_guard place(base_box=thigh_mass, anchor=[0.15, -0.82, 0.96], align=[0, 0, -0.72]) {
          size: [3.5, 3.5, 2.5], material: slate_armor, rotate: [-14, 0, 0], blend_with: [shin_mass, waist_core, waist_belly]
        }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [52, 0, -12]
          box shin_mass { size: [5.0, 10.5, 5.5], material: obsidian_scale }
          box shin_guard place(base_box=shin_mass, anchor=[0.20, 0.05, 0.96], align=[0, 0, -0.68]) {
            size: [3.5, 7.5, 2.0], material: slate_armor, rotate: [4, 0, 0], blend_with: [thigh_mass, knee_guard, hind_foot_pad]
          }
          box hock_spur place(base_box=shin_mass, anchor=[0, 0.65, -0.94], align=[0, 0, 0.72]) {
            size: [2.5, 3.0, 4.5], material: bone_ivory, rotate: [20, 0, 0], blend_with: [thigh_mass]
          }
          plane ankle_web_fringe place(base_box=shin_mass, anchor=[0.25, -0.25, -0.98], align=[0, 0, 0.88]) {
            size: [5.5, 4.0], normal: x, material: wing_umber, rotate: [8, 10, 0],
            edge: ragged(depth=3, holes=1, side=right, seed=73), layer: 1,
            blend_with: [hock_spur, hind_foot_pad]
          }

          bone hind_foot_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.42], seat=0.14) {
            rest_euler: [-24, 0, -8]
            box hind_foot_pad { size: [6.5, 3.0, 7.0], material: deep_charcoal }
            box foot_knuckle_plate place(base_box=hind_foot_pad, anchor=[0, 0.98, 0.58], align=[0, -0.82, 0]) {
              size: [5.0, 1.0, 3.0], material: slate_armor, rotate: [10, 0, 0], blend_with: [shin_mass, shin_guard, h_toe_1, h_toe_2, h_toe_3]
            }
            box h_toe_1 place(base_box=hind_foot_pad, anchor=[-0.62, -0.10, 0.94], align=[0, 0, -0.78]) {
              size: [1.5, 2.0, 4.0], material: slate_armor, rotate: [2, 14, 0]
            }
            box h_claw_1 place(base_box=h_toe_1, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.0, 1.5, 3.0], material: bone_ivory, rotate: [8, 4, 0]
            }
            box h_toe_2 place(base_box=hind_foot_pad, anchor=[0.0, -0.10, 0.98], align=[0, 0, -0.80]) {
              size: [1.5, 2.0, 4.5], material: slate_armor, rotate: [2, 0, 0], blend_with: [h_toe_1]
            }
            box h_claw_2 place(base_box=h_toe_2, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.0, 1.5, 3.5], material: bone_ivory, rotate: [8, 0, 0], blend_with: [h_claw_1]
            }
            box h_toe_3 place(base_box=hind_foot_pad, anchor=[0.62, -0.10, 0.94], align=[0, 0, -0.78]) {
              size: [1.5, 2.0, 4.0], material: slate_armor, rotate: [2, -14, 0], blend_with: [h_toe_2]
            }
            box h_claw_3 place(base_box=h_toe_3, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.0, 1.5, 3.0], material: bone_ivory, rotate: [8, -4, 0], blend_with: [h_claw_2]
            }
            box h_heel_spur place(base_box=hind_foot_pad, anchor=[0, 0.25, -0.96], align=[0, 0, 0.80]) {
              size: [2.0, 1.5, 3.0], material: bone_ivory, rotate: [12, 0, 0], blend_with: [shin_mass]
            }
          }
        }
      }

      // Extra-long 7-bone articulated serpentine whip tail (`tail_1..tail_7`) lined with bone spines & lateral keels!
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, -0.05, -1], align=[0, 0, 1], seat=0.20) {
        rest_euler: [-4, 0, 0]
        box tail_1_seg { size: [8.5, 7.5, 12.5], material: obsidian_scale }
        box tail_1_scute place(base_box=tail_1_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
          size: [6.0, 1.5, 10.5], material: belly_bronze, blend_with: [pelvis_belly, pelvis_core]
        }
        box tail_1_spine place(base_box=tail_1_seg, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
          size: [2.0, 4.0, 4.0], material: bone_ivory, rotate: [24, 0, 0], blend_with: [pelvis_core, sacrum_armor]
        }
        box tail_1_keel_l place(base_box=tail_1_seg, anchor=[0.98, 0.15, -0.10], align=[-0.82, 0, 0.35]) {
          size: [2.0, 2.5, 8.5], material: slate_armor, rotate: [8, 16, -10], blend_with: [pelvis_core, haunch_muscle_l, tail_2_seg]
        }
        box tail_1_keel_r place(base_box=tail_1_seg, anchor=[-0.98, 0.15, -0.10], align=[0.82, 0, 0.35]) {
          size: [2.0, 2.5, 8.5], material: slate_armor, rotate: [8, -16, 10], blend_with: [pelvis_core, haunch_muscle_r, tail_2_seg]
        }

        bone tail_2 attach(parent_box=tail_1_seg, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.20) {
          rest_euler: [10, 0, 0]
          box tail_2_seg { size: [7.5, 6.5, 12.0], material: obsidian_scale }
          box tail_2_scute place(base_box=tail_2_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
            size: [5.0, 1.5, 10.0], material: belly_bronze, blend_with: [tail_1_scute, tail_1_seg]
          }
          box tail_2_spine place(base_box=tail_2_seg, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
            size: [1.5, 4.0, 4.0], material: bone_ivory, rotate: [24, 0, 0], blend_with: [tail_1_seg]
          }
          box tail_2_keel_l place(base_box=tail_2_seg, anchor=[0.98, 0.15, -0.10], align=[-0.82, 0, 0.35]) {
            size: [2.0, 2.0, 8.0], material: slate_armor, rotate: [8, 16, -10], blend_with: [tail_1_seg, tail_1_keel_l, tail_3_seg]
          }
          box tail_2_keel_r place(base_box=tail_2_seg, anchor=[-0.98, 0.15, -0.10], align=[0.82, 0, 0.35]) {
            size: [2.0, 2.0, 8.0], material: slate_armor, rotate: [8, -16, 10], blend_with: [tail_1_seg, tail_1_keel_r, tail_3_seg]
          }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.20) {
            rest_euler: [10, 0, 0]
            box tail_3_seg { size: [6.5, 5.5, 11.5], material: obsidian_scale }
            box tail_3_scute place(base_box=tail_3_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
              size: [4.5, 1.0, 9.5], material: belly_bronze, blend_with: [tail_2_scute, tail_2_seg]
            }
            box tail_3_spine place(base_box=tail_3_seg, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
              size: [1.5, 3.5, 3.5], material: bone_ivory, rotate: [24, 0, 0], blend_with: [tail_2_seg]
            }
            box tail_3_keel_l place(base_box=tail_3_seg, anchor=[0.98, 0.15, -0.10], align=[-0.82, 0, 0.35]) {
              size: [1.5, 2.0, 7.5], material: slate_armor, rotate: [8, 16, -10], blend_with: [tail_2_seg, tail_2_keel_l, tail_4_seg]
            }
            box tail_3_keel_r place(base_box=tail_3_seg, anchor=[-0.98, 0.15, -0.10], align=[0.82, 0, 0.35]) {
              size: [1.5, 2.0, 7.5], material: slate_armor, rotate: [8, -16, 10], blend_with: [tail_2_seg, tail_2_keel_r, tail_4_seg]
            }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.20) {
              rest_euler: [4, 0, 0]
              box tail_4_seg { size: [5.5, 5.0, 11.0], material: obsidian_scale }
              box tail_4_scute place(base_box=tail_4_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
                size: [3.5, 1.0, 9.0], material: belly_bronze, blend_with: [tail_3_scute, tail_3_seg]
              }
              box tail_4_spine place(base_box=tail_4_seg, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
                size: [1.5, 3.5, 3.5], material: bone_ivory, rotate: [24, 0, 0], blend_with: [tail_3_seg]
              }
              box tail_4_keel_l place(base_box=tail_4_seg, anchor=[0.98, 0.15, -0.10], align=[-0.82, 0, 0.35]) {
                size: [1.5, 1.5, 7.0], material: slate_armor, rotate: [8, 16, -10], blend_with: [tail_3_seg, tail_3_keel_l, tail_5_seg]
              }
              box tail_4_keel_r place(base_box=tail_4_seg, anchor=[-0.98, 0.15, -0.10], align=[0.82, 0, 0.35]) {
                size: [1.5, 1.5, 7.0], material: slate_armor, rotate: [8, -16, 10], blend_with: [tail_3_seg, tail_3_keel_r, tail_5_seg]
              }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.20) {
                rest_euler: [4, 0, 0]
                box tail_5_seg { size: [4.5, 4.0, 10.5], material: obsidian_scale }
                box tail_5_scute place(base_box=tail_5_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
                  size: [3.0, 1.0, 8.5], material: belly_bronze, blend_with: [tail_4_scute, tail_4_seg]
                }
                box tail_5_spine place(base_box=tail_5_seg, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
                  size: [1.0, 3.0, 3.5], material: bone_ivory, rotate: [26, 0, 0], blend_with: [tail_4_seg]
                }
                box tail_5_keel_l place(base_box=tail_5_seg, anchor=[0.98, 0.15, -0.10], align=[-0.82, 0, 0.35]) {
                  size: [1.5, 1.5, 6.5], material: horn_ochre, rotate: [8, 16, -10], blend_with: [tail_4_seg, tail_4_keel_l, tail_6_seg]
                }
                box tail_5_keel_r place(base_box=tail_5_seg, anchor=[-0.98, 0.15, -0.10], align=[0.82, 0, 0.35]) {
                  size: [1.5, 1.5, 6.5], material: horn_ochre, rotate: [8, -16, 10], blend_with: [tail_4_seg, tail_4_keel_r, tail_6_seg]
                }

                bone tail_6 attach(parent_box=tail_5_seg, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.18) {
                  rest_euler: [8, 0, 0]
                  box tail_6_seg { size: [3.5, 3.5, 10.0], material: slate_armor }
                  box tail_6_spine place(base_box=tail_6_seg, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
                    size: [1.0, 3.0, 3.0], material: bone_ivory, rotate: [26, 0, 0], blend_with: [tail_5_seg]
                  }
                  box tail_6_keel_l place(base_box=tail_6_seg, anchor=[0.98, 0.15, -0.15], align=[-0.82, 0, 0.40]) {
                    size: [1.5, 1.5, 6.0], material: horn_ochre, rotate: [10, 18, -10], blend_with: [tail_5_seg, tail_5_keel_l, tail_7_seg]
                  }
                  box tail_6_keel_r place(base_box=tail_6_seg, anchor=[-0.98, 0.15, -0.15], align=[0.82, 0, 0.40]) {
                    size: [1.5, 1.5, 6.0], material: horn_ochre, rotate: [10, -18, 10], blend_with: [tail_5_seg, tail_5_keel_r, tail_7_seg]
                  }

                  bone tail_7 attach(parent_box=tail_6_seg, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.18) {
                    rest_euler: [12, 0, 0]
                    box tail_7_seg { size: [2.5, 2.5, 9.5], material: slate_armor }
                    box tail_7_spine place(base_box=tail_7_seg, anchor=[0, 0.96, 0.15], align=[0, -0.78, 0]) {
                      size: [1.0, 2.5, 3.0], material: bone_ivory, rotate: [26, 0, 0], blend_with: [tail_6_seg, tail_whip_barb]
                    }
                    box tail_whip_barb place(base_box=tail_7_seg, anchor=[0, 0.20, -0.96], align=[0, 0, 0.75]) {
                      size: [2.0, 2.5, 7.0], material: bone_ivory, rotate: [12, 0, 0]
                    }
                    box tail_whip_spur_l place(base_box=tail_7_seg, anchor=[0.94, 0.10, -0.45], align=[-0.68, 0, 0.55]) {
                      size: [1.5, 1.5, 5.0], material: horn_ochre, rotate: [10, 26, -12], blend_with: [tail_whip_barb]
                    }
                    box tail_whip_spur_r place(base_box=tail_7_seg, anchor=[-0.94, 0.10, -0.45], align=[0.68, 0, 0.55]) {
                      size: [1.5, 1.5, 5.0], material: horn_ochre, rotate: [10, -26, 12], blend_with: [tail_whip_barb]
                    }
                    plane tail_whip_crest_plane place(base_box=tail_whip_barb, anchor=[0, 0.95, 0], align=[0, -0.88, 0]) {
                      size: [3.5, 6.5], normal: x, material: bronze_wing, rotate: [8, 0, 0],
                      edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=89), layer: 1,
                      blend_with: [tail_7_seg, tail_7_spine]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
@materials {
  obsidian_scale: process(family=keratin_scales, coat=scale_rows, roughness=0.48)
  slate_armor: process(family=keratin_scales, coat=scale_rows, roughness=0.40)
  deep_charcoal: process(family=keratin_scales, coat=banded_limb, roughness=0.56)
  bronze_wing: process(family=patterned_skin, coat=mottled, roughness=0.68)
  wing_umber: process(family=patterned_skin, coat=mottled, roughness=0.72)
  belly_bronze: process(family=patterned_skin, coat=plain, roughness=0.64)
  bone_ivory: process(family=polymer_dielectric, coat=striped, roughness=0.34)
  horn_ochre: process(family=weathered_stone, coat=striped, roughness=0.44)
  mouth_crimson: process(family=patterned_skin, coat=plain, roughness=0.45)
  hellfire_orange: process(family=thin_film_iridescence, coat=plain, roughness=0.16, emissive=0.96)
  eye_gold: process(family=thin_film_iridescence, coat=plain, roughness=0.14, emissive=0.98)
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
@stamps {
  stamp fatalis_eye_gleam on skull_core.east { at: [0.68, 0.34], size: [1.5, 1.0], color: eye_gold, emissive: 0.96, mirror: true }
  stamp sternum_magma_crack on pectoral_hellfire_plate_l.down { at: [0.35, 0.48], size: [1.5, 4.5], color: hellfire_orange, emissive: 0.94, mirror: true }
  stamp throat_hellfire_glow on neck_1_scute.south { at: [0.50, 0.65], size: [2.5, 1.5], color: hellfire_orange, emissive: 0.90 }
}
@behavior {
  spring horn_upper_l { stiffness: 52, damping: 8 }
  spring horn_upper_r { stiffness: 52, damping: 8 }
  spring wing_finger_1b_l { stiffness: 44, damping: 6 }
  spring tail_6 { stiffness: 36, damping: 5 }
  spring tail_7 { stiffness: 32, damping: 4 }

  // 1. Regal Castle Schrade Rearing Breath, 5-Bone S-Neck Coil & Serpentine Tail Floor-Glide
  clip idle {
    duration_s: 3.6, loop: true
    key root.position { 0.0: [0, 0, 0], 0.9: [0, 0.5, 0], 1.8: [0, -0.4, 0], 2.7: [0, 0.5, 0], 3.6: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.9: [-3, 1.5, 0], 1.8: [2.5, 0, 0], 2.7: [-3, -1.5, 0], 3.6: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.9: [-4, 5, 2], 1.8: [3, 0, 0], 2.7: [-4, -5, -2], 3.6: [0, 0, 0], catmullrom }
    key neck_3.rotation { 0.0: [0, 0, 0], 0.9: [5, 7, 0], 1.8: [-3, 0, 0], 2.7: [5, -7, 0], 3.6: [0, 0, 0], catmullrom }
    key neck_5.rotation { 0.0: [0, 0, 0], 0.9: [-3, -4, 0], 1.8: [4, 0, 0], 2.7: [-3, 4, 0], 3.6: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.9: [5, 8, -4], 1.8: [-3, 0, 0], 2.7: [5, -8, 4], 3.6: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 1.8: [8, 0, 0], 3.6: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 0.9: [0, -4, 6], 1.8: [0, 3, -4], 2.7: [0, -4, 6], 3.6: [0, 0, 0], catmullrom }
    key wing_mount_r__wing_arm_l.rotation { 0.0: [0, 0, 0], 0.9: [0, -4, 6], 1.8: [0, 3, -4], 2.7: [0, -4, 6], 3.6: [0, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=7, freq_hz=0.2778, phase_deg=0)
    track tail_2: wave(axis=y, amp_deg=9, freq_hz=0.2778, phase_deg=-32)
    track tail_3: wave(axis=y, amp_deg=12, freq_hz=0.2778, phase_deg=-64)
    track tail_4: wave(axis=y, amp_deg=15, freq_hz=0.2778, phase_deg=-96)
    track tail_5: wave(axis=y, amp_deg=18, freq_hz=0.2778, phase_deg=-128)
    track tail_6: wave(axis=y, amp_deg=21, freq_hz=0.2778, phase_deg=-160)
    track tail_7: wave(axis=y, amp_deg=24, freq_hz=0.2778, phase_deg=-192)
  }

  // 2. Heavy Castle Schrade Dragon Stalk (quadruped stride + undulating S-neck & trailing whip tail)
  clip walk {
    duration_s: 1.8, loop: true
    key root.position { 0.0: [0, 0, 0], 0.45: [0, 1.2, 0], 0.90: [0, 0, 0], 1.35: [0, 1.2, 0], 1.80: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, -6, 3], 0.45: [2, 0, 0], 0.90: [0, 6, -3], 1.35: [2, 0, 0], 1.80: [0, -6, 3], catmullrom }
    key chest.rotation { 0.0: [0, 8, -5], 0.45: [-2, 0, 0], 0.90: [0, -8, 5], 1.35: [-2, 0, 0], 1.80: [0, 8, -5], catmullrom }
    key neck_1.rotation { 0.0: [0, -6, 3], 0.90: [0, 6, -3], 1.80: [0, -6, 3], catmullrom }
    key neck_3.rotation { 0.0: [4, -4, 0], 0.90: [4, 4, 0], 1.80: [4, -4, 0], catmullrom }
    key head.rotation { 0.0: [2, -4, 2], 0.90: [2, 4, -2], 1.80: [2, -4, 2], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [-22, 0, 0], 0.45: [6, 0, 4], 0.90: [22, 0, 0], 1.35: [-8, 0, 6], 1.80: [-22, 0, 0], catmullrom }
    key fore_arm_l.rotation { 0.0: [12, 0, 0], 0.45: [4, 0, 0], 0.90: [16, 0, 0], 1.35: [-22, 0, 0], 1.80: [12, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [22, 0, 0], 0.45: [-8, 0, 6], 0.90: [-22, 0, 0], 1.35: [6, 0, 4], 1.80: [22, 0, 0], catmullrom }
    key fore_shoulder_r__fore_arm_l.rotation { 0.0: [16, 0, 0], 0.45: [-22, 0, 0], 0.90: [12, 0, 0], 1.35: [4, 0, 0], 1.80: [16, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [20, 0, 0], 0.45: [-10, 0, 4], 0.90: [-20, 0, 0], 1.35: [6, 0, 0], 1.80: [20, 0, 0], catmullrom }
    key hind_shin_l.rotation { 0.0: [-14, 0, 0], 0.45: [22, 0, 0], 0.90: [8, 0, 0], 1.35: [-6, 0, 0], 1.80: [-14, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [-20, 0, 0], 0.45: [6, 0, 0], 0.90: [20, 0, 0], 1.35: [-10, 0, 4], 1.80: [-20, 0, 0], catmullrom }
    key hind_thigh_r__hind_shin_l.rotation { 0.0: [8, 0, 0], 0.45: [-6, 0, 0], 0.90: [-14, 0, 0], 1.35: [22, 0, 0], 1.80: [8, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=11, freq_hz=0.5556, phase_deg=0)
    track tail_3: wave(axis=y, amp_deg=16, freq_hz=0.5556, phase_deg=-55)
    track tail_5: wave(axis=y, amp_deg=22, freq_hz=0.5556, phase_deg=-110)
    track tail_7: wave(axis=y, amp_deg=28, freq_hz=0.5556, phase_deg=-165)
  }

  // 3. Infamous Fatalis Slithering Belly-Crawl Snap Charge!
  clip run {
    duration_s: 1.0, loop: true
    key root.position { 0.0: [0, -3.5, 0], 0.25: [2.5, -2.0, 2.0], 0.50: [0, -3.5, 0], 0.75: [-2.5, -2.0, 2.0], 1.0: [0, -3.5, 0], catmullrom }
    key pelvis.rotation { 0.0: [16, -16, 0], 0.50: [16, 16, 0], 1.0: [16, -16, 0], catmullrom }
    key waist.rotation { 0.0: [14, -18, 0], 0.50: [14, 18, 0], 1.0: [14, -18, 0], catmullrom }
    key chest.rotation { 0.0: [16, 20, -6], 0.50: [16, -20, 6], 1.0: [16, 20, -6], catmullrom }
    key neck_1.rotation { 0.0: [22, 18, 0], 0.50: [22, -18, 0], 1.0: [22, 18, 0], catmullrom }
    key neck_3.rotation { 0.0: [-10, -22, 0], 0.50: [-10, 22, 0], 1.0: [-10, -22, 0], catmullrom }
    key head.rotation { 0.0: [-18, -16, 8], 0.50: [-18, 16, -8], 1.0: [-18, -16, 8], catmullrom }
    key jaw.rotation { 0.0: [28, 0, 0], 0.25: [6, 0, 0], 0.50: [28, 0, 0], 0.75: [6, 0, 0], 1.0: [28, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 24, -18], 0.50: [0, 12, -10], 1.0: [0, 24, -18], catmullrom }
    key wing_mount_r__wing_arm_l.rotation { 0.0: [0, 12, -10], 0.50: [0, 24, -18], 1.0: [0, 12, -10], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [-38, 0, 18], 0.50: [34, 0, 12], 1.0: [-38, 0, 18], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [34, 0, 12], 0.50: [-38, 0, 18], 1.0: [34, 0, 12], catmullrom }
    key hind_thigh_l.rotation { 0.0: [34, 0, 14], 0.50: [-34, 0, 14], 1.0: [34, 0, 14], catmullrom }
    key hind_thigh_r.rotation { 0.0: [-34, 0, 14], 0.50: [34, 0, 14], 1.0: [-34, 0, 14], catmullrom }
    track tail_1: wave(axis=y, amp_deg=24, freq_hz=1.0, phase_deg=0)
    track tail_3: wave(axis=y, amp_deg=30, freq_hz=1.0, phase_deg=-60)
    track tail_5: wave(axis=y, amp_deg=34, freq_hz=1.0, phase_deg=-120)
  }

  // 4. Forbidden Black Dragon Cataclysm Roar — Rears Fully Upright on Hindlegs & Spreads Colossal Wings!
  clip roar {
    duration_s: 2.8, loop: false
    key root.position { 0.0: [0, 0, 0], 0.45: [0, -2.5, -2.0], 1.05: [0, 4.5, -3.5], 1.95: [0, 4.0, -3.0], 2.8: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.45: [12, 0, 0], 1.05: [-24, 0, 0], 1.95: [-22, 0, 0], 2.8: [0, 0, 0], catmullrom }
    key waist.rotation { 0.0: [0, 0, 0], 0.45: [10, 0, 0], 1.05: [-18, 0, 0], 1.95: [-16, 0, 0], 2.8: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.45: [14, 0, 0], 1.05: [-18, 0, 0], 1.50: [-16, 6, 0], 1.95: [-18, -6, 0], 2.8: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.45: [18, 0, 0], 1.05: [-12, 0, 0], 1.95: [-10, 0, 0], 2.8: [0, 0, 0], catmullrom }
    key neck_3.rotation { 0.0: [0, 0, 0], 0.45: [16, 0, 0], 1.05: [-18, 8, 0], 1.50: [-20, -8, 0], 1.95: [-18, 0, 0], 2.8: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.45: [22, 0, 0], 1.05: [-28, 0, 0], 1.50: [-26, 12, -6], 1.95: [-28, -12, 6], 2.8: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.45: [-4, 0, 0], 0.98: [44, 0, 0], 2.05: [42, 0, 0], 2.8: [0, 0, 0], catmullrom }
    // Colossal wings flare skyward & forward in terrifying intimidation!
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 0.45: [0, 22, -24], 1.05: [-12, -24, 24], 1.95: [-10, -22, 22], 2.8: [0, 0, 0], catmullrom }
    key wing_mount_r__wing_arm_l.rotation { 0.0: [0, 0, 0], 0.45: [0, 22, -24], 1.05: [-12, -24, 24], 1.95: [-10, -22, 22], 2.8: [0, 0, 0], catmullrom }
    key wing_forearm_l.rotation { 0.0: [0, 0, 0], 1.05: [0, -14, 16], 1.95: [0, -12, 14], 2.8: [0, 0, 0], catmullrom }
    key wing_mount_r__wing_forearm_l.rotation { 0.0: [0, 0, 0], 1.05: [0, -14, 16], 1.95: [0, -12, 14], 2.8: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 1.05: [-36, 0, 28], 1.95: [-32, 0, 26], 2.8: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 1.05: [-36, 0, 28], 1.95: [-32, 0, 26], 2.8: [0, 0, 0], catmullrom }
    key tail_2.rotation { 0.0: [0, 0, 0], 1.05: [16, 18, 0], 1.95: [18, -18, 0], 2.8: [0, 0, 0], catmullrom }
    key tail_5.rotation { 0.0: [0, 0, 0], 1.05: [22, -24, 0], 1.95: [24, 24, 0], 2.8: [0, 0, 0], catmullrom }
  }

  // 5. Serpentine Double-Coil S-Neck Whip & Fang Snap Lunge
  clip serpentine_snap_bite {
    duration_s: 1.6, loop: false
    key root.position { 0.0: [0, 0, 0], 0.42: [0, 1.5, -5.0], 0.82: [0, -2.5, 14.0], 1.12: [0, -1.5, 9.0], 1.6: [0, 0, 0], catmullrom }
