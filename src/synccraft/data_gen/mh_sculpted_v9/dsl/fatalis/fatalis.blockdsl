    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.55: [-58, -18, 36], 1.05: [-18, 28, -22], 1.75: [-42, 0, 28], 2.4: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.55: [-58, -18, 36], 1.05: [-18, 28, -22], 1.75: [-42, 0, 28], 2.4: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 0.55: [0, -24, 24], 1.05: [0, -34, -22], 1.75: [0, -28, 28], 2.4: [0, 0, 0], catmullrom }
    key wing_mount_r__wing_arm_l.rotation { 0.0: [0, 0, 0], 0.55: [0, -24, 24], 1.05: [0, -34, -22], 1.75: [0, -28, 28], 2.4: [0, 0, 0], catmullrom }
  }

  // 12. ICONIC SIGNATURE WILD ATTACK (`signature_gif_clip`): SCHRADE'S DEMISE HELLFIRE SWEEP!
  // Ascends skyward with thunderous wing beats, hovers high above Castle Schrade, and sweeps a
  // cataclysmic ocean of molten hellfire down across the entire arena before descending!
  clip schrade_demise_hellfire_sweep {
    duration_s: 3.0, loop: false
    key root.position {
      0.0: [0, 0, 0],
      0.38: [0, -3.0, -2.0],
      0.92: [0, 28.0, -8.0],
      1.48: [-4.0, 32.0, -6.0],
      2.08: [4.0, 30.0, -6.0],
      2.55: [0, 8.0, -2.0],
      3.0: [0, 0, 0],
      catmullrom
    }
    key pelvis.rotation {
