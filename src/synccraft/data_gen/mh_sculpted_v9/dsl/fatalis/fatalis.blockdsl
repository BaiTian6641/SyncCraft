      catmullrom
    }
    key chest.rotation {
      0.0: [0, 0, 0],
      0.38: [18, 0, 0],
      0.92: [18, 0, 0],
      1.48: [24, -22, -10],
      2.08: [24, 22, 10],
      2.55: [-10, 0, 0],
      3.0: [0, 0, 0],
      catmullrom
    }
    // 5-bone S-neck coils high then plunges straight downward to rain hellfire across the arena!
    key neck_1.rotation {
      0.0: [0, 0, 0],
      0.92: [-18, 0, 0],
      1.38: [32, -26, 0],
      2.08: [32, 26, 0],
      3.0: [0, 0, 0],
      catmullrom
    }
    key neck_3.rotation {
      0.0: [0, 0, 0],
      0.92: [-14, 0, 0],
      1.38: [26, -20, 0],
      2.08: [26, 20, 0],
      3.0: [0, 0, 0],
      catmullrom
    }
    key neck_5.rotation {
      0.0: [0, 0, 0],
      0.92: [-10, 0, 0],
      1.38: [18, -14, 0],
      2.08: [18, 14, 0],
      3.0: [0, 0, 0],
      catmullrom
    }
    key head.rotation {
      0.0: [0, 0, 0],
      0.92: [-22, 0, 0],
      1.35: [28, -18, -12],
      2.08: [28, 18, 12],
      3.0: [0, 0, 0],
      catmullrom
    }
    key jaw.rotation {
      0.0: [0, 0, 0],
      0.92: [10, 0, 0],
      1.30: [48, 0, 0],
      2.15: [48, 0, 0],
      3.0: [0, 0, 0],
      catmullrom
    }
    // Vigorous multi-beat colossal bat-wing flight strokes!
    key wing_arm_l.rotation {
      0.0: [0, 0, 0],
      0.38: [-8, -20, 28],
      0.78: [14, -26, -48],
      1.22: [-10, -24, 30],
      1.68: [12, -22, -42],
      2.15: [-8, -22, 28],
      2.58: [10, -16, -28],
      3.0: [0, 0, 0],
      catmullrom
    }
    key wing_mount_r__wing_arm_l.rotation {
      0.0: [0, 0, 0],
      0.38: [-8, -20, 28],
      0.78: [14, -26, -48],
      1.22: [-10, -24, 30],
      1.68: [12, -22, -42],
      2.15: [-8, -22, 28],
      2.58: [10, -16, -28],
      3.0: [0, 0, 0],
      catmullrom
    }
    key wing_forearm_l.rotation {
      0.0: [0, 0, 0],
      0.38: [0, -12, 18],
      0.78: [0, -18, -24],
      1.22: [0, -14, 20],
      1.68: [0, -16, -22],
      2.15: [0, -12, 18],
      3.0: [0, 0, 0],
      catmullrom
    }
    key wing_mount_r__wing_forearm_l.rotation {
      0.0: [0, 0, 0],
