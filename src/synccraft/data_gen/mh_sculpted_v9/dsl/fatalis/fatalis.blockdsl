    key tail_5.rotation { 0.0: [0, 0, 0], 0.92: [-14, 22, 0], 1.48: [-16, -30, 0], 2.08: [-16, 30, 0], 3.0: [0, 0, 0], catmullrom }
    key tail_7.rotation { 0.0: [0, 0, 0], 0.92: [-10, -24, 0], 1.48: [-12, 34, 0], 2.08: [-12, -34, 0], 3.0: [0, 0, 0], catmullrom }
  }
}
@controller {
  initial: idle
  idle -> walk when speed > 0.15, blend 0.22
  walk -> run when speed > 0.58, blend 0.18
  run -> walk when speed <= 0.45, blend 0.22
  walk -> idle when speed <= 0.08, blend 0.25
  idle -> roar when enraged > 0.5, blend 0.18
  roar -> idle when enraged <= 0.5, blend 0.25
}
