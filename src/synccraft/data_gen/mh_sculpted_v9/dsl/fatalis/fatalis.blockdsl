    key tail_1.rotation { 0.0: [0, 0, 0], 0.45: [-6, -28, 0], 0.92: [-4, 38, 0], 1.30: [0, 18, 0], 1.8: [0, 0, 0], catmullrom }
    key tail_2.rotation { 0.0: [0, 0, 0], 0.45: [-4, -28, 0], 0.95: [-4, 38, 0], 1.32: [0, 16, 0], 1.8: [0, 0, 0], catmullrom }
    key tail_3.rotation { 0.0: [0, 0, 0], 0.45: [-4, -26, 0], 0.98: [-2, 36, 0], 1.35: [0, 14, 0], 1.8: [0, 0, 0], catmullrom }
    key tail_4.rotation { 0.0: [0, 0, 0], 0.45: [0, -26, 0], 1.01: [0, 36, 0], 1.38: [0, 14, 0], 1.8: [0, 0, 0], catmullrom }
    key tail_5.rotation { 0.0: [0, 0, 0], 0.45: [0, -24, 0], 1.04: [4, 34, 0], 1.40: [0, 12, 0], 1.8: [0, 0, 0], catmullrom }
