    // 7-segment whip tail trails steeply downward and lashes during aerial hover!
    key tail_1.rotation { 0.0: [0, 0, 0], 0.92: [-22, 14, 0], 1.48: [-24, 24, 0], 2.08: [-24, -24, 0], 3.0: [0, 0, 0], catmullrom }
