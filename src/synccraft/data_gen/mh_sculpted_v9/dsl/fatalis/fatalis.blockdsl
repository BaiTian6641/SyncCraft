    key neck_1.rotation { 0.0: [0, 0, 0], 0.55: [-22, 0, 0], 1.10: [28, -28, 0], 1.95: [28, 28, 0], 2.6: [0, 0, 0], catmullrom }
    key neck_3.rotation { 0.0: [0, 0, 0], 0.55: [-16, 0, 0], 1.10: [22, -20, 0], 1.95: [22, 20, 0], 2.6: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.55: [-20, 0, 0], 1.10: [26, -16, -8], 1.95: [26, 16, 8], 2.6: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.55: [-4, 0, 0], 1.00: [44, 0, 0], 2.00: [44, 0, 0], 2.6: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 0.55: [0, -18, 20], 1.10: [0, 16, 12], 1.95: [0, 16, 12], 2.6: [0, 0, 0], catmullrom }
    key wing_mount_r__wing_arm_l.rotation { 0.0: [0, 0, 0], 0.55: [0, -18, 20], 1.10: [0, 16, 12], 1.95: [0, 16, 12], 2.6: [0, 0, 0], catmullrom }
  }

  // 7. Towering Upright Rear into Crushing Quadruped Belly Slam!
  clip crawling_belly_crush_slam {
    duration_s: 2.0, loop: false
    key root.position { 0.0: [0, 0, 0], 0.65: [0, 6.0, -4.0], 1.12: [0, -5.5, 8.0], 1.45: [0, -4.5, 7.5], 2.0: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.65: [-26, 0, 0], 1.12: [24, 0, 0], 1.45: [20, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key waist.rotation { 0.0: [0, 0, 0], 0.65: [-18, 0, 0], 1.12: [20, 0, 0], 1.45: [16, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.65: [-22, 0, 0], 1.12: [26, 0, 0], 1.45: [22, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.65: [-18, 0, 0], 1.12: [30, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key neck_4.rotation { 0.0: [0, 0, 0], 0.65: [-14, 0, 0], 1.12: [-24, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.65: [36, 0, 0], 1.12: [14, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.65: [-54, 0, 32], 1.12: [28, 0, 24], 2.0: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.65: [-54, 0, 32], 1.12: [28, 0, 24], 2.0: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 0.65: [0, -22, 26], 1.12: [0, 18, -28], 2.0: [0, 0, 0], catmullrom }
    key wing_mount_r__wing_arm_l.rotation { 0.0: [0, 0, 0], 0.65: [0, -22, 26], 1.12: [0, 18, -28], 2.0: [0, 0, 0], catmullrom }
  }

  // 8. Colossal 180-Degree 7-Bone Serpentine Whip-Tail Arena Cleave!
  clip sweeping_whip_tail_cleave {
    duration_s: 1.8, loop: false
    key root.position { 0.0: [0, 0, 0], 0.45: [-3.0, -1.0, -2.0], 0.98: [4.0, 1.5, 3.0], 1.8: [0, 0, 0], catmullrom }
