                  plane wing_bay_4_plane place(base_box=wing_spar_4, anchor=[0.05, -0.96, 0.05], align=[0, 0.88, 0]) {
                    size: [22.0, 13.0], normal: z, material: bronze_wing, rotate: [0, 0, -8],
                    edge: scallop(bays=2, depth=5, side=bottom, seed=43), layer: 2,
                    blend_with: [wing_wrist_hub, wing_radius, wing_humerus, wing_spar_3, wing_patagium_plane, wing_forearm_bay_plane]
                  }
                }
              }
            }
          }

          // Long muscular dragon forelimbs reaching down from reared chest to Y = 0
          bone fore_shoulder_l attach(parent_box=chest_core, anchor=[0.96, -0.35, 0.18], align=[-0.55, 0.85, 0], seat=0.12) mirror_x(fore_shoulder_r) {
            rest_euler: [62, 6, 22]
            box fore_bicep { size: [6.5, 13.5, 7.0], material: obsidian_scale, blend_with: [waist_core, wing_root_mass] }
            box fore_pauldron place(base_box=fore_bicep, anchor=[0.98, 0.35, 0.05], align=[-0.50, 0, 0]) {
              size: [2.5, 6.5, 6.0], material: slate_armor, rotate: [-8, 8, -12], blend_with: [chest_core, wing_root_mass]
            }
            box fore_elbow_spur place(base_box=fore_bicep, anchor=[0.15, -0.82, -0.96], align=[0, 0, 0.70]) {
              size: [3.0, 3.0, 4.5], material: bone_ivory, rotate: [20, 0, 0], blend_with: [fore_bracer]
            }

            bone fore_arm_l attach(parent_box=fore_bicep, anchor=[0.08, -1, -0.05], align=[0, 0.88, 0], seat=0.16) {
              rest_euler: [-34, 0, -14]
              box fore_bracer { size: [5.5, 13.5, 6.0], material: obsidian_scale, blend_with: [chest_core] }
              box fore_bracer_guard place(base_box=fore_bracer, anchor=[0.85, 0.05, 0.65], align=[-0.55, 0, -0.55]) {
