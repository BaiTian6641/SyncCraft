            size: [5.0, 1.5, 10.0], material: belly_bronze, blend_with: [tail_1_scute, tail_1_seg]
          }
          box tail_2_spine place(base_box=tail_2_seg, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
            size: [1.5, 3.5, 4.0], material: bone_ivory, rotate: [24, 0, 0], blend_with: [tail_1_seg]
          }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.20) {
            rest_euler: [10, 0, 0]
            box tail_3_seg { size: [6.5, 5.5, 11.5], material: obsidian_scale }
            box tail_3_scute place(base_box=tail_3_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
              size: [4.5, 1.0, 9.5], material: belly_bronze, blend_with: [tail_2_scute, tail_2_seg]
            }
            box tail_3_spine place(base_box=tail_3_seg, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
              size: [1.5, 3.5, 3.5], material: bone_ivory, rotate: [24, 0, 0], blend_with: [tail_2_seg]
            }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.20) {
              rest_euler: [4, 0, 0]
              box tail_4_seg { size: [5.5, 5.0, 11.0], material: obsidian_scale }
              box tail_4_spine place(base_box=tail_4_seg, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
                size: [1.5, 3.0, 3.5], material: bone_ivory, rotate: [24, 0, 0], blend_with: [tail_3_seg]
              }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.20) {
                rest_euler: [4, 0, 0]
                box tail_5_seg { size: [4.5, 4.0, 10.5], material: obsidian_scale }
                box tail_5_spine place(base_box=tail_5_seg, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
                  size: [1.0, 3.0, 3.5], material: bone_ivory, rotate: [26, 0, 0], blend_with: [tail_4_seg]
                }

                bone tail_6 attach(parent_box=tail_5_seg, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.18) {
                  rest_euler: [8, 0, 0]
                  box tail_6_seg { size: [3.5, 3.5, 10.0], material: slate_armor }
                  box tail_6_spine place(base_box=tail_6_seg, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
                    size: [1.0, 2.5, 3.0], material: bone_ivory, rotate: [26, 0, 0], blend_with: [tail_5_seg]
                  }

                  bone tail_7 attach(parent_box=tail_6_seg, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.18) {
                    rest_euler: [12, 0, 0]
                    box tail_7_seg { size: [2.5, 2.5, 9.5], material: slate_armor }
                    box tail_whip_barb place(base_box=tail_7_seg, anchor=[0, 0.25, -0.96], align=[0, 0, 0.75]) {
                      size: [2.0, 2.5, 6.5], material: bone_ivory, rotate: [12, 0, 0]
