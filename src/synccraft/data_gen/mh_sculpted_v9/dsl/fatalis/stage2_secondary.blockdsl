              }

              bone fore_hand_l attach(parent_box=fore_bracer, anchor=[0, -1, 0.15], align=[0, 0.88, -0.45], seat=0.14) {
                rest_euler: [18, 0, -8]
                box fore_hand_pad { size: [7.0, 3.0, 7.0], material: deep_charcoal }
                box f_toe_1 place(base_box=fore_hand_pad, anchor=[-0.68, -0.10, 0.94], align=[0, 0, -0.78]) {
                  size: [1.5, 2.0, 4.5], material: slate_armor, rotate: [2, 16, 0]
                }
                box f_toe_2 place(base_box=fore_hand_pad, anchor=[-0.22, -0.10, 0.98], align=[0, 0, -0.80]) {
                  size: [1.5, 2.0, 5.0], material: slate_armor, rotate: [2, 5, 0], blend_with: [f_toe_1]
                }
                box f_toe_3 place(base_box=fore_hand_pad, anchor=[0.24, -0.10, 0.98], align=[0, 0, -0.80]) {
                  size: [1.5, 2.0, 5.0], material: slate_armor, rotate: [2, -6, 0], blend_with: [f_toe_2]
                }
                box f_toe_4 place(base_box=fore_hand_pad, anchor=[0.70, -0.10, 0.92], align=[0, 0, -0.78]) {
                  size: [1.5, 2.0, 4.5], material: slate_armor, rotate: [2, -18, 0], blend_with: [f_toe_3]
                }
              }
            }
          }
        }
      }

      // Coiled powerful dragon hindlimbs planted wide on Y = 0
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.96, -0.12, -0.05], align=[-0.55, 0.85, 0], seat=0.14) mirror_x(hind_thigh_r) {
        rest_euler: [-10, -6, 20]
        box thigh_mass { size: [6.5, 11.5, 8.0], material: obsidian_scale, blend_with: [waist_core, tail_1_seg] }
        box thigh_armor place(base_box=thigh_mass, anchor=[0.98, 0.22, 0.08], align=[-0.48, 0, 0]) {
          size: [2.5, 6.5, 6.0], material: slate_armor, rotate: [6, -8, -10], blend_with: [pelvis_core, haunch_muscle_l]
