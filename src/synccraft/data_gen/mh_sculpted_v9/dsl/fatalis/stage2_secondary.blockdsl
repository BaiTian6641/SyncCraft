            }
          }
        }
      }

      // Extra-long 7-bone articulated serpentine whip tail (`tail_1..tail_7`) lined with bone spines!
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, -0.05, -1], align=[0, 0, 1], seat=0.20) {
