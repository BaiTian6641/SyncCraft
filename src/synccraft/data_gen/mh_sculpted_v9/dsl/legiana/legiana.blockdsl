// Legiana (Apex Glider of Coral Highlands) — Stage 3 Sculpted Blockbench Masterwork
// Hand-authored progressive Block-DSL v4.1 modeled from official Coral Highlands anatomy:
// Biped bird-of-prey digitigrade stance on Y=0 (zero walking forelegs), ultra-narrow
// viper-wedge skull (snout_taper_ratio < 0.38), twin articulated pleated cream-gold
// antennae head-vanes, 3-bone swan S-neck, chest cryo-air-sac vents, 14-wing-bone
// leaf-lobed split kite-wings + secondary patagia, & 3-lobed swallowtail stabilizer fan.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 460
  budget max_bones = 110
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  cobalt_hide: ramp(base_lch=[0.34, 0.122, 258], steps=6, hue_shift=[22, -14])
  navy_carapace: ramp(base_lch=[0.23, 0.098, 266], steps=6, hue_shift=[20, -12])
  cerulean_plate: ramp(base_lch=[0.42, 0.118, 248], steps=6, hue_shift=[22, -14])
  kite_cream: ramp(base_lch=[0.85, 0.068, 86], steps=6, hue_shift=[20, -12])
  ochre_pleat: ramp(base_lch=[0.74, 0.106, 80], steps=6, hue_shift=[18, -12])
  cream_belly: ramp(base_lch=[0.82, 0.052, 84], steps=6, hue_shift=[18, -10])
  slate_fan: ramp(base_lch=[0.31, 0.092, 244], steps=6, hue_shift=[20, -14])
  ivory_claw: ramp(base_lch=[0.89, 0.040, 88], steps=6, hue_shift=[16, -10])
  mouth_crimson: ramp(base_lch=[0.37, 0.122, 20], steps=6, hue_shift=[16, -10])
  amber_eye: ramp(base_lch=[0.84, 0.172, 84], steps=6, hue_shift=[12, -14], emissive=true)
  cryo_cyan: ramp(base_lch=[0.87, 0.152, 210], steps=6, hue_shift=[14, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 19.02, -5.0]) {
      rest_euler: [-14, 0, 0]
      box pelvis_core { size: [8.5, 8.0, 9.5], material: cobalt_hide }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
        size: [6.0, 1.5, 8.0], material: cream_belly
      }
      box sacrum_ridge place(base_box=pelvis_core, anchor=[0, 0.96, -0.05], align=[0, -0.55, 0]) {
        size: [5.0, 2.0, 8.0], material: cerulean_plate, rotate: [6, 0, 0], blend_with: [lumbar_ridge, tail_1_seg, tail_1_ridge]
      }
      box sacrum_spine_1 place(base_box=sacrum_ridge, anchor=[0, 0.96, 0.30], align=[0, -0.78, 0]) {
        size: [1.5, 2.0, 3.0], material: navy_carapace, rotate: [18, 0, 0], blend_with: [pelvis_core, lumbar_ridge]
      }
      box sacrum_spine_2 place(base_box=sacrum_ridge, anchor=[0, 0.96, -0.35], align=[0, -0.78, 0]) {
        size: [1.5, 2.0, 3.0], material: navy_carapace, rotate: [20, 0, 0], blend_with: [pelvis_core, tail_1_ridge]
      }
      box haunch_plate_l place(base_box=pelvis_core, anchor=[0.96, 0.20, 0.0], align=[-0.52, 0, 0]) {
        size: [2.5, 5.5, 7.0], material: cerulean_plate, rotate: [4, 6, -12], blend_with: [thigh_mass, waist_core]
      }
      box haunch_plate_r place(base_box=pelvis_core, anchor=[-0.96, 0.20, 0.0], align=[0.52, 0, 0]) {
        size: [2.5, 5.5, 7.0], material: cerulean_plate, rotate: [4, -6, 12], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }
      // Aerodynamic pelvic stabilizer winglets at hip-to-tail transition (seen in dorsal glide view!)
      box hip_winglet_l place(base_box=haunch_plate_l, anchor=[0.92, 0.42, -0.38], align=[-0.68, 0, 0.45]) {
        size: [2.0, 1.5, 5.5], material: ochre_pleat, rotate: [12, 26, -10], blend_with: [pelvis_core, thigh_mass, thigh_armor, tail_1_seg]
      }
      box hip_winglet_r place(base_box=haunch_plate_r, anchor=[-0.92, 0.42, -0.38], align=[0.68, 0, 0.45]) {
        size: [2.0, 1.5, 5.5], material: ochre_pleat, rotate: [12, -26, 10], blend_with: [pelvis_core, hind_thigh_r__thigh_mass, hind_thigh_r__thigh_armor, tail_1_seg]
      }
      plane hip_vane_plane_l place(base_box=hip_winglet_l, anchor=[0.88, 0.10, -0.25], align=[-0.82, 0, 0.35]) {
        size: [4.5, 5.5], normal: y, material: kite_cream, rotate: [8, 22, -8],
        edge: scallop(bays=2, depth=3, side=right), layer: 1,
        blend_with: [haunch_plate_l, thigh_mass, thigh_armor, tail_1_seg]
      }
      plane hip_vane_plane_r place(base_box=hip_winglet_r, anchor=[-0.88, 0.10, -0.25], align=[0.82, 0, 0.35]) {
        size: [4.5, 5.5], normal: y, material: kite_cream, rotate: [8, -22, 8],
        edge: scallop(bays=2, depth=3, side=left), layer: 1,
        blend_with: [haunch_plate_r, hind_thigh_r__thigh_mass, hind_thigh_r__thigh_armor, tail_1_seg]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.15, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-10, 0, 0]
        box waist_core { size: [7.5, 7.5, 9.5], material: cobalt_hide }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
          size: [5.5, 1.5, 8.0], material: cream_belly, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_ridge place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
          size: [4.5, 2.0, 8.0], material: cerulean_plate, rotate: [-4, 0, 0], blend_with: [pelvis_core, chest_core, withers_keel]
        }
        box lumbar_spine_1 place(base_box=lumbar_ridge, anchor=[0, 0.96, 0.28], align=[0, -0.78, 0]) {
          size: [1.5, 2.5, 3.0], material: navy_carapace, rotate: [18, 0, 0], blend_with: [waist_core, chest_core, withers_keel]
        }
        box lumbar_spine_2 place(base_box=lumbar_ridge, anchor=[0, 0.96, -0.32], align=[0, -0.78, 0]) {
          size: [1.5, 2.0, 3.0], material: navy_carapace, rotate: [20, 0, 0], blend_with: [waist_core, pelvis_core, sacrum_ridge, sacrum_spine_1]
        }
        box waist_shingle_l place(base_box=waist_core, anchor=[0.96, 0.25, 0.15], align=[-0.68, 0, 0]) {
          size: [1.5, 4.0, 5.0], material: cerulean_plate, rotate: [6, 10, -12], blend_with: [chest_core, pelvis_core, haunch_plate_l]
        }
        box waist_shingle_r place(base_box=waist_core, anchor=[-0.96, 0.25, 0.15], align=[0.68, 0, 0]) {
          size: [1.5, 4.0, 5.0], material: cerulean_plate, rotate: [6, -10, 12], blend_with: [chest_core, pelvis_core, haunch_plate_r]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.18, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [8, 0, 0]
          box chest_core { size: [13.5, 12.5, 13.5], material: cobalt_hide }
          box withers_keel place(base_box=chest_core, anchor=[0, 0.96, 0.10], align=[0, -0.55, 0]) {
            size: [7.5, 3.0, 11.0], material: cerulean_plate, rotate: [-8, 0, 0], blend_with: [neck_base, neck_crest_1, lumbar_ridge]
          }
          box withers_spine_1 place(base_box=withers_keel, anchor=[0, 0.96, 0.25], align=[0, -0.78, 0]) {
            size: [2.0, 3.0, 4.0], material: navy_carapace, rotate: [20, 0, 0], blend_with: [chest_core, neck_base, neck_crest_1]
          }
          box withers_spine_2 place(base_box=withers_keel, anchor=[0, 0.96, -0.35], align=[0, -0.78, 0]) {
            size: [2.0, 2.5, 4.0], material: navy_carapace, rotate: [22, 0, 0], blend_with: [chest_core, waist_core, lumbar_ridge, lumbar_spine_1]
          }
          plane withers_sail_fin place(base_box=withers_keel, anchor=[0, 0.94, -0.05], align=[0, -0.88, 0]) {
            size: [3.5, 9.0], normal: x, material: kite_cream, rotate: [8, 0, 0],
            edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=19), layer: 1,
            blend_with: [withers_spine_1, withers_spine_2, neck_crest_1, lumbar_ridge]
          }
          box shoulder_mount_l place(base_box=chest_core, anchor=[0.95, 0.26, 0.24], align=[-0.68, 0, 0]) {
            size: [2.5, 5.0, 7.5], material: cerulean_plate, rotate: [-4, 8, -14], blend_with: [withers_keel, wing_humerus]
          }
          box shoulder_mount_r place(base_box=chest_core, anchor=[-0.95, 0.26, 0.24], align=[0.68, 0, 0]) {
            size: [2.5, 5.0, 7.5], material: cerulean_plate, rotate: [-4, -8, 14], blend_with: [withers_keel, wing_arm_r__wing_humerus]
          }
          box rib_shingle_l_1 place(base_box=chest_core, anchor=[0.98, -0.10, 0.10], align=[-0.72, 0, 0]) {
            size: [2.0, 4.5, 5.5], material: cerulean_plate, rotate: [6, 12, -10], blend_with: [shoulder_mount_l, wing_humerus]
          }
          box rib_shingle_r_1 place(base_box=chest_core, anchor=[-0.98, -0.10, 0.10], align=[0.72, 0, 0]) {
            size: [2.0, 4.5, 5.5], material: cerulean_plate, rotate: [6, -12, 10], blend_with: [shoulder_mount_r, wing_arm_r__wing_humerus]
          }
          box rib_shingle_l_2 place(base_box=chest_core, anchor=[0.96, -0.24, -0.38], align=[-0.72, 0, 0]) {
            size: [2.0, 4.0, 5.0], material: navy_carapace, rotate: [8, 14, -8], blend_with: [rib_shingle_l_1, waist_core, waist_shingle_l]
          }
          box rib_shingle_r_2 place(base_box=chest_core, anchor=[-0.96, -0.24, -0.38], align=[0.72, 0, 0]) {
            size: [2.0, 4.0, 5.0], material: navy_carapace, rotate: [8, -14, 8], blend_with: [rib_shingle_r_1, waist_core, waist_shingle_r]
          }
          // Glowing Coral Highlands frost-emitting chest vents!
          box cryo_vent_l_1 place(base_box=rib_shingle_l_1, anchor=[0.94, -0.10, 0.10], align=[-0.78, 0, 0]) {
            size: [1.0, 1.5, 3.5], material: cryo_cyan, rotate: [6, 12, -10], blend_with: [chest_core]
          }
          box cryo_vent_r_1 place(base_box=rib_shingle_r_1, anchor=[-0.94, -0.10, 0.10], align=[0.78, 0, 0]) {
            size: [1.0, 1.5, 3.5], material: cryo_cyan, rotate: [6, -12, 10], blend_with: [chest_core]
          }
          box cryo_vent_l_2 place(base_box=rib_shingle_l_2, anchor=[0.94, -0.10, 0.0], align=[-0.78, 0, 0]) {
            size: [1.0, 1.5, 3.0], material: cryo_cyan, rotate: [8, 14, -8], blend_with: [chest_core]
          }
          box cryo_vent_r_2 place(base_box=rib_shingle_r_2, anchor=[-0.94, -0.10, 0.0], align=[0.78, 0, 0]) {
            size: [1.0, 1.5, 3.0], material: cryo_cyan, rotate: [8, -14, 8], blend_with: [chest_core]
          }

          // Hugged ventral freezer-sac chest plates (sy <= sx, zero protruding planks!)
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.32], align=[0, 0.42, 0]) {
            size: [9.5, 2.0, 7.0], material: cream_belly, rotate: [4, 0, 0], blend_with: [waist_belly, waist_core]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.96, 0.48], align=[0, 0.48, -0.20]) {
            size: [8.5, 2.5, 7.5], material: cream_belly, rotate: [-18, 0, 0], blend_with: [chest_scute_rear, neck_throat_1]
          }
          box freezer_sac_keel place(base_box=chest_scute_front, anchor=[0, -0.92, 0.15], align=[0, 0.68, 0]) {
            size: [4.5, 2.0, 6.0], material: kite_cream, rotate: [-12, 0, 0], blend_with: [chest_core, chest_scute_rear]
          }
          box sternum_cryo_core place(base_box=freezer_sac_keel, anchor=[0, -0.90, 0.10], align=[0, 0.80, 0]) {
            size: [2.0, 1.0, 4.0], material: cryo_cyan, rotate: [-12, 0, 0], blend_with: [chest_scute_front]
          }
          plane chest_pleat_fin_l place(base_box=chest_core, anchor=[0.65, -0.78, 0.88], align=[0, 0.72, -0.82]) {
            size: [4.5, 4.0], normal: z, material: kite_cream, rotate: [-22, -18, -12],
            edge: scallop(bays=2, depth=3, side=bottom), layer: 1,
            blend_with: [chest_scute_front, freezer_sac_keel, neck_base, neck_throat_1]
          }
          plane chest_pleat_fin_r place(base_box=chest_core, anchor=[-0.65, -0.78, 0.88], align=[0, 0.72, -0.82]) {
            size: [4.5, 4.0], normal: z, material: kite_cream, rotate: [-22, 18, 12],
            edge: scallop(bays=2, depth=3, side=bottom), layer: 1,
            blend_with: [chest_scute_front, freezer_sac_keel, neck_base, neck_throat_1]
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.36, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-28, 0, 0]
            box neck_base { size: [8.0, 8.0, 8.5], material: cobalt_hide }
            box neck_throat_1 place(base_box=neck_base, anchor=[0, -0.96, 0.05], align=[0, 0.48, 0]) {
              size: [5.5, 1.5, 7.0], material: cream_belly, rotate: [-4, 0, 0], blend_with: [chest_core, chest_scute_front]
            }
            box neck_crest_1 place(base_box=neck_base, anchor=[0, 0.96, -0.05], align=[0, -0.58, 0]) {
              size: [3.5, 2.5, 7.0], material: cerulean_plate, rotate: [10, 0, 0], blend_with: [chest_core, withers_keel, neck_mid, neck_crest_2]
            }
            box neck_spine_1 place(base_box=neck_crest_1, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
              size: [1.5, 2.5, 3.5], material: navy_carapace, rotate: [22, 0, 0], blend_with: [neck_base, withers_keel, withers_spine_1]
            }
            box neck_1_gill_l place(base_box=neck_base, anchor=[0.96, 0.12, 0.05], align=[-0.68, 0, 0]) {
              size: [1.5, 3.5, 6.0], material: ochre_pleat, rotate: [6, 14, -12], blend_with: [chest_core, shoulder_mount_l, neck_mid]
            }
            box neck_1_gill_r place(base_box=neck_base, anchor=[-0.96, 0.12, 0.05], align=[0.68, 0, 0]) {
              size: [1.5, 3.5, 6.0], material: ochre_pleat, rotate: [6, -14, 12], blend_with: [chest_core, shoulder_mount_r, neck_mid]
            }
            plane neck_1_fin_plane place(base_box=neck_crest_1, anchor=[0, 0.94, 0.0], align=[0, -0.88, 0]) {
              size: [3.5, 6.5], normal: x, material: kite_cream, rotate: [10, 0, 0],
              edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=31), layer: 2,
              blend_with: [neck_spine_1, withers_keel, withers_sail_fin, neck_crest_2]
            }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.10, 1], align=[0, 0, -1], seat=0.26) {
              rest_euler: [14, 0, 0]
              box neck_mid { size: [6.5, 6.5, 8.0], material: cobalt_hide }
              box neck_throat_2 place(base_box=neck_mid, anchor=[0, -0.96, 0.05], align=[0, 0.48, 0]) {
                size: [4.5, 1.5, 6.5], material: cream_belly, blend_with: [neck_base, neck_throat_1]
              }
              box neck_crest_2 place(base_box=neck_mid, anchor=[0, 0.96, -0.05], align=[0, -0.58, 0]) {
                size: [3.0, 2.0, 6.5], material: cerulean_plate, rotate: [10, 0, 0], blend_with: [neck_base, neck_upper, neck_crest_3]
              }
              box neck_spine_2 place(base_box=neck_crest_2, anchor=[0, 0.96, -0.10], align=[0, -0.78, 0]) {
                size: [1.5, 2.0, 3.0], material: navy_carapace, rotate: [20, 0, 0], blend_with: [neck_mid, neck_crest_1]
              }
              box neck_2_gill_l place(base_box=neck_mid, anchor=[0.96, 0.10, 0.05], align=[-0.68, 0, 0]) {
                size: [1.5, 3.0, 5.5], material: ochre_pleat, rotate: [6, 12, -12], blend_with: [neck_base, neck_1_gill_l, neck_upper]
              }
              box neck_2_gill_r place(base_box=neck_mid, anchor=[-0.96, 0.10, 0.05], align=[0.68, 0, 0]) {
                size: [1.5, 3.0, 5.5], material: ochre_pleat, rotate: [6, -12, 12], blend_with: [neck_base, neck_1_gill_r, neck_upper]
              }
              plane neck_2_fin_plane place(base_box=neck_crest_2, anchor=[0, 0.94, 0.0], align=[0, -0.88, 0]) {
                size: [3.0, 6.0], normal: x, material: kite_cream, rotate: [10, 0, 0],
                edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=37), layer: 1,
                blend_with: [neck_spine_2, neck_crest_1, neck_1_fin_plane, neck_crest_3]
              }

              bone neck_3 attach(parent_box=neck_mid, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.26) {
                rest_euler: [24, 0, 0]
                box neck_upper { size: [5.5, 5.5, 7.0], material: cobalt_hide }
                box neck_throat_3 place(base_box=neck_upper, anchor=[0, -0.96, 0.05], align=[0, 0.48, 0]) {
                  size: [3.5, 1.5, 5.5], material: cream_belly, blend_with: [neck_mid, neck_throat_2, jaw_core]
                }
                box neck_crest_3 place(base_box=neck_upper, anchor=[0, 0.96, -0.05], align=[0, -0.58, 0]) {
                  size: [2.5, 2.0, 5.5], material: cerulean_plate, rotate: [12, 0, 0], blend_with: [neck_mid, skull_core, skull_crown]
                }
                box neck_3_gill_l place(base_box=neck_upper, anchor=[0.96, 0.12, 0.05], align=[-0.68, 0, 0]) {
                  size: [1.5, 2.5, 4.5], material: ochre_pleat, rotate: [6, 12, -12], blend_with: [neck_mid, neck_2_gill_l, skull_core, cheek_jowl_l]
                }
                box neck_3_gill_r place(base_box=neck_upper, anchor=[-0.96, 0.12, 0.05], align=[0.68, 0, 0]) {
                  size: [1.5, 2.5, 4.5], material: ochre_pleat, rotate: [6, -12, 12], blend_with: [neck_mid, neck_2_gill_r, skull_core, cheek_jowl_r]
                }
                plane neck_3_fin_plane place(base_box=neck_crest_3, anchor=[0, 0.94, 0.0], align=[0, -0.88, 0]) {
                  size: [3.0, 5.0], normal: x, material: kite_cream, rotate: [12, 0, 0],
                  edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=41), layer: 2,
                  blend_with: [neck_crest_2, neck_2_fin_plane, skull_core, skull_crown, nape_crest_c]
                }

                bone head attach(parent_box=neck_upper, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                  rest_euler: [18, 0, 0]
                  box skull_core { size: [7.5, 5.0, 6.5], material: cobalt_hide }
                  box skull_crown place(base_box=skull_core, anchor=[0, 0.98, -0.10], align=[0, -0.65, 0]) {
                    size: [4.5, 1.5, 5.5], material: cerulean_plate, rotate: [6, 0, 0], blend_with: [neck_upper, brow_ridge_l, brow_ridge_r]
                  }
                  // Three fanned skull-to-neck nape crest shingles (`SKILL.md` joint connection rule!)
                  box nape_crest_c place(base_box=skull_crown, anchor=[0, 0.85, -0.92], align=[0, -0.65, 0.65]) {
                    size: [2.5, 1.5, 4.0], material: navy_carapace, rotate: [14, 0, 0], blend_with: [skull_core, neck_upper, neck_crest_3]
                  }
                  box nape_frill_l place(base_box=skull_core, anchor=[0.65, 0.88, -0.92], align=[-0.35, -0.65, 0.68]) {
                    size: [2.0, 1.5, 4.0], material: cerulean_plate, rotate: [12, -22, 10], blend_with: [skull_crown, nape_crest_c, neck_upper, neck_crest_3, vane_rib_1]
                  }
                  box nape_frill_r place(base_box=skull_core, anchor=[-0.65, 0.88, -0.92], align=[0.35, -0.65, 0.68]) {
                    size: [2.0, 1.5, 4.0], material: cerulean_plate, rotate: [12, 22, -10], blend_with: [skull_crown, nape_crest_c, neck_upper, neck_crest_3, head_vane_r__vane_rib_1]
                  }
                  box brow_ridge_l place(base_box=skull_core, anchor=[0.84, 0.78, 0.48], align=[-0.15, -0.52, -0.25]) {
                    size: [2.0, 1.5, 5.0], material: navy_carapace, rotate: [10, -14, -14], blend_with: [skull_crown, snout_core, nasal_bridge]
                  }
                  box brow_ridge_r place(base_box=skull_core, anchor=[-0.84, 0.78, 0.48], align=[0.15, -0.52, -0.25]) {
