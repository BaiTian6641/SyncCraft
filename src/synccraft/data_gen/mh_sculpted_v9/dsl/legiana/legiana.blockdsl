    key neck_1.rotation { 0.0: [0, 0, 0], 1.05: [20, 0, 0], 1.48: [-22, 0, 0], 2.2: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 1.05: [36, 0, 0], 1.48: [40, 0, 0], 2.2: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 0.55: [-12, -24, 34], 1.05: [16, 44, -16], 1.48: [-10, -28, 28], 2.2: [0, 0, 0], catmullrom }
    key wing_arm_r.rotation { 0.0: [0, 0, 0], 0.55: [-12, -24, 34], 1.05: [16, 44, -16], 1.48: [-10, -28, 28], 2.2: [0, 0, 0], catmullrom }
  }
}
@controller {
  initial: idle
  idle -> walk when speed > 0.15, blend 0.20
  walk -> run when speed > 0.55, blend 0.18
  run -> walk when speed <= 0.45, blend 0.22
  walk -> idle when speed <= 0.08, blend 0.25
  idle -> roar when enraged > 0.5, blend 0.15
  roar -> idle when enraged <= 0.5, blend 0.25
}
