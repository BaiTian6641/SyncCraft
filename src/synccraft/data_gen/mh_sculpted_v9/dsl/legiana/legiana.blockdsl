                }
                box digit_4_tip place(base_box=digit_4_spar, anchor=[0.98, 0, 0], align=[-0.86, 0, 0]) {
                  size: [6.5, 1.5, 1.5], material: navy_carapace, rotate: [0, 5, -3]
                }
                box digit_4_thorn place(base_box=digit_4_tip, anchor=[0.98, 0, 0], align=[-0.88, 0, 0]) {
                  size: [2.5, 1.0, 1.0], material: ivory_claw
                }
                plane digit_4_lobe_plane place(base_box=digit_4_spar, anchor=[-0.42, -0.18, -0.92], align=[-0.88, 0, 0.90]) {
                  size: [17.5, 10.0], normal: y, material: ochre_pleat,
                  edge: scallop(bays=3, depth=5, side=top), layer: 1,
                  blend_with: [wing_radius, forearm_bay_plane, patagium_spar, patagium_sail_plane, digit_3_spar, digit_3_lobe_plane, digit_4_tip, digit_4_thorn]
                }
                plane digit_4_tip_trim place(base_box=digit_4_tip, anchor=[-0.25, 0.25, -0.92], align=[-0.85, 0, 0.88]) {
                  size: [7.5, 5.5], normal: y, material: slate_fan,
                  edge: ragged(depth=4, holes=1, side=top, seed=69), layer: 2,
                  blend_with: [digit_4_spar, digit_4_lobe_plane, digit_4_thorn, digit_3_lobe_plane, patagium_sail_plane]
                }
              }
            }
          }
        }
      }

      // Biped Bird-of-Prey Digitigrade Hindlimbs (Grounded cleanly on Y = 0.0!)
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.94, -0.10, 0.05], align=[-0.55, 0.85, 0], seat=0.14) mirror_x(hind_thigh_r) {
        rest_euler: [-14, -6, 16]
        box thigh_mass { size: [5.0, 10.5, 6.5], material: cobalt_hide, blend_with: [waist_core, tail_1_seg] }
        box thigh_armor place(base_box=thigh_mass, anchor=[0.96, 0.20, 0.05], align=[-0.52, 0, 0]) {
          size: [2.0, 6.0, 5.0], material: cerulean_plate, rotate: [6, -8, -10], blend_with: [pelvis_core, haunch_plate_l]
        }
        box thigh_shingle_2 place(base_box=thigh_armor, anchor=[0.92, -0.45, -0.15], align=[-0.72, 0, 0]) {
          size: [1.5, 3.5, 4.0], material: navy_carapace, rotate: [10, 14, -8], blend_with: [thigh_mass, knee_guard]
        }
        box knee_guard place(base_box=thigh_mass, anchor=[0.10, -0.82, 0.96], align=[0, 0, -0.72]) {
          size: [3.0, 3.0, 2.0], material: navy_carapace, rotate: [-14, 0, 0], blend_with: [shin_mass]
        }
        plane thigh_feather_vane place(base_box=thigh_mass, anchor=[0.35, -0.15, -0.98], align=[0, 0, 0.88]) {
          size: [6.5, 4.5], normal: x, material: kite_cream, rotate: [-10, 12, 0],
          edge: spikes(width=2, min_len=2, max_len=6, side=right, seed=71), layer: 1,
          blend_with: [thigh_armor, thigh_shingle_2, shin_mass, hock_spur]
        }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [54, 0, -10]
          box shin_mass { size: [3.5, 11.5, 4.0], material: navy_carapace }
          box shin_front_guard place(base_box=shin_mass, anchor=[0.10, 0.05, 0.96], align=[0, 0, -0.72]) {
            size: [2.5, 8.0, 1.5], material: cerulean_plate, rotate: [4, 0, 0], blend_with: [thigh_mass, knee_guard, foot_pad]
          }
          box hock_spur place(base_box=shin_mass, anchor=[0, 0.68, -0.94], align=[0, 0, 0.72]) {
            size: [2.0, 2.5, 3.5], material: ivory_claw, rotate: [20, 0, 0], blend_with: [thigh_mass]
          }
          plane shin_vane_fringe place(base_box=shin_mass, anchor=[0.25, -0.20, -0.96], align=[0, 0, 0.88]) {
            size: [6.0, 3.5], normal: x, material: kite_cream, rotate: [8, 10, 0],
            edge: spikes(width=2, min_len=2, max_len=5, side=right, seed=79), layer: 2,
            blend_with: [hock_spur, foot_pad, hallux_claw]
          }

          bone hind_foot_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.42], seat=0.14) {
            rest_euler: [-26, 0, -6]
            box foot_pad { size: [5.0, 2.5, 6.0], material: navy_carapace }
            box foot_knuckle_guard place(base_box=foot_pad, anchor=[0, 0.96, 0.55], align=[0, -0.80, 0]) {
              size: [4.0, 1.0, 3.0], material: ochre_pleat, rotate: [10, 0, 0], blend_with: [shin_mass, shin_front_guard, h_toe_1, h_toe_2, h_toe_3]
            }
            box h_toe_1 place(base_box=foot_pad, anchor=[-0.64, -0.12, 0.94], align=[0, 0, -0.78]) {
              size: [1.5, 2.0, 3.5], material: cerulean_plate, rotate: [0, 16, 0]
            }
            box h_claw_1 place(base_box=h_toe_1, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.0, 1.5, 3.0], material: ivory_claw, rotate: [4, 4, 0]
            }
            box h_toe_2 place(base_box=foot_pad, anchor=[0.0, -0.12, 0.96], align=[0, 0, -0.80]) {
              size: [1.5, 2.0, 4.0], material: cerulean_plate, blend_with: [h_toe_1]
            }
            box h_claw_2 place(base_box=h_toe_2, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.0, 1.5, 3.5], material: ivory_claw, rotate: [4, 0, 0], blend_with: [h_claw_1]
            }
            box h_toe_3 place(base_box=foot_pad, anchor=[0.64, -0.12, 0.94], align=[0, 0, -0.78]) {
              size: [1.5, 2.0, 3.5], material: cerulean_plate, rotate: [0, -16, 0], blend_with: [h_toe_2]
            }
            box h_claw_3 place(base_box=h_toe_3, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.0, 1.5, 3.0], material: ivory_claw, rotate: [4, -4, 0], blend_with: [h_claw_2]
            }
            box hallux_claw place(base_box=foot_pad, anchor=[0, 0.05, -0.96], align=[0, 0, 0.82]) {
              size: [1.5, 1.5, 3.0], material: ivory_claw, rotate: [-4, 0, 0], blend_with: [shin_mass]
            }
          }
        }
      }

      // Sleek Whip Tail & Retractable 3-Lobed Swallowtail Stabilizer Fan (`tail_1..tail_5`)
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.15, -1], align=[0, 0, 1], seat=0.24) {
        rest_euler: [-4, 0, 0]
        box tail_1_seg { size: [6.5, 6.0, 8.5], material: cobalt_hide }
        box tail_1_belly place(base_box=tail_1_seg, anchor=[0, -0.96, 0], align=[0, 0.48, 0]) {
          size: [4.5, 1.5, 7.5], material: cream_belly, blend_with: [pelvis_belly, pelvis_core]
        }
        box tail_1_ridge place(base_box=tail_1_seg, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
          size: [3.5, 2.0, 7.5], material: cerulean_plate, rotate: [8, 0, 0], blend_with: [pelvis_core, tail_2_seg, tail_2_ridge]
        }
        box tail_1_keel_l place(base_box=tail_1_seg, anchor=[0.96, 0.10, -0.10], align=[-0.68, 0, 0.35]) {
          size: [1.5, 2.0, 6.0], material: ochre_pleat, rotate: [6, 18, -10], blend_with: [pelvis_core, haunch_plate_l, tail_2_seg]
        }
        box tail_1_keel_r place(base_box=tail_1_seg, anchor=[-0.96, 0.10, -0.10], align=[0.68, 0, 0.35]) {
          size: [1.5, 2.0, 6.0], material: ochre_pleat, rotate: [6, -18, 10], blend_with: [pelvis_core, haunch_plate_r, tail_2_seg]
        }

        bone tail_2 attach(parent_box=tail_1_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
          rest_euler: [10, 0, 0]
          box tail_2_seg { size: [5.5, 5.0, 8.5], material: cobalt_hide }
          box tail_2_belly place(base_box=tail_2_seg, anchor=[0, -0.96, 0], align=[0, 0.48, 0]) {
            size: [3.5, 1.5, 7.5], material: cream_belly, blend_with: [tail_1_belly, tail_1_seg]
          }
          box tail_2_ridge place(base_box=tail_2_seg, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
            size: [3.0, 1.5, 7.5], material: cerulean_plate, rotate: [8, 0, 0], blend_with: [tail_1_seg, tail_3_seg, tail_3_ridge]
          }
          box tail_2_keel_l place(base_box=tail_2_seg, anchor=[0.96, 0.10, -0.10], align=[-0.78, 0, 0.35]) {
            size: [1.5, 1.5, 6.0], material: ochre_pleat, rotate: [6, 18, -10], blend_with: [tail_1_seg, tail_1_keel_l, tail_3_seg]
          }
          box tail_2_keel_r place(base_box=tail_2_seg, anchor=[-0.96, 0.10, -0.10], align=[0.78, 0, 0.35]) {
            size: [1.5, 1.5, 6.0], material: ochre_pleat, rotate: [6, -18, 10], blend_with: [tail_1_seg, tail_1_keel_r, tail_3_seg]
          }
          plane tail_2_fin_plane place(base_box=tail_2_ridge, anchor=[0, 0.94, 0], align=[0, -0.88, 0]) {
            size: [3.0, 6.5], normal: x, material: kite_cream, rotate: [8, 0, 0],
            edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=89), layer: 1,
            blend_with: [tail_1_ridge, tail_3_ridge]
          }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
            rest_euler: [14, 0, 0]
            box tail_3_seg { size: [4.5, 4.0, 8.5], material: cobalt_hide }
            box tail_3_belly place(base_box=tail_3_seg, anchor=[0, -0.96, 0], align=[0, 0.52, 0]) {
              size: [3.0, 1.0, 7.0], material: cream_belly, blend_with: [tail_2_belly, tail_2_seg]
            }
            box tail_3_ridge place(base_box=tail_3_seg, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
              size: [2.5, 1.5, 7.5], material: cerulean_plate, rotate: [8, 0, 0], blend_with: [tail_2_seg, tail_4_seg, tail_4_ridge]
            }
            box tail_3_keel_l place(base_box=tail_3_seg, anchor=[0.96, 0.10, -0.10], align=[-0.68, 0, 0.35]) {
              size: [1.5, 1.5, 5.5], material: ochre_pleat, rotate: [6, 18, -10], blend_with: [tail_2_seg, tail_4_seg]
            }
            box tail_3_keel_r place(base_box=tail_3_seg, anchor=[-0.96, 0.10, -0.10], align=[0.68, 0, 0.35]) {
              size: [1.5, 1.5, 5.5], material: ochre_pleat, rotate: [6, -18, 10], blend_with: [tail_2_seg, tail_4_seg]
            }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
              rest_euler: [16, 0, 0]
              box tail_4_seg { size: [3.5, 3.5, 8.5], material: navy_carapace }
              box tail_4_ridge place(base_box=tail_4_seg, anchor=[0, 0.96, 0], align=[0, -0.60, 0]) {
                size: [2.0, 1.5, 7.5], material: cerulean_plate, rotate: [8, 0, 0], blend_with: [tail_3_seg, tail_5_seg, tail_5_ridge]
              }
              plane tail_4_fin_plane place(base_box=tail_4_ridge, anchor=[0, 0.94, 0], align=[0, -0.88, 0]) {
                size: [3.0, 6.5], normal: x, material: slate_fan, rotate: [8, 0, 0],
                edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=97), layer: 2,
                blend_with: [tail_3_ridge, tail_5_ridge]
              }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.22) {
                rest_euler: [12, 0, 0]
                box tail_5_seg { size: [3.0, 3.0, 8.0], material: navy_carapace }
                box tail_5_ridge place(base_box=tail_5_seg, anchor=[0, 0.96, 0.10], align=[0, -0.65, 0]) {
                  size: [1.5, 1.5, 6.5], material: ochre_pleat, rotate: [8, 0, 0], blend_with: [tail_4_seg, tail_fan_rib_c]
                }

                bone tail_fan_c attach(parent_box=tail_5_seg, anchor=[0, 0.10, -0.92], align=[0, 0, 0.88], seat=0.12) {
                  rest_euler: [6, 0, 0]
                  box tail_fan_rib_c { size: [2.5, 1.5, 14.5], material: navy_carapace }
                  box tail_fan_c_tip place(base_box=tail_fan_rib_c, anchor=[0, 0.05, -0.98], align=[0, 0, 0.86]) {
                    size: [1.5, 1.0, 5.0], material: ivory_claw
                  }
                  box tail_fan_c_cryo place(base_box=tail_fan_rib_c, anchor=[0, 0.94, 0.10], align=[0, -0.80, 0]) {
                    size: [1.0, 1.0, 9.5], material: cryo_cyan, blend_with: [tail_5_seg, tail_5_ridge]
                  }
                  plane tail_fan_c_plane place(base_box=tail_fan_rib_c, anchor=[0, 0.15, -0.05], align=[0, 0, 0]) {
                    size: [10.5, 15.0], normal: y, material: slate_fan,
                    edge: scallop(bays=3, depth=5, side=top), layer: 1,
                    blend_with: [tail_5_seg, tail_fan_c_tip, tail_fan_rib_l, tail_fan_r__tail_fan_rib_l, tail_fan_l_cryo, tail_fan_r__tail_fan_l_cryo]
                  }
                }

                bone tail_fan_l attach(parent_box=tail_5_seg, anchor=[0.92, 0.10, -0.78], align=[-0.55, 0, 0.90], seat=0.10) mirror_x(tail_fan_r) {
                  rest_euler: [8, -34, -10]
                  box tail_fan_rib_l { size: [2.0, 1.5, 13.5], material: navy_carapace, blend_with: [tail_fan_rib_c, tail_fan_r__tail_fan_rib_l] }
                  box tail_fan_l_tip place(base_box=tail_fan_rib_l, anchor=[0, 0.05, -0.98], align=[0, 0, 0.86]) {
                    size: [1.5, 1.0, 4.5], material: ivory_claw
                  }
                  box tail_fan_l_cryo place(base_box=tail_fan_rib_l, anchor=[0, 0.94, 0.15], align=[0, -0.80, 0]) {
                    size: [1.0, 1.0, 8.5], material: cryo_cyan, blend_with: [tail_5_seg, tail_fan_rib_c]
                  }
                  plane tail_fan_l_plane place(base_box=tail_fan_rib_l, anchor=[0.25, -0.15, -0.05], align=[-0.15, 0, 0]) {
                    size: [10.0, 14.0], normal: y, material: slate_fan,
                    edge: scallop(bays=3, depth=5, side=top), layer: 2,
                    blend_with: [tail_5_seg, tail_fan_l_tip, tail_fan_rib_c, tail_fan_c_cryo, tail_fan_c_plane, tail_fan_r__tail_fan_rib_l, tail_fan_r__tail_fan_l_plane]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
@materials {
  cobalt_hide: process(family=keratin_scales, coat=scale_rows, roughness=0.50)
  navy_carapace: process(family=keratin_scales, coat=banded_limb, roughness=0.40)
  cerulean_plate: process(family=keratin_scales, coat=scale_rows, roughness=0.36)
  kite_cream: process(family=patterned_skin, coat=striped, roughness=0.56)
  ochre_pleat: process(family=painted_metal, coat=striped, roughness=0.42)
  cream_belly: process(family=patterned_skin, coat=plain, roughness=0.66)
  slate_fan: process(family=keratin_scales, coat=striped, roughness=0.44)
  ivory_claw: process(family=polymer_dielectric, coat=plain, roughness=0.26)
  mouth_crimson: process(family=patterned_skin, coat=plain, roughness=0.45)
  amber_eye: process(family=thin_film_iridescence, coat=plain, roughness=0.14, emissive=0.95)
  cryo_cyan: process(family=thin_film_iridescence, coat=plain, roughness=0.18, emissive=0.94)
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
@stamps {
  stamp predator_eye_spark on skull_core.east { at: [0.74, 0.36], size: [1.5, 1.0], color: amber_eye, emissive: 0.95, mirror: true }
  stamp chest_frost_pore on shoulder_mount_l.east { at: [0.50, 0.52], size: [1.5, 2.0], color: cryo_cyan, emissive: 0.90, mirror: true }
  stamp withers_cryo_seam on withers_keel.up { at: [0.50, 0.45], size: [1.5, 3.0], color: cryo_cyan, emissive: 0.88 }
}
@behavior {
  spring head_vane_l { stiffness: 44, damping: 6 }
  spring head_vane_r { stiffness: 44, damping: 6 }
  spring tail_fan_l { stiffness: 40, damping: 5 }
  spring tail_fan_r { stiffness: 40, damping: 5 }
  spring tail_5 { stiffness: 36, damping: 5 }

  // 1. Poised Coral Highlands apex glider breathing, eagle head scan & gentle wing-sail breath
  clip idle {
    duration_s: 3.2, loop: true
    key root.position { 0.0: [0, 0, 0], 0.8: [0, -0.4, 0], 1.6: [0, 0.5, 0], 2.4: [0, -0.4, 0], 3.2: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.8: [2, 1.5, 0], 1.6: [-2.5, 0, 0], 2.4: [2, -1.5, 0], 3.2: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.8: [-3, 6, 0], 1.6: [2, 0, 0], 2.4: [-3, -6, 0], 3.2: [0, 0, 0], catmullrom }
    key neck_3.rotation { 0.0: [0, 0, 0], 0.8: [2, 8, -3], 1.6: [-2, 0, 0], 2.4: [2, -8, 3], 3.2: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.8: [4, 12, -5], 1.6: [-3, 0, 0], 2.4: [4, -12, 5], 3.2: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 1.6: [6, 0, 0], 3.2: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 1.6: [0, -4, 6], 3.2: [0, 0, 0], catmullrom }
    key wing_arm_r.rotation { 0.0: [0, 0, 0], 1.6: [0, -4, 6], 3.2: [0, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=7, freq_hz=0.3125, phase_deg=0)
    track tail_2: wave(axis=y, amp_deg=10, freq_hz=0.3125, phase_deg=-36)
    track tail_3: wave(axis=y, amp_deg=13, freq_hz=0.3125, phase_deg=-72)
    track tail_4: wave(axis=y, amp_deg=16, freq_hz=0.3125, phase_deg=-108)
    track tail_5: wave(axis=y, amp_deg=18, freq_hz=0.3125, phase_deg=-144)
  }

  // 2. Agile bird-of-prey biped stalking stride with counter-balanced kite-wings
  clip walk {
    duration_s: 1.6, loop: true
    key root.position { 0.0: [0, 0, 0], 0.4: [0, 1.4, 0], 0.8: [0, 0, 0], 1.2: [0, 1.4, 0], 1.6: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, -7, 3], 0.4: [3, 0, 0], 0.8: [0, 7, -3], 1.2: [3, 0, 0], 1.6: [0, -7, 3], catmullrom }
    key chest.rotation { 0.0: [2, 6, -4], 0.4: [-2, 0, 0], 0.8: [2, -6, 4], 1.2: [-2, 0, 0], 1.6: [2, 6, -4], catmullrom }
    key neck_1.rotation { 0.0: [4, -5, 0], 0.4: [-4, 0, 0], 0.8: [4, 5, 0], 1.2: [-4, 0, 0], 1.6: [4, -5, 0], catmullrom }
    key head.rotation { 0.0: [-3, -4, 0], 0.4: [4, 0, 0], 0.8: [-3, 4, 0], 1.2: [4, 0, 0], 1.6: [-3, -4, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [-28, 0, 0], 0.4: [6, 0, 4], 0.8: [26, 0, 0], 1.2: [-12, 0, 4], 1.6: [-28, 0, 0], catmullrom }
    key hind_shin_l.rotation { 0.0: [12, 0, 0], 0.4: [-16, 0, 0], 0.8: [20, 0, 0], 1.2: [28, 0, 0], 1.6: [12, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [26, 0, 0], 0.4: [-12, 0, 4], 0.8: [-28, 0, 0], 1.2: [6, 0, 4], 1.6: [26, 0, 0], catmullrom }
    key hind_thigh_r__hind_shin_l.rotation { 0.0: [20, 0, 0], 0.4: [28, 0, 0], 0.8: [12, 0, 0], 1.2: [-16, 0, 0], 1.6: [20, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 8, -6], 0.8: [0, -6, 6], 1.6: [0, 8, -6], catmullrom }
    key wing_arm_r.rotation { 0.0: [0, -6, 6], 0.8: [0, 8, -6], 1.6: [0, -6, 6], catmullrom }
    track tail_1: wave(axis=y, amp_deg=12, freq_hz=0.625, phase_deg=0)
    track tail_3: wave(axis=y, amp_deg=18, freq_hz=0.625, phase_deg=-60)
    track tail_5: wave(axis=y, amp_deg=22, freq_hz=0.625, phase_deg=-120)
  }

  // 3. Low-pitched raptorial sprint with flared glider kite-wings assisting lift
  clip run {
    duration_s: 0.9, loop: true
    key root.position { 0.0: [0, 1.0, 0], 0.22: [0, 5.5, 2.5], 0.45: [0, 0.5, 0], 0.68: [0, 5.5, 2.5], 0.9: [0, 1.0, 0], catmullrom }
