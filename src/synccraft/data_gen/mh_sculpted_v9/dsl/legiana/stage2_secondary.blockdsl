// Legiana (Apex Glider of Coral Highlands) — Stage 2 Secondary Anatomy & Partitioned Kite-Wings
// Adds 3D viper-wedge snout, recessed amber slit eyes, articulated 2-segment head-vanes,
// hugged cream throat/sternum freezer-sac scutes, shoulder/hip bolsters, raptor toes & talons,
// stepped wing-spar tapers + partitioned multi-bone kite-leaf membrane bays, & swallowtail fan planes.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 460
  budget max_bones = 110
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  cobalt_hide: ramp(base_lch=[0.39, 0.128, 256], steps=6, hue_shift=[22, -14])
  navy_carapace: ramp(base_lch=[0.27, 0.106, 264], steps=6, hue_shift=[20, -12])
  cerulean_plate: ramp(base_lch=[0.48, 0.122, 244], steps=6, hue_shift=[22, -14])
  kite_cream: ramp(base_lch=[0.84, 0.068, 86], steps=6, hue_shift=[20, -12])
  ochre_pleat: ramp(base_lch=[0.73, 0.105, 78], steps=6, hue_shift=[18, -12])
  cream_belly: ramp(base_lch=[0.80, 0.055, 84], steps=6, hue_shift=[18, -10])
  slate_fan: ramp(base_lch=[0.35, 0.092, 238], steps=6, hue_shift=[20, -14])
  ivory_claw: ramp(base_lch=[0.88, 0.040, 88], steps=6, hue_shift=[16, -10])
  amber_eye: ramp(base_lch=[0.82, 0.165, 82], steps=6, hue_shift=[12, -14], emissive=true)
  cryo_cyan: ramp(base_lch=[0.86, 0.148, 212], steps=6, hue_shift=[14, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 19.02, -5.0]) {
      rest_euler: [-14, 0, 0]
      box pelvis_core { size: [8.5, 8.0, 9.5], material: cobalt_hide }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
        size: [6.0, 1.5, 8.0], material: cream_belly
      }
      box sacrum_ridge place(base_box=pelvis_core, anchor=[0, 0.96, -0.05], align=[0, -0.55, 0]) {
        size: [5.0, 2.0, 8.0], material: cerulean_plate, rotate: [6, 0, 0], blend_with: [lumbar_ridge, tail_1_seg, tail_1_ridge]
      }
      box haunch_plate_l place(base_box=pelvis_core, anchor=[0.96, 0.20, 0.0], align=[-0.52, 0, 0]) {
        size: [2.5, 5.5, 7.0], material: cerulean_plate, rotate: [4, 6, -12], blend_with: [thigh_mass, waist_core]
      }
      box haunch_plate_r place(base_box=pelvis_core, anchor=[-0.96, 0.20, 0.0], align=[0.52, 0, 0]) {
        size: [2.5, 5.5, 7.0], material: cerulean_plate, rotate: [4, -6, 12], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.15, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-10, 0, 0]
        box waist_core { size: [7.5, 7.5, 9.5], material: cobalt_hide }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
          size: [5.5, 1.5, 8.0], material: cream_belly, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_ridge place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
          size: [4.5, 2.0, 8.0], material: cerulean_plate, rotate: [-4, 0, 0], blend_with: [pelvis_core, chest_core, withers_keel]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.18, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [8, 0, 0]
          box chest_core { size: [13.5, 12.5, 13.5], material: cobalt_hide }
          box withers_keel place(base_box=chest_core, anchor=[0, 0.96, 0.10], align=[0, -0.55, 0]) {
            size: [7.5, 3.0, 11.0], material: cerulean_plate, rotate: [-8, 0, 0], blend_with: [neck_base, neck_crest_1, lumbar_ridge]
          }
          box shoulder_mount_l place(base_box=chest_core, anchor=[0.95, 0.26, 0.24], align=[-0.68, 0, 0]) {
            size: [2.5, 5.0, 7.5], material: cerulean_plate, rotate: [-4, 8, -14], blend_with: [withers_keel, wing_humerus]
          }
          box shoulder_mount_r place(base_box=chest_core, anchor=[-0.95, 0.26, 0.24], align=[0.68, 0, 0]) {
            size: [2.5, 5.0, 7.5], material: cerulean_plate, rotate: [-4, -8, 14], blend_with: [withers_keel, wing_arm_r__wing_humerus]
          }
          // Hugged ventral freezer-sac chest plates
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.32], align=[0, 0.42, 0]) {
            size: [9.5, 2.0, 7.0], material: cream_belly, rotate: [4, 0, 0], blend_with: [waist_belly, waist_core]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.96, 0.48], align=[0, 0.48, -0.20]) {
            size: [8.5, 2.5, 7.5], material: cream_belly, rotate: [-18, 0, 0], blend_with: [chest_scute_rear, neck_throat_1]
          }
          box freezer_sac_keel place(base_box=chest_scute_front, anchor=[0, -0.92, 0.15], align=[0, 0.68, 0]) {
            size: [4.5, 2.0, 6.0], material: kite_cream, rotate: [-12, 0, 0], blend_with: [chest_core, chest_scute_rear]
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.36, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-28, 0, 0]
            box neck_base { size: [8.0, 8.0, 8.5], material: cobalt_hide }
            box neck_throat_1 place(base_box=neck_base, anchor=[0, -0.96, 0.05], align=[0, 0.48, 0]) {
              size: [5.5, 1.5, 7.0], material: cream_belly, rotate: [-4, 0, 0], blend_with: [chest_core, chest_scute_front]
            }
            box neck_crest_1 place(base_box=neck_base, anchor=[0, 0.96, -0.05], align=[0, -0.58, 0]) {
              size: [3.5, 2.5, 7.0], material: cerulean_plate, rotate: [10, 0, 0], blend_with: [chest_core, withers_keel, neck_mid, neck_crest_2]
            }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.10, 1], align=[0, 0, -1], seat=0.26) {
              rest_euler: [14, 0, 0]
              box neck_mid { size: [6.5, 6.5, 8.0], material: cobalt_hide }
              box neck_throat_2 place(base_box=neck_mid, anchor=[0, -0.96, 0.05], align=[0, 0.48, 0]) {
                size: [4.5, 1.5, 6.5], material: cream_belly, blend_with: [neck_base, neck_throat_1]
              }
              box neck_crest_2 place(base_box=neck_mid, anchor=[0, 0.96, -0.05], align=[0, -0.58, 0]) {
                size: [3.0, 2.0, 6.5], material: cerulean_plate, rotate: [10, 0, 0], blend_with: [neck_base, neck_upper, neck_crest_3]
              }

              bone neck_3 attach(parent_box=neck_mid, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.26) {
                rest_euler: [24, 0, 0]
                box neck_upper { size: [5.5, 5.5, 7.0], material: cobalt_hide }
                box neck_throat_3 place(base_box=neck_upper, anchor=[0, -0.96, 0.05], align=[0, 0.48, 0]) {
                  size: [3.5, 1.5, 5.5], material: cream_belly, blend_with: [neck_mid, neck_throat_2, jaw_core]
                }
                box neck_crest_3 place(base_box=neck_upper, anchor=[0, 0.96, -0.05], align=[0, -0.58, 0]) {
                  size: [2.5, 2.0, 5.5], material: cerulean_plate, rotate: [12, 0, 0], blend_with: [neck_mid, skull_core, skull_crown]
                }

                bone head attach(parent_box=neck_upper, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                  rest_euler: [18, 0, 0]
                  box skull_core { size: [7.5, 5.0, 6.5], material: cobalt_hide }
                  box skull_crown place(base_box=skull_core, anchor=[0, 0.98, -0.10], align=[0, -0.65, 0]) {
                    size: [4.5, 1.5, 5.5], material: cerulean_plate, rotate: [6, 0, 0], blend_with: [neck_upper, brow_ridge_l, brow_ridge_r]
                  }
                  box brow_ridge_l place(base_box=skull_core, anchor=[0.84, 0.78, 0.48], align=[-0.15, -0.52, -0.25]) {
                    size: [2.0, 1.5, 5.0], material: navy_carapace, rotate: [10, -14, -14], blend_with: [skull_crown, snout_core, nasal_bridge]
                  }
                  box brow_ridge_r place(base_box=skull_core, anchor=[-0.84, 0.78, 0.48], align=[0.15, -0.52, -0.25]) {
                    size: [2.0, 1.5, 5.0], material: navy_carapace, rotate: [10, 14, 14], blend_with: [skull_crown, snout_core, nasal_bridge]
                  }
                  box cheek_jowl_l place(base_box=skull_core, anchor=[0.96, -0.18, -0.05], align=[-0.52, 0, 0]) {
                    size: [2.0, 3.0, 5.0], material: cerulean_plate, rotate: [6, -12, 8], blend_with: [brow_ridge_l, neck_upper, jaw_core]
                  }
                  box cheek_jowl_r place(base_box=skull_core, anchor=[-0.96, -0.18, -0.05], align=[0.52, 0, 0]) {
                    size: [2.0, 3.0, 5.0], material: cerulean_plate, rotate: [6, 12, -8], blend_with: [brow_ridge_r, neck_upper, jaw_core]
                  }
                  box eye_slit_l place(base_box=skull_core, anchor=[0.98, 0.42, 0.52], align=[-0.72, 0, 0]) {
                    size: [1.0, 1.5, 2.0], material: amber_eye, rotate: [8, -12, 0], blend_with: [brow_ridge_l, cheek_jowl_l, maxilla_wedge_l]
                  }
                  box eye_slit_r place(base_box=skull_core, anchor=[-0.98, 0.42, 0.52], align=[0.72, 0, 0]) {
                    size: [1.0, 1.5, 2.0], material: amber_eye, rotate: [8, 12, 0], blend_with: [brow_ridge_r, cheek_jowl_r, maxilla_wedge_r]
                  }

                  // Ultra-sleek narrow viper-wedge rostrum (snout_taper_ratio < 0.38!)
                  box snout_core place(base_box=skull_core, anchor=[0, -0.12, 1], align=[0, 0, -0.78]) {
                    size: [3.5, 2.5, 6.0], material: cobalt_hide, rotate: [8, 0, 0]
                  }
                  box nasal_bridge place(base_box=snout_core, anchor=[0, 0.92, 0.05], align=[0, -0.58, 0]) {
                    size: [2.5, 1.5, 6.0], material: cerulean_plate, rotate: [5, 0, 0], blend_with: [skull_core, skull_crown]
                  }
                  box maxilla_wedge_l place(base_box=snout_core, anchor=[0.96, -0.08, -0.18], align=[-0.52, 0, 0]) {
                    size: [1.5, 2.0, 5.0], material: kite_cream, rotate: [8, -20, 8], blend_with: [skull_core, cheek_jowl_l, nasal_bridge, jaw_core]
                  }
                  box maxilla_wedge_r place(base_box=snout_core, anchor=[-0.96, -0.08, -0.18], align=[0.52, 0, 0]) {
                    size: [1.5, 2.0, 5.0], material: kite_cream, rotate: [8, 20, -8], blend_with: [skull_core, cheek_jowl_r, nasal_bridge, jaw_core]
                  }
                  box rostrum_tip place(base_box=snout_core, anchor=[0, -0.04, 0.96], align=[0, 0, -0.82]) {
                    size: [2.0, 2.0, 4.5], material: navy_carapace, rotate: [10, 0, 0], blend_with: [nasal_bridge, maxilla_wedge_l, maxilla_wedge_r]
                  }
                  box beak_hook place(base_box=rostrum_tip, anchor=[0, -0.18, 0.96], align=[0, 0, -0.82]) {
                    size: [1.5, 1.5, 2.5], material: navy_carapace, rotate: [22, 0, 0]
                  }

                  // Twin Pleated Cream-Gold Antennae Head-Vanes (fanned wide outward from cobalt ribs!)
                  bone head_vane_l attach(parent_box=skull_core, anchor=[0.78, 0.92, -0.24], align=[0, -0.25, 0.94]) mirror_x(head_vane_r) {
                    rest_euler: [26, -24, 16]
                    box vane_rib_1 { size: [2.0, 2.0, 7.5], material: navy_carapace, blend_with: [skull_crown, brow_ridge_l, neck_upper] }
                    plane vane_pleat_1 place(base_box=vane_rib_1, anchor=[0.85, 0.10, -0.05], align=[-0.82, 0, 0]) {
                      size: [5.5, 7.0], normal: y, material: kite_cream, rotate: [0, 0, -10],
                      edge: scallop(bays=3, depth=3, side=right), layer: 1,
                      blend_with: [skull_core, cheek_jowl_l, neck_upper, vane_rib_2, vane_pleat_2]
                    }

                    bone head_vane_tip_l attach(parent_box=vane_rib_1, anchor=[0, 0.08, -1], align=[0, 0, 1], seat=0.18) {
                      rest_euler: [14, -10, 6]
                      box vane_rib_2 { size: [1.5, 1.5, 8.0], material: ochre_pleat }
                      plane vane_pleat_2 place(base_box=vane_rib_2, anchor=[0.70, -0.30, 0.0], align=[-0.75, 0, 0]) {
                        size: [6.0, 7.5], normal: y, material: kite_cream, rotate: [0, 0, -4],
                        edge: scallop(bays=3, depth=4, side=right), layer: 2,
                        blend_with: [vane_rib_1, vane_pleat_1]
                      }
                    }
                  }

                  bone jaw attach(parent_box=skull_core, anchor=[0, -0.76, 0.25], align=[0, 0, -1], seat=0.16) {
                    rest_euler: [10, 0, 0]
                    box jaw_core { size: [3.0, 2.0, 6.5], material: cream_belly, blend_with: [snout_core] }
                    box jaw_tip place(base_box=jaw_core, anchor=[0, 0.08, 0.96], align=[0, 0, -0.82]) {
                      size: [2.0, 1.5, 4.0], material: kite_cream, rotate: [-6, 0, 0], blend_with: [snout_core, rostrum_tip]
                    }
                  }
                }
              }
            }
          }

          // Colossal Leaf-Lobed Split Kite-Wings (7 wing bones per side = 14 wing bones across L+R!)
          bone wing_arm_l attach(parent_box=chest_core, anchor=[0.96, 0.52, 0.22], align=[-0.92, 0, 0], seat=0.06) mirror_x(wing_arm_r) {
            rest_euler: [8, 22, 24]
            box wing_humerus { size: [13.0, 4.0, 4.5], material: cobalt_hide }
            box humerus_armor place(base_box=wing_humerus, anchor=[0.0, 0.88, 0.55], align=[0, -0.62, -0.35]) {
              size: [11.0, 2.0, 3.0], material: cerulean_plate, rotate: [8, 0, 0], blend_with: [chest_core, shoulder_mount_l, wing_radius]
            }
            plane humerus_bay_plane place(base_box=wing_humerus, anchor=[-0.75, 0.10, -0.92], align=[-0.85, 0, 0.88]) {
              size: [11.5, 8.5], normal: y, material: kite_cream,
              edge: scallop(bays=2, depth=4, side=top), layer: 1,
              blend_with: [chest_core, shoulder_mount_l, waist_core, lumbar_ridge, patagium_spar, patagium_sail_plane]
            }

            bone wing_patagium_l attach(parent_box=wing_humerus, anchor=[0.68, -0.05, -0.92], align=[-0.94, 0, 0.25], seat=0.04) {
              rest_euler: [0, 62, -12]
              box patagium_spar { size: [15.0, 2.0, 2.5], material: ochre_pleat, blend_with: [chest_core, waist_core, wing_radius] }
              box patagium_navy_tip place(base_box=patagium_spar, anchor=[0.98, 0, 0], align=[-0.85, 0, 0]) {
                size: [4.5, 1.5, 2.0], material: navy_carapace
              }
              plane patagium_sail_plane place(base_box=patagium_spar, anchor=[-0.80, 0.15, -0.92], align=[-0.88, 0, 0.90]) {
                size: [17.0, 11.0], normal: y, material: kite_cream,
                edge: scallop(bays=3, depth=5, side=top), layer: 2,
                blend_with: [wing_humerus, chest_core, waist_core, patagium_navy_tip]
              }
            }

            bone wing_forearm_l attach(parent_box=wing_humerus, anchor=[1, 0.05, 0], align=[-1, 0, 0], seat=0.14) {
              rest_euler: [-6, -30, 10]
              box wing_radius { size: [16.5, 3.5, 4.0], material: cobalt_hide }
              box radius_leading_plate place(base_box=wing_radius, anchor=[0.05, 0.86, 0.55], align=[0, -0.62, -0.35]) {
                size: [14.5, 1.5, 3.0], material: navy_carapace, rotate: [8, 0, 0], blend_with: [wing_humerus, humerus_armor, digit_1_spar]
              }
              box wrist_alula_claw place(base_box=wing_radius, anchor=[0.96, 0.25, 0.96], align=[-0.35, 0, -0.85]) {
                size: [2.0, 1.5, 4.5], material: ivory_claw, rotate: [6, -24, 0], blend_with: [radius_leading_plate, digit_1_spar]
              }
              plane forearm_bay_plane place(base_box=wing_radius, anchor=[-0.82, 0.05, -0.92], align=[-0.88, 0, 0.90]) {
                size: [15.5, 12.0], normal: y, material: ochre_pleat,
                edge: scallop(bays=2, depth=5, side=top), layer: 1,
                blend_with: [wing_humerus, humerus_bay_plane, patagium_spar, patagium_sail_plane, digit_3_spar, digit_4_spar, digit_4_lobe_plane]
              }

              bone wing_digit_1_l attach(parent_box=wing_radius, anchor=[0.98, 0.12, 0.42], align=[-0.96, 0, 0], seat=0.04) {
                rest_euler: [0, -10, 6]
                box digit_1_spar { size: [17.0, 2.5, 2.5], material: navy_carapace }
                box digit_1_tip place(base_box=digit_1_spar, anchor=[0.98, 0, 0], align=[-0.86, 0, 0]) {
                  size: [9.0, 1.5, 2.0], material: navy_carapace, rotate: [0, 4, -3]
                }
                plane digit_1_lobe_plane place(base_box=digit_1_spar, anchor=[-0.42, 0.15, -0.92], align=[-0.88, 0, 0.90]) {
                  size: [23.0, 10.5], normal: y, material: kite_cream,
                  edge: scallop(bays=3, depth=5, side=top), layer: 2,
                  blend_with: [wing_radius, forearm_bay_plane, digit_1_tip, digit_2_spar, digit_2_tip, digit_2_lobe_plane]
                }
              }

              bone wing_digit_2_l attach(parent_box=wing_radius, anchor=[0.96, 0.05, 0.08], align=[-0.96, 0, 0], seat=0.04) {
                rest_euler: [0, 18, -2]
                box digit_2_spar { size: [18.0, 2.0, 2.5], material: ochre_pleat, blend_with: [digit_1_spar] }
                box digit_2_tip place(base_box=digit_2_spar, anchor=[0.98, 0, 0], align=[-0.86, 0, 0]) {
                  size: [9.0, 1.5, 1.5], material: navy_carapace, rotate: [0, 5, -3]
                }
                plane digit_2_lobe_plane place(base_box=digit_2_spar, anchor=[-0.42, -0.15, -0.92], align=[-0.88, 0, 0.90]) {
                  size: [23.5, 11.5], normal: y, material: kite_cream,
                  edge: scallop(bays=3, depth=5, side=top), layer: 1,
                  blend_with: [wing_radius, forearm_bay_plane, digit_1_spar, digit_1_lobe_plane, digit_2_tip, digit_3_spar, digit_3_tip, digit_3_lobe_plane, digit_4_spar]
                }
              }

              bone wing_digit_3_l attach(parent_box=wing_radius, anchor=[0.99, 0.0, -0.45], align=[-0.98, 0, 0.30], seat=0.02) {
                rest_euler: [0, 46, -8]
                box digit_3_spar { size: [16.0, 2.0, 2.5], material: ochre_pleat, blend_with: [digit_1_spar, digit_2_spar] }
                box digit_3_tip place(base_box=digit_3_spar, anchor=[0.98, 0, 0], align=[-0.86, 0, 0]) {
                  size: [8.0, 1.5, 1.5], material: navy_carapace, rotate: [0, 5, -3]
                }
                plane digit_3_lobe_plane place(base_box=digit_3_spar, anchor=[-0.42, 0.18, -0.92], align=[-0.88, 0, 0.90]) {
                  size: [21.0, 11.0], normal: y, material: kite_cream,
                  edge: scallop(bays=3, depth=5, side=top), layer: 2,
                  blend_with: [wing_radius, forearm_bay_plane, digit_2_spar, digit_2_lobe_plane, digit_3_tip, digit_4_spar, digit_4_tip, digit_4_lobe_plane]
                }
              }

              bone wing_digit_4_l attach(parent_box=wing_radius, anchor=[0.96, -0.05, -0.82], align=[-0.96, 0, 0.45], seat=0.02) {
                rest_euler: [0, 72, -14]
                box digit_4_spar { size: [13.5, 2.0, 2.5], material: ochre_pleat, blend_with: [digit_1_spar, digit_2_spar, digit_3_spar, patagium_spar] }
                box digit_4_tip place(base_box=digit_4_spar, anchor=[0.98, 0, 0], align=[-0.86, 0, 0]) {
                  size: [6.5, 1.5, 1.5], material: navy_carapace, rotate: [0, 5, -3]
                }
                plane digit_4_lobe_plane place(base_box=digit_4_spar, anchor=[-0.42, -0.18, -0.92], align=[-0.88, 0, 0.90]) {
                  size: [17.5, 10.0], normal: y, material: ochre_pleat,
                  edge: scallop(bays=3, depth=5, side=top), layer: 1,
                  blend_with: [wing_radius, forearm_bay_plane, patagium_spar, patagium_sail_plane, digit_3_spar, digit_3_lobe_plane, digit_4_tip]
                }
              }
            }
          }
        }
      }

      // Biped Bird-of-Prey Digitigrade Hindlimbs
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.94, -0.10, 0.05], align=[-0.55, 0.85, 0], seat=0.14) mirror_x(hind_thigh_r) {
        rest_euler: [-14, -6, 16]
        box thigh_mass { size: [5.0, 10.5, 6.5], material: cobalt_hide, blend_with: [waist_core, tail_1_seg] }
        box thigh_armor place(base_box=thigh_mass, anchor=[0.96, 0.20, 0.05], align=[-0.52, 0, 0]) {
          size: [2.0, 6.0, 5.0], material: cerulean_plate, rotate: [6, -8, -10], blend_with: [pelvis_core, haunch_plate_l]
        }
        box knee_guard place(base_box=thigh_mass, anchor=[0.10, -0.82, 0.96], align=[0, 0, -0.72]) {
          size: [3.0, 3.0, 2.0], material: navy_carapace, rotate: [-14, 0, 0], blend_with: [shin_mass]
        }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [54, 0, -10]
          box shin_mass { size: [3.5, 11.5, 4.0], material: navy_carapace }
          box hock_spur place(base_box=shin_mass, anchor=[0, 0.68, -0.94], align=[0, 0, 0.72]) {
            size: [2.0, 2.5, 3.5], material: ivory_claw, rotate: [20, 0, 0], blend_with: [thigh_mass]
          }

          bone hind_foot_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.42], seat=0.14) {
            rest_euler: [-26, 0, -6]
            box foot_pad { size: [5.0, 2.5, 6.0], material: navy_carapace }
            box h_toe_1 place(base_box=foot_pad, anchor=[-0.64, -0.12, 0.94], align=[0, 0, -0.78]) {
              size: [1.5, 2.0, 3.5], material: cerulean_plate, rotate: [0, 16, 0]
            }
            box h_claw_1 place(base_box=h_toe_1, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.0, 1.5, 3.0], material: ivory_claw, rotate: [4, 4, 0]
            }
            box h_toe_2 place(base_box=foot_pad, anchor=[0.0, -0.12, 0.96], align=[0, 0, -0.80]) {
              size: [1.5, 2.0, 4.0], material: cerulean_plate, blend_with: [h_toe_1]
            }
            box h_claw_2 place(base_box=h_toe_2, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.0, 1.5, 3.5], material: ivory_claw, rotate: [4, 0, 0], blend_with: [h_claw_1]
            }
            box h_toe_3 place(base_box=foot_pad, anchor=[0.64, -0.12, 0.94], align=[0, 0, -0.78]) {
              size: [1.5, 2.0, 3.5], material: cerulean_plate, rotate: [0, -16, 0], blend_with: [h_toe_2]
            }
            box h_claw_3 place(base_box=h_toe_3, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.0, 1.5, 3.0], material: ivory_claw, rotate: [4, -4, 0], blend_with: [h_claw_2]
            }
            box hallux_claw place(base_box=foot_pad, anchor=[0, 0.05, -0.96], align=[0, 0, 0.82]) {
              size: [1.5, 1.5, 3.0], material: ivory_claw, rotate: [-4, 0, 0], blend_with: [shin_mass]
            }
          }
        }
      }

      // Sleek Whip Tail & 3-Lobed Swallowtail Stabilizer Fan
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.15, -1], align=[0, 0, 1], seat=0.24) {
        rest_euler: [-4, 0, 0]
        box tail_1_seg { size: [6.5, 6.0, 8.5], material: cobalt_hide }
        box tail_1_belly place(base_box=tail_1_seg, anchor=[0, -0.96, 0], align=[0, 0.48, 0]) {
          size: [4.5, 1.5, 7.5], material: cream_belly, blend_with: [pelvis_belly, pelvis_core]
        }
        box tail_1_ridge place(base_box=tail_1_seg, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
          size: [3.5, 2.0, 7.5], material: cerulean_plate, rotate: [8, 0, 0], blend_with: [pelvis_core, tail_2_seg, tail_2_ridge]
        }

        bone tail_2 attach(parent_box=tail_1_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
          rest_euler: [10, 0, 0]
          box tail_2_seg { size: [5.5, 5.0, 8.5], material: cobalt_hide }
          box tail_2_belly place(base_box=tail_2_seg, anchor=[0, -0.96, 0], align=[0, 0.48, 0]) {
            size: [3.5, 1.5, 7.5], material: cream_belly, blend_with: [tail_1_belly, tail_1_seg]
          }
          box tail_2_ridge place(base_box=tail_2_seg, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
            size: [3.0, 1.5, 7.5], material: cerulean_plate, rotate: [8, 0, 0], blend_with: [tail_1_seg, tail_3_seg, tail_3_ridge]
          }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
            rest_euler: [14, 0, 0]
            box tail_3_seg { size: [4.5, 4.0, 8.5], material: cobalt_hide }
            box tail_3_ridge place(base_box=tail_3_seg, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
              size: [2.5, 1.5, 7.5], material: cerulean_plate, rotate: [8, 0, 0], blend_with: [tail_2_seg, tail_4_seg]
            }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
              rest_euler: [16, 0, 0]
              box tail_4_seg { size: [3.5, 3.5, 8.5], material: navy_carapace }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.22) {
                rest_euler: [12, 0, 0]
                box tail_5_seg { size: [3.0, 3.0, 8.0], material: navy_carapace }

                bone tail_fan_c attach(parent_box=tail_5_seg, anchor=[0, 0.10, -0.92], align=[0, 0, 0.88], seat=0.12) {
                  rest_euler: [6, 0, 0]
                  box tail_fan_rib_c { size: [2.5, 1.5, 13.0], material: navy_carapace }
                  plane tail_fan_c_plane place(base_box=tail_fan_rib_c, anchor=[0, 0.15, -0.05], align=[0, 0, 0]) {
                    size: [9.0, 13.5], normal: y, material: slate_fan,
                    edge: scallop(bays=3, depth=4, side=top), layer: 1,
                    blend_with: [tail_5_seg, tail_fan_rib_l, tail_fan_r__tail_fan_rib_l]
                  }
                }
                bone tail_fan_l attach(parent_box=tail_5_seg, anchor=[0.92, 0.10, -0.78], align=[-0.55, 0, 0.90], seat=0.10) mirror_x(tail_fan_r) {
                  rest_euler: [8, -32, -10]
                  box tail_fan_rib_l { size: [2.0, 1.5, 12.0], material: navy_carapace, blend_with: [tail_fan_rib_c, tail_fan_r__tail_fan_rib_l] }
                  plane tail_fan_l_plane place(base_box=tail_fan_rib_l, anchor=[0.25, -0.15, -0.05], align=[-0.15, 0, 0]) {
                    size: [8.5, 12.5], normal: y, material: slate_fan,
                    edge: scallop(bays=3, depth=4, side=top), layer: 2,
                    blend_with: [tail_5_seg, tail_fan_rib_c, tail_fan_c_plane, tail_fan_r__tail_fan_l_plane]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
@materials {
  cobalt_hide: process(family=keratin_scales, coat=scale_rows, roughness=0.52)
  navy_carapace: process(family=keratin_scales, coat=banded_limb, roughness=0.42)
  cerulean_plate: process(family=keratin_scales, coat=scale_rows, roughness=0.38)
  kite_cream: process(family=patterned_skin, coat=striped, roughness=0.58)
  ochre_pleat: process(family=painted_metal, coat=striped, roughness=0.44)
  cream_belly: process(family=patterned_skin, coat=plain, roughness=0.66)
  slate_fan: process(family=keratin_scales, coat=striped, roughness=0.46)
  ivory_claw: process(family=polymer_dielectric, coat=plain, roughness=0.28)
  amber_eye: process(family=thin_film_iridescence, coat=plain, roughness=0.15, emissive=0.95)
  cryo_cyan: process(family=thin_film_iridescence, coat=plain, roughness=0.18, emissive=0.92)
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
