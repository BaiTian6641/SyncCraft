// Legiana (Apex Glider of Coral Highlands) — Stage 1 Primary Blockout
// Biped high-altitude glider Flying Wyvern: 2 digitigrade raptor hindlegs on Y=0,
// slender greyhound waist, keeled chest, 3-segment swan S-neck, viper-wedge head
// with twin swept head-vanes, fanned 4-digit + patagium kite-wing spars, & swallowtail fan.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 460
  budget max_bones = 110
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  cobalt_hide: ramp(base_lch=[0.38, 0.125, 256], steps=6, hue_shift=[22, -14])
  navy_carapace: ramp(base_lch=[0.27, 0.105, 264], steps=6, hue_shift=[20, -12])
  kite_cream: ramp(base_lch=[0.84, 0.068, 86], steps=6, hue_shift=[20, -12])
  cream_belly: ramp(base_lch=[0.80, 0.055, 84], steps=6, hue_shift=[18, -10])
  slate_fan: ramp(base_lch=[0.36, 0.088, 240], steps=6, hue_shift=[20, -14])
  cryo_cyan: ramp(base_lch=[0.86, 0.145, 212], steps=6, hue_shift=[14, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 19.02, -5.0]) {
      rest_euler: [-14, 0, 0]
      box pelvis_core { size: [8.5, 8.0, 9.5], material: cobalt_hide }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.15, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-10, 0, 0]
        box waist_core { size: [7.5, 7.5, 9.5], material: cobalt_hide }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.18, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [8, 0, 0]
          box chest_core { size: [13.5, 12.5, 13.5], material: cobalt_hide }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.36, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-28, 0, 0]
            box neck_base { size: [8.0, 8.0, 8.5], material: cobalt_hide }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.10, 1], align=[0, 0, -1], seat=0.26) {
              rest_euler: [14, 0, 0]
              box neck_mid { size: [6.5, 6.5, 8.0], material: cobalt_hide }

              bone neck_3 attach(parent_box=neck_mid, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.26) {
                rest_euler: [24, 0, 0]
                box neck_upper { size: [5.5, 5.5, 7.0], material: cobalt_hide }

                bone head attach(parent_box=neck_upper, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                  rest_euler: [18, 0, 0]
                  box skull_core { size: [7.5, 5.0, 6.5], material: cobalt_hide }
                  box snout_core place(base_box=skull_core, anchor=[0, -0.10, 1], align=[0, 0, -0.78]) {
                    size: [3.5, 3.0, 6.0], material: cobalt_hide, rotate: [8, 0, 0]
                  }
                  box rostrum_tip place(base_box=snout_core, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
                    size: [2.0, 2.0, 4.5], material: navy_carapace, rotate: [10, 0, 0]
                  }

                  bone head_vane_l attach(parent_box=skull_core, anchor=[0.76, 0.90, -0.24], align=[0, -0.25, 0.94]) mirror_x(head_vane_r) {
                    rest_euler: [28, -24, 14]
                    box vane_rib_1 { size: [2.0, 2.0, 10.5], material: kite_cream, blend_with: [neck_upper] }
                  }

                  bone jaw attach(parent_box=skull_core, anchor=[0, -0.76, 0.25], align=[0, 0, -1], seat=0.16) {
                    rest_euler: [10, 0, 0]
                    box jaw_core { size: [3.0, 2.0, 7.5], material: cream_belly, blend_with: [snout_core] }
                  }
                }
              }
            }
          }

          // Colossal Raised Split Kite-Wing Spars (4 primary digits + secondary patagium)
          bone wing_arm_l attach(parent_box=chest_core, anchor=[0.96, 0.52, 0.22], align=[-0.92, 0, 0], seat=0.06) mirror_x(wing_arm_r) {
            rest_euler: [8, 22, 24]
            box wing_humerus { size: [13.0, 4.0, 4.5], material: cobalt_hide }

            bone wing_patagium_l attach(parent_box=wing_humerus, anchor=[0.62, -0.08, -0.90], align=[-0.92, 0, 0], seat=0.05) {
              rest_euler: [0, 62, -12]
              box patagium_spar { size: [15.0, 2.0, 2.5], material: kite_cream, blend_with: [chest_core, waist_core, wing_radius] }
            }

            bone wing_forearm_l attach(parent_box=wing_humerus, anchor=[1, 0.05, 0], align=[-1, 0, 0], seat=0.14) {
              rest_euler: [-6, -30, 10]
              box wing_radius { size: [16.5, 3.5, 4.0], material: cobalt_hide }

              bone wing_digit_1_l attach(parent_box=wing_radius, anchor=[0.98, 0.12, 0.42], align=[-0.96, 0, 0], seat=0.04) {
                rest_euler: [0, -10, 6]
                box digit_1_spar { size: [23.5, 2.5, 2.5], material: navy_carapace }
              }
              bone wing_digit_2_l attach(parent_box=wing_radius, anchor=[0.96, 0.05, 0.08], align=[-0.96, 0, 0], seat=0.04) {
                rest_euler: [0, 18, -2]
                box digit_2_spar { size: [24.5, 2.0, 2.5], material: kite_cream, blend_with: [digit_1_spar] }
              }
              bone wing_digit_3_l attach(parent_box=wing_radius, anchor=[0.99, 0.0, -0.45], align=[-0.98, 0, 0.30], seat=0.02) {
                rest_euler: [0, 46, -8]
                box digit_3_spar { size: [21.5, 2.0, 2.5], material: kite_cream, blend_with: [digit_1_spar, digit_2_spar] }
              }
              bone wing_digit_4_l attach(parent_box=wing_radius, anchor=[0.96, -0.05, -0.82], align=[-0.96, 0, 0.45], seat=0.02) {
                rest_euler: [0, 72, -14]
                box digit_4_spar { size: [18.0, 2.0, 2.5], material: kite_cream, blend_with: [digit_1_spar, digit_2_spar, digit_3_spar, patagium_spar] }
              }
            }
          }
        }
      }

      // Biped Bird-of-Prey Digitigrade Hindlimbs (ZERO front walking legs!)
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.94, -0.10, 0.05], align=[-0.55, 0.85, 0], seat=0.14) mirror_x(hind_thigh_r) {
        rest_euler: [-14, -6, 16]
        box thigh_mass { size: [5.0, 10.5, 6.5], material: cobalt_hide, blend_with: [waist_core, tail_1_seg] }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [54, 0, -10]
          box shin_mass { size: [3.5, 11.5, 4.0], material: navy_carapace }

          bone hind_foot_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.42], seat=0.14) {
            rest_euler: [-26, 0, -6]
            box foot_pad { size: [5.0, 2.5, 6.5], material: navy_carapace }
          }
        }
      }

      // Sleek Whip Tail & 3-Lobed Swallowtail Stabilizer Fan
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.15, -1], align=[0, 0, 1], seat=0.24) {
        rest_euler: [-4, 0, 0]
        box tail_1_seg { size: [6.5, 6.0, 8.5], material: cobalt_hide }

        bone tail_2 attach(parent_box=tail_1_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
          rest_euler: [10, 0, 0]
          box tail_2_seg { size: [5.5, 5.0, 8.5], material: cobalt_hide }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
            rest_euler: [14, 0, 0]
            box tail_3_seg { size: [4.5, 4.0, 8.5], material: cobalt_hide }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
              rest_euler: [16, 0, 0]
              box tail_4_seg { size: [3.5, 3.5, 8.5], material: navy_carapace }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.22) {
                rest_euler: [12, 0, 0]
                box tail_5_seg { size: [3.0, 3.0, 8.0], material: navy_carapace }

                bone tail_fan_c attach(parent_box=tail_5_seg, anchor=[0, 0.10, -0.92], align=[0, 0, 0.88], seat=0.12) {
                  rest_euler: [6, 0, 0]
                  box tail_fan_rib_c { size: [3.0, 1.5, 11.5], material: slate_fan }
                }
                bone tail_fan_l attach(parent_box=tail_5_seg, anchor=[0.92, 0.10, -0.78], align=[-0.55, 0, 0.90], seat=0.10) mirror_x(tail_fan_r) {
                  rest_euler: [8, -30, -10]
                  box tail_fan_rib_l { size: [2.5, 1.5, 10.5], material: slate_fan, blend_with: [tail_fan_rib_c, tail_fan_r__tail_fan_rib_l] }
                }
              }
            }
          }
        }
      }
    }
  }
}
@materials {
  cobalt_hide: process(family=keratin_scales, coat=scale_rows, roughness=0.52)
  navy_carapace: process(family=keratin_scales, coat=banded_limb, roughness=0.42)
  kite_cream: process(family=patterned_skin, coat=striped, roughness=0.58)
  cream_belly: process(family=patterned_skin, coat=plain, roughness=0.66)
  slate_fan: process(family=keratin_scales, coat=striped, roughness=0.46)
  cryo_cyan: process(family=thin_film_iridescence, coat=plain, roughness=0.18, emissive=0.92)
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
