// Zinogre (Lord of Usurpers) — Stage 2 Secondary Anatomy, Wedged Wolf Snout & Pinecone Fulgur-Tail
// Verified 100% clean sculpted overlap (< 65% burial, 1 connected component, grounded Y = 0).
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 260
  budget max_bones = 80
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  storm_teal: ramp(base_lch=[0.49, 0.115, 206], steps=6, hue_shift=[22, -14])
  deep_teal: ramp(base_lch=[0.34, 0.095, 222], steps=6, hue_shift=[20, -12])
  teal_armor: ramp(base_lch=[0.55, 0.110, 200], steps=6, hue_shift=[20, -14])
  fulgur_gold: ramp(base_lch=[0.74, 0.130, 82], steps=6, hue_shift=[18, -14])
  ochre_dark: ramp(base_lch=[0.58, 0.115, 72], steps=6, hue_shift=[18, -12])
  shock_fur: ramp(base_lch=[0.91, 0.030, 92], steps=6, hue_shift=[24, -10])
  belly_sand: ramp(base_lch=[0.83, 0.055, 86], steps=6, hue_shift=[18, -10])
  nose_dark: ramp(base_lch=[0.22, 0.025, 245], steps=6, hue_shift=[14, -8])
  fulgur_cyan: ramp(base_lch=[0.87, 0.155, 208], steps=6, hue_shift=[12, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 19.85, -12.0]) {
      rest_euler: [8, 0, 0]
      box pelvis_core { size: [12.5, 11.0, 12.5], material: storm_teal }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.35, 0]) {
        size: [9.5, 2.0, 10.5], material: belly_sand
      }
      box haunch_muscle_l place(base_box=pelvis_core, anchor=[0.98, 0.25, -0.05], align=[-0.45, 0, 0]) {
        size: [3.5, 7.5, 9.5], material: teal_armor, rotate: [4, 6, -12], blend_with: [thigh_mass, waist_core]
      }
      box haunch_muscle_r place(base_box=pelvis_core, anchor=[-0.98, 0.25, -0.05], align=[0.45, 0, 0]) {
        size: [3.5, 7.5, 9.5], material: teal_armor, rotate: [4, -6, 12], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.15, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-5, 0, 0]
        box waist_core { size: [14.5, 13.0, 11.5], material: storm_teal }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.35, 0]) {
          size: [10.5, 2.0, 10.0], material: belly_sand, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_plate place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.45, 0]) {
          size: [8.5, 2.5, 9.5], material: ochre_dark, rotate: [-6, 0, 0], blend_with: [pelvis_core, chest_core]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.22, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [-6, 0, 0]
          box chest_core { size: [19.5, 17.0, 15.5], material: storm_teal }
          // Sculpted swept-back shock-fur mantle wedges instead of a flat white box
          box withers_mantle_c place(base_box=chest_core, anchor=[0, 0.98, 0.15], align=[0, -0.55, 0]) {
            size: [12.0, 4.5, 13.0], material: shock_fur, rotate: [-12, 0, 0], blend_with: [neck_base]
          }
          box withers_mantle_l place(base_box=chest_core, anchor=[0.68, 0.88, 0.10], align=[-0.1, -0.55, 0]) {
            size: [5.5, 4.0, 12.0], material: shock_fur, rotate: [-10, -12, -22], blend_with: [withers_mantle_c, neck_base]
          }
          box withers_mantle_r place(base_box=chest_core, anchor=[-0.68, 0.88, 0.10], align=[0.1, -0.55, 0]) {
            size: [5.5, 4.0, 12.0], material: shock_fur, rotate: [-10, 12, 22], blend_with: [withers_mantle_c, neck_base]
          }

          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.32], align=[0, 0.35, 0]) {
            size: [13.0, 2.5, 8.0], material: belly_sand, rotate: [4, 0, 0], blend_with: [waist_belly]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.96, 0.58], align=[0, 0.45, -0.25]) {
            size: [11.5, 2.5, 7.5], material: shock_fur, rotate: [-20, 0, 0], blend_with: [chest_scute_rear, fore_bracer, fore_shoulder_r__fore_bracer]
          }

          // Towering 2-Tier Raijin Fulgurbug Capacitor Fans erupting from hunched withers!
          bone capacitor_l attach(parent_box=chest_core, anchor=[0.56, 1.0, -0.18], align=[0, -0.92, 0]) mirror_x(capacitor_r) {
            rest_euler: [20, -14, -18]
            box cap_pylon_front { size: [3.0, 10.5, 4.5], material: fulgur_gold, blend_with: [withers_mantle_c, withers_mantle_l, neck_base, neck_collar_fan_l] }
            box cap_pylon_outer place(base_box=cap_pylon_front, anchor=[0.96, 0.12, -0.15], align=[-0.55, 0, 0]) {
              size: [2.5, 9.0, 4.0], material: ochre_dark, rotate: [6, -12, -18], blend_with: [chest_core, withers_mantle_l]
            }
            box cap_pylon_rear place(base_box=cap_pylon_front, anchor=[0, -0.12, -0.96], align=[0, 0, 0.48]) {
              size: [2.5, 8.0, 4.5], material: ochre_dark, rotate: [12, 0, 0], blend_with: [chest_core, withers_mantle_c, withers_mantle_l, waist_core, lumbar_plate, cap_pylon_outer]
            }
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.35, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-24, 0, 0]
            box neck_base { size: [13.5, 12.5, 9.0], material: storm_teal }
            box neck_throat_fur place(base_box=neck_base, anchor=[0, -0.96, 0.1], align=[0, 0.45, 0]) {
              size: [9.5, 2.5, 7.5], material: belly_sand, rotate: [-6, 0, 0], blend_with: [chest_scute_front, chest_core]
            }
            box neck_collar_fan_c place(base_box=neck_base, anchor=[0, 1.0, 0.42], align=[0, -0.86, 0]) {
              size: [4.5, 8.5, 3.5], material: fulgur_gold, rotate: [16, 0, 0], blend_with: [withers_mantle_c, chest_core, neck_upper, nape_crest_c]
            }
            box neck_collar_fan_l place(base_box=neck_base, anchor=[0.68, 0.96, 0.38], align=[-0.35, -0.86, 0]) {
              size: [3.5, 8.0, 3.5], material: fulgur_gold, rotate: [16, -16, -24], blend_with: [neck_collar_fan_c, withers_mantle_l, withers_mantle_c, chest_core, cap_pylon_front, neck_upper]
            }
            box neck_collar_fan_r place(base_box=neck_base, anchor=[-0.68, 0.96, 0.38], align=[0.35, -0.86, 0]) {
              size: [3.5, 8.0, 3.5], material: fulgur_gold, rotate: [16, 16, 24], blend_with: [neck_collar_fan_c, withers_mantle_r, withers_mantle_c, chest_core, capacitor_r__cap_pylon_front, neck_upper]
            }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.15, 1], align=[0, 0, -1], seat=0.26) {
              rest_euler: [14, 0, 0]
              box neck_upper { size: [10.5, 10.0, 8.0], material: shock_fur }
              box nape_crest_c place(base_box=neck_upper, anchor=[0, 0.96, -0.15], align=[0, -0.55, 0.35]) {
                size: [4.5, 3.5, 8.5], material: shock_fur, rotate: [14, 0, 0], blend_with: [neck_base, withers_mantle_c]
              }

              bone head attach(parent_box=neck_upper, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.24) {
                rest_euler: [18, 0, 0]
                box skull_core { size: [9.5, 6.5, 7.5], material: storm_teal }
                box brow_ridge_l place(base_box=skull_core, anchor=[0.82, 0.78, 0.55], align=[-0.1, -0.45, -0.3]) {
                  size: [2.5, 2.0, 5.5], material: teal_armor, rotate: [10, -12, -14]
                }
                box brow_ridge_r place(base_box=skull_core, anchor=[-0.82, 0.78, 0.55], align=[0.1, -0.45, -0.3]) {
                  size: [2.5, 2.0, 5.5], material: teal_armor, rotate: [10, 12, 14]
                }
                box cheek_jowl_l place(base_box=skull_core, anchor=[0.96, -0.22, 0.15], align=[-0.45, 0, 0]) {
                  size: [2.5, 4.0, 5.5], material: teal_armor, rotate: [6, -14, 8], blend_with: [brow_ridge_l, neck_upper]
                }
                box cheek_jowl_r place(base_box=skull_core, anchor=[-0.96, -0.22, 0.15], align=[0.45, 0, 0]) {
                  size: [2.5, 4.0, 5.5], material: teal_armor, rotate: [6, 14, -8], blend_with: [brow_ridge_r, neck_upper]
                }
                // Proudly seated glowing cyan slit eyes right under overhanging predatory brows!
                box eye_slit_l place(base_box=skull_core, anchor=[0.98, 0.48, 0.58], align=[-0.70, 0, 0]) {
                  size: [1.0, 1.5, 2.5], material: fulgur_cyan, rotate: [8, -10, 0], blend_with: [brow_ridge_l, cheek_jowl_l]
                }
                box eye_slit_r place(base_box=skull_core, anchor=[-0.98, 0.48, 0.58], align=[0.70, 0, 0]) {
                  size: [1.0, 1.5, 2.5], material: fulgur_cyan, rotate: [8, 10, 0], blend_with: [brow_ridge_r, cheek_jowl_r]
                }

                // 3D Wedged Wolf-Drake Snout
                box snout_core place(base_box=skull_core, anchor=[0, -0.15, 1], align=[0, 0, -0.78]) {
                  size: [4.5, 3.5, 6.5], material: storm_teal, rotate: [12, 0, 0], blend_with: [brow_ridge_l, brow_ridge_r, eye_slit_l, eye_slit_r]
                }
                box nasal_bridge place(base_box=snout_core, anchor=[0, 0.88, 0.05], align=[0, -0.45, 0]) {
                  size: [3.5, 2.0, 6.5], material: teal_armor, rotate: [6, 0, 0], blend_with: [skull_core, brow_ridge_l, brow_ridge_r]
                }
                box maxilla_wedge_l place(base_box=snout_core, anchor=[0.96, -0.1, -0.05], align=[-0.45, 0, 0]) {
                  size: [2.0, 3.0, 6.0], material: storm_teal, rotate: [8, -18, 8], blend_with: [skull_core, cheek_jowl_l, nasal_bridge, eye_slit_l]
                }
                box maxilla_wedge_r place(base_box=snout_core, anchor=[-0.96, -0.1, -0.05], align=[0.45, 0, 0]) {
                  size: [2.0, 3.0, 6.0], material: storm_teal, rotate: [8, 18, -8], blend_with: [skull_core, cheek_jowl_r, nasal_bridge, eye_slit_r]
                }
                box nose_tip place(base_box=snout_core, anchor=[0, 0.15, 0.96], align=[0, 0, -0.55]) {
                  size: [3.0, 2.5, 2.5], material: nose_dark, rotate: [14, 0, 0], blend_with: [nasal_bridge, maxilla_wedge_l, maxilla_wedge_r]
                }

                bone ear_l attach(parent_box=skull_core, anchor=[0.92, 0.45, -0.22], align=[0, 0, 0.88]) mirror_x(ear_r) {
                  rest_euler: [18, -32, 14]
                  box ear_blade { size: [2.0, 2.5, 7.5], material: teal_armor, blend_with: [cheek_jowl_l, neck_upper, brow_ridge_l] }
                }

                // Iconic Twin Ridged Golden Brow Horns jutting BOLDLY FORWARD & UPWARD over the snout!
                bone horn_l attach(parent_box=skull_core, anchor=[0.52, 0.98, 0.80], align=[0, -0.40, -0.95], seat=0.05) mirror_x(horn_r) {
                  rest_euler: [-24, 15, -8]
                  box horn_seg_1 { size: [3.0, 2.5, 5.0], material: fulgur_gold, blend_with: [brow_ridge_l, snout_core, nasal_bridge, horn_r__horn_seg_1] }
                  bone horn_mid_l attach(parent_box=horn_seg_1, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.22) {
                    rest_euler: [12, -5, 0]
                    box horn_seg_2 { size: [2.5, 2.0, 4.5], material: fulgur_gold, blend_with: [nasal_bridge] }
                    bone horn_tip_l attach(parent_box=horn_seg_2, anchor=[0, 0.02, 1], align=[0, 0, -1], seat=0.22) {
                      rest_euler: [14, -4, 0]
                      box horn_seg_3 { size: [1.5, 1.5, 4.0], material: ochre_dark }
                    }
                  }
                }

                bone jaw attach(parent_box=skull_core, anchor=[0, -0.68, 0.22], align=[0, 0, -1], seat=0.16) {
                  rest_euler: [6, 0, 0]
                  box jaw_core { size: [4.0, 2.5, 8.0], material: deep_teal, blend_with: [cheek_jowl_l, cheek_jowl_r, snout_core] }
                  box chin_beard place(base_box=jaw_core, anchor=[0, -0.92, -0.1], align=[0, -0.2, 0]) {
                    size: [3.5, 2.5, 6.0], material: shock_fur, rotate: [-18, 0, 0], blend_with: [neck_upper]
                  }
                  box mandible_tusk_l place(base_box=jaw_core, anchor=[0.90, -0.35, 0.15], align=[-0.1, 0.72, 0]) {
                    size: [1.5, 3.5, 2.0], material: fulgur_gold, rotate: [24, -14, 16], blend_with: [chin_beard]
                  }
                  box mandible_tusk_r place(base_box=jaw_core, anchor=[-0.90, -0.35, 0.15], align=[0.1, 0.72, 0]) {
                    size: [1.5, 3.5, 2.0], material: fulgur_gold, rotate: [24, 14, -16], blend_with: [chin_beard]
                  }
                }
              }
            }
          }

          bone fore_shoulder_l attach(parent_box=chest_core, anchor=[0.95, -0.15, 0.42], align=[-0.55, 0.82, 0], seat=0.12) mirror_x(fore_shoulder_r) {
            rest_euler: [18, 6, 22]
            box fore_bicep { size: [8.0, 11.0, 8.5], material: storm_teal }
            box pauldron_plate place(base_box=fore_bicep, anchor=[0.98, 0.32, 0.08], align=[-0.45, 0, 0]) {
              size: [2.5, 6.5, 7.0], material: fulgur_gold, rotate: [-8, 8, -12], blend_with: [chest_core]
            }
            box elbow_fur_wedge place(base_box=fore_bicep, anchor=[0.2, -0.78, -0.92], align=[0, 0, 0.65]) {
              size: [4.5, 4.5, 6.0], material: shock_fur, rotate: [22, 0, 0], blend_with: [fore_bracer]
            }

            bone fore_arm_l attach(parent_box=fore_bicep, anchor=[0.1, -1, -0.05], align=[0, 0.88, 0], seat=0.18) {
              rest_euler: [-30, 0, -14]
              box fore_bracer { size: [7.5, 11.5, 8.0], material: storm_teal, blend_with: [chest_core] }
              // Diagonal outward/backward-sweeping golden carapace bracer spurs (like @zyhfisme's Zinogre!)
              box bracer_spur_1 place(base_box=fore_bracer, anchor=[0.96, 0.50, 0.20], align=[-0.45, 0, 0.35]) {
                size: [3.0, 2.5, 7.0], material: fulgur_gold, rotate: [18, 28, -14], blend_with: [fore_bicep, pauldron_plate, elbow_fur_wedge]
              }
              box bracer_spur_2 place(base_box=fore_bracer, anchor=[0.96, 0.02, 0.22], align=[-0.45, 0, 0.35]) {
                size: [3.0, 2.5, 7.0], material: fulgur_gold, rotate: [18, 28, -14], blend_with: [bracer_spur_1, elbow_fur_wedge]
              }
              box bracer_spur_3 place(base_box=fore_bracer, anchor=[0.96, -0.46, 0.22], align=[-0.68, 0, 0.35]) {
                size: [2.5, 2.5, 6.5], material: ochre_dark, rotate: [18, 28, -14], blend_with: [bracer_spur_2, fore_paw_pad]
              }

              bone fore_paw_l attach(parent_box=fore_bracer, anchor=[0, -1, 0.15], align=[0, 0.85, -0.45], seat=0.16) {
                rest_euler: [15, 0, -8]
                box fore_paw_pad { size: [8.5, 3.5, 7.5], material: deep_teal }
                box f_toe_1 place(base_box=fore_paw_pad, anchor=[-0.68, -0.15, 0.92], align=[0, 0, -0.75]) {
                  size: [2.0, 2.5, 4.0], material: teal_armor, rotate: [4, 16, 0]
                }
                box f_toe_2 place(base_box=fore_paw_pad, anchor=[-0.22, -0.15, 0.96], align=[0, 0, -0.78]) {
                  size: [2.0, 2.5, 4.5], material: teal_armor, rotate: [4, 5, 0], blend_with: [f_toe_1]
                }
                box f_toe_3 place(base_box=fore_paw_pad, anchor=[0.24, -0.15, 0.96], align=[0, 0, -0.78]) {
                  size: [2.0, 2.5, 4.5], material: teal_armor, rotate: [4, -6, 0], blend_with: [f_toe_2]
                }
                box f_toe_4 place(base_box=fore_paw_pad, anchor=[0.70, -0.15, 0.90], align=[0, 0, -0.75]) {
                  size: [2.0, 2.5, 4.0], material: teal_armor, rotate: [4, -18, 0], blend_with: [f_toe_3]
                }
              }
            }
          }
        }
      }

      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.96, -0.10, -0.05], align=[-0.55, 0.85, 0], seat=0.12) mirror_x(hind_thigh_r) {
        rest_euler: [-22, -6, 18]
        box thigh_mass { size: [6.5, 11.5, 8.0], material: storm_teal, blend_with: [waist_core, tail_1_tail_seg] }
        box thigh_plate place(base_box=thigh_mass, anchor=[0.98, 0.2, 0.08], align=[-0.45, 0, 0]) {
          size: [2.5, 6.5, 6.0], material: teal_armor, rotate: [6, -8, -10], blend_with: [pelvis_core, haunch_muscle_l]
        }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [40, 0, -10]
          box shin_mass { size: [5.0, 10.0, 5.5], material: storm_teal }
          box hock_spur place(base_box=shin_mass, anchor=[0, 0.65, -0.90], align=[0, 0, 0.65]) {
            size: [3.5, 3.5, 4.0], material: fulgur_gold, rotate: [20, 0, 0], blend_with: [thigh_mass]
          }

          bone hind_paw_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.42], seat=0.14) {
            rest_euler: [-26, 0, -8]
            box hind_paw_pad { size: [6.5, 3.0, 7.0], material: deep_teal }
            box h_toe_1 place(base_box=hind_paw_pad, anchor=[-0.62, -0.12, 0.92], align=[0, 0, -0.75]) {
              size: [2.0, 2.0, 3.5], material: teal_armor, rotate: [4, 14, 0]
            }
            box h_toe_2 place(base_box=hind_paw_pad, anchor=[0.0, -0.12, 0.96], align=[0, 0, -0.78]) {
              size: [2.0, 2.0, 4.0], material: teal_armor, rotate: [4, 0, 0], blend_with: [h_toe_1]
            }
            box h_toe_3 place(base_box=hind_paw_pad, anchor=[0.62, -0.12, 0.92], align=[0, 0, -0.75]) {
              size: [2.0, 2.0, 3.5], material: teal_armor, rotate: [4, -14, 0], blend_with: [h_toe_2]
            }
          }
        }
      }

      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.25, -1], align=[0, 0, 1], seat=0.24) {
        rest_euler: [-4, 0, 0]
        box tail_1_tail_seg { size: [9.5, 8.5, 8.5], material: storm_teal }
        box tail_1_plate place(base_box=tail_1_tail_seg, anchor=[0, 0.95, 0], align=[0, -0.45, 0]) {
          size: [7.0, 2.5, 7.5], material: ochre_dark, rotate: [10, 0, 0], blend_with: [pelvis_core]
        }

        bone tail_2 attach(parent_box=tail_1_tail_seg, anchor=[0, 0.08, -1], align=[0, 0, 1], seat=0.24) {
          rest_euler: [15, 0, 0]
          box tail_2_seg { size: [8.5, 8.0, 8.5], material: storm_teal }
          box tail_2_blade_l place(base_box=tail_2_seg, anchor=[0.95, 0.25, -0.15], align=[-0.45, 0, 0.45]) {
            size: [3.0, 3.5, 7.5], material: fulgur_gold, rotate: [12, 26, -14], blend_with: [tail_1_tail_seg, tail_3_seg]
          }
          box tail_2_blade_r place(base_box=tail_2_seg, anchor=[-0.95, 0.25, -0.15], align=[0.45, 0, 0.45]) {
            size: [3.0, 3.5, 7.5], material: fulgur_gold, rotate: [12, -26, 14], blend_with: [tail_1_tail_seg, tail_3_seg]
          }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.08, -1], align=[0, 0, 1], seat=0.24) {
            rest_euler: [20, 0, 0]
            box tail_3_seg { size: [7.5, 7.5, 8.5], material: storm_teal }
            box tail_3_blade_l place(base_box=tail_3_seg, anchor=[0.96, 0.22, -0.2], align=[-0.48, 0, 0.55]) {
              size: [4.0, 4.0, 9.5], material: fulgur_gold, rotate: [14, 32, -16], blend_with: [tail_2_seg, tail_2_blade_l, tail_4_seg]
            }
            box tail_3_blade_r place(base_box=tail_3_seg, anchor=[-0.96, 0.22, -0.2], align=[0.48, 0, 0.55]) {
              size: [4.0, 4.0, 9.5], material: fulgur_gold, rotate: [14, -32, 16], blend_with: [tail_2_seg, tail_2_blade_r, tail_4_seg]
            }
            box tail_3_fur place(base_box=tail_3_seg, anchor=[0, 0.96, 0], align=[0, -0.45, 0]) {
              size: [4.5, 3.5, 7.5], material: shock_fur, rotate: [12, 0, 0], blend_with: [tail_2_seg]
            }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.08, -1], align=[0, 0, 1], seat=0.24) {
              rest_euler: [22, 0, 0]
              box tail_4_seg { size: [7.0, 7.0, 8.5], material: storm_teal }
              box tail_4_blade_l place(base_box=tail_4_seg, anchor=[0.96, 0.20, -0.22], align=[-0.50, 0, 0.58]) {
                size: [5.0, 4.5, 11.0], material: fulgur_gold, rotate: [16, 36, -18], blend_with: [tail_3_seg, tail_3_blade_l, tail_5_seg]
              }
              box tail_4_blade_r place(base_box=tail_4_seg, anchor=[-0.96, 0.20, -0.22], align=[0.50, 0, 0.58]) {
                size: [5.0, 4.5, 11.0], material: fulgur_gold, rotate: [16, -36, 18], blend_with: [tail_3_seg, tail_3_blade_r, tail_5_seg]
              }
              box tail_4_fur place(base_box=tail_4_seg, anchor=[0, 0.96, 0], align=[0, -0.45, 0]) {
                size: [4.5, 4.0, 8.0], material: shock_fur, rotate: [14, 0, 0], blend_with: [tail_3_fur, tail_3_seg]
              }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.08, -1], align=[0, 0, 1], seat=0.24) {
                rest_euler: [16, 0, 0]
                box tail_5_seg { size: [6.0, 6.0, 8.0], material: storm_teal }
                box tail_5_blade_l place(base_box=tail_5_seg, anchor=[0.95, 0.18, -0.2], align=[-0.48, 0, 0.58]) {
                  size: [4.5, 4.0, 10.5], material: ochre_dark, rotate: [14, 32, -16], blend_with: [tail_4_seg, tail_4_blade_l, tail_6_tip]
                }
                box tail_5_blade_r place(base_box=tail_5_seg, anchor=[-0.95, 0.18, -0.2], align=[0.48, 0, 0.58]) {
                  size: [4.5, 4.0, 10.5], material: ochre_dark, rotate: [14, -32, 16], blend_with: [tail_4_seg, tail_4_blade_r, tail_6_tip]
                }

                bone tail_6 attach(parent_box=tail_5_seg, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.22) {
                  rest_euler: [8, 0, 0]
                  box tail_6_tip { size: [4.5, 4.5, 8.5], material: fulgur_gold }
                  box tail_tip_spear place(base_box=tail_6_tip, anchor=[0, 0.1, -0.94], align=[0, 0, 0.72]) {
                    size: [3.0, 3.0, 6.5], material: ochre_dark, rotate: [8, 0, 0]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
