// Zinogre (Lord of Usurpers) — Stage 3 Sculpted Blockbench Masterwork (V9 Gold Standard)
// Hand-authored progressive Block-DSL v4.1 modeled from @zyhfisme's sculpted Zinogre style anchor
// & official Monster Hunter anatomy: wedged 3D wolf-drake snout, forward-jutting ridged golden brow
// horns, 2-tier Raijin fulgurbug capacitor crowns, spiky alpha-cut shock-fur planes, diagonal
// outward-swept forearm carapace spurs, 4-toed cyan-charged talons, & flared pinecone fulgur-tail.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 400
  budget max_bones = 96
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  storm_teal: ramp(base_lch=[0.48, 0.118, 206], steps=6, hue_shift=[24, -14])
  deep_teal: ramp(base_lch=[0.33, 0.098, 224], steps=6, hue_shift=[22, -12])
  teal_armor: ramp(base_lch=[0.55, 0.115, 199], steps=6, hue_shift=[20, -14])
  fulgur_gold: ramp(base_lch=[0.74, 0.134, 82], steps=6, hue_shift=[20, -14])
  ochre_dark: ramp(base_lch=[0.56, 0.118, 70], steps=6, hue_shift=[18, -12])
  shock_fur: ramp(base_lch=[0.91, 0.030, 92], steps=6, hue_shift=[24, -10])
  belly_sand: ramp(base_lch=[0.82, 0.058, 86], steps=6, hue_shift=[18, -10])
  ivory_claw: ramp(base_lch=[0.88, 0.042, 88], steps=6, hue_shift=[18, -10])
  mouth_crimson: ramp(base_lch=[0.36, 0.125, 22], steps=6, hue_shift=[16, -10])
  nose_dark: ramp(base_lch=[0.21, 0.028, 246], steps=6, hue_shift=[14, -8])
  fulgur_cyan: ramp(base_lch=[0.87, 0.160, 206], steps=6, hue_shift=[12, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 19.85, -12.0]) {
      rest_euler: [8, 0, 0]
      box pelvis_core { size: [12.5, 11.0, 12.5], material: storm_teal }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.35, 0]) {
        size: [9.5, 2.0, 10.5], material: belly_sand
      }
      box sacrum_ridge place(base_box=pelvis_core, anchor=[0, 0.98, -0.10], align=[0, -0.55, 0]) {
        size: [7.5, 2.5, 10.0], material: ochre_dark, rotate: [6, 0, 0], blend_with: [lumbar_plate, tail_1_tail_seg, tail_1_plate]
      }
      box sacrum_stud_1 place(base_box=sacrum_ridge, anchor=[0, 0.96, 0.35], align=[0, -0.75, 0]) {
        size: [2.5, 2.5, 3.0], material: fulgur_gold, rotate: [18, 0, 0], blend_with: [pelvis_core, lumbar_plate]
      }
      box sacrum_stud_2 place(base_box=sacrum_ridge, anchor=[0, 0.96, -0.38], align=[0, -0.75, 0]) {
        size: [2.5, 2.5, 3.0], material: fulgur_gold, rotate: [20, 0, 0], blend_with: [pelvis_core, tail_1_plate]
      }
      box haunch_muscle_l place(base_box=pelvis_core, anchor=[0.98, 0.25, -0.05], align=[-0.45, 0, 0]) {
        size: [3.5, 7.5, 9.5], material: teal_armor, rotate: [4, 6, -12], blend_with: [thigh_mass, waist_core]
      }
      box haunch_muscle_r place(base_box=pelvis_core, anchor=[-0.98, 0.25, -0.05], align=[0.45, 0, 0]) {
        size: [3.5, 7.5, 9.5], material: teal_armor, rotate: [4, -6, 12], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }
      box hip_spur_l place(base_box=haunch_muscle_l, anchor=[0.92, 0.45, -0.35], align=[-0.65, 0, 0.35]) {
        size: [2.0, 2.5, 5.5], material: fulgur_gold, rotate: [14, 24, -14], blend_with: [pelvis_core, thigh_mass, thigh_plate]
      }
      box hip_spur_r place(base_box=haunch_muscle_r, anchor=[-0.92, 0.45, -0.35], align=[0.65, 0, 0.35]) {
        size: [2.0, 2.5, 5.5], material: fulgur_gold, rotate: [14, -24, 14], blend_with: [pelvis_core, hind_thigh_r__thigh_mass, hind_thigh_r__thigh_plate]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.15, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-5, 0, 0]
        box waist_core { size: [14.5, 13.0, 11.5], material: storm_teal }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.35, 0]) {
          size: [10.5, 2.0, 10.0], material: belly_sand, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_plate place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.50, 0]) {
          size: [8.5, 2.5, 9.5], material: ochre_dark, rotate: [-6, 0, 0], blend_with: [pelvis_core, chest_core]
        }
        box lumbar_fulgur_spike_1 place(base_box=lumbar_plate, anchor=[0, 0.96, 0.32], align=[0, -0.78, 0]) {
          size: [3.0, 3.5, 3.5], material: fulgur_gold, rotate: [20, 0, 0], blend_with: [waist_core, chest_core, withers_mantle_c]
        }
        box lumbar_fulgur_spike_2 place(base_box=lumbar_plate, anchor=[0, 0.96, -0.35], align=[0, -0.78, 0]) {
          size: [2.5, 3.0, 3.5], material: fulgur_gold, rotate: [22, 0, 0], blend_with: [waist_core, pelvis_core, sacrum_ridge]
        }
        box flank_shingle_l_1 place(base_box=waist_core, anchor=[0.98, 0.35, 0.25], align=[-0.65, 0, 0]) {
          size: [2.0, 4.5, 4.5], material: teal_armor, rotate: [8, 12, -14], blend_with: [chest_core]
        }
        box flank_shingle_r_1 place(base_box=waist_core, anchor=[-0.98, 0.35, 0.25], align=[0.65, 0, 0]) {
          size: [2.0, 4.5, 4.5], material: teal_armor, rotate: [8, -12, 14], blend_with: [chest_core]
        }
        box flank_shingle_l_2 place(base_box=waist_core, anchor=[0.98, -0.10, -0.22], align=[-0.65, 0, 0]) {
          size: [2.0, 4.5, 4.5], material: teal_armor, rotate: [6, 14, -10], blend_with: [flank_shingle_l_1, pelvis_core, haunch_muscle_l, thigh_mass]
        }
        box flank_shingle_r_2 place(base_box=waist_core, anchor=[-0.98, -0.10, -0.22], align=[0.65, 0, 0]) {
          size: [2.0, 4.5, 4.5], material: teal_armor, rotate: [6, -14, 10], blend_with: [flank_shingle_r_1, pelvis_core, haunch_muscle_r, hind_thigh_r__thigh_mass]
        }
        plane waist_fur_tuft_l place(base_box=waist_core, anchor=[1.0, 0.65, -0.10], align=[-1.0, -0.5, 0]) {
          size: [8.0, 4.5], normal: x, material: shock_fur, rotate: [8, 12, -24],
          edge: spikes(width=2, min_len=3, max_len=7, side=top, seed=13), layer: 1,
          blend_with: [lumbar_plate, flank_shingle_l_1, chest_core, pelvis_core]
        }
        plane waist_fur_tuft_r place(base_box=waist_core, anchor=[-1.0, 0.65, -0.10], align=[1.0, -0.5, 0]) {
          size: [8.0, 4.5], normal: x, material: shock_fur, rotate: [8, -12, 24],
          edge: spikes(width=2, min_len=3, max_len=7, side=top, seed=13), layer: 1,
          blend_with: [lumbar_plate, flank_shingle_r_1, chest_core, pelvis_core]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.22, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [-6, 0, 0]
          box chest_core { size: [19.5, 17.0, 15.5], material: storm_teal }
          box withers_mantle_c place(base_box=chest_core, anchor=[0, 0.98, 0.15], align=[0, -0.55, 0]) {
            size: [12.0, 4.5, 13.0], material: shock_fur, rotate: [-12, 0, 0], blend_with: [neck_base, lumbar_fulgur_spike_1]
          }
          box withers_mantle_l place(base_box=chest_core, anchor=[0.68, 0.88, 0.10], align=[-0.1, -0.55, 0]) {
            size: [5.5, 4.0, 12.0], material: shock_fur, rotate: [-10, -12, -22], blend_with: [withers_mantle_c, neck_base]
          }
          box withers_mantle_r place(base_box=chest_core, anchor=[-0.68, 0.88, 0.10], align=[0.1, -0.55, 0]) {
            size: [5.5, 4.0, 12.0], material: shock_fur, rotate: [-10, 12, 22], blend_with: [withers_mantle_c, neck_base]
          }
          // Glowing dorsal fulgurbug conduit seam nestled between the capacitor pylons
          box dorsal_fulgur_core place(base_box=withers_mantle_c, anchor=[0, 0.98, -0.18], align=[0, -0.78, 0]) {
            size: [3.0, 3.0, 7.5], material: fulgur_cyan, rotate: [6, 0, 0], blend_with: [chest_core, cap_pylon_front, capacitor_r__cap_pylon_front]
          }
          // Spiky alabaster shock-fur plane crests erupting atop the hunched shoulders!
          plane withers_fur_crest_c place(base_box=withers_mantle_c, anchor=[0, 0.92, 0.48], align=[0, -0.78, 0]) {
            size: [11.0, 6.5], normal: z, material: shock_fur, rotate: [18, 0, 0],
            edge: spikes(width=2, min_len=4, max_len=9, side=top, seed=21), layer: 1,
            blend_with: [dorsal_fulgur_core, cap_pylon_front, capacitor_r__cap_pylon_front, neck_base, neck_collar_fan_c]
          }
          plane withers_fur_crest_rear place(base_box=withers_mantle_c, anchor=[0, 0.90, -0.78], align=[0, -0.78, 0]) {
            size: [9.5, 5.5], normal: z, material: shock_fur, rotate: [26, 0, 0],
            edge: spikes(width=2, min_len=4, max_len=9, side=top, seed=25), layer: 2,
            blend_with: [dorsal_fulgur_core, cap_pylon_rear, capacitor_r__cap_pylon_rear, waist_core, lumbar_plate, lumbar_fulgur_spike_1]
          }
          plane withers_fur_plume_l place(base_box=withers_mantle_l, anchor=[0.85, 1.0, -0.10], align=[0, -1.0, 0]) {
            size: [10.0, 5.5], normal: x, material: shock_fur, rotate: [10, -14, -28],
            edge: spikes(width=2, min_len=4, max_len=9, side=top, seed=29), layer: 2,
            blend_with: [withers_mantle_c, chest_core, cap_pylon_front, cap_pylon_outer, cap_pylon_rear]
          }
          plane withers_fur_plume_r place(base_box=withers_mantle_r, anchor=[-0.85, 1.0, -0.10], align=[0, -1.0, 0]) {
            size: [10.0, 5.5], normal: x, material: shock_fur, rotate: [10, 14, 28],
            edge: spikes(width=2, min_len=4, max_len=9, side=top, seed=29), layer: 2,
            blend_with: [withers_mantle_c, chest_core, capacitor_r__cap_pylon_front, capacitor_r__cap_pylon_outer, capacitor_r__cap_pylon_rear]
          }

          // Ribcage storm-teal & golden carapace flank shingles
          box rib_armor_l_1 place(base_box=chest_core, anchor=[0.99, 0.28, -0.22], align=[-0.72, 0, 0]) {
            size: [2.0, 5.5, 5.5], material: teal_armor, rotate: [8, 12, -10], blend_with: [withers_mantle_l, fore_bicep, flank_shingle_l_1, waist_core]
          }
          box rib_armor_r_1 place(base_box=chest_core, anchor=[-0.99, 0.28, -0.22], align=[0.72, 0, 0]) {
            size: [2.0, 5.5, 5.5], material: teal_armor, rotate: [8, -12, 10], blend_with: [withers_mantle_r, fore_shoulder_r__fore_bicep, flank_shingle_r_1, waist_core]
          }
          box rib_armor_l_2 place(base_box=chest_core, anchor=[0.99, -0.22, -0.35], align=[-0.72, 0, 0]) {
            size: [2.0, 5.0, 5.5], material: teal_armor, rotate: [6, 14, -8], blend_with: [rib_armor_l_1, fore_bicep, fore_bracer, flank_shingle_l_1, flank_shingle_l_2, waist_core]
          }
          box rib_armor_r_2 place(base_box=chest_core, anchor=[-0.99, -0.22, -0.35], align=[0.72, 0, 0]) {
            size: [2.0, 5.0, 5.5], material: teal_armor, rotate: [6, -14, 8], blend_with: [rib_armor_r_1, fore_shoulder_r__fore_bicep, fore_shoulder_r__fore_bracer, flank_shingle_r_1, flank_shingle_r_2, waist_core]
          }
          box rib_fulgur_stud_l place(base_box=rib_armor_l_1, anchor=[0.96, 0.20, 0], align=[-0.78, 0, 0]) {
            size: [1.5, 2.0, 3.0], material: fulgur_gold, rotate: [12, 18, -16], blend_with: [chest_core, fore_bicep]
          }
          box rib_fulgur_stud_r place(base_box=rib_armor_r_1, anchor=[-0.96, 0.20, 0], align=[0.78, 0, 0]) {
            size: [1.5, 2.0, 3.0], material: fulgur_gold, rotate: [12, -18, 16], blend_with: [chest_core, fore_shoulder_r__fore_bicep]
          }
          box rib_fulgur_stud_l_2 place(base_box=rib_armor_l_2, anchor=[0.96, 0.15, -0.15], align=[-0.78, 0, 0]) {
            size: [1.5, 2.0, 3.0], material: fulgur_gold, rotate: [12, 18, -14], blend_with: [chest_core, waist_core, fore_bicep]
          }
          box rib_fulgur_stud_r_2 place(base_box=rib_armor_r_2, anchor=[-0.96, 0.15, -0.15], align=[0.78, 0, 0]) {
            size: [1.5, 2.0, 3.0], material: fulgur_gold, rotate: [12, -18, 14], blend_with: [chest_core, waist_core, fore_shoulder_r__fore_bicep]
          }

          // Hugged ventral sternum & chest scutes (never protruding ladder planks!)
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.35], align=[0, 0.35, 0]) {
            size: [13.0, 2.5, 7.5], material: belly_sand, rotate: [4, 0, 0], blend_with: [waist_belly]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.96, 0.56], align=[0, 0.45, -0.25]) {
            size: [11.5, 2.5, 7.5], material: belly_sand, rotate: [-20, 0, 0], blend_with: [chest_scute_rear, fore_bracer, fore_shoulder_r__fore_bracer]
          }
          box sternum_keel place(base_box=chest_scute_front, anchor=[0, -0.96, 0.25], align=[0, 0.72, 0]) {
            size: [5.5, 2.0, 5.5], material: fulgur_gold, rotate: [-12, 0, 0], blend_with: [chest_core, neck_throat_fur, fore_bicep, fore_shoulder_r__fore_bicep]
          }
          plane chest_ruff_plane_l place(base_box=chest_core, anchor=[0.65, -0.82, 0.92], align=[0, 0.65, -0.85]) {
            size: [6.0, 5.0], normal: z, material: shock_fur, rotate: [-24, -18, -12],
            edge: spikes(width=2, min_len=3, max_len=7, side=bottom, seed=37), layer: 1,
            blend_with: [chest_scute_front, sternum_keel, neck_throat_fur, fore_bicep]
          }
          plane chest_ruff_plane_r place(base_box=chest_core, anchor=[-0.65, -0.82, 0.92], align=[0, 0.65, -0.85]) {
            size: [6.0, 5.0], normal: z, material: shock_fur, rotate: [-24, 18, 12],
            edge: spikes(width=2, min_len=3, max_len=7, side=bottom, seed=37), layer: 1,
            blend_with: [chest_scute_front, sternum_keel, neck_throat_fur, fore_shoulder_r__fore_bicep]
          }

          // Towering 2-Tier Raijin Fulgurbug Capacitor Fans erupting from hunched withers!
          bone capacitor_l attach(parent_box=chest_core, anchor=[0.56, 1.0, -0.18], align=[0, -0.92, 0]) mirror_x(capacitor_r) {
            rest_euler: [20, -14, -18]
            box cap_pylon_front { size: [3.0, 10.5, 4.5], material: fulgur_gold, blend_with: [withers_mantle_c, withers_mantle_l, neck_base, neck_collar_fan_l] }
            box cap_pylon_outer place(base_box=cap_pylon_front, anchor=[0.96, 0.12, -0.15], align=[-0.55, 0, 0]) {
              size: [2.5, 9.0, 4.0], material: ochre_dark, rotate: [6, -12, -18], blend_with: [chest_core, withers_mantle_l]
            }
            box cap_pylon_rear place(base_box=cap_pylon_front, anchor=[0, -0.12, -0.96], align=[0, 0, 0.48]) {
              size: [2.5, 8.0, 4.5], material: ochre_dark, rotate: [12, 0, 0], blend_with: [chest_core, withers_mantle_c, withers_mantle_l, waist_core, lumbar_plate, cap_pylon_outer]
            }
            box cap_fulgur_crystal place(base_box=cap_pylon_front, anchor=[-0.88, 0.35, 0.10], align=[0.65, 0, 0]) {
              size: [1.5, 5.0, 2.5], material: fulgur_cyan, rotate: [4, 0, 8], blend_with: [dorsal_fulgur_core, withers_mantle_c]
            }
            box cap_outer_barb place(base_box=cap_pylon_outer, anchor=[0.92, 0.35, -0.25], align=[-0.78, 0, 0]) {
              size: [1.5, 5.5, 2.5], material: fulgur_gold, rotate: [8, -14, -22]
            }
            box cap_rear_crystal place(base_box=cap_pylon_rear, anchor=[-0.85, 0.30, -0.10], align=[0.75, 0, 0]) {
              size: [1.5, 4.0, 2.5], material: fulgur_cyan, rotate: [8, 0, 6], blend_with: [dorsal_fulgur_core, withers_mantle_c, cap_pylon_front]
            }
            plane cap_shock_plume place(base_box=cap_pylon_rear, anchor=[0.2, 0.92, -0.85], align=[0, -0.85, 0.85]) {
              size: [5.5, 6.5], normal: x, material: shock_fur, rotate: [22, 0, -8],
              edge: spikes(width=2, min_len=4, max_len=9, side=top, seed=41), layer: 2,
              blend_with: [cap_pylon_front, cap_pylon_outer, withers_mantle_l]
            }
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.35, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-24, 0, 0]
            box neck_base { size: [13.5, 12.5, 9.0], material: storm_teal }
            box neck_throat_fur place(base_box=neck_base, anchor=[0, -0.96, 0.1], align=[0, 0.45, 0]) {
              size: [9.5, 2.5, 7.5], material: belly_sand, rotate: [-6, 0, 0], blend_with: [chest_scute_front, chest_core]
            }
            box neck_throat_scute_2 place(base_box=neck_throat_fur, anchor=[0, -0.96, 0.35], align=[0, 0.72, 0]) {
              size: [6.5, 1.5, 5.0], material: teal_armor, rotate: [-8, 0, 0], blend_with: [neck_base, chest_scute_front, sternum_keel]
            }
            // Front-tier Raijin thunder-collar fan (like @zyhfisme's fanned gold/cyan neck crown!)
            box neck_collar_fan_c place(base_box=neck_base, anchor=[0, 1.0, 0.42], align=[0, -0.86, 0]) {
              size: [4.5, 8.5, 3.5], material: fulgur_gold, rotate: [16, 0, 0], blend_with: [withers_mantle_c, chest_core, neck_upper, nape_crest_c]
            }
            box neck_collar_fan_l place(base_box=neck_base, anchor=[0.68, 0.96, 0.38], align=[-0.35, -0.86, 0]) {
              size: [3.5, 8.0, 3.5], material: fulgur_gold, rotate: [16, -16, -24], blend_with: [neck_collar_fan_c, withers_mantle_l, withers_mantle_c, chest_core, cap_pylon_front, neck_upper]
            }
            box neck_collar_fan_r place(base_box=neck_base, anchor=[-0.68, 0.96, 0.38], align=[0.35, -0.86, 0]) {
              size: [3.5, 8.0, 3.5], material: fulgur_gold, rotate: [16, 16, 24], blend_with: [neck_collar_fan_c, withers_mantle_r, withers_mantle_c, chest_core, capacitor_r__cap_pylon_front, neck_upper]
            }
            box neck_collar_outer_l place(base_box=neck_base, anchor=[0.98, 0.55, 0.32], align=[-0.72, -0.55, 0]) {
              size: [3.0, 6.5, 3.5], material: ochre_dark, rotate: [14, -22, -38], blend_with: [neck_collar_fan_l, withers_mantle_l, chest_core, fore_bicep]
            }
            box neck_collar_outer_r place(base_box=neck_base, anchor=[-0.98, 0.55, 0.32], align=[0.72, -0.55, 0]) {
              size: [3.0, 6.5, 3.5], material: ochre_dark, rotate: [14, 22, 38], blend_with: [neck_collar_fan_r, withers_mantle_r, chest_core, fore_shoulder_r__fore_bicep]
            }
            plane neck_mane_plane_c place(base_box=neck_collar_fan_c, anchor=[0, 0.95, -0.85], align=[0, -0.85, 0]) {
              size: [11.0, 5.5], normal: z, material: shock_fur, rotate: [12, 0, 0],
              edge: spikes(width=2, min_len=4, max_len=9, side=top, seed=53), layer: 1,
              blend_with: [neck_collar_fan_l, neck_collar_fan_r, withers_mantle_c, withers_fur_crest_c]
            }
            plane neck_side_ruff_l place(base_box=neck_base, anchor=[1.0, 0.05, 0.15], align=[-1.0, 0, 0]) {
              size: [7.5, 5.5], normal: x, material: shock_fur, rotate: [6, 18, -18],
              edge: spikes(width=2, min_len=3, max_len=7, side=top, seed=59), layer: 1,
              blend_with: [neck_collar_outer_l, chest_core, fore_bicep]
            }
            plane neck_side_ruff_r place(base_box=neck_base, anchor=[-1.0, 0.05, 0.15], align=[1.0, 0, 0]) {
