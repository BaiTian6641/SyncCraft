            size: [3.5, 7.0, 2.0], material: teal_armor, rotate: [4, 0, 0], blend_with: [thigh_mass, knee_cap, hind_paw_pad]
          }
          box hock_spur place(base_box=shin_mass, anchor=[0, 0.65, -0.92], align=[0, 0, 0.68]) {
            size: [3.5, 3.5, 4.0], material: fulgur_gold, rotate: [20, 0, 0], blend_with: [thigh_mass]
          }
          plane ankle_fur_tuft place(base_box=shin_mass, anchor=[0.25, -0.35, -0.98], align=[0, 0, 0.88]) {
            size: [4.5, 5.0], normal: x, material: shock_fur, rotate: [10, 10, 0],
