    }
  }
}
@materials {
  storm_teal: process(family=keratin_scales, coat=scale_rows, roughness=0.58)
  deep_teal: process(family=keratin_scales, coat=banded_limb, roughness=0.64)
  teal_armor: process(family=keratin_scales, coat=scale_rows, roughness=0.44)
  fulgur_gold: process(family=painted_metal, coat=striped, roughness=0.36)
  ochre_dark: process(family=weathered_stone, coat=plain, roughness=0.46)
  shock_fur: process(family=woven_fabric, coat=striped, roughness=0.76)
  belly_sand: process(family=patterned_skin, coat=plain, roughness=0.68)
  ivory_claw: process(family=polymer_dielectric, coat=plain, roughness=0.28)
  mouth_crimson: process(family=patterned_skin, coat=plain, roughness=0.45)
  nose_dark: process(family=patterned_skin, coat=plain, roughness=0.52)
  fulgur_cyan: process(family=thin_film_iridescence, coat=plain, roughness=0.18, emissive=0.95)
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
@stamps {
  stamp fulgur_eye_spark on skull_core.east { at: [0.72, 0.34], size: [1.5, 1.0], color: fulgur_cyan, emissive: 0.95, mirror: true }
  stamp collar_charge_seam on neck_collar_fan_c.south { at: [0.50, 0.45], size: [2.5, 1.0], rows: 2, spacing: 2.0, color: fulgur_cyan, emissive: 0.92 }
  stamp bracer_charge_vein on pauldron_plate.east { at: [0.48, 0.42], size: [1.5, 2.5], color: fulgur_cyan, emissive: 0.88, mirror: true }
}
@behavior {
  spring ear_l { stiffness: 42, damping: 6 }
  spring ear_r { stiffness: 42, damping: 6 }
  spring capacitor_l { stiffness: 48, damping: 7 }
  spring capacitor_r { stiffness: 48, damping: 7 }
  spring tail_6 { stiffness: 36, damping: 5 }

  // 1. Confident apex thunder-wolf breathing, prowling head scan & coiled fulgur-tail sway
  clip idle {
    duration_s: 3.2, loop: true
    key root.position { 0.0: [0, 0, 0], 0.8: [0, -0.4, 0], 1.6: [0, 0.3, 0], 2.4: [0, -0.4, 0], 3.2: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.8: [2.5, 1.5, 0], 1.6: [-2.0, 0, 0], 2.4: [2.5, -1.5, 0], 3.2: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.8: [-3, 6, 2], 1.6: [2, 0, 0], 2.4: [-3, -6, -2], 3.2: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.8: [4, 10, -4], 1.6: [-3, 0, 0], 2.4: [4, -10, 4], 3.2: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 1.6: [7, 0, 0], 3.2: [0, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=8, freq_hz=0.3125, phase_deg=0)
    track tail_2: wave(axis=y, amp_deg=11, freq_hz=0.3125, phase_deg=-35)
    track tail_3: wave(axis=y, amp_deg=14, freq_hz=0.3125, phase_deg=-70)
    track tail_4: wave(axis=y, amp_deg=16, freq_hz=0.3125, phase_deg=-105)
    track tail_5: wave(axis=y, amp_deg=18, freq_hz=0.3125, phase_deg=-140)
  }

  // 2. Swaggering Monster Hunter Zinogre territorial prowl (famous heavy shoulder roll!)
  clip walk {
    duration_s: 1.6, loop: true
    key root.position { 0.0: [0, 0, 0], 0.4: [0, 1.1, 0], 0.8: [0, 0, 0], 1.2: [0, 1.1, 0], 1.6: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, -6, 3], 0.4: [2, 0, 0], 0.8: [0, 6, -3], 1.2: [2, 0, 0], 1.6: [0, -6, 3], catmullrom }
    key chest.rotation { 0.0: [0, 8, -6], 0.4: [-2, 0, 0], 0.8: [0, -8, 6], 1.2: [-2, 0, 0], 1.6: [0, 8, -6], catmullrom }
    key neck_1.rotation { 0.0: [0, -6, 4], 0.8: [0, 6, -4], 1.6: [0, -6, 4], catmullrom }
    key head.rotation { 0.0: [2, -4, 3], 0.8: [2, 4, -3], 1.6: [2, -4, 3], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [-24, 0, 0], 0.4: [6, 0, 4], 0.8: [22, 0, 0], 1.2: [-8, 0, 6], 1.6: [-24, 0, 0], catmullrom }
    key fore_arm_l.rotation { 0.0: [12, 0, 0], 0.4: [4, 0, 0], 0.8: [18, 0, 0], 1.2: [-24, 0, 0], 1.6: [12, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [22, 0, 0], 0.4: [-8, 0, 6], 0.8: [-24, 0, 0], 1.2: [6, 0, 4], 1.6: [22, 0, 0], catmullrom }
    key fore_shoulder_r__fore_arm_l.rotation { 0.0: [18, 0, 0], 0.4: [-24, 0, 0], 0.8: [12, 0, 0], 1.2: [4, 0, 0], 1.6: [18, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [20, 0, 0], 0.4: [-10, 0, 4], 0.8: [-22, 0, 0], 1.2: [6, 0, 0], 1.6: [20, 0, 0], catmullrom }
    key hind_shin_l.rotation { 0.0: [-14, 0, 0], 0.4: [24, 0, 0], 0.8: [8, 0, 0], 1.2: [-6, 0, 0], 1.6: [-14, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [-22, 0, 0], 0.4: [6, 0, 0], 0.8: [20, 0, 0], 1.2: [-10, 0, 4], 1.6: [-22, 0, 0], catmullrom }
    key hind_thigh_r__hind_shin_l.rotation { 0.0: [8, 0, 0], 0.4: [-6, 0, 0], 0.8: [-14, 0, 0], 1.2: [24, 0, 0], 1.6: [8, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=12, freq_hz=0.625, phase_deg=0)
    track tail_3: wave(axis=y, amp_deg=18, freq_hz=0.625, phase_deg=-60)
    track tail_5: wave(axis=y, amp_deg=22, freq_hz=0.625, phase_deg=-120)
  }

  // 3. Bounding thunder-wolf rotary sprint with full spine flexion & airborne suspension
  clip run {
    duration_s: 0.9, loop: true
    key root.position { 0.0: [0, 1.5, 0], 0.22: [0, 5.5, 2.5], 0.45: [0, 0.5, 0], 0.68: [0, -1.2, -1.5], 0.9: [0, 1.5, 0], catmullrom }
    key pelvis.rotation { 0.0: [-12, 0, 0], 0.22: [-18, 0, 0], 0.45: [8, 0, 0], 0.68: [16, 0, 0], 0.9: [-12, 0, 0], catmullrom }
    key waist.rotation { 0.0: [-8, 0, 0], 0.22: [-12, 0, 0], 0.45: [10, 0, 0], 0.68: [14, 0, 0], 0.9: [-8, 0, 0], catmullrom }
    key chest.rotation { 0.0: [-10, 0, 0], 0.22: [8, 0, 0], 0.45: [16, 0, 0], 0.68: [-6, 0, 0], 0.9: [-10, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [12, 0, 0], 0.22: [-10, 0, 0], 0.45: [-16, 0, 0], 0.68: [8, 0, 0], 0.9: [12, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [-42, 0, 4], 0.28: [-18, 0, 0], 0.55: [36, 0, 0], 0.9: [-42, 0, 4], catmullrom }
    key fore_arm_l.rotation { 0.0: [-18, 0, 0], 0.28: [12, 0, 0], 0.55: [28, 0, 0], 0.9: [-18, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [-30, 0, 4], 0.22: [-44, 0, 4], 0.50: [32, 0, 0], 0.9: [-30, 0, 4], catmullrom }
    key fore_shoulder_r__fore_arm_l.rotation { 0.0: [-12, 0, 0], 0.22: [-20, 0, 0], 0.50: [28, 0, 0], 0.9: [-12, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [36, 0, 0], 0.25: [42, 0, 0], 0.58: [-36, 0, 4], 0.9: [36, 0, 0], catmullrom }
    key hind_shin_l.rotation { 0.0: [-22, 0, 0], 0.25: [18, 0, 0], 0.58: [32, 0, 0], 0.9: [-22, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [28, 0, 0], 0.32: [40, 0, 0], 0.65: [-34, 0, 4], 0.9: [28, 0, 0], catmullrom }
    key hind_thigh_r__hind_shin_l.rotation { 0.0: [-18, 0, 0], 0.32: [16, 0, 0], 0.65: [30, 0, 0], 0.9: [-18, 0, 0], catmullrom }
    track tail_1: wave(axis=x, amp_deg=18, freq_hz=1.111, phase_deg=0)
    track tail_3: wave(axis=x, amp_deg=24, freq_hz=1.111, phase_deg=-55)
    track tail_5: wave(axis=x, amp_deg=28, freq_hz=1.111, phase_deg=-110)
  }

  // 4. Apex Usurper Thunder Roar — crouches deep, throws chest & head skyward, jaws wide, capacitors flare!
  clip roar {
    duration_s: 2.4, loop: false
    key root.position { 0.0: [0, 0, 0], 0.45: [0, -2.5, -2.0], 0.95: [0, 3.0, 1.5], 1.65: [0, 2.5, 1.0], 2.4: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.45: [12, 0, 0], 0.95: [-18, 0, 0], 1.65: [-15, 0, 0], 2.4: [0, 0, 0], catmullrom }
    key waist.rotation { 0.0: [0, 0, 0], 0.45: [10, 0, 0], 0.95: [-16, 0, 0], 1.65: [-14, 0, 0], 2.4: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.45: [14, 0, 0], 0.95: [-22, 0, 0], 1.30: [-20, 5, 0], 1.65: [-22, -5, 0], 2.4: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.45: [18, 0, 0], 0.95: [-28, 0, 0], 1.30: [-26, 8, 0], 1.65: [-28, -8, 0], 2.4: [0, 0, 0], catmullrom }
    key neck_2.rotation { 0.0: [0, 0, 0], 0.45: [12, 0, 0], 0.95: [-24, 0, 0], 1.65: [-22, 0, 0], 2.4: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.45: [16, 0, 0], 0.95: [-32, 0, 0], 1.30: [-30, 10, -6], 1.65: [-32, -10, 6], 2.4: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.45: [-4, 0, 0], 0.90: [42, 0, 0], 1.75: [40, 0, 0], 2.4: [0, 0, 0], catmullrom }
    key capacitor_l.rotation { 0.0: [0, 0, 0], 0.95: [-16, 8, -18], 1.75: [-18, 8, -20], 2.4: [0, 0, 0], catmullrom }
    key capacitor_r.rotation { 0.0: [0, 0, 0], 0.95: [-16, 8, -18], 1.75: [-18, 8, -20], 2.4: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.45: [18, 0, 12], 0.95: [-14, 0, 16], 1.65: [-12, 0, 16], 2.4: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.45: [18, 0, 12], 0.95: [-14, 0, 16], 1.65: [-12, 0, 16], 2.4: [0, 0, 0], catmullrom }
    key tail_2.rotation { 0.0: [0, 0, 0], 0.95: [18, 0, 0], 1.65: [22, 12, 0], 2.4: [0, 0, 0], catmullrom }
    key tail_4.rotation { 0.0: [0, 0, 0], 0.95: [22, 0, 0], 1.65: [26, -14, 0], 2.4: [0, 0, 0], catmullrom }
  }

  // 5. Explosive Predatory Fang Snap Lunge
  clip bite_lunge {
    duration_s: 1.4, loop: false
    key root.position { 0.0: [0, 0, 0], 0.35: [0, -3.0, -5.5], 0.68: [0, 2.5, 16.0], 0.95: [0, -1.0, 12.0], 1.4: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.35: [14, -8, 0], 0.68: [-10, 10, 0], 1.4: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.35: [18, -12, -6], 0.68: [-12, 14, 8], 0.95: [8, 6, 0], 1.4: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.35: [-16, -18, 0], 0.62: [-24, 16, -14], 0.78: [14, 8, 6], 1.4: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.35: [-18, -14, -18], 0.60: [-12, 14, 22], 0.76: [18, 4, -8], 1.4: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.35: [38, 0, 0], 0.62: [44, 0, 0], 0.74: [-4, 0, 0], 1.4: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.35: [24, 0, 8], 0.68: [-38, 0, 10], 0.95: [10, 0, 4], 1.4: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.35: [24, 0, 8], 0.68: [-26, 0, 10], 0.95: [12, 0, 4], 1.4: [0, 0, 0], catmullrom }
  }

  // 6. Signature Zinogre Left-Right Earth-Shattering Forepaw Double Stomp Combo!
  clip claw_combo_double_stomp {
    duration_s: 2.2, loop: false
    key root.position { 0.0: [0, 0, 0], 0.42: [-2.0, 5.5, 2.0], 0.72: [1.5, -2.5, 7.5], 1.22: [2.5, 6.0, 9.0], 1.54: [-1.5, -3.0, 15.0], 2.2: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.42: [-22, -12, 8], 0.72: [14, 14, -6], 1.22: [-24, 14, -8], 1.54: [16, -14, 6], 2.2: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.42: [-28, -22, 16], 0.72: [22, 24, -14], 1.22: [-30, 24, -16], 1.54: [24, -24, 14], 2.2: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.42: [14, 16, -10], 0.72: [-16, -14, 8], 1.22: [14, -16, 10], 1.54: [-18, 14, -8], 2.2: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.42: [26, 0, 0], 0.72: [8, 0, 0], 1.22: [32, 0, 0], 1.54: [6, 0, 0], 2.2: [0, 0, 0], catmullrom }
    // Left forelimb raises sky-high then crashes into ground at t=0.72!
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.42: [-68, -16, 28], 0.72: [18, 8, -8], 1.22: [24, 0, 10], 2.2: [0, 0, 0], catmullrom }
    key fore_arm_l.rotation { 0.0: [0, 0, 0], 0.42: [-28, 0, 0], 0.72: [24, 0, 0], 2.2: [0, 0, 0], catmullrom }
    // Right forelimb raises even higher then slams down at t=1.54!
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.72: [24, 0, 10], 1.22: [-72, -18, 30], 1.54: [20, 8, -10], 2.2: [0, 0, 0], catmullrom }
    key fore_shoulder_r__fore_arm_l.rotation { 0.0: [0, 0, 0], 0.72: [12, 0, 0], 1.22: [-30, 0, 0], 1.54: [26, 0, 0], 2.2: [0, 0, 0], catmullrom }
  }

  // 7. 180-Degree Whipping Pinecone Tail-Club Cleave
  clip tail_whip_sweep {
    duration_s: 1.6, loop: false
    key root.position { 0.0: [0, 0, 0], 0.40: [-2.5, -1.5, -2.0], 0.85: [3.5, 2.5, 4.0], 1.6: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.40: [8, -48, -6], 0.85: [-8, 68, 10], 1.20: [0, 42, 4], 1.6: [0, 0, 0], catmullrom }
    key waist.rotation { 0.0: [0, 0, 0], 0.40: [0, -24, 0], 0.85: [0, 32, 0], 1.6: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.40: [6, -18, 0], 0.85: [8, 22, -8], 1.6: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.40: [0, 32, 0], 0.85: [0, -36, 0], 1.6: [0, 0, 0], catmullrom }
    key tail_1.rotation { 0.0: [0, 0, 0], 0.40: [-10, -34, 0], 0.82: [-14, 42, 0], 1.15: [-6, 18, 0], 1.6: [0, 0, 0], catmullrom }
    key tail_2.rotation { 0.0: [0, 0, 0], 0.40: [-8, -32, 0], 0.84: [-12, 40, 0], 1.18: [-4, 16, 0], 1.6: [0, 0, 0], catmullrom }
    key tail_3.rotation { 0.0: [0, 0, 0], 0.40: [-8, -30, 0], 0.86: [-10, 38, 0], 1.20: [-4, 14, 0], 1.6: [0, 0, 0], catmullrom }
    key tail_4.rotation { 0.0: [0, 0, 0], 0.40: [-6, -28, 0], 0.88: [-8, 36, 0], 1.22: [-2, 12, 0], 1.6: [0, 0, 0], catmullrom }
    key tail_5.rotation { 0.0: [0, 0, 0], 0.40: [-4, -24, 0], 0.90: [-6, 32, 0], 1.25: [0, 10, 0], 1.6: [0, 0, 0], catmullrom }
  }

  // 8. Fulgurbug Summoning Thunder Howl — plants wide stance, points snout vertically at the sky!
  clip thunder_howl_charge {
    duration_s: 2.8, loop: false
    key root.position { 0.0: [0, 0, 0], 0.55: [0, -2.0, -1.5], 1.10: [0, 2.0, 0], 2.15: [0, 2.2, 0], 2.8: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.55: [14, 0, 0], 1.10: [-14, 0, 0], 2.15: [-14, 0, 0], 2.8: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.55: [16, 0, 0], 1.10: [-26, 0, 0], 1.60: [-28, 0, 0], 2.15: [-26, 0, 0], 2.8: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.55: [18, 0, 0], 1.10: [-34, 0, 0], 2.15: [-34, 0, 0], 2.8: [0, 0, 0], catmullrom }
    key neck_2.rotation { 0.0: [0, 0, 0], 0.55: [14, 0, 0], 1.10: [-28, 0, 0], 2.15: [-28, 0, 0], 2.8: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.55: [18, 0, 0], 1.10: [-36, 0, 0], 1.60: [-38, 4, 0], 2.15: [-36, -4, 0], 2.8: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.55: [-4, 0, 0], 1.05: [36, 0, 0], 2.15: [38, 0, 0], 2.8: [0, 0, 0], catmullrom }
    key capacitor_l.rotation { 0.0: [0, 0, 0], 1.05: [-22, 12, -24], 1.60: [-26, 14, -28], 2.15: [-22, 12, -24], 2.8: [0, 0, 0], catmullrom }
    key capacitor_r.rotation { 0.0: [0, 0, 0], 1.05: [-22, 12, -24], 1.60: [-26, 14, -28], 2.15: [-22, 12, -24], 2.8: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 1.10: [-10, 0, 18], 2.15: [-10, 0, 18], 2.8: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 1.10: [-10, 0, 18], 2.15: [-10, 0, 18], 2.8: [0, 0, 0], catmullrom }
    key tail_2.rotation { 0.0: [0, 0, 0], 1.10: [20, 0, 0], 2.15: [24, 0, 0], 2.8: [0, 0, 0], catmullrom }
    key tail_4.rotation { 0.0: [0, 0, 0], 1.10: [24, 0, 0], 2.15: [28, 0, 0], 2.8: [0, 0, 0], catmullrom }
  }

  // 9. ICONIC SIGNATURE WILD ATTACK: Airborne Acrobatic Fulgur Backflip Overhead Tail Slam!
  clip fulgur_backflip_tail_slam {
    duration_s: 2.0, loop: false
    key root.position { 0.0: [0, 0, 0], 0.32: [0, -3.5, -3.0], 0.78: [0, 26.0, 2.0], 1.18: [0, 14.0, 10.0], 1.42: [0, -2.5, 14.0], 2.0: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.32: [18, 0, 0], 0.78: [-108, 22, 14], 1.18: [58, -12, -8], 1.42: [24, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key waist.rotation { 0.0: [0, 0, 0], 0.32: [12, 0, 0], 0.78: [-28, 12, 0], 1.18: [22, 0, 0], 1.42: [10, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.32: [16, 0, 0], 0.78: [-32, 16, 10], 1.18: [24, -8, 0], 1.42: [14, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.78: [-24, 0, 0], 1.18: [22, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.78: [38, 0, 0], 1.42: [12, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.32: [26, 0, 8], 0.78: [-52, 0, 24], 1.18: [-20, 0, 14], 1.42: [16, 0, 6], 2.0: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.32: [26, 0, 8], 0.78: [-52, 0, 24], 1.18: [-20, 0, 14], 1.42: [16, 0, 6], 2.0: [0, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [0, 0, 0], 0.32: [-24, 0, 6], 0.78: [44, 0, 16], 1.18: [-22, 0, 10], 1.42: [-14, 0, 4], 2.0: [0, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [0, 0, 0], 0.32: [-24, 0, 6], 0.78: [44, 0, 16], 1.18: [-22, 0, 10], 1.42: [-14, 0, 4], 2.0: [0, 0, 0], catmullrom }
    // Pinecone tail whips overhead during the flip and slams violently downward into Y=0 in front!
    key tail_1.rotation { 0.0: [0, 0, 0], 0.32: [-18, 0, 0], 0.78: [36, 0, 0], 1.18: [-44, 0, 0], 1.42: [-38, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key tail_2.rotation { 0.0: [0, 0, 0], 0.32: [-16, 0, 0], 0.78: [34, 0, 0], 1.18: [-42, 0, 0], 1.42: [-36, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key tail_3.rotation { 0.0: [0, 0, 0], 0.32: [-14, 0, 0], 0.78: [32, 0, 0], 1.18: [-40, 0, 0], 1.42: [-34, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key tail_4.rotation { 0.0: [0, 0, 0], 0.32: [-12, 0, 0], 0.78: [28, 0, 0], 1.18: [-38, 0, 0], 1.42: [-32, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key tail_5.rotation { 0.0: [0, 0, 0], 0.32: [-10, 0, 0], 0.78: [24, 0, 0], 1.18: [-32, 0, 0], 1.42: [-26, 0, 0], 2.0: [0, 0, 0], catmullrom }
  }

  // 10. Spiraling Corkscrew Thunder Shoulder Tackle
  clip corkscrew_shoulder_tackle {
    duration_s: 1.5, loop: false
    key root.position { 0.0: [0, 0, 0], 0.35: [-3.0, -2.5, -4.0], 0.75: [2.0, 9.5, 16.0], 1.08: [0, -1.5, 20.0], 1.5: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.35: [12, -22, -16], 0.75: [-8, 18, 95], 1.08: [10, 6, 18], 1.5: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.35: [16, -26, -22], 0.75: [-12, 22, 42], 1.08: [12, 8, 8], 1.5: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.35: [-14, 18, 0], 0.75: [10, -12, -24], 1.5: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.75: [34, 0, -16], 1.5: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.75: [-42, 0, 22], 1.5: [0, 0, 0], catmullrom }
  }

  // 11. Ultra-Charged Fulgurbug Nova Discharge Burst
  clip fulgurbug_discharge_burst {
    duration_s: 2.2, loop: false
    key root.position { 0.0: [0, 0, 0], 0.55: [0, -3.5, 0], 0.95: [0, 8.5, 0], 1.45: [0, 6.5, 0], 1.75: [0, -1.5, 0], 2.2: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.55: [16, 0, 0], 0.95: [-16, 0, 0], 1.45: [-12, 0, 0], 2.2: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.55: [22, 0, 0], 0.95: [-28, 0, 0], 1.20: [-26, 6, 0], 1.45: [-28, -6, 0], 2.2: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.55: [24, 0, 0], 0.95: [-30, 0, 0], 1.45: [-28, 0, 0], 2.2: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.55: [20, 0, 0], 0.95: [-32, 0, 0], 1.45: [-30, 0, 0], 2.2: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.55: [-4, 0, 0], 0.95: [44, 0, 0], 1.55: [40, 0, 0], 2.2: [0, 0, 0], catmullrom }
    key capacitor_l.rotation { 0.0: [0, 0, 0], 0.55: [12, 0, 8], 0.95: [-28, 16, -32], 1.55: [-26, 16, -30], 2.2: [0, 0, 0], catmullrom }
    key capacitor_r.rotation { 0.0: [0, 0, 0], 0.55: [12, 0, 8], 0.95: [-28, 16, -32], 1.55: [-26, 16, -30], 2.2: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.55: [24, 0, -8], 0.95: [-28, 0, 34], 1.45: [-24, 0, 32], 2.2: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.55: [24, 0, -8], 0.95: [-28, 0, 34], 1.45: [-24, 0, 32], 2.2: [0, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [0, 0, 0], 0.55: [-22, 0, -6], 0.95: [26, 0, 26], 1.45: [22, 0, 24], 2.2: [0, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [0, 0, 0], 0.55: [-22, 0, -6], 0.95: [26, 0, 26], 1.45: [22, 0, 24], 2.2: [0, 0, 0], catmullrom }
    key tail_2.rotation { 0.0: [0, 0, 0], 0.55: [-18, 0, 0], 0.95: [28, 0, 0], 1.45: [26, 0, 0], 2.2: [0, 0, 0], catmullrom }
    key tail_4.rotation { 0.0: [0, 0, 0], 0.55: [-18, 0, 0], 0.95: [30, 0, 0], 1.45: [28, 0, 0], 2.2: [0, 0, 0], catmullrom }
  }

  // 12. Cocky Usurper Side-Stalk & Head-Tilt Taunt (classic Zinogre slow head-cock & paw scrape!)
  clip enraged_taunt {
    duration_s: 2.0, loop: false
    key root.position { 0.0: [0, 0, 0], 0.55: [2.5, -1.0, 0], 1.35: [-2.0, -0.5, 0], 2.0: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.55: [6, 16, -8], 1.35: [4, -14, 8], 2.0: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.55: [-8, 18, 12], 1.35: [-6, -12, -10], 2.0: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.55: [8, 16, -26], 1.05: [10, 18, -28], 1.45: [-6, -14, 18], 2.0: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.55: [18, 0, 0], 1.35: [24, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.45: [-28, 0, 12], 0.85: [22, 0, 4], 1.25: [-18, 0, 10], 1.60: [16, 0, 4], 2.0: [0, 0, 0], catmullrom }
    key fore_arm_l.rotation { 0.0: [0, 0, 0], 0.45: [-22, 0, 0], 0.85: [18, 0, 0], 1.25: [-16, 0, 0], 2.0: [0, 0, 0], catmullrom }
  }
}
@controller {
  initial: idle
  idle -> walk when speed > 0.15, blend 0.20
  walk -> run when speed > 0.55, blend 0.18
  run -> walk when speed <= 0.45, blend 0.22
  walk -> idle when speed <= 0.08, blend 0.25
  idle -> roar when enraged > 0.5, blend 0.15
  roar -> idle when enraged <= 0.5, blend 0.25
}
