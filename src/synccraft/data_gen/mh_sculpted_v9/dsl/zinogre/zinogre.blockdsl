        box thigh_mass { size: [6.5, 11.5, 8.0], material: storm_teal, blend_with: [waist_core, tail_1_tail_seg] }
        box thigh_plate place(base_box=thigh_mass, anchor=[0.98, 0.25, 0.08], align=[-0.48, 0, 0]) {
          size: [2.5, 6.5, 6.0], material: teal_armor, rotate: [6, -8, -10], blend_with: [pelvis_core, haunch_muscle_l]
        }
        box thigh_spur place(base_box=thigh_plate, anchor=[0.92, 0.25, -0.42], align=[-0.68, 0, 0.45]) {
          size: [2.0, 2.5, 5.5], material: fulgur_gold, rotate: [16, 24, -12], blend_with: [thigh_mass, hip_spur_l]
        }
        box knee_cap place(base_box=thigh_mass, anchor=[0.15, -0.82, 0.96], align=[0, 0, -0.72]) {
          size: [4.0, 3.5, 2.5], material: fulgur_gold, rotate: [-14, 0, 0], blend_with: [shin_mass, waist_core, waist_belly]
