// Chaotic Gore Magala (Half-Molted Fallen Seraph) — Stage 1 Asymmetric Primary Masses Blockout
// True bilateral asymmetry (ZERO mirror_x on head, forelimbs, hindlimbs, or wings!):
// +X Left = dark obsidian Gore visor, folded violet feeler, low clawed wing-arm & draped Reaper cloak;
// -X Right = radiant golden Shagaru unfolded horn, soared seraph wing-arm & 4-spar golden wing fan!
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 128
  budget max_bones = 64
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  obsidian_indigo: ramp(base_lch=[0.26, 0.096, 282], steps=6, hue_shift=[24, -16])
  eclipse_plum: ramp(base_lch=[0.33, 0.128, 296], steps=6, hue_shift=[26, -16])
  shagaru_gold: ramp(base_lch=[0.75, 0.142, 84], steps=6, hue_shift=[20, -14])
  seraph_ivory: ramp(base_lch=[0.86, 0.058, 88], steps=6, hue_shift=[18, -10])
  wing_talon_crimson: ramp(base_lch=[0.48, 0.155, 350], steps=6, hue_shift=[20, -14])
  frenzy_violet: ramp(base_lch=[0.74, 0.225, 308], steps=6, hue_shift=[16, -18], emissive=true)
  seraph_amber: ramp(base_lch=[0.82, 0.175, 68], steps=6, hue_shift=[14, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 20.40, -14.0]) {
      rest_euler: [6, -2, 0]
      box pelvis_core { size: [13.5, 11.5, 13.0], material: obsidian_indigo }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.16, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-6, 3, 2]
        box waist_core { size: [15.0, 13.5, 12.5], material: obsidian_indigo }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.22, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [-6, 3, 2]
          box chest_core { size: [20.5, 18.0, 16.5], material: obsidian_indigo }
          box withers_girdle place(base_box=chest_core, anchor=[0, 0.98, 0.05], align=[0, -0.45, 0]) {
            size: [16.0, 6.0, 14.5], material: shagaru_gold, rotate: [-8, 0, 4]
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.28, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-22, -4, -2]
            box neck_base { size: [13.0, 12.0, 9.5], material: obsidian_indigo, blend_with: [withers_girdle] }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.14, 1], align=[0, 0, -1], seat=0.26) {
              rest_euler: [16, -2, 0]
              box neck_upper { size: [10.0, 9.5, 8.5], material: eclipse_plum }

              // ASYMMETRIC SPLIT HEAD: +X folded Gore feeler vs -X unfolded sweeping golden Shagaru horn!
              bone head attach(parent_box=neck_upper, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.24) {
                rest_euler: [18, -5, 4]
                box skull_core { size: [10.0, 6.5, 8.0], material: obsidian_indigo }
                box snout_core place(base_box=skull_core, anchor=[0, -0.14, 1], align=[0, 0, -0.78]) {
                  size: [5.0, 4.0, 7.0], material: shagaru_gold, rotate: [12, 0, 0]
                }
                // +X Left: Trapped folded violet Gore Magala feeler
                bone feeler_l attach(parent_box=skull_core, anchor=[0.64, 0.95, 0.22], align=[0, -0.55, 0.88], seat=0.10) {
                  rest_euler: [24, -14, -10]
                  box feeler_beam_l { size: [2.0, 2.0, 11.0], material: frenzy_violet, blend_with: [neck_upper] }
                }
                // -X Right: Molted unfolded sweeping golden Shagaru Magala seraph horn!
                bone shagaru_horn_r attach(parent_box=skull_core, anchor=[-0.68, 0.96, 0.40], align=[0, -0.55, 0.88], seat=0.10) {
                  rest_euler: [56, 26, 18]
                  box shagaru_horn_beam_r { size: [2.5, 2.5, 13.5], material: shagaru_gold, blend_with: [neck_upper] }
                }
                bone jaw attach(parent_box=skull_core, anchor=[0, -0.70, 0.22], align=[0, 0, -1], seat=0.16) {
                  rest_euler: [12, 0, 0]
                  box jaw_core { size: [4.5, 2.5, 8.5], material: seraph_ivory, blend_with: [snout_core] }
                }
              }
            }
          }

          // +X LEFT WING: Hunched Dark Gore Wing-Arm & Heavy Draped Reaper Cloak
          bone wing_shoulder_l attach(parent_box=withers_girdle, anchor=[0.88, 0.55, 0.18], align=[-0.85, -0.25, 0], seat=0.16) {
            rest_euler: [6, 16, 26]
            box wing_humerus_l { size: [15.0, 7.0, 8.0], material: obsidian_indigo, blend_with: [chest_core] }

            bone wing_arm_l attach(parent_box=wing_humerus_l, anchor=[0.92, 0.12, 0.25], align=[-0.25, 0, -0.88], seat=0.10) {
              rest_euler: [20, -16, -16]
              box wing_forearm_l { size: [6.5, 6.0, 17.0], material: eclipse_plum }

              bone wing_claw_hand_l attach(parent_box=wing_forearm_l, anchor=[0, -0.12, 1], align=[0, 0, -0.85], seat=0.14) {
                rest_euler: [28, -18, -14]
                box wing_palm_l { size: [7.0, 4.5, 8.5], material: wing_talon_crimson }
              }

              bone cloak_panel_1_l attach(parent_box=wing_forearm_l, anchor=[0.88, -0.10, -0.55], align=[-0.15, 0, 0.92], seat=0.12) {
                rest_euler: [-32, -26, -12]
                box cloak_spar_1_l { size: [4.0, 3.5, 16.5], material: obsidian_indigo, blend_with: [wing_humerus_l, cloak_spar_2_l] }

                bone cloak_drape_1_l attach(parent_box=cloak_spar_1_l, anchor=[0, -0.08, -1], align=[0, 0, 1], seat=0.18) {
                  rest_euler: [-30, 4, 8]
                  box cloak_lower_1_l { size: [3.5, 3.0, 15.5], material: eclipse_plum, blend_with: [cloak_lower_2_l] }
                }
              }
            }

            bone cloak_panel_2_l attach(parent_box=wing_humerus_l, anchor=[0.84, -0.05, -0.86], align=[0, 0, 0.92], seat=0.12) {
              rest_euler: [-22, -16, -16]
              box cloak_spar_2_l { size: [4.0, 3.5, 17.5], material: eclipse_plum, blend_with: [wing_forearm_l, cloak_spar_3_l] }

              bone cloak_drape_2_l attach(parent_box=cloak_spar_2_l, anchor=[0, -0.08, -1], align=[0, 0, 1], seat=0.18) {
                rest_euler: [-28, 2, 6]
                box cloak_lower_2_l { size: [3.5, 3.0, 16.0], material: obsidian_indigo, blend_with: [cloak_lower_3_l] }
              }
            }

            bone cloak_panel_3_l attach(parent_box=wing_humerus_l, anchor=[0.28, 0.34, -0.92], align=[0, 0, 0.92], seat=0.12) {
              rest_euler: [-10, -5, -14]
              box cloak_spar_3_l { size: [4.5, 3.5, 16.5], material: obsidian_indigo, blend_with: [withers_girdle, waist_core, pelvis_core] }

              bone cloak_drape_3_l attach(parent_box=cloak_spar_3_l, anchor=[0, -0.08, -1], align=[0, 0, 1], seat=0.18) {
                rest_euler: [-12, 2, 4]
                box cloak_lower_3_l { size: [3.5, 3.0, 15.0], material: eclipse_plum }
              }
            }
          }

          // -X RIGHT WING: Molted Radiant Golden Shagaru Magala Seraphic Wing-Arm Flared HIGH & WIDE!
          bone wing_shoulder_r attach(parent_box=withers_girdle, anchor=[-0.88, 0.68, 0.20], align=[0.85, -0.25, 0], seat=0.16) {
            rest_euler: [4, -22, -46]
            box wing_humerus_r { size: [17.5, 7.5, 8.5], material: shagaru_gold, blend_with: [chest_core] }

            bone wing_arm_r attach(parent_box=wing_humerus_r, anchor=[-0.92, 0.14, 0.25], align=[0.25, 0, -0.88], seat=0.10) {
              rest_euler: [8, 24, 18]
              box wing_forearm_r { size: [7.0, 6.5, 19.5], material: shagaru_gold }

              bone wing_claw_hand_r attach(parent_box=wing_forearm_r, anchor=[0, -0.10, 1], align=[0, 0, -0.85], seat=0.14) {
                rest_euler: [20, 20, 14]
                box wing_palm_r { size: [7.5, 4.5, 9.0], material: seraph_ivory }
              }

              // 4 Fanned Golden Seraphic Wing Spars radiating outward & skyward!
              bone wing_spar_1_r attach(parent_box=wing_forearm_r, anchor=[-0.88, 0.20, 0.15], align=[0.20, 0, 0.92], seat=0.12) {
                rest_euler: [18, 42, 16]
                box shagaru_spar_1_r { size: [3.5, 3.5, 30.0], material: shagaru_gold, blend_with: [wing_humerus_r, shagaru_spar_2_r] }
              }

              bone wing_spar_2_r attach(parent_box=wing_forearm_r, anchor=[-0.86, 0.05, -0.45], align=[0.18, 0, 0.92], seat=0.12) {
                rest_euler: [8, 28, 12]
                box shagaru_spar_2_r { size: [3.5, 3.5, 28.5], material: seraph_ivory, blend_with: [wing_humerus_r, shagaru_spar_3_r] }
              }
            }

            bone wing_spar_3_r attach(parent_box=wing_humerus_r, anchor=[-0.82, 0.05, -0.86], align=[0, 0, 0.92], seat=0.12) {
              rest_euler: [-2, 18, 10]
              box shagaru_spar_3_r { size: [4.0, 3.5, 26.5], material: shagaru_gold, blend_with: [wing_forearm_r, shagaru_spar_4_r] }
            }

            bone wing_spar_4_r attach(parent_box=wing_humerus_r, anchor=[-0.32, 0.30, -0.92], align=[0, 0, 0.92], seat=0.12) {
              rest_euler: [-8, 8, 8]
              box shagaru_spar_4_r { size: [4.0, 3.5, 23.5], material: seraph_ivory, blend_with: [withers_girdle, waist_core] }
            }
          }

          // Unmirrored Forelimbs (+X Dark Gore vs -X Golden Shagaru, both grounded on Y = 0)
          bone fore_shoulder_l attach(parent_box=chest_core, anchor=[0.95, -0.18, 0.44], align=[-0.55, 0.82, 0], seat=0.12) {
            rest_euler: [18, 6, 18]
            box fore_bicep_l { size: [7.5, 11.5, 8.0], material: obsidian_indigo }

            bone fore_arm_l attach(parent_box=fore_bicep_l, anchor=[0.10, -1, -0.05], align=[0, 0.88, 0], seat=0.18) {
              rest_euler: [-30, 0, -14]
              box fore_bracer_l { size: [7.0, 11.5, 7.5], material: eclipse_plum, blend_with: [chest_core] }

              bone fore_paw_l attach(parent_box=fore_bracer_l, anchor=[0, -1, 0.15], align=[0, 0.85, -0.45], seat=0.16) {
                rest_euler: [16, 0, -8]
                box fore_paw_pad_l { size: [8.0, 3.5, 8.5], material: obsidian_indigo }
              }
            }
          }

          bone fore_shoulder_r attach(parent_box=chest_core, anchor=[-0.95, -0.14, 0.44], align=[0.55, 0.82, 0], seat=0.12) {
            rest_euler: [18, -6, -24]
            box fore_bicep_r { size: [7.5, 11.5, 8.0], material: shagaru_gold }

            bone fore_arm_r attach(parent_box=fore_bicep_r, anchor=[-0.10, -1, -0.05], align=[0, 0.88, 0], seat=0.18) {
              rest_euler: [-30, 0, 16]
              box fore_bracer_r { size: [7.0, 12.0, 7.5], material: shagaru_gold, blend_with: [chest_core] }

              bone fore_paw_r attach(parent_box=fore_bracer_r, anchor=[0, -1, 0.15], align=[0, 0.85, -0.45], seat=0.16) {
                rest_euler: [15, 0, 6]
                box fore_paw_pad_r { size: [8.0, 3.5, 8.5], material: seraph_ivory }
              }
            }
          }
        }
      }

      // Unmirrored Digitigrade Hindlimbs (+X Gore vs -X Half-Molted Shagaru)
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.96, -0.10, -0.05], align=[-0.55, 0.85, 0], seat=0.12) {
        rest_euler: [-22, -6, 18]
        box thigh_mass_l { size: [6.5, 11.5, 8.5], material: obsidian_indigo, blend_with: [waist_core, tail_1_tail_seg] }

        bone hind_shin_l attach(parent_box=thigh_mass_l, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [40, 0, -10]
          box shin_mass_l { size: [5.0, 10.5, 5.5], material: eclipse_plum }

          bone hind_paw_l attach(parent_box=shin_mass_l, anchor=[0, -1, 0.15], align=[0, 0.88, -0.42], seat=0.14) {
            rest_euler: [-24, 0, -8]
            box hind_paw_pad_l { size: [6.5, 3.0, 7.5], material: obsidian_indigo }
          }
        }
      }

      bone hind_thigh_r attach(parent_box=pelvis_core, anchor=[-0.96, -0.10, -0.05], align=[0.55, 0.85, 0], seat=0.12) {
        rest_euler: [-22, 6, -18]
        box thigh_mass_r { size: [6.5, 11.5, 8.5], material: shagaru_gold, blend_with: [waist_core, tail_1_tail_seg] }

        bone hind_shin_r attach(parent_box=thigh_mass_r, anchor=[-0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [40, 0, 10]
          box shin_mass_r { size: [5.0, 10.5, 5.5], material: shagaru_gold }

          bone hind_paw_r attach(parent_box=shin_mass_r, anchor=[0, -1, 0.15], align=[0, 0.88, -0.42], seat=0.14) {
            rest_euler: [-24, 0, 8]
            box hind_paw_pad_r { size: [6.5, 3.0, 7.5], material: seraph_ivory }
          }
        }
      }

      // S-Curved Half-Molted Tail
      chain tail attach(parent_box=pelvis_core, anchor=[0, 0.18, -1], align=[0, 0, 1], seat=0.24) segments=6 taper=0.88 bend=[-9, -1, 13, 18, 20, 14] {
        box tail_seg { size: [9.0, 8.0, 9.0], material: obsidian_indigo }
      }
    }
  }
}
