          blend_with: [thigh_carapace, thigh_shingle_low, thigh_aero_spur, shin_mass]
        }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [58, 0, -14]
          box shin_mass { size: [4.5, 12.5, 5.0], material: midnight_slate }
          box calf_bulge place(base_box=shin_mass, anchor=[0, 0.35, -0.92], align=[0, 0, 0.55]) {
            size: [3.5, 5.5, 2.5], material: deep_sapphire, rotate: [10, 0, 0], blend_with: [thigh_mass, hock_spur]
          }
          box shin_guard place(base_box=shin_mass, anchor=[0.15, 0.12, 0.96], align=[0, 0, -0.68]) {
            size: [3.0, 8.0, 2.0], material: azure_cobalt, rotate: [4, 0, 0], blend_with: [thigh_mass, knee_guard, hind_foot_pad]
          }
          box ankle_shingle place(base_box=shin_guard, anchor=[0, -0.82, 0.88], align=[0, 0.45, -0.75]) {
            size: [2.5, 2.5, 1.5], material: cerulean_rim, rotate: [12, 0, 0], blend_with: [shin_mass, hind_foot_pad, h_knuckle_plate]
          }
          box hock_spur place(base_box=shin_mass, anchor=[0, -0.12, -0.96], align=[0, 0, 0.82]) {
            size: [2.0, 2.0, 4.0], material: ivory_bone, rotate: [20, 0, 0], blend_with: [calf_bulge]
          }
          plane shin_scale_fringe place(base_box=shin_mass, anchor=[0.30, -0.35, -0.98], align=[0, 0, 0.88]) {
            size: [5.5, 3.5], normal: x, material: deep_sapphire, rotate: [8, 10, 0],
            edge: spikes(width=2, min_len=2, max_len=5, side=right, seed=53), layer: 1,
            blend_with: [calf_bulge, hock_spur, hind_foot_pad]
          }

          bone hind_foot_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.45], seat=0.14) {
            rest_euler: [-24, 0, -8]
            box hind_foot_pad { size: [6.5, 3.0, 7.0], material: midnight_slate }
            box h_knuckle_plate place(base_box=hind_foot_pad, anchor=[0, 0.96, 0.58], align=[0, -0.80, 0]) {
              size: [5.0, 1.0, 3.5], material: azure_cobalt, rotate: [10, 0, 0], blend_with: [shin_mass, shin_guard, ankle_shingle, h_toe_1, h_toe_2, h_toe_3]
            }
            box h_toe_1 place(base_box=hind_foot_pad, anchor=[-0.64, -0.12, 0.92], align=[0, 0, -0.76]) {
              size: [2.0, 2.0, 4.0], material: mist_cream, rotate: [3, 16, 0]
            }
            box h_talon_1 place(base_box=h_toe_1, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.5, 1.5, 3.5], material: ivory_bone, rotate: [10, 4, 0]
            }
            box h_toe_2 place(base_box=hind_foot_pad, anchor=[0.0, -0.12, 0.96], align=[0, 0, -0.78]) {
              size: [2.0, 2.0, 4.5], material: mist_cream, rotate: [3, 0, 0], blend_with: [h_toe_1]
            }
            box h_talon_2 place(base_box=h_toe_2, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.5, 1.5, 4.0], material: ivory_bone, rotate: [10, 0, 0], blend_with: [h_talon_1]
            }
            box h_toe_3 place(base_box=hind_foot_pad, anchor=[0.64, -0.12, 0.92], align=[0, 0, -0.76]) {
              size: [2.0, 2.0, 4.0], material: mist_cream, rotate: [3, -16, 0], blend_with: [h_toe_2]
            }
            box h_talon_3 place(base_box=h_toe_3, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.5, 1.5, 3.5], material: ivory_bone, rotate: [10, -4, 0], blend_with: [h_talon_2]
            }
            box h_inner_dewclaw place(base_box=hind_foot_pad, anchor=[-0.96, 0.10, -0.28], align=[0.75, 0, 0.35]) {
              size: [1.5, 1.5, 3.0], material: ivory_bone, rotate: [8, -24, 0], blend_with: [shin_mass]
            }
            box h_hallux_claw place(base_box=hind_foot_pad, anchor=[0, -0.05, -0.94], align=[0, 0, 0.80]) {
              size: [1.5, 1.5, 3.5], material: ivory_bone, rotate: [-8, 0, 0], blend_with: [shin_mass]
            }
          }
        }
      }

      // Whip-Sleek Tail Terminating in Sharper Diamond-Spiked Cerulean Mace (`tail_1..tail_6`)!
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.16, -1], align=[0, 0, 1], seat=0.22) {
        rest_euler: [4, 0, 0]
        box tail_1_seg { size: [9.0, 8.5, 9.5], material: midnight_slate }
        box tail_1_plate place(base_box=tail_1_seg, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
          size: [7.0, 2.5, 8.5], material: azure_cobalt, rotate: [6, 0, 0], blend_with: [pelvis_core, sacrum_shingle, sacrum_fin_2, tail_2_seg, tail_2_plate]
        }
        box tail_1_spine place(base_box=tail_1_plate, anchor=[0, 0.96, -0.05], align=[0, -0.80, 0]) {
          size: [1.5, 2.5, 3.5], material: ivory_bone, rotate: [20, 0, 0], blend_with: [tail_1_seg, pelvis_core, sacrum_shingle]
        }
        box tail_1_keel_l place(base_box=tail_1_seg, anchor=[0.98, 0.12, -0.10], align=[-0.68, 0, 0.30]) {
          size: [2.0, 2.5, 7.0], material: deep_sapphire, rotate: [8, 16, -10], blend_with: [pelvis_core, haunch_muscle_l, tail_2_seg]
        }
        box tail_1_keel_r place(base_box=tail_1_seg, anchor=[-0.98, 0.12, -0.10], align=[0.68, 0, 0.30]) {
          size: [2.0, 2.5, 7.0], material: deep_sapphire, rotate: [8, -16, 10], blend_with: [pelvis_core, haunch_muscle_r, tail_2_seg]
        }
        box tail_1_belly place(base_box=tail_1_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
          size: [6.0, 1.5, 8.5], material: mist_cream, blend_with: [pelvis_belly, pelvis_core]
        }

        bone tail_2 attach(parent_box=tail_1_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.22) {
          rest_euler: [5, 0, 0]
          box tail_2_seg { size: [7.5, 7.0, 9.5], material: midnight_slate }
          box tail_2_plate place(base_box=tail_2_seg, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
            size: [6.0, 2.0, 8.5], material: azure_cobalt, rotate: [6, 0, 0], blend_with: [tail_1_seg, tail_3_seg, tail_3_plate]
          }
          box tail_2_spine place(base_box=tail_2_plate, anchor=[0, 0.96, -0.05], align=[0, -0.80, 0]) {
            size: [1.5, 2.5, 3.5], material: ivory_bone, rotate: [20, 0, 0], blend_with: [tail_2_seg, tail_1_plate]
          }
          box tail_2_keel_l place(base_box=tail_2_seg, anchor=[0.98, 0.10, -0.10], align=[-0.68, 0, 0.30]) {
            size: [2.0, 2.0, 7.0], material: deep_sapphire, rotate: [8, 16, -10], blend_with: [tail_1_seg, tail_1_keel_l, tail_3_seg]
          }
          box tail_2_keel_r place(base_box=tail_2_seg, anchor=[-0.98, 0.10, -0.10], align=[0.68, 0, 0.30]) {
            size: [2.0, 2.0, 7.0], material: deep_sapphire, rotate: [8, -16, 10], blend_with: [tail_1_seg, tail_1_keel_r, tail_3_seg]
          }
          box tail_2_belly place(base_box=tail_2_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
            size: [5.0, 1.5, 8.5], material: mist_cream, blend_with: [tail_1_belly, tail_1_seg]
          }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.22) {
            rest_euler: [7, 0, 0]
            box tail_3_seg { size: [6.0, 6.0, 9.5], material: midnight_slate }
            box tail_3_plate place(base_box=tail_3_seg, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
              size: [5.0, 2.0, 8.5], material: azure_cobalt, rotate: [8, 0, 0], blend_with: [tail_2_seg, tail_4_seg, tail_4_plate]
            }
            box tail_3_spine place(base_box=tail_3_plate, anchor=[0, 0.96, -0.05], align=[0, -0.80, 0]) {
              size: [1.5, 2.5, 3.0], material: ivory_bone, rotate: [20, 0, 0], blend_with: [tail_3_seg, tail_2_plate]
            }
            box tail_3_keel_l place(base_box=tail_3_seg, anchor=[0.98, 0.08, -0.10], align=[-0.72, 0, 0.30]) {
              size: [1.5, 2.0, 7.0], material: cerulean_rim, rotate: [8, 16, -8], blend_with: [tail_2_seg, tail_2_keel_l, tail_4_seg]
            }
            box tail_3_keel_r place(base_box=tail_3_seg, anchor=[-0.98, 0.08, -0.10], align=[0.72, 0, 0.30]) {
              size: [1.5, 2.0, 7.0], material: cerulean_rim, rotate: [8, -16, 8], blend_with: [tail_2_seg, tail_2_keel_r, tail_4_seg]
            }
            box tail_3_belly place(base_box=tail_3_seg, anchor=[0, -0.96, 0], align=[0, 0.48, 0]) {
              size: [4.0, 1.5, 8.5], material: mist_cream, blend_with: [tail_2_belly, tail_2_seg]
            }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.22) {
              rest_euler: [9, 0, 0]
              box tail_4_seg { size: [5.0, 5.0, 9.0], material: midnight_slate }
              box tail_4_plate place(base_box=tail_4_seg, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
                size: [4.0, 2.0, 8.0], material: azure_cobalt, rotate: [8, 0, 0], blend_with: [tail_3_seg, diamond_mace_core, mace_dorsal_crest]
              }
              box tail_4_spine place(base_box=tail_4_plate, anchor=[0, 0.96, -0.05], align=[0, -0.80, 0]) {
                size: [1.5, 2.0, 3.0], material: ivory_bone, rotate: [20, 0, 0], blend_with: [tail_4_seg, tail_3_plate]
              }
              box tail_4_belly place(base_box=tail_4_seg, anchor=[0, -0.96, 0], align=[0, 0.52, 0]) {
                size: [3.5, 1.0, 8.0], material: mist_cream, blend_with: [tail_3_belly, tail_3_seg, diamond_mace_core]
              }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.20) {
                rest_euler: [8, 0, 0]
                box diamond_mace_core { size: [8.0, 5.0, 10.5], material: azure_cobalt }
                box mace_dorsal_crest place(base_box=diamond_mace_core, anchor=[0, 0.96, 0], align=[0, -0.58, 0]) {
                  size: [6.0, 2.0, 9.5], material: deep_sapphire, rotate: [8, 0, 0], blend_with: [tail_4_seg, tail_lance_tip]
                }
                box mace_top_blade_1 place(base_box=mace_dorsal_crest, anchor=[0, 0.96, 0.30], align=[0, -0.82, 0]) {
                  size: [1.5, 2.5, 3.0], material: ivory_bone, rotate: [22, 0, 0], blend_with: [diamond_mace_core, tail_4_plate]
                }
                box mace_top_blade_2 place(base_box=mace_dorsal_crest, anchor=[0, 0.96, -0.34], align=[0, -0.82, 0]) {
                  size: [1.5, 3.0, 3.0], material: ivory_bone, rotate: [24, 0, 0], blend_with: [diamond_mace_core, mace_top_blade_1, tail_lance_tip]
                }
                box diamond_wing_l place(base_box=diamond_mace_core, anchor=[0.96, 0.05, -0.05], align=[-0.52, 0, 0]) {
                  size: [4.0, 3.5, 9.5], material: deep_sapphire, rotate: [6, 24, -8], blend_with: [tail_4_seg, tail_lance_tip]
                }
                box diamond_wing_r place(base_box=diamond_mace_core, anchor=[-0.96, 0.05, -0.05], align=[0.52, 0, 0]) {
                  size: [4.0, 3.5, 9.5], material: deep_sapphire, rotate: [6, -24, 8], blend_with: [tail_4_seg, tail_lance_tip]
                }
                box diamond_blade_l_1 place(base_box=diamond_wing_l, anchor=[0.94, 0.14, 0.56], align=[-0.82, 0, 0.35]) {
                  size: [5.0, 1.5, 2.5], material: ivory_bone, rotate: [6, 36, -8], blend_with: [diamond_mace_core, tail_4_seg]
                }
                box diamond_blade_r_1 place(base_box=diamond_wing_r, anchor=[-0.94, 0.14, 0.56], align=[0.82, 0, 0.35]) {
                  size: [5.0, 1.5, 2.5], material: ivory_bone, rotate: [6, -36, 8], blend_with: [diamond_mace_core, tail_4_seg]
                }
                box diamond_blade_l_2 place(base_box=diamond_wing_l, anchor=[0.96, 0.08, -0.02], align=[-0.84, 0, 0.35]) {
                  size: [6.0, 1.5, 2.5], material: ivory_bone, rotate: [6, 42, -8], blend_with: [diamond_mace_core, diamond_blade_l_1]
                }
                box diamond_blade_r_2 place(base_box=diamond_wing_r, anchor=[-0.96, 0.08, -0.02], align=[0.84, 0, 0.35]) {
                  size: [6.0, 1.5, 2.5], material: ivory_bone, rotate: [6, -42, 8], blend_with: [diamond_mace_core, diamond_blade_r_1]
                }
                box diamond_blade_l_3 place(base_box=diamond_wing_l, anchor=[0.94, 0.04, -0.58], align=[-0.82, 0, 0.35]) {
                  size: [5.0, 1.5, 2.5], material: ivory_bone, rotate: [6, 48, -8], blend_with: [diamond_mace_core, diamond_blade_l_2, tail_lance_tip]
                }
                box diamond_blade_r_3 place(base_box=diamond_wing_r, anchor=[-0.94, 0.04, -0.58], align=[0.82, 0, 0.35]) {
                  size: [5.0, 1.5, 2.5], material: ivory_bone, rotate: [6, -48, 8], blend_with: [diamond_mace_core, diamond_blade_r_2, tail_lance_tip]
                }
                box mace_ventral_spur_l place(base_box=diamond_mace_core, anchor=[0.72, -0.88, -0.10], align=[-0.65, 0.65, 0]) {
                  size: [2.5, 2.0, 6.0], material: midnight_slate, rotate: [-12, 24, 18], blend_with: [diamond_wing_l, tail_4_seg, tail_lance_tip]
                }
                box mace_ventral_spur_r place(base_box=diamond_mace_core, anchor=[-0.72, -0.88, -0.10], align=[0.65, 0.65, 0]) {
                  size: [2.5, 2.0, 6.0], material: midnight_slate, rotate: [-12, -24, -18], blend_with: [diamond_wing_r, tail_4_seg, tail_lance_tip]
                }
                plane mace_aero_fin_l place(base_box=diamond_wing_l, anchor=[0.85, 0.72, 0], align=[-0.85, -0.5, 0]) {
                  size: [3.5, 8.5], normal: x, material: emerald_sail, rotate: [8, 22, -28],
                  edge: spikes(width=2, min_len=2, max_len=6, side=top, seed=67), layer: 1,
                  blend_with: [diamond_mace_core, mace_dorsal_crest, diamond_blade_l_1, diamond_blade_l_2, diamond_blade_l_3]
                }
                plane mace_aero_fin_r place(base_box=diamond_wing_r, anchor=[-0.85, 0.72, 0], align=[0.85, -0.5, 0]) {
                  size: [3.5, 8.5], normal: x, material: emerald_sail, rotate: [8, -22, 28],
                  edge: spikes(width=2, min_len=2, max_len=6, side=top, seed=67), layer: 2,
                  blend_with: [diamond_mace_core, mace_dorsal_crest, diamond_blade_r_1, diamond_blade_r_2, diamond_blade_r_3]
                }

                bone tail_6 attach(parent_box=diamond_mace_core, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.20) {
                  rest_euler: [6, 0, 0]
                  box tail_lance_tip { size: [3.5, 3.0, 7.5], material: deep_sapphire }
                  box lance_side_barb_l place(base_box=tail_lance_tip, anchor=[0.96, 0.05, 0.12], align=[-0.78, 0, 0]) {
                    size: [2.5, 1.5, 5.0], material: ivory_bone, rotate: [6, 28, -8], blend_with: [diamond_mace_core, diamond_wing_l, diamond_blade_l_3]
                  }
                  box lance_side_barb_r place(base_box=tail_lance_tip, anchor=[-0.96, 0.05, 0.12], align=[0.78, 0, 0]) {
                    size: [2.5, 1.5, 5.0], material: ivory_bone, rotate: [6, -28, 8], blend_with: [diamond_mace_core, diamond_wing_r, diamond_blade_r_3]
                  }
                  box lance_ivory_spear place(base_box=tail_lance_tip, anchor=[0, 0.05, -0.96], align=[0, 0, 0.82]) {
                    size: [2.0, 2.0, 6.5], material: ivory_bone, rotate: [6, 0, 0]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
@materials {
  azure_cobalt: process(family=keratin_scales, coat=scale_rows, roughness=0.42)
  cerulean_rim: process(family=keratin_scales, coat=striped, roughness=0.38)
  deep_sapphire: process(family=keratin_scales, coat=scale_rows, roughness=0.48)
  midnight_slate: process(family=keratin_scales, coat=banded_limb, roughness=0.60)
  emerald_sail: process(family=patterned_skin, coat=mottled, roughness=0.56)
  jade_patagium: process(family=patterned_skin, coat=mottled, roughness=0.60)
  ivory_bone: process(family=polymer_dielectric, coat=striped, roughness=0.30)
  mist_cream: process(family=patterned_skin, coat=plain, roughness=0.66)
  mouth_crimson: process(family=patterned_skin, coat=plain, roughness=0.44, emissive=0.40)
  napalm_amber: process(family=thin_film_iridescence, coat=plain, roughness=0.16, emissive=0.95)
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
@stamps {
  stamp azure_eye_glint on skull_core.east { at: [0.74, 0.36], size: [1.5, 1.0], color: napalm_amber, emissive: 0.95, mirror: true }
  stamp jaw_napalm_spark on jaw_core.east { at: [0.58, 0.25], size: [2.0, 1.0], color: napalm_amber, emissive: 0.85, mirror: true }
  stamp sapphire_keel_crest on withers_carapace_c.up { at: [0.50, 0.50], size: [3.0, 6.5], color: midnight_slate, emissive: 0.0 }
}
@behavior {
  spring temporal_lance_l { stiffness: 48, damping: 6 }
  spring temporal_lance_r { stiffness: 48, damping: 6 }
  spring tail_6 { stiffness: 40, damping: 5 }

  // 1. High-Altitude Peregrine Pursuit Poise — alert falcon head scan, arched emerald wings & whip-mace sway
  clip idle {
    duration_s: 3.0, loop: true
    key root.position { 0.0: [0, 0, 0], 0.75: [0, -0.5, 0], 1.50: [0, 0.5, 0], 2.25: [0, -0.5, 0], 3.0: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.75: [2.5, 2.0, 0], 1.50: [-2.5, 0, 0], 2.25: [2.5, -2.0, 0], 3.0: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.75: [-3, 8, 2], 1.50: [2, 0, 0], 2.25: [-3, -8, -2], 3.0: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.75: [4, 14, -5], 1.50: [-3, 0, 0], 2.25: [4, -14, 5], 3.0: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 1.50: [8, 0, 0], 3.0: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 1.50: [-2, -5, 7], 3.0: [0, 0, 0], catmullrom }
    key wing_arm_r.rotation { 0.0: [0, 0, 0], 1.50: [-2, 5, -7], 3.0: [0, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=8, freq_hz=0.3333, phase_deg=0)
    track tail_2: wave(axis=y, amp_deg=11, freq_hz=0.3333, phase_deg=-35)
    track tail_3: wave(axis=y, amp_deg=14, freq_hz=0.3333, phase_deg=-70)
    track tail_4: wave(axis=y, amp_deg=17, freq_hz=0.3333, phase_deg=-105)
    track tail_5: wave(axis=y, amp_deg=20, freq_hz=0.3333, phase_deg=-140)
  }

  // 2. Agile Wide-Splayed Raptor Stalk
  clip walk {
    duration_s: 1.5, loop: true
    key root.position { 0.0: [0, 0, 0], 0.375: [0, 1.5, 0], 0.75: [0, 0, 0], 1.125: [0, 1.5, 0], 1.5: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, -8, 4], 0.375: [3, 0, 0], 0.75: [0, 8, -4], 1.125: [3, 0, 0], 1.5: [0, -8, 4], catmullrom }
    key chest.rotation { 0.0: [2, 9, -5], 0.375: [-2, 0, 0], 0.75: [2, -9, 5], 1.125: [-2, 0, 0], 1.5: [2, 9, -5], catmullrom }
    key neck_1.rotation { 0.0: [0, -7, 3], 0.75: [0, 7, -3], 1.5: [0, -7, 3], catmullrom }
    key head.rotation { 0.0: [3, -6, 3], 0.75: [3, 6, -3], 1.5: [3, -6, 3], catmullrom }
