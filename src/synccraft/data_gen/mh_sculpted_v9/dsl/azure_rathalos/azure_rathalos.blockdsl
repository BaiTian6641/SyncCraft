// Azure Rathalos (Cerulean Sky Sovereign) — Stage 3 Sculpted Blockbench Masterwork (V9)
// Hand-authored progressive Block-DSL v4.1 modeled from official Capcom Monster Hunter Azure Rathalos
// physiology & @zyhfisme sculpted Blockbench conventions:
// - Distinct high-altitude aerial-pursuit silhouette (NOT a palette swap of standard Rathalos!):
//   sleeker horizontal peregrine-falcon posture, narrower drag-reducing waist, deep wind-splitter chest keel,
//   elongated 3-segment temporal crown prongs + swept cheek lances, high-aspect gull-arched 4-finger wings
//   lined with ivory saw-spikes & 12 emerald-chartreuse scroll membrane bays, & diamond-spiked tail mace!
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 400
  budget max_bones = 96
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  azure_cobalt: ramp(base_lch=[0.52, 0.148, 246], steps=6, hue_shift=[20, -16])
  cerulean_rim: ramp(base_lch=[0.61, 0.142, 234], steps=6, hue_shift=[18, -14])
  deep_sapphire: ramp(base_lch=[0.38, 0.132, 254], steps=6, hue_shift=[18, -14])
  midnight_slate: ramp(base_lch=[0.27, 0.046, 258], steps=6, hue_shift=[18, -12])
  emerald_sail: ramp(base_lch=[0.73, 0.118, 146], steps=6, hue_shift=[22, -16])
  jade_patagium: ramp(base_lch=[0.64, 0.112, 158], steps=6, hue_shift=[20, -14])
  ivory_bone: ramp(base_lch=[0.88, 0.040, 88], steps=6, hue_shift=[18, -10])
  mist_cream: ramp(base_lch=[0.83, 0.042, 86], steps=6, hue_shift=[18, -10])
  mouth_crimson: ramp(base_lch=[0.42, 0.145, 24], steps=6, hue_shift=[16, -12])
  napalm_amber: ramp(base_lch=[0.85, 0.170, 56], steps=6, hue_shift=[14, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 21.60, -9.0]) {
      rest_euler: [-6, 0, 0]
      box pelvis_core { size: [11.5, 11.0, 13.5], material: midnight_slate }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.42, 0]) {
        size: [8.5, 2.0, 11.5], material: mist_cream
      }
      box sacrum_shingle place(base_box=pelvis_core, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
        size: [9.0, 2.5, 12.0], material: azure_cobalt, rotate: [6, 0, 0], blend_with: [lumbar_shingle, tail_1_plate, tail_1_seg]
      }
      box sacrum_fin_1 place(base_box=sacrum_shingle, anchor=[0, 0.96, 0.34], align=[0, -0.80, 0]) {
        size: [1.5, 2.5, 3.5], material: ivory_bone, rotate: [20, 0, 0], blend_with: [pelvis_core, lumbar_shingle]
      }
      box sacrum_fin_2 place(base_box=sacrum_shingle, anchor=[0, 0.96, -0.36], align=[0, -0.80, 0]) {
        size: [1.5, 2.5, 3.5], material: ivory_bone, rotate: [22, 0, 0], blend_with: [pelvis_core, tail_1_plate]
      }
      box haunch_muscle_l place(base_box=pelvis_core, anchor=[0.98, 0.22, 0.04], align=[-0.50, 0, 0]) {
        size: [3.5, 7.0, 9.5], material: azure_cobalt, rotate: [4, 6, -12], blend_with: [thigh_mass, waist_core]
      }
      box haunch_muscle_r place(base_box=pelvis_core, anchor=[-0.98, 0.22, 0.04], align=[0.50, 0, 0]) {
        size: [3.5, 7.0, 9.5], material: azure_cobalt, rotate: [4, -6, 12], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }
      box hip_strake_l place(base_box=haunch_muscle_l, anchor=[0.92, 0.42, -0.38], align=[-0.68, 0, 0.35]) {
        size: [2.0, 2.0, 5.5], material: cerulean_rim, rotate: [14, 24, -14], blend_with: [pelvis_core, thigh_mass, thigh_carapace]
      }
      box hip_strake_r place(base_box=haunch_muscle_r, anchor=[-0.92, 0.42, -0.38], align=[0.68, 0, 0.35]) {
        size: [2.0, 2.0, 5.5], material: cerulean_rim, rotate: [14, -24, 14], blend_with: [pelvis_core, hind_thigh_r__thigh_mass, hind_thigh_r__thigh_carapace]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.10, 1], align=[0, 0, -1], seat=0.26) {
        rest_euler: [-4, 0, 0]
        box waist_core { size: [11.5, 11.5, 12.5], material: midnight_slate }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.42, 0]) {
          size: [8.5, 2.0, 11.0], material: mist_cream, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_shingle place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
          size: [9.5, 2.5, 11.5], material: azure_cobalt, rotate: [-4, 0, 0], blend_with: [pelvis_core, chest_core, withers_carapace_c]
        }
        box lumbar_fin_1 place(base_box=lumbar_shingle, anchor=[0, 0.96, 0.32], align=[0, -0.80, 0]) {
          size: [2.0, 3.0, 4.0], material: deep_sapphire, rotate: [20, 0, 0], blend_with: [waist_core, chest_core, withers_carapace_c]
        }
        box lumbar_fin_2 place(base_box=lumbar_shingle, anchor=[0, 0.96, -0.34], align=[0, -0.80, 0]) {
          size: [1.5, 2.5, 3.5], material: ivory_bone, rotate: [22, 0, 0], blend_with: [waist_core, pelvis_core, sacrum_shingle]
        }
        box flank_strake_l_1 place(base_box=waist_core, anchor=[0.98, 0.32, 0.24], align=[-0.68, 0, 0]) {
          size: [2.0, 4.0, 5.0], material: deep_sapphire, rotate: [8, 12, -14], blend_with: [chest_core, lumbar_shingle]
        }
        box flank_strake_r_1 place(base_box=waist_core, anchor=[-0.98, 0.32, 0.24], align=[0.68, 0, 0]) {
          size: [2.0, 4.0, 5.0], material: deep_sapphire, rotate: [8, -12, 14], blend_with: [chest_core, lumbar_shingle]
        }
        box flank_strake_l_2 place(base_box=waist_core, anchor=[0.98, -0.14, -0.22], align=[-0.68, 0, 0]) {
          size: [2.0, 4.0, 5.0], material: cerulean_rim, rotate: [6, 14, -10], blend_with: [flank_strake_l_1, pelvis_core, haunch_muscle_l, thigh_mass]
        }
        box flank_strake_r_2 place(base_box=waist_core, anchor=[-0.98, -0.14, -0.22], align=[0.68, 0, 0]) {
          size: [2.0, 4.0, 5.0], material: cerulean_rim, rotate: [6, -14, 10], blend_with: [flank_strake_r_1, pelvis_core, haunch_muscle_r, hind_thigh_r__thigh_mass]
        }
        plane lumbar_aero_fin place(base_box=lumbar_shingle, anchor=[0.18, 0.94, 0], align=[0, -0.88, 0]) {
          size: [4.0, 9.5], normal: x, material: cerulean_rim, rotate: [6, 0, -6],
          edge: spikes(width=2, min_len=2, max_len=6, side=top, seed=13), layer: 1,
          blend_with: [lumbar_fin_1, lumbar_fin_2, withers_carapace_c, sacrum_shingle]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.16, 1], align=[0, 0, -1], seat=0.26) {
          rest_euler: [12, 0, 0]
          box chest_core { size: [18.0, 16.5, 16.5], material: midnight_slate }
          box withers_carapace_c place(base_box=chest_core, anchor=[0, 0.98, 0.08], align=[0, -0.55, 0]) {
            size: [12.0, 3.5, 15.0], material: azure_cobalt, rotate: [-8, 0, 0], blend_with: [neck_base, neck_shingle_c, waist_core, lumbar_fin_1]
          }
          box withers_plate_l place(base_box=chest_core, anchor=[0.68, 0.90, 0.10], align=[-0.15, -0.58, 0]) {
            size: [5.0, 3.0, 13.0], material: deep_sapphire, rotate: [-8, -10, -20], blend_with: [withers_carapace_c, neck_base, wing_humerus]
          }
          box withers_plate_r place(base_box=chest_core, anchor=[-0.68, 0.90, 0.10], align=[0.15, -0.58, 0]) {
            size: [5.0, 3.0, 13.0], material: deep_sapphire, rotate: [-8, 10, 20], blend_with: [withers_carapace_c, neck_base, wing_arm_r__wing_humerus]
          }
          box withers_spine_1 place(base_box=withers_carapace_c, anchor=[0, 0.96, 0.36], align=[0, -0.80, 0]) {
            size: [2.0, 3.5, 4.5], material: ivory_bone, rotate: [18, 0, 0], blend_with: [chest_core, neck_base, neck_shingle_c]
          }
          box withers_spine_2 place(base_box=withers_carapace_c, anchor=[0, 0.96, -0.04], align=[0, -0.80, 0]) {
            size: [2.0, 3.5, 4.5], material: deep_sapphire, rotate: [20, 0, 0], blend_with: [chest_core, withers_spine_1]
          }
          box withers_spine_3 place(base_box=withers_carapace_c, anchor=[0, 0.96, -0.44], align=[0, -0.80, 0]) {
            size: [2.0, 3.0, 4.0], material: ivory_bone, rotate: [22, 0, 0], blend_with: [chest_core, withers_spine_2, waist_core, lumbar_shingle]
          }
          plane withers_aero_fin place(base_box=withers_carapace_c, anchor=[-0.18, 0.94, 0], align=[0, -0.88, 0]) {
            size: [4.5, 12.5], normal: x, material: emerald_sail, rotate: [4, 0, 6],
            edge: spikes(width=2, min_len=3, max_len=7, side=top, seed=19), layer: 2,
            blend_with: [withers_spine_1, withers_spine_2, withers_spine_3, neck_shingle_c, lumbar_shingle, lumbar_aero_fin]
          }
          box pectoral_mount_l place(base_box=chest_core, anchor=[0.98, 0.10, 0.24], align=[-0.68, 0, 0]) {
            size: [2.5, 6.5, 10.0], material: deep_sapphire, rotate: [-6, 8, -12], blend_with: [withers_carapace_c, withers_plate_l, wing_humerus]
          }
          box pectoral_mount_r place(base_box=chest_core, anchor=[-0.98, 0.10, 0.24], align=[0.68, 0, 0]) {
            size: [2.5, 6.5, 10.0], material: deep_sapphire, rotate: [-6, -8, 12], blend_with: [withers_carapace_c, withers_plate_r, wing_arm_r__wing_humerus]
          }
          box rib_strake_l place(base_box=chest_core, anchor=[0.99, -0.28, -0.20], align=[-0.72, 0, 0]) {
            size: [2.0, 4.5, 6.0], material: cerulean_rim, rotate: [6, 12, -10], blend_with: [pectoral_mount_l, waist_core, flank_strake_l_1]
          }
          box rib_strake_r place(base_box=chest_core, anchor=[-0.99, -0.28, -0.20], align=[0.72, 0, 0]) {
            size: [2.0, 4.5, 6.0], material: cerulean_rim, rotate: [6, -12, 10], blend_with: [pectoral_mount_r, waist_core, flank_strake_r_1]
          }

          // Streamlined Aerodynamic Chest Keel & Wind-Splitter Sternum Blade!
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.34], align=[0, 0.42, 0]) {
            size: [11.0, 2.5, 8.5], material: mist_cream, rotate: [4, 0, 0], blend_with: [waist_belly, waist_core]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.96, 0.48], align=[0, 0.48, -0.20]) {
            size: [9.5, 2.5, 9.0], material: mist_cream, rotate: [-18, 0, 0], blend_with: [chest_scute_rear, neck_throat_scute]
          }
          box aero_sternum_keel place(base_box=chest_scute_front, anchor=[0, -0.96, 0.24], align=[0, 0.72, 0]) {
            size: [4.5, 3.0, 9.0], material: deep_sapphire, rotate: [-14, 0, 0], blend_with: [chest_core, chest_scute_rear, neck_throat_scute]
          }
          box keel_splitter_blade place(base_box=aero_sternum_keel, anchor=[0, -0.96, 0.25], align=[0, 0.84, 0]) {
            size: [2.0, 1.5, 7.5], material: ivory_bone, rotate: [-10, 0, 0], blend_with: [chest_scute_front, neck_throat_scute]
          }
          box collar_strake_l place(base_box=chest_core, anchor=[0.60, -0.38, 0.96], align=[-0.35, 0, -0.68]) {
            size: [4.0, 4.5, 2.5], material: azure_cobalt, rotate: [-10, -18, -8], blend_with: [chest_scute_front, aero_sternum_keel, pectoral_mount_l, neck_base, neck_throat_scute]
          }
          box collar_strake_r place(base_box=chest_core, anchor=[-0.60, -0.38, 0.96], align=[0.35, 0, -0.68]) {
            size: [4.0, 4.5, 2.5], material: azure_cobalt, rotate: [-10, 18, 8], blend_with: [chest_scute_front, aero_sternum_keel, pectoral_mount_r, neck_base, neck_throat_scute]
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.28, 1], align=[0, 0, -1], seat=0.24) {
            rest_euler: [-22, 0, 0]
            box neck_base { size: [10.0, 9.5, 10.5], material: midnight_slate }
            box neck_shingle_c place(base_box=neck_base, anchor=[0, 0.96, 0.05], align=[0, -0.55, 0]) {
              size: [8.0, 2.5, 9.5], material: azure_cobalt, rotate: [6, 0, 0], blend_with: [chest_core, withers_carapace_c, withers_spine_1, neck_upper, nape_shingle_c]
            }
            box neck_spine_1 place(base_box=neck_shingle_c, anchor=[0, 0.96, -0.06], align=[0, -0.86, 0]) {
              size: [1.5, 3.0, 3.5], material: ivory_bone, rotate: [18, 0, 0], blend_with: [neck_base, chest_core, withers_carapace_c, withers_spine_1]
            }
            box neck_spine_2 place(base_box=neck_shingle_c, anchor=[0, 0.96, 0.34], align=[0, -0.82, 0]) {
              size: [1.5, 2.5, 3.5], material: deep_sapphire, rotate: [18, 0, 0], blend_with: [neck_base, neck_upper, nape_shingle_c]
            }
            box neck_side_plate_l place(base_box=neck_base, anchor=[0.98, 0.24, 0.08], align=[-0.68, 0, 0]) {
              size: [2.0, 4.0, 8.0], material: deep_sapphire, rotate: [6, -10, -14], blend_with: [neck_shingle_c, chest_core, withers_plate_l, neck_upper]
            }
            box neck_side_plate_r place(base_box=neck_base, anchor=[-0.98, 0.24, 0.08], align=[0.68, 0, 0]) {
              size: [2.0, 4.0, 8.0], material: deep_sapphire, rotate: [6, 10, 14], blend_with: [neck_shingle_c, chest_core, withers_plate_r, neck_upper]
            }
            box neck_throat_scute place(base_box=neck_base, anchor=[0, -0.96, 0.10], align=[0, 0.48, 0]) {
              size: [7.5, 2.0, 9.0], material: mist_cream, rotate: [-6, 0, 0], blend_with: [chest_core, chest_scute_front, aero_sternum_keel]
            }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.10, 1], align=[0, 0, -1], seat=0.24) {
              rest_euler: [14, 0, 0]
              box neck_upper { size: [8.0, 8.0, 9.0], material: midnight_slate }
              box nape_shingle_c place(base_box=neck_upper, anchor=[0, 0.96, 0.0], align=[0, -0.55, 0]) {
                size: [6.5, 2.5, 8.5], material: azure_cobalt, rotate: [8, 0, 0], blend_with: [neck_base, neck_spine_2, skull_core, skull_crown]
              }
              box nape_spine_1 place(base_box=nape_shingle_c, anchor=[0, 0.96, -0.24], align=[0, -0.82, 0]) {
                size: [1.5, 2.5, 3.0], material: ivory_bone, rotate: [18, 0, 0], blend_with: [neck_upper, neck_shingle_c, horn_mid, crown_horn_r__horn_mid]
              }
              box nape_spine_2 place(base_box=nape_shingle_c, anchor=[0, 0.96, 0.28], align=[0, -0.82, 0]) {
                size: [1.5, 2.0, 2.5], material: deep_sapphire, rotate: [16, 0, 0], blend_with: [neck_upper, skull_core, skull_crown, horn_root, crown_horn_r__horn_root]
              }
              box nape_side_plate_l place(base_box=neck_upper, anchor=[0.98, 0.22, 0.05], align=[-0.68, 0, 0]) {
                size: [1.5, 3.5, 7.0], material: cerulean_rim, rotate: [6, -10, -14], blend_with: [nape_shingle_c, neck_base, neck_side_plate_l, skull_core, cheek_jowl_l, lance_frill_plate]
              }
              box nape_side_plate_r place(base_box=neck_upper, anchor=[-0.98, 0.22, 0.05], align=[0.68, 0, 0]) {
                size: [1.5, 3.5, 7.0], material: cerulean_rim, rotate: [6, 10, 14], blend_with: [nape_shingle_c, neck_base, neck_side_plate_r, skull_core, cheek_jowl_r, temporal_lance_r__lance_frill_plate]
              }
              box nape_throat_scute place(base_box=neck_upper, anchor=[0, -0.96, 0.05], align=[0, 0.52, 0]) {
                size: [5.5, 1.5, 7.5], material: mist_cream, rotate: [-4, 0, 0], blend_with: [neck_base, neck_throat_scute, jaw_core]
              }
              plane nape_aero_fin place(base_box=nape_shingle_c, anchor=[0.15, 0.94, 0], align=[0, -0.88, 0]) {
                size: [3.5, 7.0], normal: x, material: cerulean_rim, rotate: [8, 0, -5],
                edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=23), layer: 1,
                blend_with: [nape_spine_1, nape_spine_2, neck_shingle_c, skull_crown, horn_root, crown_horn_r__horn_root, horn_mid, crown_horn_r__horn_mid]
              }

              bone head attach(parent_box=neck_upper, anchor=[0, 0.06, 1], align=[0, 0, -1], seat=0.22) {
                rest_euler: [20, 0, 0]
                box skull_core { size: [9.0, 6.0, 8.0], material: azure_cobalt }
                box skull_crown place(base_box=skull_core, anchor=[0, 0.98, -0.10], align=[0, -0.60, 0]) {
                  size: [6.0, 2.0, 7.0], material: deep_sapphire, rotate: [6, 0, 0], blend_with: [neck_upper, nape_shingle_c, nape_spine_2, brow_blade_l, brow_blade_r]
                }
                box crown_aero_keel place(base_box=skull_crown, anchor=[0, 0.96, 0.14], align=[0, -0.80, 0]) {
                  size: [1.5, 1.5, 5.5], material: ivory_bone, rotate: [8, 0, 0], blend_with: [skull_core, nasal_aero_ridge, nape_spine_2]
                }
                box brow_blade_l place(base_box=skull_core, anchor=[0.84, 0.80, 0.52], align=[-0.15, -0.48, -0.25]) {
                  size: [2.5, 2.0, 6.0], material: deep_sapphire, rotate: [10, -14, -14], blend_with: [skull_crown]
                }
                box brow_blade_r place(base_box=skull_core, anchor=[-0.84, 0.80, 0.52], align=[0.15, -0.48, -0.25]) {
                  size: [2.5, 2.0, 6.0], material: deep_sapphire, rotate: [10, 14, 14], blend_with: [skull_crown]
                }
                box brow_lance_l place(base_box=brow_blade_l, anchor=[0.68, 0.92, -0.38], align=[-0.55, -0.80, 0.40]) {
                  size: [1.5, 1.5, 3.5], material: ivory_bone, rotate: [16, -20, -14], blend_with: [skull_core, skull_crown, horn_root]
                }
                box brow_lance_r place(base_box=brow_blade_r, anchor=[-0.68, 0.92, -0.38], align=[0.55, -0.80, 0.40]) {
                  size: [1.5, 1.5, 3.5], material: ivory_bone, rotate: [16, 20, 14], blend_with: [skull_core, skull_crown, crown_horn_r__horn_root]
                }
                box cheek_jowl_l place(base_box=skull_core, anchor=[0.98, -0.18, 0.05], align=[-0.50, 0, 0]) {
                  size: [2.5, 4.0, 6.0], material: azure_cobalt, rotate: [6, -14, 8], blend_with: [brow_blade_l, neck_upper]
                }
                box cheek_jowl_r place(base_box=skull_core, anchor=[-0.98, -0.18, 0.05], align=[0.50, 0, 0]) {
                  size: [2.5, 4.0, 6.0], material: azure_cobalt, rotate: [6, 14, -8], blend_with: [brow_blade_r, neck_upper]
                }
                box cheek_spur_l place(base_box=cheek_jowl_l, anchor=[0.92, -0.32, -0.58], align=[-0.72, 0, 0.55]) {
                  size: [1.5, 2.0, 4.0], material: ivory_bone, rotate: [8, -26, 12], blend_with: [skull_core, neck_upper, nape_side_plate_l, lance_frill_plate]
                }
                box cheek_spur_r place(base_box=cheek_jowl_r, anchor=[-0.92, -0.32, -0.58], align=[0.72, 0, 0.55]) {
                  size: [1.5, 2.0, 4.0], material: ivory_bone, rotate: [8, 26, -12], blend_with: [skull_core, neck_upper, nape_side_plate_r, temporal_lance_r__lance_frill_plate]
                }
                box eye_slit_l place(base_box=skull_core, anchor=[0.98, 0.45, 0.56], align=[-0.72, 0, 0]) {
                  size: [1.0, 1.5, 2.5], material: napalm_amber, rotate: [8, -10, 0], blend_with: [brow_blade_l, cheek_jowl_l]
                }
                box eye_slit_r place(base_box=skull_core, anchor=[-0.98, 0.45, 0.56], align=[0.72, 0, 0]) {
                  size: [1.0, 1.5, 2.5], material: napalm_amber, rotate: [8, 10, 0], blend_with: [brow_blade_r, cheek_jowl_r]
                }

