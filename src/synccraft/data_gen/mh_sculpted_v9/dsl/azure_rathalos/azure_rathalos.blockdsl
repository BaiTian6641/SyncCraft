    key wing_arm_r.rotation { 0.0: [0, 0, 0], 0.26: [-12, -16, -28], 0.64: [14, 28, 28], 1.25: [-8, 10, -22], 1.8: [0, 0, 0], catmullrom }
  }

  // 12. Cerulean Predator Threat Display — low falcon crouch, flaring emerald wing sails & temporal lances!
  clip cerulean_predator_threat_display {
    duration_s: 2.0, loop: false
    key root.position { 0.0: [0, 0, 0], 0.50: [2.2, -1.5, 1.5], 1.25: [-2.2, -1.2, 1.0], 2.0: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.50: [10, 16, -6], 1.25: [10, -16, 6], 2.0: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.50: [16, 18, 8], 1.25: [16, -18, -8], 2.0: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.50: [-14, 16, -20], 1.25: [-14, -16, 20], 2.0: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.45: [32, 0, 0], 0.75: [6, 0, 0], 1.20: [36, 0, 0], 1.55: [8, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 0.50: [-8, -16, 20], 1.25: [-6, -10, 16], 2.0: [0, 0, 0], catmullrom }
    key wing_arm_r.rotation { 0.0: [0, 0, 0], 0.50: [-6, 10, -16], 1.25: [-8, 16, -20], 2.0: [0, 0, 0], catmullrom }
  }
}
@controller {
  initial: idle
  idle -> walk when speed > 0.15, blend 0.20
  walk -> run when speed > 0.55, blend 0.18
  run -> walk when speed <= 0.45, blend 0.22
  walk -> idle when speed <= 0.08, blend 0.25
  idle -> roar when enraged > 0.5, blend 0.15
  roar -> idle when enraged <= 0.5, blend 0.25
}
