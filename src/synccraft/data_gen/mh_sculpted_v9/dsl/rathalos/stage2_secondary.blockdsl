// Rathalos (King of the Skies) — Stage 2 Secondary Anatomy, 3D Wedged Eagle-Beak Snout & Partitioned Wing Bays
// ~132 elements: 3D wedged maxilla/beak, 3-seg swept obsidian crown horns, serrated cheek frills, chin spike,
// crimson carapace shingles, 12 scalloped non-uni-sheet wing membrane bays, raptorial talons, & spiked mace tail.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 220
  budget max_bones = 80
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  rath_crimson: ramp(base_lch=[0.50, 0.168, 27], steps=6, hue_shift=[24, -16])
  deep_crimson: ramp(base_lch=[0.38, 0.145, 23], steps=6, hue_shift=[22, -14])
  charcoal_hide: ramp(base_lch=[0.29, 0.032, 38], steps=6, hue_shift=[20, -12])
  obsidian_horn: ramp(base_lch=[0.23, 0.026, 285], steps=6, hue_shift=[18, -12])
  belly_cream: ramp(base_lch=[0.80, 0.056, 80], steps=6, hue_shift=[20, -12])
  wing_tan: ramp(base_lch=[0.74, 0.068, 72], steps=6, hue_shift=[22, -14])
  ivory_claw: ramp(base_lch=[0.86, 0.044, 84], steps=6, hue_shift=[18, -10])
  hellfire_amber: ramp(base_lch=[0.84, 0.168, 68], steps=6, hue_shift=[14, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 20.65, -8.0]) {
      rest_euler: [-10, 0, 0]
      box pelvis_core { size: [12.0, 11.5, 13.0], material: charcoal_hide }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.40, 0]) {
        size: [9.0, 2.0, 11.0], material: belly_cream
      }
      box sacrum_shingle place(base_box=pelvis_core, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
        size: [9.5, 2.5, 11.5], material: rath_crimson, rotate: [6, 0, 0], blend_with: [lumbar_shingle, tail_1_plate, tail_1_seg]
      }
      box haunch_muscle_l place(base_box=pelvis_core, anchor=[0.98, 0.22, 0.02], align=[-0.48, 0, 0]) {
        size: [3.5, 7.5, 9.5], material: rath_crimson, rotate: [4, 6, -12], blend_with: [thigh_mass, waist_core]
      }
      box haunch_muscle_r place(base_box=pelvis_core, anchor=[-0.98, 0.22, 0.02], align=[0.48, 0, 0]) {
        size: [3.5, 7.5, 9.5], material: rath_crimson, rotate: [4, -6, 12], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.12, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-6, 0, 0]
        box waist_core { size: [13.0, 12.5, 11.5], material: charcoal_hide }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.40, 0]) {
          size: [9.5, 2.0, 10.0], material: belly_cream, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_shingle place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
          size: [10.0, 2.5, 10.5], material: rath_crimson, rotate: [-5, 0, 0], blend_with: [pelvis_core, chest_core, withers_carapace_c]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.18, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [8, 0, 0]
          box chest_core { size: [18.5, 16.5, 15.5], material: charcoal_hide }
          box withers_carapace_c place(base_box=chest_core, anchor=[0, 0.98, 0.08], align=[0, -0.55, 0]) {
            size: [12.5, 3.5, 14.0], material: rath_crimson, rotate: [-8, 0, 0], blend_with: [neck_base, neck_shingle_c, waist_core]
          }
          box pectoral_mount_l place(base_box=chest_core, anchor=[0.98, 0.12, 0.22], align=[-0.68, 0, 0]) {
            size: [2.5, 6.5, 9.5], material: rath_crimson, rotate: [-6, 8, -12], blend_with: [withers_carapace_c, wing_humerus]
          }
          box pectoral_mount_r place(base_box=chest_core, anchor=[-0.98, 0.12, 0.22], align=[0.68, 0, 0]) {
            size: [2.5, 6.5, 9.5], material: rath_crimson, rotate: [-6, -8, 12], blend_with: [withers_carapace_c, wing_arm_r__wing_humerus]
          }
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.32], align=[0, 0.42, 0]) {
            size: [12.5, 2.5, 8.0], material: belly_cream, rotate: [4, 0, 0], blend_with: [waist_belly, waist_core]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.96, 0.48], align=[0, 0.48, -0.20]) {
            size: [11.0, 2.5, 8.0], material: belly_cream, rotate: [-18, 0, 0], blend_with: [chest_scute_rear, neck_throat_scute]
          }
          box sternum_keel place(base_box=chest_scute_front, anchor=[0, -0.95, 0.20], align=[0, 0.72, 0]) {
            size: [6.0, 2.0, 6.5], material: deep_crimson, rotate: [-12, 0, 0], blend_with: [chest_core, neck_throat_scute]
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.32, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-30, 0, 0]
            box neck_base { size: [11.0, 10.5, 9.5], material: charcoal_hide }
            box neck_shingle_c place(base_box=neck_base, anchor=[0, 0.96, 0.05], align=[0, -0.55, 0]) {
              size: [8.5, 2.5, 9.0], material: rath_crimson, rotate: [8, 0, 0], blend_with: [chest_core, withers_carapace_c, neck_upper, nape_shingle_c]
            }
            box neck_throat_scute place(base_box=neck_base, anchor=[0, -0.96, 0.10], align=[0, 0.48, 0]) {
              size: [8.0, 2.0, 8.0], material: belly_cream, rotate: [-6, 0, 0], blend_with: [chest_core, chest_scute_front]
            }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.12, 1], align=[0, 0, -1], seat=0.26) {
              rest_euler: [18, 0, 0]
              box neck_upper { size: [8.5, 8.5, 8.5], material: charcoal_hide }
              box nape_shingle_c place(base_box=neck_upper, anchor=[0, 0.96, 0.0], align=[0, -0.55, 0]) {
                size: [7.0, 2.5, 8.0], material: rath_crimson, rotate: [8, 0, 0], blend_with: [neck_base, skull_core, skull_crown]
              }
              box nape_throat_scute place(base_box=neck_upper, anchor=[0, -0.96, 0.05], align=[0, 0.52, 0]) {
                size: [6.0, 1.5, 7.0], material: belly_cream, rotate: [-4, 0, 0], blend_with: [neck_base, neck_throat_scute, jaw_core]
              }

              bone head attach(parent_box=neck_upper, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.24) {
                rest_euler: [26, 0, 0]
                box skull_core { size: [9.5, 6.5, 7.5], material: rath_crimson }
                box skull_crown place(base_box=skull_core, anchor=[0, 0.98, -0.10], align=[0, -0.60, 0]) {
                  size: [6.5, 2.0, 6.5], material: deep_crimson, rotate: [6, 0, 0], blend_with: [neck_upper, nape_shingle_c, brow_ridge_l, brow_ridge_r]
                }
                box brow_ridge_l place(base_box=skull_core, anchor=[0.84, 0.80, 0.52], align=[-0.15, -0.48, -0.25]) {
                  size: [2.5, 2.0, 5.5], material: deep_crimson, rotate: [10, -12, -14], blend_with: [skull_crown]
                }
                box brow_ridge_r place(base_box=skull_core, anchor=[-0.84, 0.80, 0.52], align=[0.15, -0.48, -0.25]) {
                  size: [2.5, 2.0, 5.5], material: deep_crimson, rotate: [10, 12, 14], blend_with: [skull_crown]
                }
                box cheek_jowl_l place(base_box=skull_core, anchor=[0.98, -0.18, 0.05], align=[-0.50, 0, 0]) {
                  size: [2.5, 4.0, 5.5], material: rath_crimson, rotate: [6, -14, 8], blend_with: [brow_ridge_l, neck_upper]
                }
                box cheek_jowl_r place(base_box=skull_core, anchor=[-0.98, -0.18, 0.05], align=[0.50, 0, 0]) {
                  size: [2.5, 4.0, 5.5], material: rath_crimson, rotate: [6, 14, -8], blend_with: [brow_ridge_r, neck_upper]
                }
                box eye_slit_l place(base_box=skull_core, anchor=[0.98, 0.45, 0.56], align=[-0.72, 0, 0]) {
                  size: [1.0, 1.5, 2.5], material: hellfire_amber, rotate: [8, -10, 0], blend_with: [brow_ridge_l, cheek_jowl_l]
                }
                box eye_slit_r place(base_box=skull_core, anchor=[-0.98, 0.45, 0.56], align=[0.72, 0, 0]) {
                  size: [1.0, 1.5, 2.5], material: hellfire_amber, rotate: [8, 10, 0], blend_with: [brow_ridge_r, cheek_jowl_r]
                }

                // 3D Wedged Hooked Eagle-Beak Snout (snout_taper_ratio < 0.45!)
                box snout_core place(base_box=skull_core, anchor=[0, -0.10, 1], align=[0, 0, -0.80]) {
                  size: [4.5, 3.5, 6.5], material: rath_crimson, rotate: [10, 0, 0], blend_with: [brow_ridge_l, brow_ridge_r, eye_slit_l, eye_slit_r]
                }
                box nasal_bridge place(base_box=snout_core, anchor=[0, 0.90, 0.05], align=[0, -0.52, 0]) {
                  size: [3.0, 2.0, 6.5], material: deep_crimson, rotate: [6, 0, 0], blend_with: [skull_core, skull_crown, brow_ridge_l, brow_ridge_r]
                }
                box maxilla_wedge_l place(base_box=snout_core, anchor=[0.96, -0.10, -0.06], align=[-0.50, 0, 0]) {
                  size: [2.0, 3.0, 5.5], material: rath_crimson, rotate: [8, -18, 8], blend_with: [skull_core, cheek_jowl_l, nasal_bridge, eye_slit_l]
                }
                box maxilla_wedge_r place(base_box=snout_core, anchor=[-0.96, -0.10, -0.06], align=[0.50, 0, 0]) {
                  size: [2.0, 3.0, 5.5], material: rath_crimson, rotate: [8, 18, -8], blend_with: [skull_core, cheek_jowl_r, nasal_bridge, eye_slit_r]
                }
                box beak_hook place(base_box=snout_core, anchor=[0, -0.15, 0.96], align=[0, 0.15, -0.78]) {
                  size: [2.5, 3.0, 3.0], material: obsidian_horn, rotate: [32, 0, 0], blend_with: [nasal_bridge, maxilla_wedge_l, maxilla_wedge_r, jaw_core]
                }

                // Serrated Cheek/Ear Frills fanning outward & backward
                bone ear_frill_l attach(parent_box=skull_core, anchor=[0.95, 0.15, -0.35], align=[0, 0, 0.88], seat=0.06) mirror_x(ear_frill_r) {
                  rest_euler: [12, -34, 10]
                  box frill_plate { size: [1.5, 4.0, 6.5], material: rath_crimson, blend_with: [cheek_jowl_l, brow_ridge_l, neck_upper, horn_root, crown_horn_r__horn_root] }
                  box frill_spike_top place(base_box=frill_plate, anchor=[0, 0.65, -0.92], align=[0, 0, 0.78]) {
                    size: [1.0, 1.5, 3.5], material: obsidian_horn, rotate: [8, 0, 0]
                  }
                  box frill_spike_low place(base_box=frill_plate, anchor=[0, -0.45, -0.92], align=[0, 0, 0.78]) {
                    size: [1.0, 1.5, 3.0], material: obsidian_horn, rotate: [-6, 0, 0]
                  }
                }

                // 3-Segment Swept Obsidian Crown Horns
                bone crown_horn_l attach(parent_box=skull_core, anchor=[0.66, 0.88, -0.62], align=[0, 0, 0.92], seat=0.06) mirror_x(crown_horn_r) {
                  rest_euler: [22, -16, 10]
                  box horn_root { size: [2.5, 2.5, 5.0], material: obsidian_horn, blend_with: [skull_crown, brow_ridge_l, neck_upper, nape_shingle_c] }
                  bone crown_horn_mid_l attach(parent_box=horn_root, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.22) {
                    rest_euler: [12, -4, 0]
                    box horn_mid { size: [2.0, 2.0, 4.5], material: obsidian_horn, blend_with: [nape_shingle_c, neck_upper] }
                    bone crown_horn_tip_l attach(parent_box=horn_mid, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.22) {
                      rest_euler: [10, 4, 0]
                      box horn_tip { size: [1.5, 1.5, 4.0], material: obsidian_horn }
                    }
                  }
                }

                bone jaw attach(parent_box=skull_core, anchor=[0, -0.72, 0.18], align=[0, 0, -1], seat=0.16) {
                  rest_euler: [14, 0, 0]
                  box jaw_core { size: [4.0, 2.5, 8.0], material: belly_cream, blend_with: [snout_core, cheek_jowl_l, cheek_jowl_r] }
                  box chin_spike place(base_box=jaw_core, anchor=[0, -0.92, 0.76], align=[0, 0.82, -0.20]) {
                    size: [1.5, 3.5, 2.0], material: obsidian_horn, rotate: [-14, 0, 0]
                  }
                }
              }
            }
          }

          // Colossal Articulated 4-Finger Non-Uni-Sheet Wings (14 wing bones + 12 scalloped membrane planes!)
          bone wing_arm_l attach(parent_box=chest_core, anchor=[0.96, 0.58, 0.32], align=[-1, 0, 0], seat=0.12) mirror_x(wing_arm_r) {
            rest_euler: [-6, 24, 16]
            box wing_humerus { size: [14.0, 4.5, 4.5], material: rath_crimson, blend_with: [pectoral_mount_l] }
            box elbow_armor place(base_box=wing_humerus, anchor=[0.96, 0.35, -0.25], align=[-0.55, -0.45, 0.35]) {
              size: [3.5, 3.0, 4.5], material: deep_crimson, rotate: [8, 14, -10], blend_with: [wing_ulna]
            }
            plane wing_arm_patagium place(base_box=wing_humerus, anchor=[0.05, 0.10, -0.60], align=[0, 0, 1.0]) {
              size: [14.0, 16.0], normal: y, material: wing_tan,
              edge: scallop(bays=2, depth=5, side=top, seed=11), layer: 1,
              blend_with: [chest_core, pectoral_mount_l, waist_core, lumbar_shingle, wing_ulna, wing_forearm_patagium, finger_3_spar, finger_4_spar, wing_bay_3, wing_bay_4]
            }

            bone wing_forearm_l attach(parent_box=wing_humerus, anchor=[1, 0.05, 0], align=[-1, 0, 0], seat=0.12) {
              rest_euler: [4, -48, 12]
              box wing_ulna { size: [18.0, 4.0, 4.0], material: rath_crimson }
              box leading_spike_1 place(base_box=wing_ulna, anchor=[-0.35, 0.35, 0.96], align=[0, 0, -0.78]) {
                size: [1.5, 1.5, 3.0], material: obsidian_horn, rotate: [-12, -22, 0]
              }
              box leading_spike_2 place(base_box=wing_ulna, anchor=[0.15, 0.35, 0.96], align=[0, 0, -0.78]) {
                size: [1.5, 1.5, 3.5], material: obsidian_horn, rotate: [-12, -22, 0]
              }
              box leading_spike_3 place(base_box=wing_ulna, anchor=[0.62, 0.35, 0.96], align=[0, 0, -0.78]) {
                size: [1.5, 2.0, 4.0], material: obsidian_horn, rotate: [-12, -20, 0]
              }
              plane wing_forearm_patagium place(base_box=wing_ulna, anchor=[0.05, -0.10, -0.65], align=[0, 0, 1.0]) {
                size: [16.5, 13.5], normal: y, material: wing_tan,
                edge: scallop(bays=2, depth=5, side=top, seed=17), layer: 2,
                blend_with: [wing_humerus, wing_arm_patagium, finger_1_spar, finger_2_spar, finger_3_spar, finger_4_spar, wing_bay_1, wing_bay_2, wing_bay_3, wing_bay_4]
              }

              bone wing_thumb_claw_l attach(parent_box=wing_ulna, anchor=[0.94, 0.12, 0.92], align=[0, 0, -1], seat=0.10) {
                rest_euler: [14, -14, 0]
                box thumb_talon_base { size: [2.0, 2.0, 4.0], material: rath_crimson }
                box thumb_talon_tip place(base_box=thumb_talon_base, anchor=[0, -0.10, 0.96], align=[0, 0, -0.82]) {
                  size: [1.5, 1.5, 3.5], material: obsidian_horn, rotate: [20, 0, 0]
                }
              }

              bone wing_finger_1_l attach(parent_box=wing_ulna, anchor=[0.98, 0.08, 0.65], align=[-1, 0, 0], seat=0.06) {
                rest_euler: [-4, 24, -8]
                box finger_1_spar { size: [26.0, 2.5, 2.5], material: rath_crimson, blend_with: [thumb_talon_base, finger_2_spar, finger_3_spar, finger_4_spar] }
                plane wing_bay_1 place(base_box=finger_1_spar, anchor=[0.06, 0.10, -0.55], align=[0, 0, 1.0]) {
                  size: [22.5, 10.5], normal: y, material: wing_tan,
                  edge: scallop(bays=1, depth=6, side=right, seed=23), layer: 1,
                  blend_with: [wing_ulna, wing_forearm_patagium, finger_2_spar, finger_3_spar, finger_4_spar, wing_bay_2, wing_bay_3, wing_bay_4]
                }
              }

              bone wing_finger_2_l attach(parent_box=wing_ulna, anchor=[0.98, 0.02, 0.15], align=[-1, 0, 0], seat=0.06) {
                rest_euler: [-6, 48, -12]
                box finger_2_spar { size: [24.0, 2.5, 2.5], material: rath_crimson, blend_with: [finger_1_spar, finger_3_spar, finger_4_spar] }
                plane wing_bay_2 place(base_box=finger_2_spar, anchor=[0.06, -0.10, -0.55], align=[0, 0, 1.0]) {
                  size: [20.5, 10.5], normal: y, material: wing_tan,
                  edge: scallop(bays=1, depth=6, side=right, seed=29), layer: 2,
                  blend_with: [wing_ulna, wing_forearm_patagium, finger_1_spar, finger_3_spar, finger_4_spar, wing_bay_1, wing_bay_3, wing_bay_4]
                }
              }

              bone wing_finger_3_l attach(parent_box=wing_ulna, anchor=[0.96, -0.04, -0.38], align=[-1, 0, 0], seat=0.04) {
                rest_euler: [-8, 72, -16]
                box finger_3_spar { size: [21.5, 2.0, 2.0], material: charcoal_hide, blend_with: [finger_1_spar, finger_2_spar, finger_4_spar] }
                plane wing_bay_3 place(base_box=finger_3_spar, anchor=[0.06, 0.10, -0.55], align=[0, 0, 1.0]) {
                  size: [18.5, 10.5], normal: y, material: wing_tan,
                  edge: scallop(bays=1, depth=6, side=right, seed=31), layer: 1,
                  blend_with: [wing_ulna, wing_arm_patagium, wing_forearm_patagium, finger_1_spar, finger_2_spar, finger_4_spar, wing_bay_1, wing_bay_2, wing_bay_4]
                }
              }

              bone wing_finger_4_l attach(parent_box=wing_ulna, anchor=[0.92, -0.08, -0.88], align=[-1, 0, 0], seat=0.04) {
                rest_euler: [-8, 96, -18]
                box finger_4_spar { size: [18.5, 2.0, 2.0], material: charcoal_hide, blend_with: [finger_1_spar, finger_2_spar, finger_3_spar, wing_humerus] }
                plane wing_bay_4 place(base_box=finger_4_spar, anchor=[0.04, -0.10, -0.55], align=[0, 0, 1.0]) {
                  size: [16.5, 10.5], normal: y, material: wing_tan,
                  edge: scallop(bays=2, depth=5, side=top, seed=37), layer: 2,
                  blend_with: [wing_ulna, wing_humerus, wing_arm_patagium, wing_forearm_patagium, finger_1_spar, finger_2_spar, finger_3_spar, wing_bay_1, wing_bay_2, wing_bay_3]
                }
              }
            }
          }
        }
      }

      // Muscular Raptorial Digitigrade Hindlegs with Venom Talons grounded at Y = 0!
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.95, -0.08, 0.08], align=[-0.55, 0.85, 0], seat=0.12) mirror_x(hind_thigh_r) {
        rest_euler: [-26, -6, 18]
        box thigh_mass { size: [7.0, 12.5, 8.5], material: charcoal_hide, blend_with: [waist_core, tail_1_seg] }
        box thigh_carapace place(base_box=thigh_mass, anchor=[0.98, 0.25, 0.08], align=[-0.50, 0, 0]) {
          size: [2.5, 7.0, 6.5], material: rath_crimson, rotate: [6, -8, -10], blend_with: [pelvis_core, haunch_muscle_l]
        }
        box knee_guard place(base_box=thigh_mass, anchor=[0.10, -0.82, 0.96], align=[0, 0, -0.72]) {
          size: [4.0, 3.5, 2.5], material: rath_crimson, rotate: [-14, 0, 0], blend_with: [shin_mass, waist_core, waist_belly]
        }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [58, 0, -12]
          box shin_mass { size: [5.0, 11.5, 5.5], material: charcoal_hide }
          box shin_guard place(base_box=shin_mass, anchor=[0.15, 0.08, 0.96], align=[0, 0, -0.68]) {
            size: [3.5, 7.5, 2.0], material: rath_crimson, rotate: [4, 0, 0], blend_with: [thigh_mass, knee_guard, hind_foot_pad]
          }
          box hock_spur place(base_box=shin_mass, anchor=[0, 0.22, -0.96], align=[0, 0, 0.82]) {
            size: [2.5, 2.5, 3.5], material: obsidian_horn, rotate: [18, 0, 0]
          }

          bone hind_foot_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.45], seat=0.14) {
            rest_euler: [-22, 0, -6]
            box hind_foot_pad { size: [6.5, 3.0, 7.0], material: charcoal_hide }
            box h_toe_1 place(base_box=hind_foot_pad, anchor=[-0.64, -0.12, 0.92], align=[0, 0, -0.76]) {
              size: [2.0, 2.0, 4.0], material: belly_cream, rotate: [3, 15, 0]
            }
            box h_talon_1 place(base_box=h_toe_1, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.5, 1.5, 3.5], material: obsidian_horn, rotate: [10, 4, 0]
            }
            box h_toe_2 place(base_box=hind_foot_pad, anchor=[0.0, -0.12, 0.96], align=[0, 0, -0.78]) {
              size: [2.0, 2.0, 4.5], material: belly_cream, rotate: [3, 0, 0], blend_with: [h_toe_1]
            }
            box h_talon_2 place(base_box=h_toe_2, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.5, 1.5, 4.0], material: obsidian_horn, rotate: [10, 0, 0], blend_with: [h_talon_1]
            }
            box h_toe_3 place(base_box=hind_foot_pad, anchor=[0.64, -0.12, 0.92], align=[0, 0, -0.76]) {
              size: [2.0, 2.0, 4.0], material: belly_cream, rotate: [3, -15, 0], blend_with: [h_toe_2]
            }
            box h_talon_3 place(base_box=h_toe_3, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.5, 1.5, 3.5], material: obsidian_horn, rotate: [10, -4, 0], blend_with: [h_talon_2]
            }
            box h_hallux_claw place(base_box=hind_foot_pad, anchor=[0, -0.05, -0.94], align=[0, 0, 0.80]) {
              size: [1.5, 1.5, 3.5], material: obsidian_horn, rotate: [-8, 0, 0], blend_with: [shin_mass]
            }
          }
        }
      }

      // S-Curved Tail Flaring into Spiked Mace Club at tail_5!
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.18, -1], align=[0, 0, 1], seat=0.24) {
        rest_euler: [6, 0, 0]
        box tail_1_seg { size: [9.5, 9.0, 9.0], material: charcoal_hide }
        box tail_1_plate place(base_box=tail_1_seg, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
          size: [7.5, 2.5, 8.0], material: rath_crimson, rotate: [8, 0, 0], blend_with: [pelvis_core, sacrum_shingle, tail_2_seg, tail_2_plate]
        }
        box tail_1_belly place(base_box=tail_1_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
          size: [6.5, 1.5, 8.0], material: belly_cream, blend_with: [pelvis_belly, pelvis_core]
        }

        bone tail_2 attach(parent_box=tail_1_seg, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.24) {
          rest_euler: [6, 0, 0]
          box tail_2_seg { size: [8.0, 7.5, 9.0], material: charcoal_hide }
          box tail_2_plate place(base_box=tail_2_seg, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
            size: [6.5, 2.0, 8.0], material: rath_crimson, rotate: [8, 0, 0], blend_with: [tail_1_seg, tail_3_seg, tail_3_plate]
          }
          box tail_2_belly place(base_box=tail_2_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
            size: [5.5, 1.5, 8.0], material: belly_cream, blend_with: [tail_1_belly, tail_1_seg]
          }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.24) {
            rest_euler: [8, 0, 0]
            box tail_3_seg { size: [6.5, 6.5, 9.0], material: charcoal_hide }
            box tail_3_plate place(base_box=tail_3_seg, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
              size: [5.5, 2.0, 8.0], material: rath_crimson, rotate: [8, 0, 0], blend_with: [tail_2_seg, tail_4_seg, tail_4_plate]
            }
            box tail_3_belly place(base_box=tail_3_seg, anchor=[0, -0.96, 0], align=[0, 0.48, 0]) {
              size: [4.5, 1.5, 8.0], material: belly_cream, blend_with: [tail_2_belly, tail_2_seg]
            }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.24) {
              rest_euler: [10, 0, 0]
              box tail_4_seg { size: [5.5, 5.5, 8.5], material: charcoal_hide }
              box tail_4_plate place(base_box=tail_4_seg, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
                size: [4.5, 2.0, 7.5], material: rath_crimson, rotate: [10, 0, 0], blend_with: [tail_3_seg, tail_club_core]
              }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.22) {
                rest_euler: [10, 0, 0]
                box tail_club_core { size: [8.5, 5.5, 9.5], material: rath_crimson }
                box club_flange_l place(base_box=tail_club_core, anchor=[0.96, 0.05, -0.05], align=[-0.52, 0, 0]) {
                  size: [3.5, 4.0, 8.5], material: deep_crimson, rotate: [6, 18, -8], blend_with: [tail_4_seg, tail_stinger]
                }
                box club_flange_r place(base_box=tail_club_core, anchor=[-0.96, 0.05, -0.05], align=[0.52, 0, 0]) {
                  size: [3.5, 4.0, 8.5], material: deep_crimson, rotate: [6, -18, 8], blend_with: [tail_4_seg, tail_stinger]
                }
                box club_spike_l_1 place(base_box=club_flange_l, anchor=[0.92, 0.15, 0.55], align=[-0.78, 0, 0]) {
                  size: [4.0, 2.0, 2.5], material: obsidian_horn, rotate: [6, 26, -10], blend_with: [tail_club_core, tail_4_seg]
                }
                box club_spike_r_1 place(base_box=club_flange_r, anchor=[-0.92, 0.15, 0.55], align=[0.78, 0, 0]) {
                  size: [4.0, 2.0, 2.5], material: obsidian_horn, rotate: [6, -26, 10], blend_with: [tail_club_core, tail_4_seg]
                }
                box club_spike_l_2 place(base_box=club_flange_l, anchor=[0.94, 0.10, -0.05], align=[-0.80, 0, 0]) {
                  size: [4.5, 2.0, 2.5], material: obsidian_horn, rotate: [6, 32, -10], blend_with: [tail_club_core, club_spike_l_1]
                }
                box club_spike_r_2 place(base_box=club_flange_r, anchor=[-0.94, 0.10, -0.05], align=[0.80, 0, 0]) {
                  size: [4.5, 2.0, 2.5], material: obsidian_horn, rotate: [6, -32, 10], blend_with: [tail_club_core, club_spike_r_1]
                }
                box club_spike_l_3 place(base_box=club_flange_l, anchor=[0.92, 0.08, -0.62], align=[-0.78, 0, 0]) {
                  size: [4.0, 2.0, 2.5], material: obsidian_horn, rotate: [6, 38, -10], blend_with: [tail_club_core, club_spike_l_2, tail_stinger]
                }
                box club_spike_r_3 place(base_box=club_flange_r, anchor=[-0.92, 0.08, -0.62], align=[0.78, 0, 0]) {
                  size: [4.0, 2.0, 2.5], material: obsidian_horn, rotate: [6, -38, 10], blend_with: [tail_club_core, club_spike_r_2, tail_stinger]
                }

                bone tail_6 attach(parent_box=tail_club_core, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.22) {
                  rest_euler: [6, 0, 0]
                  box tail_stinger { size: [3.5, 3.5, 7.5], material: obsidian_horn }
                }
              }
            }
          }
        }
      }
    }
  }
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
