  // 11. Thunderous Wing-Gust Windpress Back-Hop & Fireball Counter!
  clip wing_gust_windpress_takeoff {
    duration_s: 1.8, loop: false
    key root.position { 0.0: [0, 0, 0], 0.28: [0, -2.0, 2.0], 0.68: [0, 14.0, -14.0], 1.25: [0, 1.5, -16.0], 1.8: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.28: [12, 0, 0], 0.68: [-18, 0, 0], 1.25: [10, 0, 0], 1.8: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.28: [-14, 0, 0], 0.68: [18, 0, 0], 1.25: [12, 0, 0], 1.8: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.68: [38, 0, 0], 1.25: [18, 0, 0], 1.8: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 0.28: [-12, 16, 32], 0.65: [14, -26, -24], 1.25: [-8, -10, 22], 1.8: [0, 0, 0], catmullrom }
    key wing_arm_r.rotation { 0.0: [0, 0, 0], 0.28: [-12, -16, -32], 0.65: [14, 26, 24], 1.25: [-8, 10, -22], 1.8: [0, 0, 0], catmullrom }
  }

  // 12. Menacing Enraged Sky-King Threat Display (lowers eagle beak, snaps jaws, flares wings & frills!)
  clip enraged_sky_king_taunt {
    duration_s: 2.0, loop: false
    key root.position { 0.0: [0, 0, 0], 0.50: [2.0, -1.5, 1.5], 1.25: [-2.0, -1.2, 1.0], 2.0: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.50: [10, 14, -6], 1.25: [10, -14, 6], 2.0: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.50: [16, 16, 8], 1.25: [16, -16, -8], 2.0: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.50: [-14, 14, -18], 1.25: [-14, -14, 18], 2.0: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.45: [30, 0, 0], 0.75: [6, 0, 0], 1.20: [34, 0, 0], 1.55: [8, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 0.50: [-8, -14, 22], 1.25: [-6, -10, 18], 2.0: [0, 0, 0], catmullrom }
    key wing_arm_r.rotation { 0.0: [0, 0, 0], 0.50: [-6, 10, -18], 1.25: [-8, 14, -22], 2.0: [0, 0, 0], catmullrom }
  }
}
@controller {
  initial: idle
  idle -> walk when speed > 0.15, blend 0.20
  walk -> run when speed > 0.55, blend 0.18
  run -> walk when speed <= 0.45, blend 0.22
  walk -> idle when speed <= 0.08, blend 0.25
  idle -> roar when enraged > 0.5, blend 0.15
  roar -> idle when enraged <= 0.5, blend 0.25
}
