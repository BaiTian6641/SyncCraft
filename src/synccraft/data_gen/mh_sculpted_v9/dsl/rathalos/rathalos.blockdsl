        }
        box knee_spike place(base_box=knee_guard, anchor=[0, 0.15, 0.96], align=[0, 0, -0.82]) {
          size: [1.5, 1.5, 2.5], material: obsidian_horn, rotate: [-18, 0, 0]
        }
        plane thigh_scale_fringe place(base_box=thigh_mass, anchor=[0.42, -0.15, -0.98], align=[0, 0, 0.88]) {
          size: [6.5, 4.0], normal: x, material: deep_crimson, rotate: [-10, 12, 0],
          edge: spikes(width=2, min_len=2, max_len=5, side=right, seed=47), layer: 1,
          blend_with: [thigh_carapace, thigh_shingle_low, thigh_rear_spur, shin_mass]
        }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [58, 0, -12]
          box shin_mass { size: [5.0, 11.5, 5.5], material: charcoal_hide }
          box calf_bulge place(base_box=shin_mass, anchor=[0, 0.35, -0.92], align=[0, 0, 0.55]) {
            size: [4.0, 5.5, 2.5], material: deep_crimson, rotate: [10, 0, 0], blend_with: [thigh_mass, hock_spur]
          }
          box shin_guard place(base_box=shin_mass, anchor=[0.15, 0.12, 0.96], align=[0, 0, -0.68]) {
            size: [3.5, 7.5, 2.0], material: rath_crimson, rotate: [4, 0, 0], blend_with: [thigh_mass, knee_guard, hind_foot_pad]
          }
          box ankle_shingle place(base_box=shin_guard, anchor=[0, -0.82, 0.88], align=[0, 0.45, -0.75]) {
            size: [3.0, 2.5, 1.5], material: scarlet_rim, rotate: [12, 0, 0], blend_with: [shin_mass, hind_foot_pad, h_knuckle_plate]
          }
          box hock_spur place(base_box=shin_mass, anchor=[0, -0.12, -0.96], align=[0, 0, 0.82]) {
            size: [2.0, 2.0, 3.5], material: obsidian_horn, rotate: [18, 0, 0], blend_with: [calf_bulge]
          }
          plane shin_scale_fringe place(base_box=shin_mass, anchor=[0.30, -0.35, -0.98], align=[0, 0, 0.88]) {
            size: [5.5, 3.5], normal: x, material: obsidian_horn, rotate: [8, 10, 0],
            edge: spikes(width=2, min_len=2, max_len=5, side=right, seed=53), layer: 1,
            blend_with: [calf_bulge, hock_spur, hind_foot_pad]
          }

          bone hind_foot_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.45], seat=0.14) {
            rest_euler: [-22, 0, -6]
            box hind_foot_pad { size: [6.5, 3.0, 7.0], material: charcoal_hide }
            box h_knuckle_plate place(base_box=hind_foot_pad, anchor=[0, 0.96, 0.58], align=[0, -0.80, 0]) {
              size: [5.5, 1.0, 3.5], material: rath_crimson, rotate: [10, 0, 0], blend_with: [shin_mass, shin_guard, ankle_shingle, h_toe_1, h_toe_2, h_toe_3]
            }
            box h_toe_1 place(base_box=hind_foot_pad, anchor=[-0.64, -0.12, 0.92], align=[0, 0, -0.76]) {
              size: [2.0, 2.0, 4.0], material: belly_cream, rotate: [3, 15, 0]
            }
            box h_talon_1 place(base_box=h_toe_1, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.5, 1.5, 3.5], material: obsidian_horn, rotate: [10, 4, 0]
            }
            box h_toe_2 place(base_box=hind_foot_pad, anchor=[0.0, -0.12, 0.96], align=[0, 0, -0.78]) {
              size: [2.0, 2.0, 4.5], material: belly_cream, rotate: [3, 0, 0], blend_with: [h_toe_1]
            }
            box h_talon_2 place(base_box=h_toe_2, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.5, 1.5, 4.0], material: obsidian_horn, rotate: [10, 0, 0], blend_with: [h_talon_1]
            }
            box h_toe_3 place(base_box=hind_foot_pad, anchor=[0.64, -0.12, 0.92], align=[0, 0, -0.76]) {
              size: [2.0, 2.0, 4.0], material: belly_cream, rotate: [3, -15, 0], blend_with: [h_toe_2]
            }
            box h_talon_3 place(base_box=h_toe_3, anchor=[0, -0.05, 0.96], align=[0, 0, -0.82]) {
              size: [1.5, 1.5, 3.5], material: obsidian_horn, rotate: [10, -4, 0], blend_with: [h_talon_2]
            }
            box h_inner_dewclaw place(base_box=hind_foot_pad, anchor=[-0.96, 0.10, -0.28], align=[0.75, 0, 0.35]) {
              size: [1.5, 1.5, 3.0], material: obsidian_horn, rotate: [8, -24, 0], blend_with: [shin_mass]
            }
            box h_hallux_claw place(base_box=hind_foot_pad, anchor=[0, -0.05, -0.94], align=[0, 0, 0.80]) {
              size: [1.5, 1.5, 3.5], material: obsidian_horn, rotate: [-8, 0, 0], blend_with: [shin_mass]
            }
          }
        }
      }

      // S-Curved Tail Flaring into Spiked Crimson-Obsidian Mace Club (`tail_1..tail_6`)!
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.18, -1], align=[0, 0, 1], seat=0.24) {
        rest_euler: [6, 0, 0]
        box tail_1_seg { size: [9.5, 9.0, 9.0], material: charcoal_hide }
        box tail_1_plate place(base_box=tail_1_seg, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
          size: [7.5, 2.5, 8.0], material: rath_crimson, rotate: [8, 0, 0], blend_with: [pelvis_core, sacrum_shingle, sacrum_spine_2, tail_2_seg, tail_2_plate]
        }
        box tail_1_spine place(base_box=tail_1_plate, anchor=[0, 0.96, -0.05], align=[0, -0.78, 0]) {
          size: [2.0, 2.5, 3.0], material: obsidian_horn, rotate: [18, 0, 0], blend_with: [tail_1_seg, pelvis_core, sacrum_shingle]
        }
        box tail_1_keel_l place(base_box=tail_1_seg, anchor=[0.98, 0.12, -0.10], align=[-0.68, 0, 0.30]) {
          size: [2.0, 3.0, 6.5], material: deep_crimson, rotate: [8, 16, -10], blend_with: [pelvis_core, haunch_muscle_l, tail_2_seg]
        }
        box tail_1_keel_r place(base_box=tail_1_seg, anchor=[-0.98, 0.12, -0.10], align=[0.68, 0, 0.30]) {
          size: [2.0, 3.0, 6.5], material: deep_crimson, rotate: [8, -16, 10], blend_with: [pelvis_core, haunch_muscle_r, tail_2_seg]
        }
        box tail_1_belly place(base_box=tail_1_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
          size: [6.5, 1.5, 8.0], material: belly_cream, blend_with: [pelvis_belly, pelvis_core]
        }

        bone tail_2 attach(parent_box=tail_1_seg, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.24) {
          rest_euler: [6, 0, 0]
          box tail_2_seg { size: [8.0, 7.5, 9.0], material: charcoal_hide }
          box tail_2_plate place(base_box=tail_2_seg, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
            size: [6.5, 2.0, 8.0], material: rath_crimson, rotate: [8, 0, 0], blend_with: [tail_1_seg, tail_3_seg, tail_3_plate]
          }
          box tail_2_spine place(base_box=tail_2_plate, anchor=[0, 0.96, -0.05], align=[0, -0.78, 0]) {
            size: [1.5, 2.5, 3.0], material: obsidian_horn, rotate: [18, 0, 0], blend_with: [tail_2_seg, tail_1_plate]
          }
          box tail_2_keel_l place(base_box=tail_2_seg, anchor=[0.98, 0.10, -0.10], align=[-0.68, 0, 0.30]) {
            size: [2.0, 2.5, 6.5], material: deep_crimson, rotate: [8, 16, -10], blend_with: [tail_1_seg, tail_1_keel_l, tail_3_seg]
          }
          box tail_2_keel_r place(base_box=tail_2_seg, anchor=[-0.98, 0.10, -0.10], align=[0.68, 0, 0.30]) {
            size: [2.0, 2.5, 6.5], material: deep_crimson, rotate: [8, -16, 10], blend_with: [tail_1_seg, tail_1_keel_r, tail_3_seg]
          }
          box tail_2_belly place(base_box=tail_2_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
            size: [5.5, 1.5, 8.0], material: belly_cream, blend_with: [tail_1_belly, tail_1_seg]
          }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.24) {
            rest_euler: [8, 0, 0]
            box tail_3_seg { size: [6.5, 6.5, 9.0], material: charcoal_hide }
            box tail_3_plate place(base_box=tail_3_seg, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
              size: [5.5, 2.0, 8.0], material: rath_crimson, rotate: [8, 0, 0], blend_with: [tail_2_seg, tail_4_seg, tail_4_plate]
            }
            box tail_3_spine place(base_box=tail_3_plate, anchor=[0, 0.96, -0.05], align=[0, -0.78, 0]) {
              size: [1.5, 2.5, 3.0], material: obsidian_horn, rotate: [18, 0, 0], blend_with: [tail_3_seg, tail_2_plate]
            }
            box tail_3_keel_l place(base_box=tail_3_seg, anchor=[0.98, 0.08, -0.10], align=[-0.72, 0, 0.30]) {
              size: [1.5, 2.0, 6.5], material: deep_crimson, rotate: [8, 16, -8], blend_with: [tail_2_seg, tail_2_keel_l, tail_4_seg]
            }
            box tail_3_keel_r place(base_box=tail_3_seg, anchor=[-0.98, 0.08, -0.10], align=[0.72, 0, 0.30]) {
              size: [1.5, 2.0, 6.5], material: deep_crimson, rotate: [8, -16, 8], blend_with: [tail_2_seg, tail_2_keel_r, tail_4_seg]
            }
            box tail_3_belly place(base_box=tail_3_seg, anchor=[0, -0.96, 0], align=[0, 0.48, 0]) {
              size: [4.5, 1.5, 8.0], material: belly_cream, blend_with: [tail_2_belly, tail_2_seg]
            }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.24) {
              rest_euler: [10, 0, 0]
              box tail_4_seg { size: [5.5, 5.5, 8.5], material: charcoal_hide }
              box tail_4_plate place(base_box=tail_4_seg, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
                size: [4.5, 2.0, 7.5], material: rath_crimson, rotate: [10, 0, 0], blend_with: [tail_3_seg, tail_club_core, club_dorsal_shield]
              }
              box tail_4_spine place(base_box=tail_4_plate, anchor=[0, 0.96, -0.05], align=[0, -0.78, 0]) {
                size: [1.5, 2.0, 2.5], material: obsidian_horn, rotate: [18, 0, 0], blend_with: [tail_4_seg, tail_3_plate]
              }
              box tail_4_belly place(base_box=tail_4_seg, anchor=[0, -0.96, 0], align=[0, 0.52, 0]) {
                size: [3.5, 1.0, 7.5], material: belly_cream, blend_with: [tail_3_belly, tail_3_seg, tail_club_core]
              }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.22) {
                rest_euler: [10, 0, 0]
                box tail_club_core { size: [8.5, 5.5, 9.5], material: rath_crimson }
                box club_dorsal_shield place(base_box=tail_club_core, anchor=[0, 0.96, 0], align=[0, -0.58, 0]) {
                  size: [6.5, 2.0, 8.5], material: deep_crimson, rotate: [8, 0, 0], blend_with: [tail_4_seg, tail_stinger]
                }
                box club_top_spike_1 place(base_box=club_dorsal_shield, anchor=[0, 0.96, 0.28], align=[0, -0.80, 0]) {
                  size: [1.5, 2.5, 2.5], material: obsidian_horn, rotate: [20, 0, 0], blend_with: [tail_club_core, tail_4_plate]
                }
                box club_top_spike_2 place(base_box=club_dorsal_shield, anchor=[0, 0.96, -0.32], align=[0, -0.80, 0]) {
                  size: [1.5, 2.5, 2.5], material: obsidian_horn, rotate: [22, 0, 0], blend_with: [tail_club_core, club_top_spike_1, tail_stinger]
                }
                box club_flange_l place(base_box=tail_club_core, anchor=[0.96, 0.05, -0.05], align=[-0.52, 0, 0]) {
                  size: [3.5, 4.0, 8.5], material: deep_crimson, rotate: [6, 18, -8], blend_with: [tail_4_seg, tail_stinger]
                }
                box club_flange_r place(base_box=tail_club_core, anchor=[-0.96, 0.05, -0.05], align=[0.52, 0, 0]) {
                  size: [3.5, 4.0, 8.5], material: deep_crimson, rotate: [6, -18, 8], blend_with: [tail_4_seg, tail_stinger]
                }
                box club_spike_l_1 place(base_box=club_flange_l, anchor=[0.92, 0.16, 0.62], align=[-0.80, 0, 0]) {
                  size: [4.5, 2.0, 2.0], material: obsidian_horn, rotate: [6, 24, -10], blend_with: [tail_club_core, tail_4_seg]
                }
                box club_spike_r_1 place(base_box=club_flange_r, anchor=[-0.92, 0.16, 0.62], align=[0.80, 0, 0]) {
                  size: [4.5, 2.0, 2.0], material: obsidian_horn, rotate: [6, -24, 10], blend_with: [tail_club_core, tail_4_seg]
                }
                box club_spike_l_2 place(base_box=club_flange_l, anchor=[0.94, 0.10, 0.08], align=[-0.82, 0, 0]) {
                  size: [5.5, 2.0, 2.5], material: obsidian_horn, rotate: [6, 32, -10], blend_with: [tail_club_core, club_spike_l_1]
                }
                box club_spike_r_2 place(base_box=club_flange_r, anchor=[-0.94, 0.10, 0.08], align=[0.82, 0, 0]) {
                  size: [5.5, 2.0, 2.5], material: obsidian_horn, rotate: [6, -32, 10], blend_with: [tail_club_core, club_spike_r_1]
                }
                box club_spike_l_3 place(base_box=club_flange_l, anchor=[0.92, 0.06, -0.52], align=[-0.80, 0, 0]) {
                  size: [5.0, 2.0, 2.0], material: obsidian_horn, rotate: [6, 38, -10], blend_with: [tail_club_core, club_spike_l_2, tail_stinger]
                }
                box club_spike_r_3 place(base_box=club_flange_r, anchor=[-0.92, 0.06, -0.52], align=[0.80, 0, 0]) {
                  size: [5.0, 2.0, 2.0], material: obsidian_horn, rotate: [6, -38, 10], blend_with: [tail_club_core, club_spike_r_2, tail_stinger]
                }
                box club_ventral_barb_l place(base_box=tail_club_core, anchor=[0.72, -0.88, -0.10], align=[-0.65, 0.65, 0]) {
                  size: [2.5, 2.0, 5.5], material: obsidian_horn, rotate: [-12, 22, 18], blend_with: [club_flange_l, tail_4_seg, tail_stinger]
                }
                box club_ventral_barb_r place(base_box=tail_club_core, anchor=[-0.72, -0.88, -0.10], align=[0.65, 0.65, 0]) {
                  size: [2.5, 2.0, 5.5], material: obsidian_horn, rotate: [-12, -22, -18], blend_with: [club_flange_r, tail_4_seg, tail_stinger]
                }
                plane club_fringe_l place(base_box=club_flange_l, anchor=[0.85, 0.72, 0], align=[-0.85, -0.5, 0]) {
                  size: [3.5, 7.5], normal: x, material: scarlet_rim, rotate: [8, 18, -28],
                  edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=61), layer: 1,
                  blend_with: [tail_club_core, club_dorsal_shield, club_spike_l_1, club_spike_l_2, club_spike_l_3]
                }
                plane club_fringe_r place(base_box=club_flange_r, anchor=[-0.85, 0.72, 0], align=[0.85, -0.5, 0]) {
                  size: [3.5, 7.5], normal: x, material: scarlet_rim, rotate: [8, -18, 28],
                  edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=61), layer: 2,
                  blend_with: [tail_club_core, club_dorsal_shield, club_spike_r_1, club_spike_r_2, club_spike_r_3]
                }

                bone tail_6 attach(parent_box=tail_club_core, anchor=[0, 0.02, -1], align=[0, 0, 1], seat=0.22) {
                  rest_euler: [6, 0, 0]
                  box tail_stinger { size: [4.0, 3.5, 7.0], material: deep_crimson }
                  box stinger_barb_l place(base_box=tail_stinger, anchor=[0.96, 0.05, 0.10], align=[-0.75, 0, 0]) {
                    size: [2.5, 1.5, 4.5], material: obsidian_horn, rotate: [6, 26, -8], blend_with: [tail_club_core, club_flange_l, club_spike_l_3]
                  }
                  box stinger_barb_r place(base_box=tail_stinger, anchor=[-0.96, 0.05, 0.10], align=[0.75, 0, 0]) {
                    size: [2.5, 1.5, 4.5], material: obsidian_horn, rotate: [6, -26, 8], blend_with: [tail_club_core, club_flange_r, club_spike_r_3]
                  }
                  box stinger_venom_tip place(base_box=tail_stinger, anchor=[0, 0.05, -0.96], align=[0, 0, 0.80]) {
                    size: [2.0, 2.0, 5.5], material: obsidian_horn, rotate: [8, 0, 0]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
@materials {
  rath_crimson: process(family=keratin_scales, coat=scale_rows, roughness=0.46)
  deep_crimson: process(family=keratin_scales, coat=scale_rows, roughness=0.52)
  scarlet_rim: process(family=keratin_scales, coat=striped, roughness=0.42)
  charcoal_hide: process(family=keratin_scales, coat=banded_limb, roughness=0.64)
  obsidian_horn: process(family=weathered_stone, coat=striped, roughness=0.38)
  belly_cream: process(family=patterned_skin, coat=plain, roughness=0.68)
  wing_tan: process(family=patterned_skin, coat=mottled, roughness=0.62)
  ivory_claw: process(family=polymer_dielectric, coat=plain, roughness=0.28)
  mouth_ember: process(family=patterned_skin, coat=plain, roughness=0.42, emissive=0.45)
  hellfire_amber: process(family=thin_film_iridescence, coat=plain, roughness=0.18, emissive=0.95)
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
@stamps {
  stamp rath_eye_glint on skull_core.east { at: [0.74, 0.36], size: [1.5, 1.0], color: hellfire_amber, emissive: 0.95, mirror: true }
  stamp jaw_ember_glow on jaw_core.east { at: [0.55, 0.25], size: [2.0, 1.0], color: hellfire_amber, emissive: 0.85, mirror: true }
  stamp carapace_soot_band on withers_carapace_c.up { at: [0.50, 0.50], size: [3.0, 6.0], color: obsidian_horn, emissive: 0.0 }
}
@behavior {
  spring ear_frill_l { stiffness: 46, damping: 6 }
  spring ear_frill_r { stiffness: 46, damping: 6 }
  spring tail_6 { stiffness: 38, damping: 5 }

  // 1. Alert King of the Skies breathing, proud wing-mantle poise & coiled mace-tail sway
  clip idle {
    duration_s: 3.2, loop: true
    key root.position { 0.0: [0, 0, 0], 0.8: [0, -0.5, 0], 1.6: [0, 0.4, 0], 2.4: [0, -0.5, 0], 3.2: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.8: [2.5, 1.5, 0], 1.6: [-2.5, 0, 0], 2.4: [2.5, -1.5, 0], 3.2: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.8: [-3, 7, 2], 1.6: [2, 0, 0], 2.4: [-3, -7, -2], 3.2: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.8: [4, 12, -4], 1.6: [-3, 0, 0], 2.4: [4, -12, 4], 3.2: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 1.6: [8, 0, 0], 3.2: [0, 0, 0], catmullrom }
    key wing_arm_l.rotation { 0.0: [0, 0, 0], 1.6: [-2, -4, 6], 3.2: [0, 0, 0], catmullrom }
    key wing_arm_r.rotation { 0.0: [0, 0, 0], 1.6: [-2, 4, -6], 3.2: [0, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=7, freq_hz=0.3125, phase_deg=0)
    track tail_2: wave(axis=y, amp_deg=10, freq_hz=0.3125, phase_deg=-35)
    track tail_3: wave(axis=y, amp_deg=13, freq_hz=0.3125, phase_deg=-70)
    track tail_4: wave(axis=y, amp_deg=16, freq_hz=0.3125, phase_deg=-105)
    track tail_5: wave(axis=y, amp_deg=18, freq_hz=0.3125, phase_deg=-140)
  }

  // 2. Stalking Raptorial Biped Ground Stride (heavy avian-theropod hip roll & balanced wing sway)
  clip walk {
    duration_s: 1.6, loop: true
    key root.position { 0.0: [0, 0, 0], 0.4: [0, 1.4, 0], 0.8: [0, 0, 0], 1.2: [0, 1.4, 0], 1.6: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, -7, 4], 0.4: [3, 0, 0], 0.8: [0, 7, -4], 1.2: [3, 0, 0], 1.6: [0, -7, 4], catmullrom }
    key chest.rotation { 0.0: [2, 8, -5], 0.4: [-2, 0, 0], 0.8: [2, -8, 5], 1.2: [-2, 0, 0], 1.6: [2, 8, -5], catmullrom }
    key neck_1.rotation { 0.0: [0, -6, 3], 0.8: [0, 6, -3], 1.6: [0, -6, 3], catmullrom }
    key head.rotation { 0.0: [3, -5, 3], 0.8: [3, 5, -3], 1.6: [3, -5, 3], catmullrom }
