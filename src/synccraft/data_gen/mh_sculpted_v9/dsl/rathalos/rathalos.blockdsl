// Rathalos (King of the Skies) — Stage 3 Sculpted Blockbench Masterwork (V9)
// Hand-authored progressive Block-DSL v4.1 modeled from official Capcom Monster Hunter Rathalos
// physiology & @zyhfisme sculpted Blockbench conventions:
// - True Biped Flying Wyvern (ONLY 2 raptorial venom-talon hindlegs grounded at Y=0; NO front walking legs!)
// - Sharp 3D wedged eagle-beak snout (snout_taper_ratio < 0.45), swept 3-segment obsidian crown horns,
//   serrated alpha-cut cheek/ear frills, & iconic downward-jutting mandibular chin spike
// - Cascading crimson dorsal carapace shingles over charcoal-obsidian spine & contoured cream ventral scutes
// - Non-uni-sheet 14-bone 4-finger wings with 12 layered scalloped flame-scroll membrane bays (layer 1 & 2)
// - Flared crimson-and-obsidian spiked mace tail club & 12 vigorous Monster Hunter behavior clips!
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 400
  budget max_bones = 96
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  rath_crimson: ramp(base_lch=[0.50, 0.168, 27], steps=6, hue_shift=[24, -16])
  deep_crimson: ramp(base_lch=[0.38, 0.148, 22], steps=6, hue_shift=[22, -14])
  scarlet_rim: ramp(base_lch=[0.58, 0.172, 32], steps=6, hue_shift=[20, -14])
  charcoal_hide: ramp(base_lch=[0.29, 0.032, 38], steps=6, hue_shift=[20, -12])
  obsidian_horn: ramp(base_lch=[0.22, 0.028, 285], steps=6, hue_shift=[18, -12])
  belly_cream: ramp(base_lch=[0.81, 0.056, 80], steps=6, hue_shift=[20, -12])
  wing_tan: ramp(base_lch=[0.74, 0.070, 72], steps=6, hue_shift=[22, -14])
  ivory_claw: ramp(base_lch=[0.87, 0.044, 84], steps=6, hue_shift=[18, -10])
  mouth_ember: ramp(base_lch=[0.44, 0.152, 28], steps=6, hue_shift=[18, -12])
  hellfire_amber: ramp(base_lch=[0.85, 0.172, 68], steps=6, hue_shift=[14, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 20.65, -8.0]) {
      rest_euler: [-10, 0, 0]
      box pelvis_core { size: [12.0, 11.5, 13.0], material: charcoal_hide }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.40, 0]) {
        size: [9.0, 2.0, 11.0], material: belly_cream
      }
      box sacrum_shingle place(base_box=pelvis_core, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
        size: [9.5, 2.5, 11.5], material: rath_crimson, rotate: [6, 0, 0], blend_with: [lumbar_shingle, tail_1_plate, tail_1_seg]
      }
      box sacrum_spine_1 place(base_box=sacrum_shingle, anchor=[0, 0.96, 0.34], align=[0, -0.78, 0]) {
        size: [2.0, 2.5, 3.0], material: obsidian_horn, rotate: [18, 0, 0], blend_with: [pelvis_core, lumbar_shingle]
      }
      box sacrum_spine_2 place(base_box=sacrum_shingle, anchor=[0, 0.96, -0.36], align=[0, -0.78, 0]) {
        size: [2.0, 2.5, 3.0], material: obsidian_horn, rotate: [20, 0, 0], blend_with: [pelvis_core, tail_1_plate]
      }
      box haunch_muscle_l place(base_box=pelvis_core, anchor=[0.98, 0.22, 0.02], align=[-0.48, 0, 0]) {
        size: [3.5, 7.5, 9.5], material: rath_crimson, rotate: [4, 6, -12], blend_with: [thigh_mass, waist_core]
      }
      box haunch_muscle_r place(base_box=pelvis_core, anchor=[-0.98, 0.22, 0.02], align=[0.48, 0, 0]) {
        size: [3.5, 7.5, 9.5], material: rath_crimson, rotate: [4, -6, 12], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }
      box hip_spur_l place(base_box=haunch_muscle_l, anchor=[0.92, 0.42, -0.36], align=[-0.68, 0, 0.35]) {
        size: [2.0, 2.5, 5.0], material: deep_crimson, rotate: [14, 22, -14], blend_with: [pelvis_core, thigh_mass, thigh_carapace]
      }
      box hip_spur_r place(base_box=haunch_muscle_r, anchor=[-0.92, 0.42, -0.36], align=[0.68, 0, 0.35]) {
        size: [2.0, 2.5, 5.0], material: deep_crimson, rotate: [14, -22, 14], blend_with: [pelvis_core, hind_thigh_r__thigh_mass, hind_thigh_r__thigh_carapace]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.12, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-6, 0, 0]
        box waist_core { size: [13.0, 12.5, 11.5], material: charcoal_hide }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.40, 0]) {
          size: [9.5, 2.0, 10.0], material: belly_cream, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_shingle place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.52, 0]) {
          size: [10.0, 2.5, 10.5], material: rath_crimson, rotate: [-5, 0, 0], blend_with: [pelvis_core, chest_core, withers_carapace_c]
        }
        box lumbar_spine_1 place(base_box=lumbar_shingle, anchor=[0, 0.96, 0.32], align=[0, -0.78, 0]) {
          size: [2.0, 3.0, 3.5], material: obsidian_horn, rotate: [18, 0, 0], blend_with: [waist_core, chest_core, withers_carapace_c]
        }
        box lumbar_spine_2 place(base_box=lumbar_shingle, anchor=[0, 0.96, -0.34], align=[0, -0.78, 0]) {
          size: [2.0, 2.5, 3.0], material: obsidian_horn, rotate: [20, 0, 0], blend_with: [waist_core, pelvis_core, sacrum_shingle]
        }
        box flank_shingle_l_1 place(base_box=waist_core, anchor=[0.98, 0.32, 0.24], align=[-0.68, 0, 0]) {
          size: [2.0, 4.5, 4.5], material: deep_crimson, rotate: [8, 12, -14], blend_with: [chest_core, lumbar_shingle]
        }
        box flank_shingle_r_1 place(base_box=waist_core, anchor=[-0.98, 0.32, 0.24], align=[0.68, 0, 0]) {
          size: [2.0, 4.5, 4.5], material: deep_crimson, rotate: [8, -12, 14], blend_with: [chest_core, lumbar_shingle]
        }
        box flank_shingle_l_2 place(base_box=waist_core, anchor=[0.98, -0.12, -0.22], align=[-0.68, 0, 0]) {
          size: [2.0, 4.5, 4.5], material: rath_crimson, rotate: [6, 14, -10], blend_with: [flank_shingle_l_1, pelvis_core, haunch_muscle_l, thigh_mass]
        }
        box flank_shingle_r_2 place(base_box=waist_core, anchor=[-0.98, -0.12, -0.22], align=[0.68, 0, 0]) {
          size: [2.0, 4.5, 4.5], material: rath_crimson, rotate: [6, -14, 10], blend_with: [flank_shingle_r_1, pelvis_core, haunch_muscle_r, hind_thigh_r__thigh_mass]
        }
        plane lumbar_dorsal_fin place(base_box=lumbar_shingle, anchor=[0.18, 0.94, 0], align=[0, -0.88, 0]) {
          size: [3.5, 8.5], normal: x, material: obsidian_horn, rotate: [6, 0, -6],
          edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=13), layer: 1,
          blend_with: [lumbar_spine_1, lumbar_spine_2, withers_carapace_c, sacrum_shingle]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.18, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [8, 0, 0]
          box chest_core { size: [19.0, 17.0, 16.0], material: charcoal_hide }
          box withers_carapace_c place(base_box=chest_core, anchor=[0, 0.98, 0.08], align=[0, -0.55, 0]) {
            size: [12.5, 3.5, 14.0], material: rath_crimson, rotate: [-8, 0, 0], blend_with: [neck_base, neck_shingle_c, waist_core, lumbar_spine_1]
          }
          box withers_plate_l place(base_box=chest_core, anchor=[0.68, 0.90, 0.10], align=[-0.15, -0.58, 0]) {
            size: [5.0, 3.0, 12.0], material: deep_crimson, rotate: [-8, -10, -20], blend_with: [withers_carapace_c, neck_base, wing_humerus]
          }
          box withers_plate_r place(base_box=chest_core, anchor=[-0.68, 0.90, 0.10], align=[0.15, -0.58, 0]) {
            size: [5.0, 3.0, 12.0], material: deep_crimson, rotate: [-8, 10, 20], blend_with: [withers_carapace_c, neck_base, wing_arm_r__wing_humerus]
          }
          box withers_spine_1 place(base_box=withers_carapace_c, anchor=[0, 0.96, 0.35], align=[0, -0.78, 0]) {
            size: [2.5, 3.5, 4.0], material: obsidian_horn, rotate: [16, 0, 0], blend_with: [chest_core, neck_base, neck_shingle_c]
          }
          box withers_spine_2 place(base_box=withers_carapace_c, anchor=[0, 0.96, -0.05], align=[0, -0.78, 0]) {
            size: [2.5, 3.5, 4.0], material: obsidian_horn, rotate: [18, 0, 0], blend_with: [chest_core, withers_spine_1]
          }
          box withers_spine_3 place(base_box=withers_carapace_c, anchor=[0, 0.96, -0.44], align=[0, -0.78, 0]) {
            size: [2.0, 3.0, 3.5], material: obsidian_horn, rotate: [20, 0, 0], blend_with: [chest_core, withers_spine_2, waist_core, lumbar_shingle]
          }
          plane withers_dorsal_fin place(base_box=withers_carapace_c, anchor=[-0.18, 0.94, 0], align=[0, -0.88, 0]) {
            size: [4.5, 11.5], normal: x, material: obsidian_horn, rotate: [4, 0, 6],
            edge: spikes(width=2, min_len=3, max_len=7, side=top, seed=19), layer: 2,
            blend_with: [withers_spine_1, withers_spine_2, withers_spine_3, neck_shingle_c, lumbar_shingle, lumbar_dorsal_fin]
          }
          box pectoral_mount_l place(base_box=chest_core, anchor=[0.98, 0.12, 0.22], align=[-0.68, 0, 0]) {
            size: [2.5, 6.5, 9.5], material: rath_crimson, rotate: [-6, 8, -12], blend_with: [withers_carapace_c, withers_plate_l, wing_humerus]
          }
          box pectoral_mount_r place(base_box=chest_core, anchor=[-0.98, 0.12, 0.22], align=[0.68, 0, 0]) {
            size: [2.5, 6.5, 9.5], material: rath_crimson, rotate: [-6, -8, 12], blend_with: [withers_carapace_c, withers_plate_r, wing_arm_r__wing_humerus]
          }
          box rib_shingle_l_1 place(base_box=chest_core, anchor=[0.99, -0.28, -0.20], align=[-0.72, 0, 0]) {
            size: [2.0, 5.0, 5.5], material: scarlet_rim, rotate: [6, 12, -10], blend_with: [pectoral_mount_l, waist_core, flank_shingle_l_1]
          }
          box rib_shingle_r_1 place(base_box=chest_core, anchor=[-0.99, -0.28, -0.20], align=[0.72, 0, 0]) {
            size: [2.0, 5.0, 5.5], material: scarlet_rim, rotate: [6, -12, 10], blend_with: [pectoral_mount_r, waist_core, flank_shingle_r_1]
          }
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.32], align=[0, 0.42, 0]) {
            size: [12.5, 2.5, 8.0], material: belly_cream, rotate: [4, 0, 0], blend_with: [waist_belly, waist_core]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.96, 0.48], align=[0, 0.48, -0.20]) {
            size: [11.0, 2.5, 8.0], material: belly_cream, rotate: [-18, 0, 0], blend_with: [chest_scute_rear, neck_throat_scute]
          }
          box sternum_keel place(base_box=chest_scute_front, anchor=[0, -0.95, 0.20], align=[0, 0.72, 0]) {
            size: [6.0, 2.0, 6.5], material: deep_crimson, rotate: [-12, 0, 0], blend_with: [chest_core, neck_throat_scute]
          }
          box collar_guard_l place(base_box=chest_core, anchor=[0.62, -0.38, 0.96], align=[-0.35, 0, -0.68]) {
            size: [4.5, 4.5, 2.5], material: rath_crimson, rotate: [-10, -18, -8], blend_with: [chest_scute_front, sternum_keel, pectoral_mount_l, neck_base, neck_throat_scute]
          }
          box collar_guard_r place(base_box=chest_core, anchor=[-0.62, -0.38, 0.96], align=[0.35, 0, -0.68]) {
            size: [4.5, 4.5, 2.5], material: rath_crimson, rotate: [-10, 18, 8], blend_with: [chest_scute_front, sternum_keel, pectoral_mount_r, neck_base, neck_throat_scute]
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.32, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-30, 0, 0]
            box neck_base { size: [11.0, 10.5, 9.5], material: charcoal_hide }
            box neck_shingle_c place(base_box=neck_base, anchor=[0, 0.96, 0.05], align=[0, -0.55, 0]) {
              size: [8.5, 2.5, 9.0], material: rath_crimson, rotate: [8, 0, 0], blend_with: [chest_core, withers_carapace_c, withers_spine_1, neck_upper, nape_shingle_c]
            }
            box neck_spine_1 place(base_box=neck_shingle_c, anchor=[0, 0.96, -0.08], align=[0, -0.86, 0]) {
              size: [2.0, 3.0, 3.0], material: obsidian_horn, rotate: [16, 0, 0], blend_with: [neck_base, chest_core, withers_carapace_c, withers_spine_1]
            }
            box neck_spine_2 place(base_box=neck_shingle_c, anchor=[0, 0.96, 0.30], align=[0, -0.78, 0]) {
              size: [1.5, 2.5, 3.0], material: obsidian_horn, rotate: [16, 0, 0], blend_with: [neck_base, neck_upper, nape_shingle_c]
            }
            box neck_side_plate_l place(base_box=neck_base, anchor=[0.98, 0.25, 0.08], align=[-0.68, 0, 0]) {
              size: [2.0, 4.5, 7.5], material: deep_crimson, rotate: [6, -10, -14], blend_with: [neck_shingle_c, chest_core, withers_plate_l, neck_upper]
            }
            box neck_side_plate_r place(base_box=neck_base, anchor=[-0.98, 0.25, 0.08], align=[0.68, 0, 0]) {
              size: [2.0, 4.5, 7.5], material: deep_crimson, rotate: [6, 10, 14], blend_with: [neck_shingle_c, chest_core, withers_plate_r, neck_upper]
            }
            box neck_throat_scute place(base_box=neck_base, anchor=[0, -0.96, 0.10], align=[0, 0.48, 0]) {
              size: [8.0, 2.0, 8.0], material: belly_cream, rotate: [-6, 0, 0], blend_with: [chest_core, chest_scute_front, sternum_keel]
            }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.12, 1], align=[0, 0, -1], seat=0.26) {
              rest_euler: [18, 0, 0]
              box neck_upper { size: [8.5, 8.5, 8.5], material: charcoal_hide }
              box nape_shingle_c place(base_box=neck_upper, anchor=[0, 0.96, 0.0], align=[0, -0.55, 0]) {
                size: [7.0, 2.5, 8.0], material: rath_crimson, rotate: [8, 0, 0], blend_with: [neck_base, neck_spine_2, skull_core, skull_crown]
              }
              box nape_spine_1 place(base_box=nape_shingle_c, anchor=[0, 0.96, -0.25], align=[0, -0.78, 0]) {
                size: [1.5, 2.5, 2.5], material: obsidian_horn, rotate: [18, 0, 0], blend_with: [neck_upper, neck_shingle_c, horn_mid, crown_horn_r__horn_mid]
              }
              box nape_spine_2 place(base_box=nape_shingle_c, anchor=[0, 0.96, 0.28], align=[0, -0.78, 0]) {
                size: [1.5, 2.0, 2.5], material: obsidian_horn, rotate: [16, 0, 0], blend_with: [neck_upper, skull_core, skull_crown, horn_root, crown_horn_r__horn_root]
              }
              box nape_side_plate_l place(base_box=neck_upper, anchor=[0.98, 0.22, 0.05], align=[-0.68, 0, 0]) {
                size: [1.5, 4.0, 6.5], material: deep_crimson, rotate: [6, -10, -14], blend_with: [nape_shingle_c, neck_base, neck_side_plate_l, skull_core, cheek_jowl_l, frill_plate]
              }
              box nape_side_plate_r place(base_box=neck_upper, anchor=[-0.98, 0.22, 0.05], align=[0.68, 0, 0]) {
                size: [1.5, 4.0, 6.5], material: deep_crimson, rotate: [6, 10, 14], blend_with: [nape_shingle_c, neck_base, neck_side_plate_r, skull_core, cheek_jowl_r, ear_frill_r__frill_plate]
              }
              box nape_throat_scute place(base_box=neck_upper, anchor=[0, -0.96, 0.05], align=[0, 0.52, 0]) {
                size: [6.0, 1.5, 7.0], material: belly_cream, rotate: [-4, 0, 0], blend_with: [neck_base, neck_throat_scute, jaw_core]
              }
              plane nape_dorsal_fin place(base_box=nape_shingle_c, anchor=[0.15, 0.94, 0], align=[0, -0.88, 0]) {
                size: [3.0, 6.5], normal: x, material: obsidian_horn, rotate: [8, 0, -5],
                edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=23), layer: 1,
                blend_with: [nape_spine_1, nape_spine_2, neck_shingle_c, skull_crown, horn_root, crown_horn_r__horn_root, horn_mid, crown_horn_r__horn_mid]
              }

              bone head attach(parent_box=neck_upper, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.24) {
                rest_euler: [26, 0, 0]
                box skull_core { size: [9.5, 6.5, 7.5], material: rath_crimson }
                box skull_crown place(base_box=skull_core, anchor=[0, 0.98, -0.10], align=[0, -0.60, 0]) {
                  size: [6.5, 2.0, 6.5], material: deep_crimson, rotate: [6, 0, 0], blend_with: [neck_upper, nape_shingle_c, nape_spine_2, brow_ridge_l, brow_ridge_r]
                }
                box crown_median_keel place(base_box=skull_crown, anchor=[0, 0.96, 0.12], align=[0, -0.78, 0]) {
                  size: [2.0, 1.5, 5.0], material: obsidian_horn, rotate: [8, 0, 0], blend_with: [skull_core, nasal_bridge, nape_spine_2]
                }
                box brow_ridge_l place(base_box=skull_core, anchor=[0.84, 0.80, 0.52], align=[-0.15, -0.48, -0.25]) {
                  size: [2.5, 2.0, 5.5], material: deep_crimson, rotate: [10, -12, -14], blend_with: [skull_crown]
                }
                box brow_ridge_r place(base_box=skull_core, anchor=[-0.84, 0.80, 0.52], align=[0.15, -0.48, -0.25]) {
                  size: [2.5, 2.0, 5.5], material: deep_crimson, rotate: [10, 12, 14], blend_with: [skull_crown]
                }
                box brow_spike_l place(base_box=brow_ridge_l, anchor=[0.65, 0.92, -0.35], align=[-0.55, -0.78, 0.35]) {
                  size: [1.5, 1.5, 3.0], material: obsidian_horn, rotate: [16, -18, -14], blend_with: [skull_core, skull_crown, horn_root]
                }
                box brow_spike_r place(base_box=brow_ridge_r, anchor=[-0.65, 0.92, -0.35], align=[0.55, -0.78, 0.35]) {
                  size: [1.5, 1.5, 3.0], material: obsidian_horn, rotate: [16, 18, 14], blend_with: [skull_core, skull_crown, crown_horn_r__horn_root]
                }
                box cheek_jowl_l place(base_box=skull_core, anchor=[0.98, -0.18, 0.05], align=[-0.50, 0, 0]) {
                  size: [2.5, 4.0, 5.5], material: rath_crimson, rotate: [6, -14, 8], blend_with: [brow_ridge_l, neck_upper]
                }
                box cheek_jowl_r place(base_box=skull_core, anchor=[-0.98, -0.18, 0.05], align=[0.50, 0, 0]) {
                  size: [2.5, 4.0, 5.5], material: rath_crimson, rotate: [6, 14, -8], blend_with: [brow_ridge_r, neck_upper]
                }
                box cheek_spur_l place(base_box=cheek_jowl_l, anchor=[0.92, -0.32, -0.55], align=[-0.72, 0, 0.55]) {
                  size: [1.5, 2.0, 3.5], material: obsidian_horn, rotate: [8, -24, 12], blend_with: [skull_core, neck_upper, nape_side_plate_l, frill_plate]
                }
                box cheek_spur_r place(base_box=cheek_jowl_r, anchor=[-0.92, -0.32, -0.55], align=[0.72, 0, 0.55]) {
                  size: [1.5, 2.0, 3.5], material: obsidian_horn, rotate: [8, 24, -12], blend_with: [skull_core, neck_upper, nape_side_plate_r, ear_frill_r__frill_plate]
                }
                box eye_slit_l place(base_box=skull_core, anchor=[0.98, 0.45, 0.56], align=[-0.72, 0, 0]) {
                  size: [1.0, 1.5, 2.5], material: hellfire_amber, rotate: [8, -10, 0], blend_with: [brow_ridge_l, cheek_jowl_l]
                }
                box eye_slit_r place(base_box=skull_core, anchor=[-0.98, 0.45, 0.56], align=[0.72, 0, 0]) {
                  size: [1.0, 1.5, 2.5], material: hellfire_amber, rotate: [8, 10, 0], blend_with: [brow_ridge_r, cheek_jowl_r]
                }

                // 3D Wedged Hooked Eagle-Beak Snout (snout_taper_ratio < 0.45!)
                box snout_core place(base_box=skull_core, anchor=[0, -0.10, 1], align=[0, 0, -0.80]) {
                  size: [4.5, 3.5, 6.5], material: rath_crimson, rotate: [10, 0, 0], blend_with: [brow_ridge_l, brow_ridge_r, eye_slit_l, eye_slit_r]
                }
