// Ruiner Nergigante (Eater of Elders) — Stage 1 Six-Limbed Hunched Juggernaut & Asymmetric Horn Blockout
// Verified right-handed SE(3): 4 grounded legs + 2 dorsal wing-arm rigs + genuinely asymmetric L/R bull horns!
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 128
  budget max_bones = 64
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  obsidian_hide: ramp(base_lch=[0.29, 0.055, 275], steps=6, hue_shift=[24, -16])
  gunmetal_iron: ramp(base_lch=[0.54, 0.068, 248], steps=6, hue_shift=[22, -16])
  ivory_spike: ramp(base_lch=[0.86, 0.048, 82], steps=6, hue_shift=[20, -12])
  copper_underhide: ramp(base_lch=[0.52, 0.125, 38], steps=6, hue_shift=[20, -14])
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 21.61, -14.5]) {
      rest_euler: [12, 0, 0]
      box pelvis_core { size: [14.0, 11.5, 13.5], material: obsidian_hide }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.16, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-6, 0, 0]
        box waist_core { size: [16.5, 14.0, 12.5], material: obsidian_hide }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.24, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [-10, 0, 0]
          box chest_core { size: [22.0, 18.5, 17.5], material: obsidian_hide }
          box hunch_shoulder_mass place(base_box=chest_core, anchor=[0, 0.98, 0.08], align=[0, -0.45, 0]) {
            size: [18.0, 6.5, 15.0], material: gunmetal_iron, rotate: [-12, 0, 0]
          }

          // Six-Limbed Dragon Dorsal Wing Rig (high spiked wing-elbows towering above hunched shoulders!)
          bone wing_shoulder_l attach(parent_box=hunch_shoulder_mass, anchor=[0.88, 0.65, -0.05], align=[-0.85, 0, 0], seat=0.14) mirror_x(wing_shoulder_r) {
            rest_euler: [10, 24, 48]
            box wing_arm_spar { size: [14.0, 4.5, 5.0], material: obsidian_hide, blend_with: [chest_core] }

            bone wing_forearm_l attach(parent_box=wing_arm_spar, anchor=[1, 0.05, 0.05], align=[-1, 0, 0], seat=0.18) {
              rest_euler: [0, -36, 8]
              box wing_forearm_spar { size: [17.0, 4.0, 4.5], material: gunmetal_iron }

              bone wing_wrist_l attach(parent_box=wing_forearm_spar, anchor=[1, 0, 0], align=[-1, 0, 0], seat=0.06) {
                rest_euler: [0, 56, -34]
                box wing_main_spar { size: [20.0, 3.0, 3.5], material: ivory_spike }
              }
            }
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.22, 1], align=[0, 0, -1], seat=0.28) {
            rest_euler: [-12, 0, 0]
            box neck_base { size: [15.5, 13.5, 9.0], material: obsidian_hide, blend_with: [hunch_shoulder_mass] }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.26) {
              rest_euler: [18, 0, 0]
              box neck_upper { size: [12.5, 11.0, 7.5], material: obsidian_hide }

              bone head attach(parent_box=neck_upper, anchor=[0, 0.02, 1], align=[0, 0, -1], seat=0.24) {
                rest_euler: [14, 0, 0]
                box skull_core { size: [11.0, 7.5, 8.0], material: obsidian_hide }
                box snout_core place(base_box=skull_core, anchor=[0, -0.14, 1], align=[0, 0, -0.78]) {
                  size: [5.5, 4.5, 6.0], material: obsidian_hide, rotate: [14, 0, 0]
                }
                // ASYMMETRIC BULL-DEMON HORNS: Left = curved ivory-bone horn (+Ry flares +X outward!); Right = massive scarred regrown gunmetal-iron horn (-Ry flares -X outward!)
                bone horn_l attach(parent_box=skull_core, anchor=[0.88, 0.72, 0.35], align=[-0.35, -0.35, -0.85], seat=0.10) {
                  rest_euler: [-24, 42, -16]
                  box horn_l_beam { size: [3.5, 3.5, 11.5], material: ivory_spike }
                }
                bone horn_r attach(parent_box=skull_core, anchor=[-0.90, 0.76, 0.38], align=[0.35, -0.35, -0.85], seat=0.10) {
                  rest_euler: [-30, -38, 20]
                  box horn_r_iron_beam { size: [4.5, 4.5, 14.5], material: gunmetal_iron }
                }
                bone jaw attach(parent_box=skull_core, anchor=[0, -0.72, 0.20], align=[0, 0, -1], seat=0.16) {
                  rest_euler: [12, 0, 0]
                  box jaw_core { size: [5.0, 3.0, 7.5], material: copper_underhide }
                }
              }
            }
          }

          // Gorilla-Like Colossal Brawling Forelimbs planted wide on Y = 0!
          bone fore_shoulder_l attach(parent_box=chest_core, anchor=[0.96, -0.18, 0.44], align=[-0.55, 0.82, 0], seat=0.12) mirror_x(fore_shoulder_r) {
            rest_euler: [20, 8, 28]
            box fore_bicep { size: [9.5, 12.0, 9.5], material: obsidian_hide }

            bone fore_arm_l attach(parent_box=fore_bicep, anchor=[0.12, -1, -0.04], align=[0, 0.88, 0], seat=0.18) {
              rest_euler: [-32, 0, -18]
              box fore_bracer { size: [9.0, 12.5, 9.0], material: gunmetal_iron, blend_with: [chest_core] }

              bone fore_hand_l attach(parent_box=fore_bracer, anchor=[0, -1, 0.16], align=[0, 0.85, -0.45], seat=0.16) {
                rest_euler: [16, 0, -10]
                box fore_palm { size: [9.5, 4.0, 8.5], material: copper_underhide }
              }
            }
          }
        }
      }

      // Sturdy Digitigrade Elder Dragon Hindlimbs planted on Y = 0
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.96, -0.12, -0.05], align=[-0.55, 0.85, 0], seat=0.12) mirror_x(hind_thigh_r) {
        rest_euler: [-24, -6, 18]
        box thigh_mass { size: [7.5, 12.5, 9.0], material: obsidian_hide, blend_with: [waist_core, tail_1_tail_seg] }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.10], align=[0, 0.88, 0], seat=0.16) {
          rest_euler: [42, 0, -10]
          box shin_mass { size: [6.0, 11.0, 6.5], material: obsidian_hide }

          bone hind_foot_l attach(parent_box=shin_mass, anchor=[0, -1, 0.15], align=[0, 0.88, -0.42], seat=0.14) {
            rest_euler: [-30, 0, -8]
            box hind_foot_pad { size: [7.5, 3.5, 8.0], material: copper_underhide }
          }
        }
      }

      // Heavy Spiked Elder Dragon Club Tail
      chain tail attach(parent_box=pelvis_core, anchor=[0, 0.18, -1], align=[0, 0, 1], seat=0.24) segments=6 taper=0.91 bend=[-10, 10, 14, 12, 8, 4] {
        box tail_seg { size: [10.5, 9.0, 9.5], material: obsidian_hide }
      }
    }
  }
}
