// Ruiner Nergigante (Eater of Elders) — Stage 3 Sculpted Blockbench Masterwork (V9)
// Hand-authored progressive Block-DSL v4.1 modeled from Capcom Monster Hunter World: Iceborne references:
// six-limbed hunchbacked juggernaut Elder Dragon, genuinely asymmetric bull-demon horns (left bone-ivory vs
// right massive battle-scarred regrown gunmetal-iron cleaver horn), brutal bulldog wedged snout, dense
// gunmetal-iron & ivory regenerative spike mantle, 12-bone non-uni-sheet tattered wings, & gorilla forelimbs.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 440
  budget max_bones = 96
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  obsidian_hide: ramp(base_lch=[0.29, 0.055, 275], steps=6, hue_shift=[24, -16])
  elder_charcoal: ramp(base_lch=[0.36, 0.062, 290], steps=6, hue_shift=[24, -16])
  gunmetal_iron: ramp(base_lch=[0.54, 0.068, 248], steps=6, hue_shift=[22, -16])
  scarred_steel: ramp(base_lch=[0.66, 0.058, 238], steps=6, hue_shift=[22, -14])
  ivory_spike: ramp(base_lch=[0.86, 0.048, 82], steps=6, hue_shift=[20, -12])
  aged_keratin: ramp(base_lch=[0.64, 0.082, 68], steps=6, hue_shift=[18, -12])
  copper_underhide: ramp(base_lch=[0.48, 0.125, 34], steps=6, hue_shift=[22, -14])
  wing_membrane_plum: ramp(base_lch=[0.35, 0.088, 12], steps=6, hue_shift=[24, -16])
  maw_crimson: ramp(base_lch=[0.40, 0.155, 20], steps=6, hue_shift=[16, -12])
  ruiner_amber: ramp(base_lch=[0.76, 0.195, 52], steps=6, hue_shift=[14, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 22.15, -14.5]) {
      rest_euler: [12, 0, 0]
      box pelvis_core { size: [14.0, 11.5, 13.5], material: obsidian_hide }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.42, 0]) {
        size: [10.0, 2.0, 11.0], material: copper_underhide
      }
      box sacrum_armor place(base_box=pelvis_core, anchor=[0, 0.98, -0.08], align=[0, -0.58, 0]) {
        size: [8.5, 2.5, 10.5], material: elder_charcoal, rotate: [8, 0, 0], blend_with: [lumbar_armor, tail_1_seg, tail_1_plate]
      }
      box sacrum_iron_spike_1 place(base_box=sacrum_armor, anchor=[0, 0.96, 0.34], align=[0, -0.78, 0]) {
        size: [3.0, 3.5, 4.0], material: gunmetal_iron, rotate: [22, 0, 0], blend_with: [pelvis_core, lumbar_armor]
      }
      box sacrum_ivory_spike_2 place(base_box=sacrum_armor, anchor=[0, 0.96, -0.38], align=[0, -0.78, 0]) {
        size: [2.5, 3.5, 4.0], material: ivory_spike, rotate: [24, 0, 0], blend_with: [pelvis_core, tail_1_plate]
      }
      box haunch_mass_l place(base_box=pelvis_core, anchor=[0.98, 0.24, -0.05], align=[-0.50, 0, 0]) {
        size: [3.5, 8.0, 10.0], material: elder_charcoal, rotate: [5, 8, -14], blend_with: [thigh_mass, waist_core]
      }
      box haunch_mass_r place(base_box=pelvis_core, anchor=[-0.98, 0.24, -0.05], align=[0.50, 0, 0]) {
        size: [3.5, 8.0, 10.0], material: elder_charcoal, rotate: [5, -8, 14], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }
      box hip_iron_spur_l place(base_box=haunch_mass_l, anchor=[0.92, 0.45, -0.36], align=[-0.68, 0, 0.38]) {
        size: [2.5, 3.0, 6.5], material: gunmetal_iron, rotate: [18, 26, -14], blend_with: [pelvis_core, thigh_mass, thigh_iron_plate]
      }
      box hip_iron_spur_r place(base_box=haunch_mass_r, anchor=[-0.92, 0.45, -0.36], align=[0.68, 0, 0.38]) {
        size: [2.5, 3.0, 6.5], material: gunmetal_iron, rotate: [18, -26, 14], blend_with: [pelvis_core, hind_thigh_r__thigh_mass, hind_thigh_r__thigh_iron_plate]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.16, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-6, 0, 0]
        box waist_core { size: [16.5, 14.0, 12.5], material: obsidian_hide }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.42, 0]) {
          size: [12.0, 2.0, 10.5], material: copper_underhide, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_armor place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
          size: [10.0, 3.0, 10.5], material: elder_charcoal, rotate: [-6, 0, 0], blend_with: [pelvis_core, chest_core]
        }
        box lumbar_iron_spike_1 place(base_box=lumbar_armor, anchor=[0, 0.96, 0.34], align=[0, -0.80, 0]) {
          size: [3.5, 4.5, 4.5], material: gunmetal_iron, rotate: [24, 0, 0], blend_with: [waist_core, chest_core, hunch_shoulder_c]
        }
        box lumbar_ivory_spike_2 place(base_box=lumbar_armor, anchor=[0, 0.96, -0.36], align=[0, -0.80, 0]) {
          size: [3.0, 4.0, 4.5], material: ivory_spike, rotate: [26, 0, 0], blend_with: [waist_core, pelvis_core, sacrum_armor]
        }
        box flank_spike_plate_l_1 place(base_box=waist_core, anchor=[0.98, 0.35, 0.22], align=[-0.68, 0, 0]) {
          size: [2.5, 5.5, 6.0], material: gunmetal_iron, rotate: [10, 16, -16], blend_with: [chest_core]
        }
        box flank_spike_plate_r_1 place(base_box=waist_core, anchor=[-0.98, 0.35, 0.22], align=[0.68, 0, 0]) {
          size: [2.5, 5.5, 6.0], material: gunmetal_iron, rotate: [10, -16, 16], blend_with: [chest_core]
        }
        box flank_spike_plate_l_2 place(base_box=waist_core, anchor=[0.98, -0.14, -0.22], align=[-0.68, 0, 0]) {
          size: [2.0, 5.0, 5.5], material: ivory_spike, rotate: [8, 18, -12], blend_with: [flank_spike_plate_l_1, pelvis_core, haunch_mass_l, thigh_mass]
        }
        box flank_spike_plate_r_2 place(base_box=waist_core, anchor=[-0.98, -0.14, -0.22], align=[0.68, 0, 0]) {
          size: [2.0, 5.0, 5.5], material: ivory_spike, rotate: [8, -18, 12], blend_with: [flank_spike_plate_r_1, pelvis_core, haunch_mass_r, hind_thigh_r__thigh_mass]
        }
        plane waist_quill_plane_l place(base_box=waist_core, anchor=[1.0, 0.68, -0.10], align=[-1.0, -0.5, 0]) {
          size: [5.5, 8.5], normal: x, material: ivory_spike, rotate: [10, 14, -26],
          edge: spikes(width=4, min_len=3, max_len=8, side=top, seed=13), layer: 1,
          blend_with: [lumbar_armor, flank_spike_plate_l_1, chest_core, pelvis_core]
        }
        plane waist_quill_plane_r place(base_box=waist_core, anchor=[-1.0, 0.68, -0.10], align=[1.0, -0.5, 0]) {
          size: [5.5, 8.5], normal: x, material: ivory_spike, rotate: [10, -14, 26],
          edge: spikes(width=4, min_len=3, max_len=8, side=top, seed=13), layer: 1,
          blend_with: [lumbar_armor, flank_spike_plate_r_1, chest_core, pelvis_core]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.24, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [-10, 0, 0]
          box chest_core { size: [22.0, 18.5, 17.5], material: obsidian_hide }
          // Towering Hunchbacked Scapula & Regenerative Gunmetal/Ivory Spike Mantle
          box hunch_shoulder_c place(base_box=chest_core, anchor=[0, 0.98, 0.10], align=[0, -0.55, 0]) {
            size: [14.5, 5.5, 15.0], material: elder_charcoal, rotate: [-12, 0, 0], blend_with: [neck_base, lumbar_armor, lumbar_iron_spike_1]
          }
          box hunch_scapula_l place(base_box=chest_core, anchor=[0.74, 0.88, 0.05], align=[-0.20, -0.55, 0]) {
            size: [6.5, 5.5, 13.5], material: gunmetal_iron, rotate: [-8, -14, -22], blend_with: [hunch_shoulder_c, neck_base]
          }
          box hunch_scapula_r place(base_box=chest_core, anchor=[-0.74, 0.88, 0.05], align=[0.20, -0.55, 0]) {
            size: [6.5, 5.5, 13.5], material: gunmetal_iron, rotate: [-8, 14, 22], blend_with: [hunch_shoulder_c, neck_base]
          }
          // Dense Multi-Tier Regenerative Gunmetal-Iron & Ivory Porcupine Spikes
          box hunch_iron_spike_c place(base_box=hunch_shoulder_c, anchor=[0, 0.98, 0.18], align=[0, -0.86, 0.25]) {
            size: [3.5, 6.5, 6.5], material: gunmetal_iron, rotate: [26, 0, 0], blend_with: [chest_core, neck_base, neck_spike_crown_c]
          }
          box hunch_ivory_spike_rear place(base_box=hunch_shoulder_c, anchor=[0, 0.98, -0.58], align=[0, -0.86, 0.25]) {
            size: [3.0, 6.0, 6.0], material: ivory_spike, rotate: [30, 0, 0], blend_with: [chest_core, hunch_iron_spike_c, lumbar_armor, lumbar_iron_spike_1]
          }
          box hunch_ivory_spike_l place(base_box=hunch_scapula_l, anchor=[0.55, 0.98, 0.35], align=[-0.25, -0.88, 0.25]) {
            size: [3.0, 6.5, 7.0], material: ivory_spike, rotate: [26, -16, -20], blend_with: [hunch_shoulder_c, chest_core, neck_base, wing_arm_spar, wing_arm_iron_crest]
          }
          box hunch_ivory_spike_r place(base_box=hunch_scapula_r, anchor=[-0.55, 0.98, 0.35], align=[0.25, -0.88, 0.25]) {
            size: [3.0, 6.5, 7.0], material: ivory_spike, rotate: [26, 16, 20], blend_with: [hunch_shoulder_c, chest_core, neck_base, wing_shoulder_r__wing_arm_spar, wing_shoulder_r__wing_arm_iron_crest]
          }
          box hunch_outer_iron_l place(base_box=hunch_scapula_l, anchor=[0.96, 0.45, 0.32], align=[-0.72, -0.55, 0.25]) {
            size: [2.5, 5.5, 6.0], material: scarred_steel, rotate: [22, -24, -34], blend_with: [chest_core, fore_bicep, pauldron_iron_plate]
          }
          box hunch_outer_iron_r place(base_box=hunch_scapula_r, anchor=[-0.96, 0.45, 0.32], align=[0.72, -0.55, 0.25]) {
            size: [2.5, 5.5, 6.0], material: scarred_steel, rotate: [22, 24, 34], blend_with: [chest_core, fore_shoulder_r__fore_bicep, fore_shoulder_r__pauldron_iron_plate]
          }
          plane hunch_quill_crest_c place(base_box=hunch_shoulder_c, anchor=[0, 0.92, 0.48], align=[0, -0.82, 0]) {
            size: [12.0, 6.5], normal: z, material: ivory_spike, rotate: [22, 0, 0],
            edge: spikes(width=4, min_len=4, max_len=9, side=top, seed=19), layer: 1,
            blend_with: [hunch_iron_spike_c, hunch_ivory_spike_l, hunch_ivory_spike_r, neck_base, neck_spike_crown_c]
          }
          plane hunch_quill_crest_rear place(base_box=hunch_shoulder_c, anchor=[0, 0.90, -0.82], align=[0, -0.82, 0]) {
            size: [10.5, 6.0], normal: z, material: scarred_steel, rotate: [28, 0, 0],
            edge: spikes(width=4, min_len=4, max_len=9, side=top, seed=23), layer: 2,
            blend_with: [hunch_ivory_spike_rear, waist_core, lumbar_armor, lumbar_iron_spike_1]
          }

          // Ribcage Iron & Ivory Shingles
          box rib_iron_shingle_l_1 place(base_box=chest_core, anchor=[0.99, 0.24, -0.24], align=[-0.74, 0, 0]) {
            size: [2.5, 6.0, 6.5], material: gunmetal_iron, rotate: [10, 16, -12], blend_with: [hunch_scapula_l, fore_bicep, flank_spike_plate_l_1, waist_core]
          }
          box rib_iron_shingle_r_1 place(base_box=chest_core, anchor=[-0.99, 0.24, -0.24], align=[0.74, 0, 0]) {
            size: [2.5, 6.0, 6.5], material: gunmetal_iron, rotate: [10, -16, 12], blend_with: [hunch_scapula_r, fore_shoulder_r__fore_bicep, flank_spike_plate_r_1, waist_core]
          }
          box rib_ivory_shingle_l_2 place(base_box=chest_core, anchor=[0.99, -0.24, -0.36], align=[-0.74, 0, 0]) {
            size: [2.0, 5.0, 6.0], material: ivory_spike, rotate: [8, 18, -10], blend_with: [rib_iron_shingle_l_1, fore_bicep, fore_bracer, flank_spike_plate_l_1, flank_spike_plate_l_2, waist_core]
          }
          box rib_ivory_shingle_r_2 place(base_box=chest_core, anchor=[-0.99, -0.24, -0.36], align=[0.74, 0, 0]) {
            size: [2.0, 5.0, 6.0], material: ivory_spike, rotate: [8, -18, 10], blend_with: [rib_iron_shingle_r_1, fore_shoulder_r__fore_bicep, fore_shoulder_r__fore_bracer, flank_spike_plate_r_1, flank_spike_plate_r_2, waist_core]
          }

          // Warm Burnt-Copper / Bruised-Amber Ventral Sternum Scutes & Spiked Collar Ruff
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.32], align=[0, 0.42, 0]) {
            size: [14.5, 2.5, 9.0], material: copper_underhide, rotate: [4, 0, 0], blend_with: [waist_belly]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.96, 0.56], align=[0, 0.48, -0.25]) {
            size: [13.0, 2.5, 8.5], material: copper_underhide, rotate: [-18, 0, 0], blend_with: [chest_scute_rear, fore_bracer, fore_shoulder_r__fore_bracer]
          }
          box sternum_iron_keel place(base_box=chest_scute_front, anchor=[0, -0.95, 0.25], align=[0, 0.72, 0]) {
            size: [5.5, 2.5, 6.0], material: gunmetal_iron, rotate: [-12, 0, 0], blend_with: [chest_core, neck_throat_plate, fore_bicep, fore_shoulder_r__fore_bicep]
          }
          plane chest_spike_ruff_l place(base_box=chest_core, anchor=[0.66, -0.82, 0.92], align=[0, 0.65, -0.85]) {
            size: [7.0, 5.5], normal: z, material: ivory_spike, rotate: [-24, -18, -12],
            edge: spikes(width=4, min_len=3, max_len=8, side=bottom, seed=37), layer: 1,
            blend_with: [chest_scute_front, sternum_iron_keel, neck_throat_plate, fore_bicep]
          }
          plane chest_spike_ruff_r place(base_box=chest_core, anchor=[-0.66, -0.82, 0.92], align=[0, 0.65, -0.85]) {
            size: [7.0, 5.5], normal: z, material: gunmetal_iron, rotate: [-24, 18, 12],
            edge: spikes(width=4, min_len=3, max_len=8, side=bottom, seed=37), layer: 1,
            blend_with: [chest_scute_front, sternum_iron_keel, neck_throat_plate, fore_shoulder_r__fore_bicep]
          }

          // SIX-LIMBED SPINED ELDER DRAGON WINGS (12 wing bones + 10 tattered non-uni-sheet membrane bays!)
          bone wing_shoulder_l attach(parent_box=hunch_shoulder_c, anchor=[0.94, 0.68, -0.12], align=[-0.94, -0.60, 0], seat=0.05) mirror_x(wing_shoulder_r) {
            rest_euler: [8, 20, 42]
            box wing_arm_spar { size: [14.0, 4.5, 5.0], material: obsidian_hide, blend_with: [chest_core, hunch_scapula_l, hunch_scapula_r] }
            box wing_arm_iron_crest place(base_box=wing_arm_spar, anchor=[0.25, 0.96, 0.25], align=[0, -0.82, 0]) {
              size: [9.0, 3.5, 3.5], material: gunmetal_iron, rotate: [12, 8, -14], blend_with: [hunch_scapula_l, wing_forearm_spar]
            }
            box wing_arm_ivory_quill place(base_box=wing_arm_iron_crest, anchor=[0.10, 0.92, 0.25], align=[0, -0.84, 0]) {
              size: [6.0, 3.0, 2.5], material: ivory_spike, rotate: [16, 12, -18]
            }
            plane wing_arm_patagium place(base_box=wing_arm_spar, anchor=[0.22, 0.0, -0.96], align=[0, 0, 0.92]) {
              size: [11.0, 7.5], normal: y, material: wing_membrane_plum,
              edge: ragged(depth=5, holes=2, side=top, seed=17), layer: 2,
              blend_with: [chest_core, hunch_scapula_l, waist_core, wing_forearm_spar, wing_forearm_patagium]
            }

            bone wing_forearm_l attach(parent_box=wing_arm_spar, anchor=[1, 0.05, 0.05], align=[-1, 0, 0], seat=0.10) {
              rest_euler: [0, -34, 8]
              box wing_forearm_spar { size: [17.0, 4.0, 4.5], material: elder_charcoal }
              box wing_elbow_spike place(base_box=wing_forearm_spar, anchor=[-0.72, 0.88, -0.65], align=[0.45, -0.65, 0.55]) {
                size: [6.5, 3.0, 3.5], material: ivory_spike, rotate: [14, 28, 18], blend_with: [wing_arm_spar]
              }
              box wing_elbow_iron_lance place(base_box=wing_elbow_spike, anchor=[-0.88, 0.35, -0.35], align=[0.72, -0.35, 0.35]) {
                size: [5.0, 2.0, 2.5], material: scarred_steel, rotate: [10, 18, 14], blend_with: [wing_arm_spar, wing_forearm_spar]
              }
              box wing_leading_iron_row place(base_box=wing_forearm_spar, anchor=[0.15, 0.55, 0.96], align=[0, -0.55, -0.72]) {
                size: [12.0, 3.0, 3.5], material: gunmetal_iron, rotate: [-16, -8, 0], blend_with: [wing_wrist_hub]
              }
              plane wing_leading_quill_plane place(base_box=wing_leading_iron_row, anchor=[0, 0.96, 0.25], align=[0, -0.88, 0]) {
                size: [11.0, 4.5], normal: z, material: ivory_spike, rotate: [-18, 0, 0],
                edge: spikes(width=4, min_len=3, max_len=7, side=top, seed=27), layer: 1,
                blend_with: [wing_forearm_spar, wing_wrist_hub, wing_thumb_claw]
              }
              plane wing_forearm_patagium place(base_box=wing_forearm_spar, anchor=[0.05, 0.15, -0.96], align=[0, 0, 0.92]) {
                size: [15.0, 11.5], normal: y, material: wing_membrane_plum,
                edge: scallop(bays=3, depth=5, side=top, seed=23), layer: 1,
                blend_with: [wing_arm_spar, wing_wrist_hub, wing_f3_spar, wing_bay_3_plane, wing_bay_2_plane, wing_bay_1_plane]
              }

              bone wing_wrist_l attach(parent_box=wing_forearm_spar, anchor=[1, 0, 0], align=[-1, 0, 0], seat=0.10) {
                rest_euler: [0, 26, -20]
                box wing_wrist_hub { size: [5.0, 4.0, 4.5], material: gunmetal_iron }
                box wing_thumb_claw place(base_box=wing_wrist_hub, anchor=[0.45, 0.45, 0.98], align=[0, -0.45, -0.82]) {
                  size: [3.0, 3.0, 8.5], material: scarred_steel, rotate: [-22, -24, 12], blend_with: [wing_forearm_spar, wing_f1_spar]
                }
                box wing_thumb_ivory_barb place(base_box=wing_wrist_hub, anchor=[-0.35, 0.88, 0.85], align=[0, -0.78, -0.78]) {
                  size: [2.0, 2.5, 6.0], material: ivory_spike, rotate: [-28, -14, 16], blend_with: [wing_forearm_spar, wing_leading_iron_row, wing_thumb_claw]
                }

                bone wing_finger_1_l attach(parent_box=wing_wrist_hub, anchor=[1, 0.22, 0.55], align=[-1, 0, 0], seat=0.06) {
                  rest_euler: [0, 14, -6]
                  box wing_f1_spar { size: [22.0, 2.5, 3.0], material: gunmetal_iron }
                  box wing_f1_iron_ridge place(base_box=wing_f1_spar, anchor=[0.10, 0.92, 0.45], align=[0, -0.82, 0]) {
                    size: [14.0, 2.0, 2.0], material: scarred_steel, rotate: [-12, 0, 0], blend_with: [wing_wrist_hub, wing_thumb_claw]
                  }
                  box wing_f1_tip_spike place(base_box=wing_f1_spar, anchor=[0.98, 0, 0], align=[-0.82, 0, 0]) {
                    size: [6.5, 2.0, 2.0], material: ivory_spike, rotate: [0, 8, -6]
                  }
                  plane wing_bay_1_plane place(base_box=wing_f1_spar, anchor=[0.02, 0.0, -0.96], align=[0, 0, 0.92]) {
                    size: [20.0, 9.5], normal: y, material: wing_membrane_plum,
                    edge: ragged(depth=5, holes=3, side=top, seed=31), layer: 1,
                    blend_with: [wing_wrist_hub, wing_f2_spar, wing_bay_2_plane]
                  }
                }

                bone wing_finger_2_l attach(parent_box=wing_wrist_hub, anchor=[0.88, 0.0, -0.15], align=[-1, 0, 0], seat=0.06) {
                  rest_euler: [0, 44, -12]
                  box wing_f2_spar { size: [19.5, 2.5, 2.5], material: ivory_spike, blend_with: [wing_f1_spar] }
                  box wing_f2_tip_spike place(base_box=wing_f2_spar, anchor=[0.98, 0, 0], align=[-0.82, 0, 0]) {
                    size: [5.5, 1.5, 2.0], material: scarred_steel, rotate: [0, 10, -6]
                  }
