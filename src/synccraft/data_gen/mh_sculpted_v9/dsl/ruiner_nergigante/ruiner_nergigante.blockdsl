                  size: [3.5, 3.0, 7.0], material: scarred_steel, rotate: [14, 0, 0], blend_with: [tail_4_dorsal_ivory, tail_6_mace]
                }
                plane tail_5_quill_l place(base_box=tail_5_dorsal_iron, anchor=[0.38, 0.92, 0], align=[0, -0.85, 0]) {
                  size: [5.0, 7.5], normal: x, material: ivory_spike, rotate: [8, 0, -16],
                  edge: spikes(width=4, min_len=3, max_len=8, side=top, seed=137), layer: 2,
                  blend_with: [tail_4_quill_l, tail_6_mace]
                }
                plane tail_5_quill_r place(base_box=tail_5_dorsal_iron, anchor=[-0.38, 0.92, 0], align=[0, -0.85, 0]) {
                  size: [5.0, 7.5], normal: x, material: scarred_steel, rotate: [8, 0, 16],
                  edge: spikes(width=4, min_len=3, max_len=8, side=top, seed=137), layer: 1,
                  blend_with: [tail_4_quill_r, tail_6_mace, tail_5_quill_l]
                }

                bone tail_6 attach(parent_box=tail_5_seg, anchor=[0, 0.05, -1], align=[0, 0, 1], seat=0.22) {
                  rest_euler: [4, 0, 0]
                  box tail_6_mace { size: [5.0, 4.5, 9.0], material: gunmetal_iron }
                  box tail_6_side_spike_l place(base_box=tail_6_mace, anchor=[0.96, 0.12, -0.15], align=[-0.65, 0, 0.45]) {
                    size: [3.0, 2.5, 8.0], material: ivory_spike, rotate: [10, 26, -12], blend_with: [tail_5_seg, tail_5_spike_l, tail_mace_tip_l]
                  }
                  box tail_6_side_spike_r place(base_box=tail_6_mace, anchor=[-0.96, 0.12, -0.15], align=[0.65, 0, 0.45]) {
                    size: [3.0, 2.5, 8.0], material: scarred_steel, rotate: [10, -26, 12], blend_with: [tail_5_seg, tail_5_spike_r, tail_mace_tip_r]
                  }
                  box tail_mace_tip_l place(base_box=tail_6_mace, anchor=[0.68, 0.12, -0.92], align=[-0.35, 0, 0.72]) {
                    size: [2.0, 2.5, 7.5], material: ivory_spike, rotate: [8, 18, -8], blend_with: [tail_5_seg, tail_5_spike_l]
                  }
                  box tail_mace_tip_r place(base_box=tail_6_mace, anchor=[-0.68, 0.12, -0.92], align=[0.35, 0, 0.72]) {
                    size: [2.0, 2.5, 7.5], material: scarred_steel, rotate: [8, -18, 8], blend_with: [tail_5_seg, tail_5_spike_r, tail_mace_tip_l]
                  }
                  box tail_mace_center_lance place(base_box=tail_6_mace, anchor=[0, 0.88, -0.65], align=[0, -0.78, 0.55]) {
                    size: [2.0, 2.5, 6.0], material: gunmetal_iron, rotate: [16, 0, 0], blend_with: [tail_mace_tip_l, tail_mace_tip_r]
                  }
                  plane tail_6_quill_l place(base_box=tail_6_mace, anchor=[0.35, 0.94, 0], align=[0, -0.85, 0]) {
                    size: [4.5, 7.0], normal: x, material: ivory_spike, rotate: [10, 0, -16],
                    edge: spikes(width=4, min_len=3, max_len=8, side=top, seed=149), layer: 1,
                    blend_with: [tail_5_quill_l, tail_5_dorsal_iron, tail_mace_tip_l, tail_mace_center_lance]
                  }
                  plane tail_6_quill_r place(base_box=tail_6_mace, anchor=[-0.35, 0.94, 0], align=[0, -0.85, 0]) {
                    size: [4.5, 7.0], normal: x, material: scarred_steel, rotate: [10, 0, 16],
                    edge: spikes(width=4, min_len=3, max_len=8, side=top, seed=149), layer: 2,
                    blend_with: [tail_5_quill_r, tail_5_dorsal_iron, tail_mace_tip_r, tail_mace_center_lance, tail_6_quill_l]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
@materials {
  obsidian_hide: process(family=keratin_scales, coat=scale_rows, roughness=0.58)
  elder_charcoal: process(family=keratin_scales, coat=banded_limb, roughness=0.52)
  gunmetal_iron: process(family=brushed_metal, coat=striped, roughness=0.28)
  scarred_steel: process(family=painted_metal, coat=striped, roughness=0.24)
  ivory_spike: process(family=polymer_dielectric, coat=striped, roughness=0.36)
  aged_keratin: process(family=weathered_stone, coat=striped, roughness=0.46)
  copper_underhide: process(family=patterned_skin, coat=plain, roughness=0.62)
  wing_membrane_plum: process(family=woven_fabric, coat=mottled, roughness=0.72)
  maw_crimson: process(family=patterned_skin, coat=plain, roughness=0.44)
  ruiner_amber: process(family=thin_film_iridescence, coat=plain, roughness=0.18, emissive=0.95)
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
@stamps {
  stamp predator_amber_glare on skull_core.east { at: [0.72, 0.36], size: [1.5, 1.0], color: ruiner_amber, emissive: 0.95, mirror: true }
  stamp battle_scar_gleam on horn_r_seg_2.west { at: [0.52, 0.40], size: [3.0, 1.0], rows: 2, spacing: 1.8, color: ruiner_amber, emissive: 0.85 }
  stamp throat_dermal_glow on neck_throat_plate.down { at: [0.50, 0.38], size: [4.0, 1.0], rows: 2, spacing: 2.0, color: ruiner_amber, emissive: 0.82 }
}
@behavior {
  spring wing_finger_1_l { stiffness: 46, damping: 6 }
  spring wing_shoulder_r__wing_finger_1_l { stiffness: 46, damping: 6 }
  spring tail_6 { stiffness: 40, damping: 5 }

  // 1. Hulking Eater of Elders breathing, spiked wings subtly flexing, snarling bulldog head scan
  clip idle {
    duration_s: 3.2, loop: true
    key root.position { 0.0: [0, 0, 0], 0.8: [0, -0.6, 0], 1.6: [0, 0.4, 0], 2.4: [0, -0.6, 0], 3.2: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.8: [3.0, 2.0, 0], 1.6: [-2.5, 0, 0], 2.4: [3.0, -2.0, 0], 3.2: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.8: [-3, 6, 2], 1.6: [2, 0, 0], 2.4: [-3, -6, -2], 3.2: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.8: [4, 10, -4], 1.6: [-3, 0, 0], 2.4: [4, -10, 4], 3.2: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 1.6: [9, 0, 0], 3.2: [0, 0, 0], catmullrom }
    key wing_shoulder_l.rotation { 0.0: [0, 0, 0], 1.6: [0, -4, 6], 3.2: [0, 0, 0], catmullrom }
    key wing_shoulder_r.rotation { 0.0: [0, 0, 0], 1.6: [0, -4, 6], 3.2: [0, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=7, freq_hz=0.3125, phase_deg=0)
    track tail_3: wave(axis=y, amp_deg=12, freq_hz=0.3125, phase_deg=-65)
    track tail_5: wave(axis=y, amp_deg=16, freq_hz=0.3125, phase_deg=-130)
  }

  // 2. Heavy gorilla-juggernaut stalk with rolling spiked shoulders & planted fist impacts
  clip walk {
    duration_s: 1.8, loop: true
    key root.position { 0.0: [0, 0, 0], 0.45: [0, 1.3, 0], 0.90: [0, 0, 0], 1.35: [0, 1.3, 0], 1.8: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, -6, 3], 0.45: [3, 0, 0], 0.90: [0, 6, -3], 1.35: [3, 0, 0], 1.8: [0, -6, 3], catmullrom }
    key chest.rotation { 0.0: [0, 10, -7], 0.45: [-3, 0, 0], 0.90: [0, -10, 7], 1.35: [-3, 0, 0], 1.8: [0, 10, -7], catmullrom }
    key head.rotation { 0.0: [3, -5, 4], 0.90: [3, 5, -4], 1.8: [3, -5, 4], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [-24, 0, 0], 0.45: [6, 0, 5], 0.90: [22, 0, 0], 1.35: [-10, 0, 6], 1.8: [-24, 0, 0], catmullrom }
    key fore_arm_l.rotation { 0.0: [12, 0, 0], 0.45: [4, 0, 0], 0.90: [18, 0, 0], 1.35: [-24, 0, 0], 1.8: [12, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [22, 0, 0], 0.45: [-10, 0, 6], 0.90: [-24, 0, 0], 1.35: [6, 0, 5], 1.8: [22, 0, 0], catmullrom }
    key fore_shoulder_r__fore_arm_l.rotation { 0.0: [18, 0, 0], 0.45: [-24, 0, 0], 0.90: [12, 0, 0], 1.35: [4, 0, 0], 1.8: [18, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [20, 0, 0], 0.45: [-10, 0, 4], 0.90: [-22, 0, 0], 1.35: [6, 0, 0], 1.8: [20, 0, 0], catmullrom }
    key hind_shin_l.rotation { 0.0: [-14, 0, 0], 0.45: [24, 0, 0], 0.90: [8, 0, 0], 1.35: [-6, 0, 0], 1.8: [-14, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [-22, 0, 0], 0.45: [6, 0, 0], 0.90: [20, 0, 0], 1.35: [-10, 0, 4], 1.8: [-22, 0, 0], catmullrom }
    key hind_thigh_r__hind_shin_l.rotation { 0.0: [8, 0, 0], 0.45: [-6, 0, 0], 0.90: [-14, 0, 0], 1.35: [24, 0, 0], 1.8: [8, 0, 0], catmullrom }
    key wing_shoulder_l.rotation { 0.0: [0, 4, -4], 0.90: [0, -4, 6], 1.8: [0, 4, -4], catmullrom }
    key wing_shoulder_r.rotation { 0.0: [0, -4, 6], 0.90: [0, 4, -4], 1.8: [0, -4, 6], catmullrom }
    track tail_1: wave(axis=y, amp_deg=11, freq_hz=0.5556, phase_deg=0)
    track tail_4: wave(axis=y, amp_deg=18, freq_hz=0.5556, phase_deg=-90)
  }

  // 3. Thundering 6-limbed Elder Dragon bull-charge with half-flared spiked bat wings
  clip run {
    duration_s: 0.95, loop: true
    key root.position { 0.0: [0, 1.8, 0], 0.24: [0, 6.0, 3.0], 0.48: [0, 0.4, 0], 0.72: [0, -1.6, -1.5], 0.95: [0, 1.8, 0], catmullrom }
    key pelvis.rotation { 0.0: [-14, 0, 0], 0.24: [-20, 0, 0], 0.48: [10, 0, 0], 0.72: [18, 0, 0], 0.95: [-14, 0, 0], catmullrom }
    key waist.rotation { 0.0: [-8, 0, 0], 0.24: [-12, 0, 0], 0.48: [10, 0, 0], 0.72: [14, 0, 0], 0.95: [-8, 0, 0], catmullrom }
    key chest.rotation { 0.0: [-10, 0, 0], 0.24: [10, 0, 0], 0.48: [18, 0, 0], 0.72: [-8, 0, 0], 0.95: [-10, 0, 0], catmullrom }
    key head.rotation { 0.0: [12, 0, 0], 0.24: [-12, 0, 0], 0.48: [-16, 0, 0], 0.72: [8, 0, 0], 0.95: [12, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [-42, 0, 6], 0.28: [-18, 0, 0], 0.56: [36, 0, 0], 0.95: [-42, 0, 6], catmullrom }
    key fore_arm_l.rotation { 0.0: [-18, 0, 0], 0.28: [12, 0, 0], 0.56: [28, 0, 0], 0.95: [-18, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [-30, 0, 6], 0.22: [-44, 0, 6], 0.52: [34, 0, 0], 0.95: [-30, 0, 6], catmullrom }
    key fore_shoulder_r__fore_arm_l.rotation { 0.0: [-14, 0, 0], 0.22: [-20, 0, 0], 0.52: [28, 0, 0], 0.95: [-14, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [36, 0, 0], 0.26: [42, 0, 0], 0.58: [-36, 0, 4], 0.95: [36, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [28, 0, 0], 0.32: [40, 0, 0], 0.64: [-34, 0, 4], 0.95: [28, 0, 0], catmullrom }
    key wing_shoulder_l.rotation { 0.0: [0, -10, 14], 0.48: [0, 8, -10], 0.95: [0, -10, 14], catmullrom }
    key wing_shoulder_r.rotation { 0.0: [0, -10, 14], 0.48: [0, 8, -10], 0.95: [0, -10, 14], catmullrom }
    track tail_2: wave(axis=x, amp_deg=20, freq_hz=1.0526, phase_deg=0)
    track tail_5: wave(axis=x, amp_deg=28, freq_hz=1.0526, phase_deg=-90)
  }

  // 4. Eater of Elders Roar — rears upright on hindlegs, unfurls both 12-bone spiked wings wide, throws asymmetric horns high!
  clip roar {
    duration_s: 2.6, loop: false
    key root.position { 0.0: [0, 0, 0], 0.45: [0, -3.0, -2.5], 1.05: [0, 9.5, -2.0], 1.85: [0, 8.5, -1.5], 2.6: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.45: [14, 0, 0], 1.05: [-34, 0, 0], 1.85: [-30, 0, 0], 2.6: [0, 0, 0], catmullrom }
    key waist.rotation { 0.0: [0, 0, 0], 0.45: [12, 0, 0], 1.05: [-22, 0, 0], 1.85: [-20, 0, 0], 2.6: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.45: [18, 0, 0], 1.05: [-26, 0, 0], 1.45: [-24, 6, 0], 1.85: [-26, -6, 0], 2.6: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.45: [16, 0, 0], 1.05: [-18, 0, 0], 1.85: [-18, 0, 0], 2.6: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.45: [18, 0, 0], 1.05: [-22, 0, 0], 1.45: [-20, 10, -8], 1.85: [-22, -10, 8], 2.6: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.45: [-6, 0, 0], 0.98: [46, 0, 0], 1.90: [44, 0, 0], 2.6: [0, 0, 0], catmullrom }
    // Both 6-bone spiked bat wings unfurl dramatically wide & skyward!
    key wing_shoulder_l.rotation { 0.0: [0, 0, 0], 1.05: [-8, -26, 22], 1.85: [-8, -24, 20], 2.6: [0, 0, 0], catmullrom }
    key wing_forearm_l.rotation { 0.0: [0, 0, 0], 1.05: [0, 22, 12], 1.85: [0, 20, 10], 2.6: [0, 0, 0], catmullrom }
    key wing_wrist_l.rotation { 0.0: [0, 0, 0], 1.05: [0, -24, 16], 1.85: [0, -22, 14], 2.6: [0, 0, 0], catmullrom }
    key wing_shoulder_r.rotation { 0.0: [0, 0, 0], 1.05: [-8, -26, 22], 1.85: [-8, -24, 20], 2.6: [0, 0, 0], catmullrom }
    key wing_shoulder_r__wing_forearm_l.rotation { 0.0: [0, 0, 0], 1.05: [0, 22, 12], 1.85: [0, 20, 10], 2.6: [0, 0, 0], catmullrom }
    key wing_shoulder_r__wing_wrist_l.rotation { 0.0: [0, 0, 0], 1.05: [0, -24, 16], 1.85: [0, -22, 14], 2.6: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 1.05: [-38, 0, 28], 1.85: [-34, 0, 26], 2.6: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 1.05: [-38, 0, 28], 1.85: [-34, 0, 26], 2.6: [0, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [0, 0, 0], 1.05: [28, 0, 8], 1.85: [26, 0, 8], 2.6: [0, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [0, 0, 0], 1.05: [28, 0, 8], 1.85: [26, 0, 8], 2.6: [0, 0, 0], catmullrom }
  }

  // 5. SIGNATURE GIF CLIP: Ruiner Heaven-Shattering Extinction Metallic Divebomb!
  clip extinction_metallic_divebomb {
    duration_s: 2.3, loop: false
    key root.position { 0.0: [0, 0, 0], 0.36: [0, -4.5, -3.5], 0.85: [0, 32.0, -4.0], 1.25: [0, 24.0, 6.0], 1.62: [0, -3.5, 22.0], 2.3: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.36: [18, 0, 0], 0.85: [-28, 0, 0], 1.25: [42, -12, 16], 1.62: [22, 0, 0], 2.3: [0, 0, 0], catmullrom }
    key waist.rotation { 0.0: [0, 0, 0], 0.36: [14, 0, 0], 0.85: [-18, 0, 0], 1.25: [22, 0, 0], 1.62: [14, 0, 0], 2.3: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.36: [20, 0, 0], 0.85: [-24, 0, 0], 1.25: [28, -14, 18], 1.62: [24, 0, 0], 2.3: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.85: [-26, 0, 0], 1.25: [18, 8, -12], 1.62: [-14, 0, 0], 2.3: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.85: [44, 0, 0], 1.25: [36, 0, 0], 1.62: [12, 0, 0], 2.3: [0, 0, 0], catmullrom }
    // Spreads spiked wings huge at apex (t=0.85), sweeps back like a meteor (t=1.25), explodes metallic spikes outward on impact (t=1.62)!
    key wing_shoulder_l.rotation { 0.0: [0, 0, 0], 0.85: [-12, -32, 28], 1.25: [14, 34, -22], 1.62: [-10, -28, 24], 2.3: [0, 0, 0], catmullrom }
    key wing_forearm_l.rotation { 0.0: [0, 0, 0], 0.85: [0, 26, 14], 1.25: [0, -22, -12], 1.62: [0, 24, 12], 2.3: [0, 0, 0], catmullrom }
    key wing_wrist_l.rotation { 0.0: [0, 0, 0], 0.85: [0, -28, 18], 1.25: [0, 28, -14], 1.62: [0, -24, 16], 2.3: [0, 0, 0], catmullrom }
    key wing_shoulder_r.rotation { 0.0: [0, 0, 0], 0.85: [-12, -32, 28], 1.25: [14, 34, -22], 1.62: [-10, -28, 24], 2.3: [0, 0, 0], catmullrom }
    key wing_shoulder_r__wing_forearm_l.rotation { 0.0: [0, 0, 0], 0.85: [0, 26, 14], 1.25: [0, -22, -12], 1.62: [0, 24, 12], 2.3: [0, 0, 0], catmullrom }
    key wing_shoulder_r__wing_wrist_l.rotation { 0.0: [0, 0, 0], 0.85: [0, -28, 18], 1.25: [0, 28, -14], 1.62: [0, -24, 16], 2.3: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.85: [-62, 0, 32], 1.25: [-54, 0, 18], 1.62: [24, 0, 28], 2.3: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.85: [-62, 0, 32], 1.25: [-68, 0, 24], 1.62: [26, 0, 28], 2.3: [0, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [0, 0, 0], 0.85: [42, 0, 16], 1.25: [36, 0, 12], 1.62: [-18, 0, 8], 2.3: [0, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [0, 0, 0], 0.85: [42, 0, 16], 1.25: [36, 0, 12], 1.62: [-18, 0, 8], 2.3: [0, 0, 0], catmullrom }
  }

  // 6. Ruiner Right-Arm Iron-Spike Shrapnel Ground Slam!
  clip iron_spike_shrapnel_slam {
    duration_s: 1.9, loop: false
    key root.position { 0.0: [0, 0, 0], 0.55: [2.5, 8.5, -1.0], 0.92: [-2.0, -3.5, 10.5], 1.30: [-1.5, -2.5, 10.0], 1.9: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.55: [-28, 18, -10], 0.92: [20, -20, 8], 1.9: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.55: [-34, 28, -18], 0.92: [26, -28, 16], 1.9: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.55: [38, 0, 0], 0.92: [14, 0, 0], 1.9: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.55: [-82, -20, 34], 0.92: [24, 10, -12], 1.30: [20, 8, -10], 1.9: [0, 0, 0], catmullrom }
    key fore_shoulder_r__fore_arm_l.rotation { 0.0: [0, 0, 0], 0.55: [-32, 0, 0], 0.92: [28, 0, 0], 1.9: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.55: [22, 0, 14], 0.92: [-14, 0, 18], 1.9: [0, 0, 0], catmullrom }
    key wing_shoulder_r.rotation { 0.0: [0, 0, 0], 0.55: [-10, -24, 24], 0.92: [12, 20, -14], 1.9: [0, 0, 0], catmullrom }
  }

  // 7. Asymmetric Scarred Gunmetal-Iron Horn Bulldozer Uppercut Gore!
  clip bulldog_horn_uppercut_gore {
    duration_s: 1.7, loop: false
    key root.position { 0.0: [0, 0, 0], 0.42: [0, -4.0, -4.0], 0.85: [0, -2.5, 14.0], 1.18: [0, 6.5, 18.0], 1.7: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.42: [18, -10, 0], 0.85: [14, 12, 0], 1.18: [-22, 0, 0], 1.7: [0, 0, 0], catmullrom }
