// Ruiner Nergigante (Eater of Elders) — Stage 2 Secondary Anatomy, Asymmetric Bull Horns & 12-Bone Partitioned Spiked Wings
// Hand-authored progressive Block-DSL v4.1: bulldog wedged snout, genuine L/R horn asymmetry, gorilla forelimbs, & non-uni-sheet wings.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 260
  budget max_bones = 90
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  obsidian_hide: ramp(base_lch=[0.29, 0.055, 275], steps=6, hue_shift=[24, -16])
  elder_charcoal: ramp(base_lch=[0.36, 0.062, 290], steps=6, hue_shift=[24, -16])
  gunmetal_iron: ramp(base_lch=[0.54, 0.068, 248], steps=6, hue_shift=[22, -16])
  scarred_steel: ramp(base_lch=[0.66, 0.058, 238], steps=6, hue_shift=[22, -14])
  ivory_spike: ramp(base_lch=[0.86, 0.048, 82], steps=6, hue_shift=[20, -12])
  aged_keratin: ramp(base_lch=[0.64, 0.082, 68], steps=6, hue_shift=[18, -12])
  copper_underhide: ramp(base_lch=[0.52, 0.125, 38], steps=6, hue_shift=[20, -14])
  wing_membrane_plum: ramp(base_lch=[0.35, 0.085, 12], steps=6, hue_shift=[24, -16])
  ruiner_amber: ramp(base_lch=[0.76, 0.195, 52], steps=6, hue_shift=[14, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 21.85, -14.5]) {
      rest_euler: [12, 0, 0]
      box pelvis_core { size: [14.0, 11.5, 13.5], material: obsidian_hide }
      box pelvis_belly place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.42, 0]) {
        size: [10.0, 2.0, 11.0], material: copper_underhide
      }
      box sacrum_armor place(base_box=pelvis_core, anchor=[0, 0.98, -0.08], align=[0, -0.58, 0]) {
        size: [8.5, 2.5, 10.5], material: elder_charcoal, rotate: [8, 0, 0], blend_with: [lumbar_armor, tail_1_seg, tail_1_plate]
      }
      box haunch_mass_l place(base_box=pelvis_core, anchor=[0.98, 0.24, -0.05], align=[-0.50, 0, 0]) {
        size: [3.5, 8.0, 10.0], material: elder_charcoal, rotate: [5, 8, -14], blend_with: [thigh_mass, waist_core]
      }
      box haunch_mass_r place(base_box=pelvis_core, anchor=[-0.98, 0.24, -0.05], align=[0.50, 0, 0]) {
        size: [3.5, 8.0, 10.0], material: elder_charcoal, rotate: [5, -8, 14], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.16, 1], align=[0, 0, -1], seat=0.28) {
        rest_euler: [-6, 0, 0]
        box waist_core { size: [16.5, 14.0, 12.5], material: obsidian_hide }
        box waist_belly place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.42, 0]) {
          size: [12.0, 2.0, 10.5], material: copper_underhide, blend_with: [pelvis_belly, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_armor place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
          size: [10.0, 3.0, 10.5], material: elder_charcoal, rotate: [-6, 0, 0], blend_with: [pelvis_core, chest_core]
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.24, 1], align=[0, 0, -1], seat=0.28) {
          rest_euler: [-10, 0, 0]
          box chest_core { size: [22.0, 18.5, 17.5], material: obsidian_hide }
          // Towering Hunchbacked Scapula & Regenerative Spike Mantle
          box hunch_shoulder_c place(base_box=chest_core, anchor=[0, 0.98, 0.10], align=[0, -0.55, 0]) {
            size: [14.5, 5.5, 15.0], material: elder_charcoal, rotate: [-12, 0, 0], blend_with: [neck_base, lumbar_armor]
          }
          box hunch_scapula_l place(base_box=chest_core, anchor=[0.74, 0.88, 0.05], align=[-0.20, -0.55, 0]) {
            size: [6.5, 5.5, 13.5], material: gunmetal_iron, rotate: [-8, -14, -22], blend_with: [hunch_shoulder_c, neck_base]
          }
          box hunch_scapula_r place(base_box=chest_core, anchor=[-0.74, 0.88, 0.05], align=[0.20, -0.55, 0]) {
            size: [6.5, 5.5, 13.5], material: gunmetal_iron, rotate: [-8, 14, 22], blend_with: [hunch_shoulder_c, neck_base]
          }
          // Dorsal Gunmetal-Iron & Ivory Spike Clusters
          box hunch_iron_spike_c place(base_box=hunch_shoulder_c, anchor=[0, 0.98, -0.15], align=[0, -0.86, 0.25]) {
            size: [3.5, 6.5, 7.5], material: gunmetal_iron, rotate: [26, 0, 0], blend_with: [chest_core, lumbar_armor]
          }
          box hunch_ivory_spike_l place(base_box=hunch_scapula_l, anchor=[0.55, 0.98, 0.35], align=[-0.25, -0.88, 0.25]) {
            size: [3.0, 6.5, 7.0], material: ivory_spike, rotate: [26, -16, -20], blend_with: [hunch_shoulder_c, chest_core, neck_base, wing_arm_spar, wing_arm_iron_crest]
          }
          box hunch_ivory_spike_r place(base_box=hunch_scapula_r, anchor=[-0.55, 0.98, 0.35], align=[0.25, -0.88, 0.25]) {
            size: [3.0, 6.5, 7.0], material: ivory_spike, rotate: [26, 16, 20], blend_with: [hunch_shoulder_c, chest_core, neck_base, wing_shoulder_r__wing_arm_spar, wing_shoulder_r__wing_arm_iron_crest]
          }

          // Warm Burnt-Copper / Bruised-Amber Ventral Sternum Scutes
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.32], align=[0, 0.42, 0]) {
            size: [14.5, 2.5, 9.0], material: copper_underhide, rotate: [4, 0, 0], blend_with: [waist_belly]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.96, 0.56], align=[0, 0.48, -0.25]) {
            size: [13.0, 2.5, 8.5], material: copper_underhide, rotate: [-18, 0, 0], blend_with: [chest_scute_rear, fore_bracer, fore_shoulder_r__fore_bracer]
          }

          // SIX-LIMBED SPINED ELDER DRAGON WINGS (12 wing bones + 10 tattered non-uni-sheet membrane bays!)
          bone wing_shoulder_l attach(parent_box=hunch_shoulder_c, anchor=[0.94, 0.68, -0.12], align=[-0.94, -0.60, 0], seat=0.05) mirror_x(wing_shoulder_r) {
            rest_euler: [8, 20, 42]
            box wing_arm_spar { size: [14.0, 4.5, 5.0], material: obsidian_hide, blend_with: [chest_core, hunch_scapula_l, hunch_scapula_r] }
            box wing_arm_iron_crest place(base_box=wing_arm_spar, anchor=[0.25, 0.96, 0.25], align=[0, -0.82, 0]) {
              size: [9.0, 3.5, 3.5], material: gunmetal_iron, rotate: [12, 8, -14], blend_with: [hunch_scapula_l, wing_forearm_spar]
            }
            plane wing_arm_patagium place(base_box=wing_arm_spar, anchor=[0.22, 0.0, -0.96], align=[0, 0, 0.92]) {
              size: [11.0, 7.5], normal: y, material: wing_membrane_plum,
              edge: ragged(depth=5, holes=2, side=top, seed=17), layer: 2,
              blend_with: [chest_core, hunch_scapula_l, waist_core, wing_forearm_spar, wing_forearm_patagium]
            }

            bone wing_forearm_l attach(parent_box=wing_arm_spar, anchor=[1, 0.05, 0.05], align=[-1, 0, 0], seat=0.10) {
              rest_euler: [0, -34, 8]
              box wing_forearm_spar { size: [17.0, 4.0, 4.5], material: elder_charcoal }
              box wing_elbow_spike place(base_box=wing_forearm_spar, anchor=[-0.72, 0.88, -0.65], align=[0.45, -0.65, 0.55]) {
                size: [6.5, 3.0, 3.5], material: ivory_spike, rotate: [14, 28, 18], blend_with: [wing_arm_spar]
              }
              box wing_leading_iron_row place(base_box=wing_forearm_spar, anchor=[0.15, 0.55, 0.96], align=[0, -0.55, -0.72]) {
                size: [12.0, 3.0, 3.5], material: gunmetal_iron, rotate: [-16, -8, 0], blend_with: [wing_wrist_hub]
              }
              plane wing_forearm_patagium place(base_box=wing_forearm_spar, anchor=[0.05, 0.15, -0.96], align=[0, 0, 0.92]) {
                size: [15.0, 11.5], normal: y, material: wing_membrane_plum,
                edge: scallop(bays=3, depth=5, side=top, seed=23), layer: 1,
                blend_with: [wing_arm_spar, wing_wrist_hub, wing_f3_spar, wing_bay_3_plane, wing_bay_2_plane, wing_bay_1_plane]
              }

              bone wing_wrist_l attach(parent_box=wing_forearm_spar, anchor=[1, 0, 0], align=[-1, 0, 0], seat=0.10) {
                rest_euler: [0, 26, -20]
                box wing_wrist_hub { size: [5.0, 4.0, 4.5], material: gunmetal_iron }
                box wing_thumb_claw place(base_box=wing_wrist_hub, anchor=[0.45, 0.45, 0.98], align=[0, -0.45, -0.82]) {
                  size: [3.0, 3.0, 8.5], material: scarred_steel, rotate: [-22, -24, 12], blend_with: [wing_forearm_spar, wing_f1_spar]
                }

                bone wing_finger_1_l attach(parent_box=wing_wrist_hub, anchor=[1, 0.22, 0.55], align=[-1, 0, 0], seat=0.06) {
                  rest_euler: [0, 14, -6]
                  box wing_f1_spar { size: [22.0, 2.5, 3.0], material: gunmetal_iron }
                  box wing_f1_tip_spike place(base_box=wing_f1_spar, anchor=[0.98, 0, 0], align=[-0.82, 0, 0]) {
                    size: [6.0, 2.0, 2.0], material: ivory_spike, rotate: [0, 8, -6]
                  }
                  plane wing_bay_1_plane place(base_box=wing_f1_spar, anchor=[0.02, 0.0, -0.96], align=[0, 0, 0.92]) {
                    size: [20.0, 9.5], normal: y, material: wing_membrane_plum,
                    edge: ragged(depth=5, holes=3, side=top, seed=31), layer: 1,
                    blend_with: [wing_wrist_hub, wing_f2_spar, wing_bay_2_plane]
                  }
                }

                bone wing_finger_2_l attach(parent_box=wing_wrist_hub, anchor=[0.88, 0.0, -0.15], align=[-1, 0, 0], seat=0.06) {
                  rest_euler: [0, 44, -12]
                  box wing_f2_spar { size: [19.5, 2.5, 2.5], material: ivory_spike, blend_with: [wing_f1_spar] }
                  plane wing_bay_2_plane place(base_box=wing_f2_spar, anchor=[0.02, 0.0, -0.96], align=[0, 0, 0.92]) {
                    size: [17.5, 9.5], normal: y, material: wing_membrane_plum,
                    edge: scallop(bays=3, depth=5, side=top, seed=37), layer: 2,
                    blend_with: [wing_wrist_hub, wing_f3_spar, wing_bay_3_plane]
                  }
                }

                bone wing_finger_3_l attach(parent_box=wing_wrist_hub, anchor=[0.55, -0.20, -0.85], align=[-1, 0, 0], seat=0.06) {
                  rest_euler: [0, 74, -18]
                  box wing_f3_spar { size: [16.5, 2.0, 2.5], material: gunmetal_iron, blend_with: [wing_forearm_spar, wing_f2_spar] }
                  plane wing_bay_3_plane place(base_box=wing_f3_spar, anchor=[0.02, 0.0, -0.96], align=[0, 0, 0.92]) {
                    size: [14.5, 8.5], normal: y, material: wing_membrane_plum,
                    edge: ragged(depth=5, holes=2, side=top, seed=43), layer: 1,
                    blend_with: [wing_wrist_hub, wing_forearm_spar]
                  }
                }
              }
            }
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.22, 1], align=[0, 0, -1], seat=0.28) {
            rest_euler: [-12, 0, 0]
            box neck_base { size: [15.5, 13.5, 9.0], material: obsidian_hide, blend_with: [hunch_shoulder_c, hunch_scapula_l, hunch_scapula_r] }
            box neck_throat_plate place(base_box=neck_base, anchor=[0, -0.96, 0.12], align=[0, 0.45, 0]) {
              size: [10.5, 2.5, 7.5], material: copper_underhide, rotate: [-6, 0, 0], blend_with: [chest_scute_front, chest_core]
            }
            box neck_spike_crown_c place(base_box=neck_base, anchor=[0, 1.0, 0.25], align=[0, -0.84, 0]) {
              size: [5.0, 8.5, 4.5], material: ivory_spike, rotate: [24, 0, 0], blend_with: [hunch_shoulder_c, chest_core, neck_upper]
            }
            box neck_spike_crown_l place(base_box=neck_base, anchor=[0.72, 0.94, 0.22], align=[-0.35, -0.84, 0]) {
              size: [3.5, 8.0, 4.5], material: gunmetal_iron, rotate: [24, -18, -28], blend_with: [neck_spike_crown_c, hunch_scapula_l, chest_core, neck_upper]
            }
            box neck_spike_crown_r place(base_box=neck_base, anchor=[-0.72, 0.94, 0.22], align=[0.35, -0.84, 0]) {
              size: [3.5, 8.0, 4.5], material: gunmetal_iron, rotate: [24, 18, 28], blend_with: [neck_spike_crown_c, hunch_scapula_r, chest_core, neck_upper]
            }

            bone neck_2 attach(parent_box=neck_base, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.26) {
              rest_euler: [18, 0, 0]
              box neck_upper { size: [12.5, 11.0, 7.5], material: obsidian_hide }
              box nape_iron_crest place(base_box=neck_upper, anchor=[0, 0.96, -0.15], align=[0, -0.68, 0.35]) {
                size: [5.5, 4.5, 7.5], material: gunmetal_iron, rotate: [18, 0, 0], blend_with: [neck_base, neck_spike_crown_c, skull_core]
              }

              bone head attach(parent_box=neck_upper, anchor=[0, 0.02, 1], align=[0, 0, -1], seat=0.24) {
                rest_euler: [14, 0, 0]
                box skull_core { size: [11.0, 7.5, 8.0], material: obsidian_hide }
                box brow_ridge_l place(base_box=skull_core, anchor=[0.84, 0.78, 0.56], align=[-0.20, -0.52, -0.30]) {
                  size: [3.0, 2.5, 6.0], material: elder_charcoal, rotate: [12, -14, -16]
                }
                box brow_ridge_r place(base_box=skull_core, anchor=[-0.84, 0.78, 0.56], align=[0.20, -0.52, -0.30]) {
                  size: [3.0, 2.5, 6.0], material: gunmetal_iron, rotate: [12, 14, 16]
                }
                box cheek_armor_l place(base_box=skull_core, anchor=[0.96, -0.22, 0.14], align=[-0.50, 0, 0]) {
                  size: [3.0, 4.5, 6.0], material: elder_charcoal, rotate: [6, -15, 8], blend_with: [brow_ridge_l, neck_upper]
                }
                box cheek_armor_r place(base_box=skull_core, anchor=[-0.96, -0.22, 0.14], align=[0.50, 0, 0]) {
                  size: [3.0, 4.5, 6.0], material: elder_charcoal, rotate: [6, 15, -8], blend_with: [brow_ridge_r, neck_upper]
                }
                box eye_slit_l place(base_box=skull_core, anchor=[0.98, 0.44, 0.58], align=[-0.72, 0, 0]) {
                  size: [1.0, 1.5, 2.5], material: ruiner_amber, rotate: [8, -12, 0], blend_with: [brow_ridge_l, cheek_armor_l]
                }
                box eye_slit_r place(base_box=skull_core, anchor=[-0.98, 0.44, 0.58], align=[0.72, 0, 0]) {
                  size: [1.0, 1.5, 2.5], material: ruiner_amber, rotate: [8, 12, 0], blend_with: [brow_ridge_r, cheek_armor_r]
                }

                // Brutal Bulldog-Gargoyle Wedged Snout
                box snout_core place(base_box=skull_core, anchor=[0, -0.14, 1], align=[0, 0, -0.78]) {
                  size: [5.0, 4.5, 6.0], material: obsidian_hide, rotate: [14, 0, 0], blend_with: [brow_ridge_l, brow_ridge_r, eye_slit_l, eye_slit_r]
                }
                box nasal_spike_bridge place(base_box=snout_core, anchor=[0, 0.90, 0.05], align=[0, -0.52, 0]) {
                  size: [3.5, 2.5, 6.0], material: gunmetal_iron, rotate: [8, 0, 0], blend_with: [skull_core, brow_ridge_l, brow_ridge_r]
                }
                box maxilla_wedge_l place(base_box=snout_core, anchor=[0.96, -0.10, -0.04], align=[-0.50, 0, 0]) {
                  size: [2.0, 3.5, 5.5], material: elder_charcoal, rotate: [8, -22, 8], blend_with: [skull_core, cheek_armor_l, nasal_spike_bridge, eye_slit_l]
                }
                box maxilla_wedge_r place(base_box=snout_core, anchor=[-0.96, -0.10, -0.04], align=[0.50, 0, 0]) {
                  size: [2.0, 3.5, 5.5], material: elder_charcoal, rotate: [8, 22, -8], blend_with: [skull_core, cheek_armor_r, nasal_spike_bridge, eye_slit_r]
                }
                box nose_horn_shield place(base_box=snout_core, anchor=[0, 0.25, 0.96], align=[0, -0.25, -0.62]) {
                  size: [3.0, 3.5, 3.0], material: ivory_spike, rotate: [-18, 0, 0], blend_with: [nasal_spike_bridge, maxilla_wedge_l, maxilla_wedge_r]
                }

                // GENUINELY ASYMMETRIC BULL-DEMON HORNS!
                // Left Horn (+X): Curved weathered bone-ivory bull horn
                bone horn_l attach(parent_box=skull_core, anchor=[0.90, 0.92, 0.08], align=[-0.55, -0.72, -0.75], seat=0.05) {
                  rest_euler: [-14, 46, -16]
                  box horn_l_seg_1 { size: [4.0, 4.0, 6.5], material: aged_keratin, blend_with: [brow_ridge_l, cheek_armor_l, neck_upper] }
                  bone horn_l_mid attach(parent_box=horn_l_seg_1, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.18) {
                    rest_euler: [-22, -28, 8]
                    box horn_l_seg_2 { size: [3.5, 3.5, 6.0], material: ivory_spike }
                    bone horn_l_tip attach(parent_box=horn_l_seg_2, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.18) {
                      rest_euler: [-24, -22, 8]
                      box horn_l_seg_3 { size: [2.5, 2.5, 5.5], material: ivory_spike }
                    }
                  }
                }
                // Right Horn (-X): MASSIVE battle-scarred regrown gunmetal-iron cleaver horn!
                bone horn_r attach(parent_box=skull_core, anchor=[-0.92, 0.96, -0.02], align=[0.65, -0.82, -0.65], seat=0.05) {
                  rest_euler: [-18, -40, 20]
                  box horn_r_seg_1 { size: [5.0, 5.0, 7.5], material: gunmetal_iron, blend_with: [brow_ridge_r, cheek_armor_r, neck_upper] }
                  box horn_r_regrown_spur place(base_box=horn_r_seg_1, anchor=[-0.92, 0.35, 0.25], align=[0.65, -0.35, 0]) {
                    size: [2.5, 3.0, 5.5], material: scarred_steel, rotate: [-12, -24, 18]
                  }
                  bone horn_r_mid attach(parent_box=horn_r_seg_1, anchor=[0, 0.10, 1], align=[0, 0, -1], seat=0.18) {
                    rest_euler: [-24, 24, -10]
                    box horn_r_seg_2 { size: [4.5, 5.0, 7.5], material: gunmetal_iron }
                    box horn_r_cleaver_keel place(base_box=horn_r_seg_2, anchor=[-0.45, 0.96, 0.10], align=[0.25, -0.78, 0]) {
                      size: [2.5, 2.5, 6.5], material: scarred_steel, rotate: [-8, 0, 14], blend_with: [horn_r_seg_1, horn_r_seg_3]
                    }
                    bone horn_r_tip attach(parent_box=horn_r_seg_2, anchor=[0, 0.10, 1], align=[0, 0, -1], seat=0.18) {
                      rest_euler: [-26, 20, -8]
                      box horn_r_seg_3 { size: [3.0, 3.5, 7.0], material: scarred_steel }
                    }
                  }
                }

                bone jaw attach(parent_box=skull_core, anchor=[0, -0.74, 0.20], align=[0, 0, -1], seat=0.16) {
                  rest_euler: [18, 0, 0]
                  box jaw_core { size: [5.0, 3.0, 7.5], material: elder_charcoal, blend_with: [cheek_armor_l, cheek_armor_r, snout_core] }
                  box chin_spike_plate place(base_box=jaw_core, anchor=[0, -0.92, 0.15], align=[0, 0.55, 0]) {
                    size: [4.0, 2.5, 5.5], material: ivory_spike, rotate: [-14, 0, 0], blend_with: [neck_upper]
                  }
                }
              }
            }
          }

          // Gorilla-Like Colossal Brawling Forelimbs
          bone fore_shoulder_l attach(parent_box=chest_core, anchor=[0.96, -0.18, 0.44], align=[-0.55, 0.82, 0], seat=0.12) mirror_x(fore_shoulder_r) {
            rest_euler: [20, 8, 28]
            box fore_bicep { size: [9.5, 12.0, 9.5], material: obsidian_hide }
            box pauldron_iron_plate place(base_box=fore_bicep, anchor=[0.98, 0.35, 0.08], align=[-0.52, 0, 0]) {
              size: [3.0, 7.5, 8.0], material: gunmetal_iron, rotate: [-8, 10, -14], blend_with: [chest_core]
            }
            box elbow_ivory_spike place(base_box=fore_bicep, anchor=[0.25, -0.78, -0.94], align=[0, 0, 0.68]) {
              size: [4.5, 4.5, 7.0], material: ivory_spike, rotate: [24, 0, 0], blend_with: [fore_bracer]
            }

            bone fore_arm_l attach(parent_box=fore_bicep, anchor=[0.12, -1, -0.04], align=[0, 0.88, 0], seat=0.18) {
              rest_euler: [-32, 0, -18]
              box fore_bracer { size: [9.0, 12.5, 9.0], material: elder_charcoal, blend_with: [chest_core] }
              box bracer_iron_spike_1 place(base_box=fore_bracer, anchor=[0.96, 0.52, 0.18], align=[-0.50, 0, 0.38]) {
