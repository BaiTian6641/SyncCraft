              box bracer_iron_spike_3 place(base_box=fore_bracer, anchor=[0.96, -0.46, 0.16], align=[-0.65, 0, 0.38]) {
                size: [3.0, 2.5, 7.5], material: gunmetal_iron, rotate: [22, 32, -16], blend_with: [bracer_ivory_spike_2, fore_palm]
              }

              bone fore_hand_l attach(parent_box=fore_bracer, anchor=[0, -1, 0.16], align=[0, 0.85, -0.45], seat=0.16) {
                rest_euler: [16, 0, -10]
                box fore_palm { size: [9.5, 4.0, 8.0], material: copper_underhide }
                box f_toe_1 place(base_box=fore_palm, anchor=[-0.68, -0.12, 0.92], align=[0, 0, -0.75]) {
