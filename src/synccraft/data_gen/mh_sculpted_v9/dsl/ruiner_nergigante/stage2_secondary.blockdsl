              }
              box tail_4_spike_r place(base_box=tail_4_seg, anchor=[-0.96, 0.20, -0.22], align=[0.52, 0, 0.58]) {
                size: [4.5, 4.0, 11.0], material: ivory_spike, rotate: [16, -36, 18], blend_with: [tail_3_seg, tail_3_spike_r, tail_5_seg]
              }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.08, -1], align=[0, 0, 1], seat=0.24) {
                rest_euler: [8, 0, 0]
