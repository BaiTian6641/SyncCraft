                }
                box f_toe_2 place(base_box=fore_palm, anchor=[-0.22, -0.12, 0.96], align=[0, 0, -0.78]) {
                  size: [2.0, 2.5, 5.0], material: ivory_spike, rotate: [3, 5, 0], blend_with: [f_toe_1]
                }
                box f_toe_3 place(base_box=fore_palm, anchor=[0.24, -0.12, 0.96], align=[0, 0, -0.78]) {
