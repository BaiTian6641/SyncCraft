    key tail_4.rotation { 0.0: [0, 0, 0], 0.62: [12, 34, 0], 1.18: [18, 28, 0], 1.68: [20, 24, 0], 2.6: [0, 0, 0], catmullrom }
    key tail_5.rotation { 0.0: [0, 0, 0], 0.62: [14, 32, 0], 1.18: [20, 26, 0], 1.68: [22, 22, 0], 2.6: [0, 0, 0], catmullrom }
  }

  // 10. Twin Lightning-Sphere Spit Barrage — rears cobra neck & whips head left-then-right with sharp recoil!
  clip double_lightning_spit_barrage {
    duration_s: 2.0, loop: false
    key root.position { 0.0: [0, 0, 0], 0.38: [0, 1.5, -3.5], 0.68: [0, -0.8, 3.0], 1.12: [0, 1.8, -2.5], 1.42: [0, -1.0, 4.0], 2.0: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.38: [-18, -16, 0], 0.68: [12, 22, -6], 1.12: [-20, 18, 0], 1.42: [14, -24, 6], 2.0: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.38: [-22, -18, 0], 0.68: [20, 24, 0], 1.12: [-24, 20, 0], 1.42: [22, -26, 0], 2.0: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.38: [18, -14, 0], 0.68: [-22, 18, -10], 1.12: [18, 14, 0], 1.42: [-24, -18, 10], 2.0: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.38: [-4, 0, 0], 0.64: [40, 0, 0], 0.92: [6, 0, 0], 1.38: [42, 0, 0], 2.0: [0, 0, 0], catmullrom }
    key hood_l.rotation { 0.0: [0, 0, 0], 0.68: [6, -26, 18], 1.42: [8, -28, 20], 2.0: [0, 0, 0], catmullrom }
    key hood_r.rotation { 0.0: [0, 0, 0], 0.68: [6, -26, 18], 1.42: [8, -28, 20], 2.0: [0, 0, 0], catmullrom }
  }

  // 11. Corkscrew Tidal Barrel-Roll Surge — dynamic pelagic spiral charge!
  clip corkscrew_tidal_barrel_roll {
    duration_s: 1.6, loop: false
    key root.position { 0.0: [0, 0, 0], 0.35: [-2.5, -1.5, -4.0], 0.78: [2.0, 11.5, 18.0], 1.15: [0, -1.0, 22.0], 1.6: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.35: [8, -20, -24], 0.78: [-6, 16, 115], 1.15: [6, 6, 22], 1.6: [0, 0, 0], catmullrom }
    key waist.rotation { 0.0: [0, 0, 0], 0.35: [0, 18, -14], 0.78: [0, -14, 32], 1.6: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.35: [10, 16, -18], 0.78: [8, -16, 36], 1.6: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.78: [24, 0, 18], 1.6: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.78: [-28, 0, -24], 1.6: [0, 0, 0], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [0, 0, 0], 0.78: [38, -22, -16], 1.6: [0, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [0, 0, 0], 0.78: [38, -22, -16], 1.6: [0, 0, 0], catmullrom }
    key tail_2.rotation { 0.0: [0, 0, 0], 0.78: [12, 34, 28], 1.6: [0, 0, 0], catmullrom }
    key tail_4.rotation { 0.0: [0, 0, 0], 0.78: [14, -36, 28], 1.6: [0, 0, 0], catmullrom }
  }

  // 12. Enraged Cobra-Hood Threat Display & Spire Crackle Taunt
  clip enraged_cobra_hood_taunt {
    duration_s: 2.2, loop: false
    key root.position { 0.0: [0, 0, 0], 0.55: [-2.5, 1.2, 0], 1.35: [2.5, 1.2, 0], 2.2: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.55: [-14, 16, -6], 1.35: [-14, -16, 6], 2.2: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.55: [-16, 18, 8], 1.35: [-16, -18, -8], 2.2: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.55: [-12, 16, -18], 1.35: [-12, -16, 18], 2.2: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 0.45: [28, 0, 0], 0.75: [4, 0, 0], 1.25: [32, 0, 0], 1.55: [6, 0, 0], 2.2: [0, 0, 0], catmullrom }
    key hood_l.rotation { 0.0: [0, 0, 0], 0.45: [8, -30, 24], 0.85: [4, -12, 10], 1.35: [10, -32, 26], 2.2: [0, 0, 0], catmullrom }
    key hood_r.rotation { 0.0: [0, 0, 0], 0.45: [8, -30, 24], 0.85: [4, -12, 10], 1.35: [10, -32, 26], 2.2: [0, 0, 0], catmullrom }
    key shock_spire_2_l.rotation { 0.0: [0, 0, 0], 0.55: [18, 0, -20], 1.35: [20, 0, -22], 2.2: [0, 0, 0], catmullrom }
    key shock_spire_2_r.rotation { 0.0: [0, 0, 0], 0.55: [18, 0, -20], 1.35: [20, 0, -22], 2.2: [0, 0, 0], catmullrom }
  }
}
@controller {
  initial: idle
  idle -> walk when speed > 0.12, blend 0.22
  walk -> run when speed > 0.52, blend 0.18
  run -> walk when speed <= 0.42, blend 0.22
  walk -> idle when speed <= 0.06, blend 0.25
  idle -> roar when enraged > 0.5, blend 0.16
  roar -> idle when enraged <= 0.5, blend 0.25
}
