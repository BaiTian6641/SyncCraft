// Lagiacrus (Lord of the Seas) — Stage 3 Sculpted Blockbench Masterwork (V9 Leviathan Flagship)
// Hand-authored progressive Block-DSL v4.1 modeled from official Capcom MH3 / MH Wilds references &
// @zyhfisme sculpted Blockbench style anchor: low-slung 7.6 HL marine crocodilian-plesiosaur S-coil,
// elongated wedged U-snout with interlocked conical fangs, 3-segment swept crown horns, articulated
// notched multi-lobe cobra gill-hood, 4 ranked pairs of burnt-orange & electric-cyan dorsal shock-spires,
// 4 wide-sprawled webbed amphibious paddles on Y = 0, & vertical ribbon-fin paddle tail.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 420
  budget max_bones = 96
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  sapphire_hide: ramp(base_lch=[0.46, 0.132, 244], steps=6, hue_shift=[24, -16])
  azure_scale: ramp(base_lch=[0.55, 0.125, 233], steps=6, hue_shift=[22, -14])
  deep_cobalt: ramp(base_lch=[0.31, 0.108, 254], steps=6, hue_shift=[20, -14])
  shock_orange: ramp(base_lch=[0.63, 0.162, 44], steps=6, hue_shift=[20, -14])
  terracotta_shell: ramp(base_lch=[0.47, 0.136, 36], steps=6, hue_shift=[18, -12])
  ventral_cream: ramp(base_lch=[0.84, 0.056, 86], steps=6, hue_shift=[18, -10])
  hood_membrane: ramp(base_lch=[0.65, 0.102, 222], steps=6, hue_shift=[22, -14])
  ivory_fang: ramp(base_lch=[0.90, 0.040, 88], steps=6, hue_shift=[18, -10])
  mouth_crimson: ramp(base_lch=[0.37, 0.126, 22], steps=6, hue_shift=[16, -10])
  nose_dark: ramp(base_lch=[0.21, 0.032, 248], steps=6, hue_shift=[14, -8])
  eye_amber: ramp(base_lch=[0.79, 0.168, 68], steps=6, hue_shift=[14, -12], emissive=true)
  dynamo_cyan: ramp(base_lch=[0.88, 0.168, 206], steps=6, hue_shift=[12, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    // Low-slung Leviathan pelvis hovering close to the surf, yawed into an organic marine S-coil
    bone pelvis joint(parent=ground_origin, at=[0, 10.49, -11.5]) {
      rest_euler: [2, -12, 0]
      box pelvis_core { size: [12.5, 9.5, 14.0], material: sapphire_hide }
      box pelvis_scute place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.42, 0]) {
        size: [9.5, 2.0, 12.0], material: ventral_cream
      }
      box sacrum_dynamo_ridge place(base_box=pelvis_core, anchor=[0, 0.98, -0.05], align=[0, -0.62, 0]) {
        size: [5.0, 2.0, 11.5], material: deep_cobalt, rotate: [-3, 0, 0], blend_with: [waist_core, lumbar_dynamo_ridge, tail_1_tail_seg]
      }
      box sacrum_dermal_spine place(base_box=sacrum_dynamo_ridge, anchor=[0, 0.96, -0.45], align=[0, -0.82, 0]) {
        size: [2.0, 2.5, 3.5], material: shock_orange, rotate: [-18, 0, 0], blend_with: [pelvis_core, tail_1_tail_seg, tail_1_dorsal_spine]
      }
      box haunch_mass_l place(base_box=pelvis_core, anchor=[0.98, 0.18, -0.05], align=[-0.52, 0, 0]) {
        size: [3.0, 6.5, 10.0], material: azure_scale, rotate: [4, 6, -12], blend_with: [thigh_mass, waist_core]
      }
      box haunch_mass_r place(base_box=pelvis_core, anchor=[-0.98, 0.18, -0.05], align=[0.52, 0, 0]) {
        size: [3.0, 6.5, 10.0], material: azure_scale, rotate: [4, -6, 12], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }
      box hip_shingle_l place(base_box=haunch_mass_l, anchor=[0.94, 0.58, -0.62], align=[-0.84, 0, 0.58]) {
        size: [1.5, 2.5, 4.5], material: deep_cobalt, rotate: [-10, 20, -14], blend_with: [pelvis_core, thigh_mass, thigh_plate, tail_1_tail_seg, tail_1_keel_l]
      }
      box hip_shingle_r place(base_box=haunch_mass_r, anchor=[-0.94, 0.58, -0.62], align=[0.84, 0, 0.58]) {
        size: [1.5, 2.5, 4.5], material: deep_cobalt, rotate: [-10, -20, 14], blend_with: [pelvis_core, hind_thigh_r__thigh_mass, hind_thigh_r__thigh_plate, tail_1_tail_seg, tail_1_keel_r]
      }

      // Pair 4 (Sacral) Bio-Electric Dorsal Shock-Spires
      bone shock_spire_4_l attach(parent_box=pelvis_core, anchor=[0.44, 0.96, 0.06], align=[0, -0.86, 0]) mirror_x(shock_spire_4_r) {
        rest_euler: [-28, -10, -18]
        box spire_4_base { size: [2.5, 3.5, 4.0], material: terracotta_shell, blend_with: [sacrum_dynamo_ridge, waist_core, tail_1_tail_seg] }
        box spire_4_shaft place(base_box=spire_4_base, anchor=[0, 0.95, -0.10], align=[0, -0.82, 0]) {
          size: [2.0, 5.0, 3.0], material: shock_orange, rotate: [-8, 0, -4]
        }
        box spire_4_tip place(base_box=spire_4_shaft, anchor=[0, 0.95, -0.12], align=[0, -0.85, 0]) {
          size: [1.5, 3.0, 2.0], material: terracotta_shell, rotate: [-10, 0, -4]
        }
        box spire_4_cyan_core place(base_box=spire_4_shaft, anchor=[-0.86, 0.15, 0.10], align=[0.72, 0, 0]) {
          size: [1.0, 3.5, 2.0], material: dynamo_cyan, blend_with: [spire_4_base, pelvis_core, sacrum_dynamo_ridge]
        }
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.02, 1], align=[0, 0, -1], seat=0.26) {
        rest_euler: [-2, 16, 0]
        box waist_core { size: [14.0, 10.5, 14.0], material: sapphire_hide }
        box waist_scute place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.42, 0]) {
          size: [10.5, 2.0, 12.0], material: ventral_cream, blend_with: [pelvis_scute, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_dynamo_ridge place(base_box=waist_core, anchor=[0, 0.98, 0.0], align=[0, -0.62, 0]) {
          size: [5.5, 2.0, 12.0], material: deep_cobalt, rotate: [-3, 0, 0], blend_with: [pelvis_core, chest_core, dorsal_dynamo_ridge]
        }
        box lumbar_charge_node place(base_box=lumbar_dynamo_ridge, anchor=[0, 0.96, 0.0], align=[0, -0.82, 0]) {
          size: [2.0, 1.5, 6.5], material: dynamo_cyan, blend_with: [waist_core, spire_3_base, shock_spire_3_r__spire_3_base]
        }
        box flank_plate_l place(base_box=waist_core, anchor=[0.98, 0.22, 0.05], align=[-0.62, 0, 0]) {
          size: [2.5, 6.0, 10.5], material: azure_scale, rotate: [4, 8, -12], blend_with: [chest_core, pelvis_core, haunch_mass_l]
        }
        box flank_plate_r place(base_box=waist_core, anchor=[-0.98, 0.22, 0.05], align=[0.62, 0, 0]) {
          size: [2.5, 6.0, 10.5], material: azure_scale, rotate: [4, -8, 12], blend_with: [chest_core, pelvis_core, haunch_mass_r]
        }
        box flank_shingle_l_1 place(base_box=flank_plate_l, anchor=[0.94, 0.28, 0.30], align=[-0.72, 0, 0]) {
          size: [1.5, 3.5, 4.5], material: deep_cobalt, rotate: [6, 14, -14], blend_with: [waist_core, chest_core, shoulder_mass_l]
        }
        box flank_shingle_r_1 place(base_box=flank_plate_r, anchor=[-0.94, 0.28, 0.30], align=[0.72, 0, 0]) {
          size: [1.5, 3.5, 4.5], material: deep_cobalt, rotate: [6, -14, 14], blend_with: [waist_core, chest_core, shoulder_mass_r]
        }
        box flank_shingle_l_2 place(base_box=flank_plate_l, anchor=[0.94, -0.18, -0.28], align=[-0.72, 0, 0]) {
          size: [1.5, 3.5, 4.5], material: deep_cobalt, rotate: [4, 14, -10], blend_with: [waist_core, pelvis_core, haunch_mass_l, flank_shingle_l_1]
        }
        box flank_shingle_r_2 place(base_box=flank_plate_r, anchor=[-0.94, -0.18, -0.28], align=[0.72, 0, 0]) {
          size: [1.5, 3.5, 4.5], material: deep_cobalt, rotate: [4, -14, 10], blend_with: [waist_core, pelvis_core, haunch_mass_r, flank_shingle_r_1]
        }

        // Pair 3 (Lumbar) Bio-Electric Dorsal Shock-Spires
        bone shock_spire_3_l attach(parent_box=waist_core, anchor=[0.46, 0.96, 0.04], align=[0, -0.88, 0]) mirror_x(shock_spire_3_r) {
          rest_euler: [-26, -12, -20]
          box spire_3_base { size: [3.0, 4.5, 4.5], material: terracotta_shell, blend_with: [lumbar_dynamo_ridge, chest_core, pelvis_core] }
          box spire_3_shaft place(base_box=spire_3_base, anchor=[0, 0.95, -0.10], align=[0, -0.84, 0]) {
            size: [2.5, 6.5, 3.5], material: shock_orange, rotate: [-8, 0, -5]
          }
          box spire_3_tip place(base_box=spire_3_shaft, anchor=[0, 0.95, -0.12], align=[0, -0.85, 0]) {
            size: [1.5, 3.5, 2.5], material: terracotta_shell, rotate: [-10, 0, -4]
          }
          box spire_3_outer_barb place(base_box=spire_3_base, anchor=[0.92, 0.20, -0.15], align=[-0.72, 0, 0]) {
            size: [1.5, 4.0, 2.5], material: shock_orange, rotate: [-8, -10, -18], blend_with: [waist_core, flank_plate_l]
          }
          box spire_3_cyan_core place(base_box=spire_3_shaft, anchor=[-0.86, 0.15, 0.10], align=[0.72, 0, 0]) {
            size: [1.0, 5.0, 2.0], material: dynamo_cyan, blend_with: [spire_3_base, waist_core, lumbar_dynamo_ridge]
          }
          plane spire_3_arc_plane place(base_box=spire_3_shaft, anchor=[-0.35, 0.35, -0.92], align=[0, 0, 0.85]) {
            size: [5.0, 3.0], normal: x, material: dynamo_cyan, rotate: [-8, 0, 0],
            edge: spikes(width=2, min_len=2, max_len=5, side=right, seed=71), layer: 1,
            blend_with: [spire_3_base, spire_3_tip, spire_3_cyan_core, spire_4_base, spire_4_shaft]
          }
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.26) {
          rest_euler: [-3, 10, 0]
          box chest_core { size: [16.5, 12.0, 16.0], material: sapphire_hide }
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.32], align=[0, 0.42, 0]) {
            size: [12.0, 2.0, 8.5], material: ventral_cream, rotate: [2, 0, 0], blend_with: [waist_scute]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.94, 0.56], align=[0, 0.45, -0.25]) {
            size: [11.0, 2.5, 8.0], material: ventral_cream, rotate: [-14, 0, 0], blend_with: [chest_scute_rear, neck_1_core, neck_1_scute]
          }
          box sternum_keel_plate place(base_box=chest_scute_front, anchor=[0, -0.94, 0.24], align=[0, 0.72, 0]) {
            size: [6.0, 1.5, 5.5], material: azure_scale, rotate: [-10, 0, 0], blend_with: [chest_core, neck_1_scute]
          }
          box shoulder_mass_l place(base_box=chest_core, anchor=[0.98, 0.18, 0.22], align=[-0.55, 0, 0]) {
            size: [3.0, 7.5, 10.5], material: azure_scale, rotate: [-4, 8, -14], blend_with: [fore_bicep, waist_core, flank_plate_l]
          }
          box shoulder_mass_r place(base_box=chest_core, anchor=[-0.98, 0.18, 0.22], align=[0.55, 0, 0]) {
            size: [3.0, 7.5, 10.5], material: azure_scale, rotate: [-4, -8, 14], blend_with: [fore_shoulder_r__fore_bicep, waist_core, flank_plate_r]
          }
          box rib_shingle_l_1 place(base_box=shoulder_mass_l, anchor=[0.94, 0.30, -0.22], align=[-0.72, 0, 0]) {
            size: [1.5, 4.0, 5.0], material: deep_cobalt, rotate: [-4, 14, -14], blend_with: [chest_core, fore_bicep, pauldron_plate]
          }
          box rib_shingle_r_1 place(base_box=shoulder_mass_r, anchor=[-0.94, 0.30, -0.22], align=[0.72, 0, 0]) {
            size: [1.5, 4.0, 5.0], material: deep_cobalt, rotate: [-4, -14, 14], blend_with: [chest_core, fore_shoulder_r__fore_bicep, fore_shoulder_r__pauldron_plate]
          }
          box rib_shingle_l_2 place(base_box=chest_core, anchor=[0.98, -0.18, -0.36], align=[-0.72, 0, 0]) {
            size: [2.0, 4.5, 5.5], material: deep_cobalt, rotate: [4, 12, -10], blend_with: [shoulder_mass_l, rib_shingle_l_1, waist_core, flank_plate_l, flank_shingle_l_1]
          }
          box rib_shingle_r_2 place(base_box=chest_core, anchor=[-0.98, -0.18, -0.36], align=[0.72, 0, 0]) {
            size: [2.0, 4.5, 5.5], material: deep_cobalt, rotate: [4, -12, 10], blend_with: [shoulder_mass_r, rib_shingle_r_1, waist_core, flank_plate_r, flank_shingle_r_1]
          }
          box dorsal_dynamo_ridge place(base_box=chest_core, anchor=[0, 0.98, 0.0], align=[0, -0.60, 0]) {
            size: [6.5, 2.5, 13.5], material: deep_cobalt, rotate: [-4, 0, 0], blend_with: [waist_core, neck_1_core]
          }
          box dorsal_dynamo_seam place(base_box=dorsal_dynamo_ridge, anchor=[0, 0.96, -0.05], align=[0, -0.82, 0]) {
            size: [2.5, 2.0, 9.5], material: dynamo_cyan, blend_with: [chest_core, spire_1_base, shock_spire_1_r__spire_1_base, spire_2_base, shock_spire_2_r__spire_2_base]
          }

          // Pair 1 (Anterior Thoracic) Bio-Electric Dorsal Shock-Spires
          bone shock_spire_1_l attach(parent_box=chest_core, anchor=[0.46, 0.96, 0.42], align=[0, -0.88, 0]) mirror_x(shock_spire_1_r) {
            rest_euler: [-18, -12, -20]
            box spire_1_base { size: [3.0, 4.5, 4.0], material: terracotta_shell, blend_with: [dorsal_dynamo_ridge, neck_1_core, neck_1_crest, spire_2_base] }
            box spire_1_shaft place(base_box=spire_1_base, anchor=[0, 0.95, -0.06], align=[0, -0.84, 0]) {
              size: [2.5, 6.5, 3.5], material: shock_orange, rotate: [-8, 0, -4], blend_with: [neck_1_core]
            }
            box spire_1_tip place(base_box=spire_1_shaft, anchor=[0, 0.95, -0.10], align=[0, -0.85, 0]) {
              size: [1.5, 3.5, 2.5], material: terracotta_shell, rotate: [-10, 0, -4]
            }
            box spire_1_outer_barb place(base_box=spire_1_base, anchor=[0.92, 0.22, -0.12], align=[-0.72, 0, 0]) {
              size: [1.5, 4.0, 2.5], material: shock_orange, rotate: [-6, -10, -18], blend_with: [chest_core, shoulder_mass_l, neck_1_core]
            }
            box spire_1_cyan_core place(base_box=spire_1_shaft, anchor=[-0.86, 0.18, 0.10], align=[0.72, 0, 0]) {
              size: [1.0, 5.0, 2.0], material: dynamo_cyan, blend_with: [spire_1_base, dorsal_dynamo_ridge, dorsal_dynamo_seam]
            }
            plane spire_1_arc_plane place(base_box=spire_1_shaft, anchor=[-0.88, 0.45, 0.45], align=[0, 0, -0.72]) {
              size: [4.5, 2.5], normal: x, material: dynamo_cyan, rotate: [-6, 0, 0],
              edge: spikes(width=2, min_len=2, max_len=5, side=left, seed=73), layer: 1,
              blend_with: [spire_1_base, spire_1_tip, spire_1_cyan_core]
            }
          }

          // Pair 2 (Dominant Posterior Thoracic) Bio-Electric Dorsal Shock-Spires
          bone shock_spire_2_l attach(parent_box=chest_core, anchor=[0.52, 0.96, -0.26], align=[0, -0.88, 0]) mirror_x(shock_spire_2_r) {
            rest_euler: [-26, -14, -22]
            box spire_2_base { size: [3.5, 5.5, 4.5], material: terracotta_shell, blend_with: [dorsal_dynamo_ridge, waist_core, spire_3_base] }
            box spire_2_shaft place(base_box=spire_2_base, anchor=[0, 0.95, -0.10], align=[0, -0.85, 0]) {
              size: [3.0, 9.0, 4.0], material: shock_orange, rotate: [-10, 0, -6]
            }
            box spire_2_tip place(base_box=spire_2_shaft, anchor=[0, 0.95, -0.12], align=[0, -0.86, 0]) {
              size: [2.0, 4.5, 2.5], material: terracotta_shell, rotate: [-12, 0, -4]
            }
            box spire_2_outer_fin place(base_box=spire_2_base, anchor=[0.92, 0.25, -0.18], align=[-0.65, 0, 0]) {
              size: [2.0, 6.0, 3.5], material: terracotta_shell, rotate: [-8, -12, -18], blend_with: [chest_core, shoulder_mass_l]
            }
            box spire_2_cyan_core place(base_box=spire_2_shaft, anchor=[-0.86, 0.18, 0.10], align=[0.72, 0, 0]) {
              size: [1.5, 6.5, 2.5], material: dynamo_cyan, blend_with: [spire_2_base, dorsal_dynamo_ridge, dorsal_dynamo_seam]
            }
            plane spire_2_arc_plane place(base_box=spire_2_shaft, anchor=[-0.35, 0.35, -0.94], align=[0, 0, 0.85]) {
              size: [7.5, 4.5], normal: x, material: dynamo_cyan, rotate: [-10, 0, 0],
              edge: spikes(width=2, min_len=3, max_len=7, side=right, seed=79), layer: 2,
              blend_with: [spire_2_base, spire_2_tip, spire_2_cyan_core]
            }
          }

          // Rising 3-segment plesiosaur-cobra S-neck
          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.24, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-42, -10, 0]
            box neck_1_core { size: [12.0, 10.5, 11.0], material: sapphire_hide }
            box neck_1_scute place(base_box=neck_1_core, anchor=[0, -0.96, 0.05], align=[0, 0.45, 0]) {
              size: [8.5, 2.0, 9.5], material: ventral_cream, blend_with: [chest_scute_front, chest_core]
            }
            box neck_1_crest place(base_box=neck_1_core, anchor=[0, 0.96, 0.05], align=[0, -0.65, 0]) {
              size: [3.0, 2.5, 8.0], material: shock_orange, rotate: [8, 0, 0], blend_with: [chest_core, dorsal_dynamo_ridge, neck_2_core]
            }
            box neck_1_shingle_l place(base_box=neck_1_core, anchor=[0.96, 0.16, 0.0], align=[-0.68, 0, 0]) {
              size: [2.0, 4.5, 7.5], material: azure_scale, rotate: [6, -8, -14], blend_with: [chest_core, shoulder_mass_l, neck_2_core]
            }
            box neck_1_shingle_r place(base_box=neck_1_core, anchor=[-0.96, 0.16, 0.0], align=[0.68, 0, 0]) {
              size: [2.0, 4.5, 7.5], material: azure_scale, rotate: [6, 8, 14], blend_with: [chest_core, shoulder_mass_r, neck_2_core]
            }
            plane neck_1_dorsal_fin place(base_box=neck_1_crest, anchor=[0, 0.96, 0.0], align=[0, -0.85, 0]) {
              size: [3.5, 7.5], normal: x, material: hood_membrane,
              edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=83), layer: 1,
              blend_with: [neck_1_core, neck_2_crest]
            }

            bone neck_2 attach(parent_box=neck_1_core, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.25) {
              rest_euler: [-26, -8, 0]
              box neck_2_core { size: [10.0, 9.0, 10.5], material: sapphire_hide }
              box neck_2_scute place(base_box=neck_2_core, anchor=[0, -0.96, 0.05], align=[0, 0.45, 0]) {
                size: [7.5, 2.0, 9.0], material: ventral_cream, blend_with: [neck_1_scute, neck_1_core]
              }
              box neck_2_crest place(base_box=neck_2_core, anchor=[0, 0.96, -0.05], align=[0, -0.65, 0]) {
                size: [3.0, 3.0, 8.0], material: shock_orange, rotate: [12, 0, 0], blend_with: [neck_1_core, neck_1_crest, neck_3_core]
              }
              box neck_2_shingle_l place(base_box=neck_2_core, anchor=[0.96, 0.16, 0.0], align=[-0.68, 0, 0]) {
                size: [1.5, 4.0, 7.0], material: azure_scale, rotate: [6, -8, -14], blend_with: [neck_1_core, neck_1_shingle_l, neck_3_core, hood_rib_mid, hood_web_upper, hood_rib_lower, hood_web_lower]
              }
              box neck_2_shingle_r place(base_box=neck_2_core, anchor=[-0.96, 0.16, 0.0], align=[0.68, 0, 0]) {
                size: [1.5, 4.0, 7.0], material: azure_scale, rotate: [6, 8, 14], blend_with: [neck_1_core, neck_1_shingle_r, neck_3_core, hood_r__hood_rib_mid, hood_r__hood_web_upper, hood_r__hood_rib_lower, hood_r__hood_web_lower]
              }
              plane neck_2_dorsal_fin place(base_box=neck_2_crest, anchor=[0, 0.96, 0.0], align=[0, -0.85, 0]) {
                size: [3.5, 7.5], normal: x, material: hood_membrane,
                edge: spikes(width=2, min_len=2, max_len=5, side=top, seed=89), layer: 2,
