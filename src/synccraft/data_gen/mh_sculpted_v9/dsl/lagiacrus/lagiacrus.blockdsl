                  size: [1.5, 1.5, 4.5], material: azure_scale, rotate: [0, 5, 0], blend_with: [f_toe_1]
                }
                box f_claw_2 place(base_box=f_toe_2, anchor=[0, 0.15, 0.96], align=[0, 0, -0.82]) {
                  size: [1.0, 1.0, 3.0], material: ivory_fang, rotate: [0, 0, 0], blend_with: [f_claw_1, f_paddle_web]
                }
                box f_toe_3 place(base_box=fore_paddle_pad, anchor=[0.24, 0.05, 0.96], align=[0, 0, -0.80]) {
                  size: [1.5, 1.5, 4.5], material: azure_scale, rotate: [0, -6, 0], blend_with: [f_toe_2]
                }
                box f_claw_3 place(base_box=f_toe_3, anchor=[0, 0.15, 0.96], align=[0, 0, -0.82]) {
                  size: [1.0, 1.0, 3.0], material: ivory_fang, rotate: [0, 0, 0], blend_with: [f_claw_2, f_paddle_web]
                }
                box f_toe_4 place(base_box=fore_paddle_pad, anchor=[0.70, 0.05, 0.90], align=[0, 0, -0.78]) {
                  size: [1.5, 1.5, 4.0], material: azure_scale, rotate: [0, -20, 0], blend_with: [f_toe_3]
                }
                box f_claw_4 place(base_box=f_toe_4, anchor=[0, 0.15, 0.96], align=[0, 0, -0.82]) {
                  size: [1.0, 1.0, 2.5], material: ivory_fang, rotate: [0, -4, 0], blend_with: [f_claw_3, f_paddle_web]
                }
                box f_dewclaw place(base_box=fore_paddle_pad, anchor=[-0.96, 0.25, -0.38], align=[0.72, 0, 0.35]) {
                  size: [1.5, 1.0, 3.0], material: ivory_fang, rotate: [0, -26, 0], blend_with: [fore_bracer]
                }
                plane f_paddle_web place(base_box=fore_paddle_pad, anchor=[0, 0.20, 0.92], align=[0, 0, -0.78]) {
                  size: [8.5, 4.5], normal: y, material: hood_membrane,
                  edge: scallop(bays=3, depth=3, side=bottom, seed=31), layer: 1,
                  blend_with: [f_knuckle_plate, f_toe_1, f_toe_2, f_toe_3, f_toe_4]
                }
              }
            }
          }
        }
      }

      // Wide-sprawled marine crocodilian hindlimbs (+Rz = +64 deg splays knee wide laterally!)
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.94, -0.16, -0.05], align=[-0.30, 0.86, 0], seat=0.14) mirror_x(hind_thigh_r) {
        rest_euler: [18, -12, 64]
        box thigh_mass { size: [5.5, 9.0, 6.5], material: sapphire_hide, blend_with: [waist_core, tail_1_tail_seg] }
        box thigh_plate place(base_box=thigh_mass, anchor=[0.96, 0.24, 0.05], align=[-0.55, 0, 0]) {
          size: [2.0, 5.5, 5.5], material: azure_scale, rotate: [6, -8, -10], blend_with: [pelvis_core, haunch_mass_l]
        }
        box knee_spur place(base_box=thigh_mass, anchor=[0.18, -0.78, 0.94], align=[0, 0, -0.72]) {
          size: [2.5, 2.5, 3.5], material: shock_orange, rotate: [-14, 0, 0], blend_with: [shin_mass, shin_shield]
        }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.05], align=[0, 0.86, 0], seat=0.18) {
          rest_euler: [-24, 0, -46]
          box shin_mass { size: [4.5, 6.0, 5.0], material: deep_cobalt }
          box shin_shield place(base_box=shin_mass, anchor=[0.92, 0.08, 0.12], align=[-0.62, 0, 0]) {
            size: [1.5, 4.5, 4.0], material: azure_scale, rotate: [4, 8, -8], blend_with: [thigh_mass, hind_paddle_pad]
          }
          box hock_fin_spur place(base_box=shin_mass, anchor=[0.15, 0.45, -0.94], align=[0, 0, 0.75]) {
            size: [2.0, 2.5, 4.0], material: shock_orange, rotate: [16, 0, 0], blend_with: [thigh_mass]
          }
          plane shin_swim_fringe place(base_box=shin_mass, anchor=[0.30, 0.22, -0.96], align=[0, 0, 0.88]) {
            size: [3.5, 4.0], normal: x, material: hood_membrane, rotate: [8, 12, 0],
            edge: scallop(bays=2, depth=3, side=right, seed=113), layer: 1,
            blend_with: [hock_fin_spur, shin_shield, hind_paddle_pad]
          }

          bone hind_paddle_l attach(parent_box=shin_mass, anchor=[0, -1, 0.14], align=[0, 0.86, -0.45], seat=0.16) {
            rest_euler: [4, 14, -18]
            box hind_paddle_pad { size: [7.5, 2.0, 8.5], material: deep_cobalt }
            box h_knuckle_plate place(base_box=hind_paddle_pad, anchor=[0, 0.96, 0.52], align=[0, -0.82, 0]) {
              size: [5.5, 1.0, 3.0], material: azure_scale, rotate: [8, 0, 0], blend_with: [shin_mass, shin_shield, h_toe_1, h_toe_2, h_toe_3]
            }
            box h_toe_1 place(base_box=hind_paddle_pad, anchor=[-0.62, 0.05, 0.92], align=[0, 0, -0.78]) {
              size: [1.5, 1.5, 4.0], material: azure_scale, rotate: [0, 16, 0]
            }
            box h_claw_1 place(base_box=h_toe_1, anchor=[0, 0.15, 0.96], align=[0, 0, -0.82]) {
              size: [1.0, 1.0, 2.5], material: ivory_fang, rotate: [0, 4, 0], blend_with: [h_paddle_web]
            }
            box h_toe_2 place(base_box=hind_paddle_pad, anchor=[0.0, 0.05, 0.96], align=[0, 0, -0.80]) {
              size: [1.5, 1.5, 4.5], material: azure_scale, rotate: [0, 0, 0], blend_with: [h_toe_1]
            }
            box h_claw_2 place(base_box=h_toe_2, anchor=[0, 0.15, 0.96], align=[0, 0, -0.82]) {
              size: [1.0, 1.0, 3.0], material: ivory_fang, rotate: [0, 0, 0], blend_with: [h_claw_1, h_paddle_web]
            }
            box h_toe_3 place(base_box=hind_paddle_pad, anchor=[0.62, 0.05, 0.92], align=[0, 0, -0.78]) {
              size: [1.5, 1.5, 4.0], material: azure_scale, rotate: [0, -16, 0], blend_with: [h_toe_2]
            }
            box h_claw_3 place(base_box=h_toe_3, anchor=[0, 0.15, 0.96], align=[0, 0, -0.82]) {
              size: [1.0, 1.0, 2.5], material: ivory_fang, rotate: [0, -4, 0], blend_with: [h_claw_2, h_paddle_web]
            }
            box h_heel_spur place(base_box=hind_paddle_pad, anchor=[0, 0.28, -0.96], align=[0, 0, 0.80]) {
              size: [2.0, 1.0, 3.0], material: shock_orange, rotate: [6, 0, 0], blend_with: [shin_mass]
            }
            plane h_paddle_web place(base_box=hind_paddle_pad, anchor=[0, 0.20, 0.92], align=[0, 0, -0.78]) {
              size: [7.5, 4.5], normal: y, material: hood_membrane,
              edge: scallop(bays=2, depth=3, side=bottom, seed=37), layer: 1,
              blend_with: [h_knuckle_plate, h_toe_1, h_toe_2, h_toe_3]
            }
          }
        }
      }

      // Long undulating S-coiled marine Leviathan ribbon-fin paddle tail (`tail_1..tail_6`)
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.25) {
        rest_euler: [-2, -18, 0]
        box tail_1_tail_seg { size: [10.5, 8.5, 11.5], material: sapphire_hide }
        box tail_1_scute place(base_box=tail_1_tail_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
          size: [7.5, 1.5, 10.0], material: ventral_cream, blend_with: [pelvis_scute, pelvis_core]
        }
        box tail_1_dorsal_spine place(base_box=tail_1_tail_seg, anchor=[0, 0.96, -0.05], align=[0, -0.72, 0]) {
          size: [2.5, 3.0, 6.5], material: shock_orange, rotate: [-14, 0, 0], blend_with: [pelvis_core, sacrum_dynamo_ridge, tail_2_seg]
        }
        box tail_1_keel_l place(base_box=tail_1_tail_seg, anchor=[0.96, 0.12, -0.10], align=[-0.62, 0, 0.35]) {
          size: [2.5, 3.0, 8.5], material: azure_scale, rotate: [6, 16, -10], blend_with: [pelvis_core, haunch_mass_l, tail_2_seg]
        }
        box tail_1_keel_r place(base_box=tail_1_tail_seg, anchor=[-0.96, 0.12, -0.10], align=[0.62, 0, 0.35]) {
          size: [2.5, 3.0, 8.5], material: azure_scale, rotate: [6, -16, 10], blend_with: [pelvis_core, haunch_mass_r, tail_2_seg]
        }

        bone tail_2 attach(parent_box=tail_1_tail_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.25) {
          rest_euler: [3, -22, 0]
          box tail_2_seg { size: [9.0, 8.0, 11.5], material: sapphire_hide }
          box tail_2_scute place(base_box=tail_2_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
            size: [6.0, 1.5, 10.0], material: ventral_cream, blend_with: [tail_1_scute, tail_1_tail_seg]
          }
          box tail_2_dorsal_spine place(base_box=tail_2_seg, anchor=[0, 0.96, -0.05], align=[0, -0.72, 0]) {
            size: [2.0, 3.0, 6.5], material: shock_orange, rotate: [-14, 0, 0], blend_with: [tail_1_tail_seg, tail_1_dorsal_spine, tail_3_seg]
          }
          box tail_2_keel_l place(base_box=tail_2_seg, anchor=[0.96, 0.12, -0.10], align=[-0.62, 0, 0.35]) {
            size: [2.0, 3.0, 8.5], material: azure_scale, rotate: [6, 16, -10], blend_with: [tail_1_tail_seg, tail_1_keel_l, tail_3_seg]
          }
          box tail_2_keel_r place(base_box=tail_2_seg, anchor=[-0.96, 0.12, -0.10], align=[0.62, 0, 0.35]) {
            size: [2.0, 3.0, 8.5], material: azure_scale, rotate: [6, -16, 10], blend_with: [tail_1_tail_seg, tail_1_keel_r, tail_3_seg]
          }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.25) {
            rest_euler: [6, -14, 0]
            box tail_3_seg { size: [7.5, 7.0, 11.5], material: sapphire_hide }
            box tail_3_scute place(base_box=tail_3_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
              size: [5.0, 1.5, 10.0], material: ventral_cream, blend_with: [tail_2_scute, tail_2_seg]
            }
            box tail_3_keel_l place(base_box=tail_3_seg, anchor=[0.96, 0.10, -0.10], align=[-0.68, 0, 0.35]) {
              size: [2.0, 2.5, 8.0], material: azure_scale, rotate: [6, 18, -10], blend_with: [tail_2_seg, tail_2_keel_l, tail_4_seg]
            }
            box tail_3_keel_r place(base_box=tail_3_seg, anchor=[-0.96, 0.10, -0.10], align=[0.68, 0, 0.35]) {
              size: [2.0, 2.5, 8.0], material: azure_scale, rotate: [6, -18, 10], blend_with: [tail_2_seg, tail_2_keel_r, tail_4_seg]
            }
            plane caudal_dorsal_3 place(base_box=tail_3_seg, anchor=[0, 0.96, -0.10], align=[0, -0.82, 0]) {
              size: [4.5, 10.0], normal: x, material: hood_membrane, rotate: [6, 0, 0],
              edge: spikes(width=2, min_len=3, max_len=6, side=top, seed=41), layer: 1,
              blend_with: [tail_2_seg, tail_2_dorsal_spine, tail_4_seg, caudal_dorsal_4]
            }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
              rest_euler: [8, 22, 0]
              box tail_4_seg { size: [5.0, 7.0, 11.5], material: deep_cobalt }
              box tail_4_lateral_spur_l place(base_box=tail_4_seg, anchor=[0.96, 0.08, -0.15], align=[-0.72, 0, 0.35]) {
                size: [1.5, 2.0, 7.5], material: shock_orange, rotate: [4, 18, -8], blend_with: [tail_3_seg, tail_3_keel_l, tail_5_seg]
              }
              box tail_4_lateral_spur_r place(base_box=tail_4_seg, anchor=[-0.96, 0.08, -0.15], align=[0.72, 0, 0.35]) {
                size: [1.5, 2.0, 7.5], material: shock_orange, rotate: [4, -18, 8], blend_with: [tail_3_seg, tail_3_keel_r, tail_5_seg]
              }
              plane caudal_dorsal_4 place(base_box=tail_4_seg, anchor=[0, 0.96, 0], align=[0, -0.84, 0]) {
                size: [7.5, 11.5], normal: x, material: hood_membrane, rotate: [4, 0, 0],
                edge: spikes(width=2, min_len=3, max_len=7, side=top, seed=43), layer: 2,
                blend_with: [tail_3_seg, caudal_dorsal_3, tail_5_seg, caudal_dorsal_5]
              }
              plane caudal_ventral_4 place(base_box=tail_4_seg, anchor=[0, -0.96, 0], align=[0, 0.84, 0]) {
                size: [5.0, 10.5], normal: x, material: hood_membrane, rotate: [-4, 0, 0],
                edge: scallop(bays=3, depth=3, side=bottom, seed=47), layer: 1,
                blend_with: [tail_3_seg, tail_3_scute, tail_5_seg, caudal_ventral_5]
              }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
                rest_euler: [9, 26, 0]
                box tail_5_seg { size: [3.5, 6.5, 11.5], material: deep_cobalt }
                box tail_5_lateral_spur_l place(base_box=tail_5_seg, anchor=[0.96, 0.05, -0.15], align=[-0.86, 0, 0.45]) {
                  size: [1.5, 1.5, 6.5], material: shock_orange, rotate: [4, 18, -6], blend_with: [tail_4_seg, tail_4_lateral_spur_l, tail_6_tip]
                }
                box tail_5_lateral_spur_r place(base_box=tail_5_seg, anchor=[-0.96, 0.05, -0.15], align=[0.86, 0, 0.45]) {
                  size: [1.5, 1.5, 6.5], material: shock_orange, rotate: [4, -18, 6], blend_with: [tail_4_seg, tail_4_lateral_spur_r, tail_6_tip]
                }
                box tail_5_dynamo_vein place(base_box=tail_5_seg, anchor=[0, 0.96, 0.0], align=[0, -0.82, 0]) {
                  size: [1.5, 1.5, 8.0], material: dynamo_cyan, blend_with: [caudal_dorsal_5, tail_4_seg, tail_6_tip]
                }
                plane caudal_dorsal_5 place(base_box=tail_5_seg, anchor=[0, 0.96, 0], align=[0, -0.85, 0]) {
                  size: [9.0, 11.5], normal: x, material: shock_orange, rotate: [-4, 0, 0],
                  edge: spikes(width=2, min_len=4, max_len=8, side=top, seed=53), layer: 1,
                  blend_with: [tail_4_seg, caudal_dorsal_4, tail_5_dynamo_vein, tail_6_tip, caudal_dorsal_6]
                }
                plane caudal_ventral_5 place(base_box=tail_5_seg, anchor=[0, -0.96, 0], align=[0, 0.85, 0]) {
                  size: [6.5, 11.0], normal: x, material: hood_membrane, rotate: [4, 0, 0],
                  edge: scallop(bays=3, depth=4, side=bottom, seed=59), layer: 2,
                  blend_with: [tail_4_seg, caudal_ventral_4, tail_6_tip, caudal_ventral_6]
                }

                bone tail_6 attach(parent_box=tail_5_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.22) {
                  rest_euler: [6, 18, 0]
                  box tail_6_tip { size: [2.5, 5.0, 11.0], material: deep_cobalt }
                  box tail_6_lateral_barb_l place(base_box=tail_6_tip, anchor=[0.96, 0.05, -0.25], align=[-0.78, 0, 0.35]) {
                    size: [1.5, 1.5, 6.0], material: shock_orange, rotate: [2, 20, -6], blend_with: [tail_5_seg, tail_spear_end]
                  }
                  box tail_6_lateral_barb_r place(base_box=tail_6_tip, anchor=[-0.96, 0.05, -0.25], align=[0.78, 0, 0.35]) {
                    size: [1.5, 1.5, 6.0], material: shock_orange, rotate: [2, -20, 6], blend_with: [tail_5_seg, tail_spear_end]
                  }
                  box tail_spear_end place(base_box=tail_6_tip, anchor=[0, 0.02, -0.95], align=[0, 0, 0.78]) {
                    size: [1.5, 3.0, 7.5], material: shock_orange, rotate: [2, 0, 0]
                  }
                  box tail_spear_point place(base_box=tail_spear_end, anchor=[0, 0.0, -0.96], align=[0, 0, 0.82]) {
                    size: [1.0, 1.5, 4.5], material: terracotta_shell, rotate: [2, 0, 0]
                  }
                  plane caudal_dorsal_6 place(base_box=tail_6_tip, anchor=[0, 0.96, -0.10], align=[0, -0.85, 0]) {
                    size: [8.0, 13.0], normal: x, material: shock_orange, rotate: [-14, 0, 0],
                    edge: ragged(depth=5, holes=2, side=top, seed=61), layer: 2,
                    blend_with: [tail_5_seg, caudal_dorsal_5, tail_spear_end, tail_spear_point, caudal_ventral_6]
                  }
                  plane caudal_ventral_6 place(base_box=tail_6_tip, anchor=[0, -0.96, -0.10], align=[0, 0.85, 0]) {
                    size: [6.5, 12.5], normal: x, material: hood_membrane, rotate: [14, 0, 0],
                    edge: ragged(depth=4, holes=1, side=bottom, seed=67), layer: 1,
                    blend_with: [tail_5_seg, caudal_ventral_5, tail_spear_end, tail_spear_point, caudal_dorsal_6]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
@materials {
  sapphire_hide: process(family=keratin_scales, coat=scale_rows, roughness=0.52)
  azure_scale: process(family=keratin_scales, coat=scale_rows, roughness=0.42)
  deep_cobalt: process(family=keratin_scales, coat=banded_limb, roughness=0.58)
  shock_orange: process(family=painted_metal, coat=striped, roughness=0.34)
  terracotta_shell: process(family=weathered_stone, coat=plain, roughness=0.46)
  ventral_cream: process(family=patterned_skin, coat=plain, roughness=0.66)
  hood_membrane: process(family=patterned_skin, coat=striped, roughness=0.48)
  ivory_fang: process(family=polymer_dielectric, coat=plain, roughness=0.26)
  mouth_crimson: process(family=patterned_skin, coat=plain, roughness=0.44)
  nose_dark: process(family=patterned_skin, coat=plain, roughness=0.50)
  eye_amber: process(family=thin_film_iridescence, coat=plain, roughness=0.18, emissive=0.95)
  dynamo_cyan: process(family=thin_film_iridescence, coat=plain, roughness=0.16, emissive=0.96)
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
@stamps {
  stamp leviathan_eye_glint on skull_core.east { at: [0.68, 0.36], size: [1.5, 1.0], color: eye_amber, emissive: 0.95, mirror: true }
  stamp hood_ocellus_spark on hood_rib_mid.up { at: [0.55, 0.48], size: [2.0, 1.5], color: dynamo_cyan, emissive: 0.90, mirror: true }
  stamp shoulder_bio_seam on shoulder_mass_l.east { at: [0.46, 0.44], size: [2.0, 1.0], rows: 2, spacing: 2.0, color: dynamo_cyan, emissive: 0.88, mirror: true }
}
@behavior {
  spring hood_l { stiffness: 38, damping: 6 }
  spring hood_r { stiffness: 38, damping: 6 }
  spring shock_spire_2_l { stiffness: 52, damping: 8 }
  spring shock_spire_2_r { stiffness: 52, damping: 8 }
  spring tail_6 { stiffness: 32, damping: 5 }

  // 1. Regal marine Leviathan breathing, gill-hood pulse, predatory scan & continuous sinusoidal tail wave
  clip idle {
    duration_s: 3.6, loop: true
    key root.position { 0.0: [0, 0, 0], 0.9: [0, -0.35, 0], 1.8: [0, 0.30, 0], 2.7: [0, -0.35, 0], 3.6: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.9: [2, 3, 0], 1.8: [-2, 0, 0], 2.7: [2, -3, 0], 3.6: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.9: [-3, 5, 0], 1.8: [2, 0, 0], 2.7: [-3, -5, 0], 3.6: [0, 0, 0], catmullrom }
    key neck_2.rotation { 0.0: [0, 0, 0], 0.9: [-2, 6, 2], 1.8: [2, 0, 0], 2.7: [-2, -6, -2], 3.6: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.9: [3, 8, -3], 1.8: [-3, 0, 0], 2.7: [3, -8, 3], 3.6: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 1.8: [6, 0, 0], 3.6: [0, 0, 0], catmullrom }
    key hood_l.rotation { 0.0: [0, 0, 0], 1.8: [0, -10, 6], 3.6: [0, 0, 0], catmullrom }
    key hood_r.rotation { 0.0: [0, 0, 0], 1.8: [0, -10, 6], 3.6: [0, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=9, freq_hz=0.2778, phase_deg=0)
    track tail_2: wave(axis=y, amp_deg=12, freq_hz=0.2778, phase_deg=-40)
    track tail_3: wave(axis=y, amp_deg=15, freq_hz=0.2778, phase_deg=-80)
    track tail_4: wave(axis=y, amp_deg=18, freq_hz=0.2778, phase_deg=-120)
    track tail_5: wave(axis=y, amp_deg=22, freq_hz=0.2778, phase_deg=-160)
  }

  // 2. Low-slung amphibious crocodilian prowl — wide sprawled limb strides + lateral S-wave spine undulation
  clip walk {
    duration_s: 1.8, loop: true
