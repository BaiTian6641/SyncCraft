// Lagiacrus (Lord of the Seas) — Stage 2 Secondary Anatomy, Wedged Crocodilian U-Snout, Cobra Hood & Shock-Spires
// Verified right-handed SE(3): 45 bones, < 65% sculpted overlap, 1 connected component, grounded Y = 0.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 260
  budget max_bones = 80
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  sapphire_hide: ramp(base_lch=[0.46, 0.128, 244], steps=6, hue_shift=[22, -16])
  azure_scale: ramp(base_lch=[0.54, 0.122, 234], steps=6, hue_shift=[20, -14])
  deep_cobalt: ramp(base_lch=[0.32, 0.105, 252], steps=6, hue_shift=[20, -14])
  shock_orange: ramp(base_lch=[0.62, 0.158, 44], steps=6, hue_shift=[18, -14])
  terracotta_shell: ramp(base_lch=[0.48, 0.132, 38], steps=6, hue_shift=[18, -12])
  ventral_cream: ramp(base_lch=[0.83, 0.056, 86], steps=6, hue_shift=[18, -10])
  hood_membrane: ramp(base_lch=[0.64, 0.098, 224], steps=6, hue_shift=[22, -14])
  nose_dark: ramp(base_lch=[0.22, 0.032, 248], steps=6, hue_shift=[14, -8])
  eye_amber: ramp(base_lch=[0.78, 0.165, 68], steps=6, hue_shift=[14, -12], emissive=true)
  dynamo_cyan: ramp(base_lch=[0.87, 0.165, 206], steps=6, hue_shift=[12, -16], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 10.49, -11.5]) {
      rest_euler: [2, -12, 0]
      box pelvis_core { size: [12.5, 9.5, 14.0], material: sapphire_hide }
      box pelvis_scute place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.42, 0]) {
        size: [9.5, 2.0, 12.0], material: ventral_cream
      }
      box haunch_mass_l place(base_box=pelvis_core, anchor=[0.98, 0.18, -0.05], align=[-0.52, 0, 0]) {
        size: [3.0, 6.5, 10.0], material: azure_scale, rotate: [4, 6, -12], blend_with: [thigh_mass, waist_core]
      }
      box haunch_mass_r place(base_box=pelvis_core, anchor=[-0.98, 0.18, -0.05], align=[0.52, 0, 0]) {
        size: [3.0, 6.5, 10.0], material: azure_scale, rotate: [4, -6, 12], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }

      // Pair 4 (Sacral) Bio-Electric Dorsal Shock-Spires (-Rx sweeps upward & backward!)
      bone shock_spire_4_l attach(parent_box=pelvis_core, anchor=[0.44, 0.96, 0.06], align=[0, -0.86, 0]) mirror_x(shock_spire_4_r) {
        rest_euler: [-28, -10, -18]
        box spire_4_base { size: [2.5, 3.5, 4.0], material: terracotta_shell, blend_with: [waist_core, tail_1_tail_seg] }
        box spire_4_shaft place(base_box=spire_4_base, anchor=[0, 0.95, -0.10], align=[0, -0.82, 0]) {
          size: [2.0, 5.0, 3.0], material: shock_orange, rotate: [-8, 0, -4]
        }
        box spire_4_cyan_core place(base_box=spire_4_shaft, anchor=[-0.86, 0.15, 0.10], align=[0.72, 0, 0]) {
          size: [1.0, 3.5, 2.0], material: dynamo_cyan, blend_with: [spire_4_base, pelvis_core]
        }
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.02, 1], align=[0, 0, -1], seat=0.26) {
        rest_euler: [-2, 16, 0]
        box waist_core { size: [14.0, 10.5, 14.0], material: sapphire_hide }
        box waist_scute place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.42, 0]) {
          size: [10.5, 2.0, 12.0], material: ventral_cream, blend_with: [pelvis_scute, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box flank_plate_l place(base_box=waist_core, anchor=[0.98, 0.22, 0.05], align=[-0.62, 0, 0]) {
          size: [2.5, 6.0, 10.5], material: azure_scale, rotate: [4, 8, -12], blend_with: [chest_core, pelvis_core, haunch_mass_l]
        }
        box flank_plate_r place(base_box=waist_core, anchor=[-0.98, 0.22, 0.05], align=[0.62, 0, 0]) {
          size: [2.5, 6.0, 10.5], material: azure_scale, rotate: [4, -8, 12], blend_with: [chest_core, pelvis_core, haunch_mass_r]
        }

        // Pair 3 (Lumbar) Bio-Electric Dorsal Shock-Spires
        bone shock_spire_3_l attach(parent_box=waist_core, anchor=[0.46, 0.96, 0.04], align=[0, -0.88, 0]) mirror_x(shock_spire_3_r) {
          rest_euler: [-26, -12, -20]
          box spire_3_base { size: [3.0, 4.5, 4.5], material: terracotta_shell, blend_with: [chest_core, pelvis_core] }
          box spire_3_shaft place(base_box=spire_3_base, anchor=[0, 0.95, -0.10], align=[0, -0.84, 0]) {
            size: [2.5, 6.5, 3.5], material: shock_orange, rotate: [-8, 0, -5]
          }
          box spire_3_cyan_core place(base_box=spire_3_shaft, anchor=[-0.86, 0.15, 0.10], align=[0.72, 0, 0]) {
            size: [1.0, 4.5, 2.0], material: dynamo_cyan, blend_with: [spire_3_base, waist_core]
          }
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.26) {
          rest_euler: [-3, 10, 0]
          box chest_core { size: [16.5, 12.0, 16.0], material: sapphire_hide }
          box chest_scute_rear place(base_box=chest_core, anchor=[0, -0.96, -0.32], align=[0, 0.42, 0]) {
            size: [12.0, 2.0, 8.5], material: ventral_cream, rotate: [2, 0, 0], blend_with: [waist_scute]
          }
          box chest_scute_front place(base_box=chest_core, anchor=[0, -0.94, 0.56], align=[0, 0.45, -0.25]) {
            size: [11.0, 2.5, 8.0], material: ventral_cream, rotate: [-14, 0, 0], blend_with: [chest_scute_rear, neck_1_core, neck_1_scute]
          }
          box shoulder_mass_l place(base_box=chest_core, anchor=[0.98, 0.18, 0.22], align=[-0.55, 0, 0]) {
            size: [3.0, 7.5, 10.5], material: azure_scale, rotate: [-4, 8, -14], blend_with: [fore_bicep, waist_core, flank_plate_l]
          }
          box shoulder_mass_r place(base_box=chest_core, anchor=[-0.98, 0.18, 0.22], align=[0.55, 0, 0]) {
            size: [3.0, 7.5, 10.5], material: azure_scale, rotate: [-4, -8, 14], blend_with: [fore_shoulder_r__fore_bicep, waist_core, flank_plate_r]
          }
          box dorsal_dynamo_ridge place(base_box=chest_core, anchor=[0, 0.98, 0.0], align=[0, -0.60, 0]) {
            size: [6.5, 2.5, 13.5], material: deep_cobalt, rotate: [-4, 0, 0], blend_with: [waist_core, neck_1_core]
          }

          // Pair 1 (Anterior Thoracic) Bio-Electric Dorsal Shock-Spires
          bone shock_spire_1_l attach(parent_box=chest_core, anchor=[0.46, 0.96, 0.42], align=[0, -0.88, 0]) mirror_x(shock_spire_1_r) {
            rest_euler: [-18, -12, -20]
            box spire_1_base { size: [3.0, 4.5, 4.0], material: terracotta_shell, blend_with: [dorsal_dynamo_ridge, neck_1_core, neck_1_crest, spire_2_base] }
            box spire_1_shaft place(base_box=spire_1_base, anchor=[0, 0.95, -0.06], align=[0, -0.84, 0]) {
              size: [2.5, 6.5, 3.5], material: shock_orange, rotate: [-8, 0, -4], blend_with: [neck_1_core]
            }
            box spire_1_cyan_core place(base_box=spire_1_shaft, anchor=[-0.86, 0.18, 0.10], align=[0.72, 0, 0]) {
              size: [1.0, 4.5, 2.0], material: dynamo_cyan, blend_with: [spire_1_base, dorsal_dynamo_ridge]
            }
          }

          // Pair 2 (Dominant Posterior Thoracic) Bio-Electric Dorsal Shock-Spires
          bone shock_spire_2_l attach(parent_box=chest_core, anchor=[0.52, 0.96, -0.26], align=[0, -0.88, 0]) mirror_x(shock_spire_2_r) {
            rest_euler: [-26, -14, -22]
            box spire_2_base { size: [3.5, 5.5, 4.5], material: terracotta_shell, blend_with: [dorsal_dynamo_ridge, waist_core, spire_3_base] }
            box spire_2_shaft place(base_box=spire_2_base, anchor=[0, 0.95, -0.10], align=[0, -0.85, 0]) {
              size: [3.0, 9.0, 4.0], material: shock_orange, rotate: [-10, 0, -6]
            }
            box spire_2_outer_fin place(base_box=spire_2_base, anchor=[0.92, 0.25, -0.18], align=[-0.65, 0, 0]) {
              size: [2.0, 6.0, 3.5], material: terracotta_shell, rotate: [-8, -12, -18], blend_with: [chest_core, shoulder_mass_l]
            }
            box spire_2_cyan_core place(base_box=spire_2_shaft, anchor=[-0.86, 0.18, 0.10], align=[0.72, 0, 0]) {
              size: [1.5, 6.5, 2.5], material: dynamo_cyan, blend_with: [spire_2_base, dorsal_dynamo_ridge]
            }
          }

          // Rising 3-segment plesiosaur-cobra S-neck
          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.24, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-42, -10, 0]
            box neck_1_core { size: [12.0, 10.5, 11.0], material: sapphire_hide }
            box neck_1_scute place(base_box=neck_1_core, anchor=[0, -0.96, 0.05], align=[0, 0.45, 0]) {
              size: [8.5, 2.0, 9.5], material: ventral_cream, blend_with: [chest_scute_front, chest_core]
            }
            box neck_1_crest place(base_box=neck_1_core, anchor=[0, 0.96, 0.05], align=[0, -0.65, 0]) {
              size: [3.0, 2.5, 8.0], material: shock_orange, rotate: [8, 0, 0], blend_with: [chest_core, dorsal_dynamo_ridge, neck_2_core]
            }

            bone neck_2 attach(parent_box=neck_1_core, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.25) {
              rest_euler: [-26, -8, 0]
              box neck_2_core { size: [10.0, 9.0, 10.5], material: sapphire_hide }
              box neck_2_scute place(base_box=neck_2_core, anchor=[0, -0.96, 0.05], align=[0, 0.45, 0]) {
                size: [7.5, 2.0, 9.0], material: ventral_cream, blend_with: [neck_1_scute, neck_1_core]
              }
              box neck_2_crest place(base_box=neck_2_core, anchor=[0, 0.96, -0.05], align=[0, -0.65, 0]) {
                size: [3.0, 3.0, 8.0], material: shock_orange, rotate: [12, 0, 0], blend_with: [neck_1_core, neck_1_crest, neck_3_core]
              }

              bone neck_3 attach(parent_box=neck_2_core, anchor=[0, 0.06, 1], align=[0, 0, -1], seat=0.25) {
                rest_euler: [22, -4, 0]
                box neck_3_core { size: [8.5, 8.0, 9.5], material: sapphire_hide }
                box neck_3_scute place(base_box=neck_3_core, anchor=[0, -0.96, 0.05], align=[0, 0.45, 0]) {
                  size: [6.5, 1.5, 8.0], material: ventral_cream, blend_with: [neck_2_scute, neck_2_core]
                }
                box neck_3_crest place(base_box=neck_3_core, anchor=[0, 0.96, -0.05], align=[0, -0.65, 0]) {
                  size: [2.5, 2.5, 7.5], material: shock_orange, rotate: [12, 0, 0], blend_with: [neck_2_core, neck_2_crest, skull_core]
                }

                // Articulated Notched Multi-Lobe Cobra Gill-Hood (`hood_l` -> `hood_lower_l`) fanning WIDE OUTWARD (+X / -X)!
                bone hood_l attach(parent_box=neck_3_core, anchor=[0.96, 0.16, 0.25], align=[-0.78, 0, 0], seat=0.10) mirror_x(hood_r) {
                  rest_euler: [-6, 22, 8]
                  box hood_rib_upper { size: [8.0, 1.5, 3.5], material: azure_scale, rotate: [6, -10, 14], blend_with: [skull_core, cheek_jowl_l] }
                  box hood_spine_upper place(base_box=hood_rib_upper, anchor=[0.96, 0.0, -0.10], align=[-0.82, 0, 0]) {
                    size: [3.0, 1.0, 2.0], material: shock_orange, rotate: [6, 12, 10]
                  }
                  box hood_rib_mid place(base_box=hood_rib_upper, anchor=[-0.12, -0.35, -0.92], align=[-0.35, 0.35, 0.65]) {
                    size: [8.5, 1.5, 4.0], material: deep_cobalt, rotate: [-6, 16, -6], blend_with: [neck_3_core, neck_2_core]
                  }
                  box hood_spine_mid place(base_box=hood_rib_mid, anchor=[0.96, 0.0, -0.15], align=[-0.82, 0, 0]) {
                    size: [3.0, 1.0, 2.0], material: shock_orange, rotate: [0, 18, -6]
                  }
                  plane hood_web_upper place(base_box=hood_rib_mid, anchor=[0.08, 0.10, 0.15], align=[0, 0, 0]) {
                    size: [9.5, 7.5], normal: y, material: hood_membrane,
                    edge: scallop(bays=3, depth=4, side=right, seed=17), layer: 1,
                    blend_with: [hood_rib_upper, hood_spine_upper, hood_spine_mid, skull_core, cheek_jowl_l, neck_3_core, neck_2_core]
                  }

                  bone hood_lower_l attach(parent_box=hood_rib_mid, anchor=[-0.10, -0.65, -0.88], align=[-0.48, 0.55, 0.72], seat=0.12) {
                    rest_euler: [-8, 12, -16]
                    box hood_rib_lower { size: [6.5, 1.5, 4.0], material: deep_cobalt, blend_with: [neck_3_core, neck_2_core] }
                    box hood_spine_lower place(base_box=hood_rib_lower, anchor=[0.96, 0.0, -0.15], align=[-0.82, 0, 0]) {
                      size: [2.5, 1.0, 2.0], material: shock_orange, rotate: [0, 18, -8]
                    }
                    plane hood_web_lower place(base_box=hood_rib_lower, anchor=[0.08, 0.0, 0.0], align=[0, 0, 0]) {
                      size: [7.5, 6.5], normal: y, material: hood_membrane,
                      edge: spikes(width=2, min_len=3, max_len=6, side=right, seed=23), layer: 2,
                      blend_with: [hood_rib_mid, hood_web_upper, hood_spine_lower, neck_3_core, neck_2_core, neck_1_core]
                    }
                  }
                }

                bone head attach(parent_box=neck_3_core, anchor=[0, 0.06, 1], align=[0, 0, -1], seat=0.24) {
                  rest_euler: [50, 0, 0]
                  box skull_core { size: [9.5, 6.0, 8.5], material: sapphire_hide }
                  box skull_crown place(base_box=skull_core, anchor=[0, 0.96, -0.10], align=[0, -0.65, 0]) {
                    size: [6.0, 2.0, 7.0], material: azure_scale, rotate: [5, 0, 0], blend_with: [neck_3_core, neck_3_crest, brow_ridge_l, brow_ridge_r]
                  }
                  box brow_ridge_l place(base_box=skull_core, anchor=[0.84, 0.78, 0.48], align=[-0.15, -0.52, -0.25]) {
                    size: [2.5, 2.0, 6.0], material: azure_scale, rotate: [8, -12, -16], blend_with: [skull_crown]
                  }
                  box brow_ridge_r place(base_box=skull_core, anchor=[-0.84, 0.78, 0.48], align=[0.15, -0.52, -0.25]) {
                    size: [2.5, 2.0, 6.0], material: azure_scale, rotate: [8, 12, 16], blend_with: [skull_crown]
                  }
                  box cheek_jowl_l place(base_box=skull_core, anchor=[0.98, -0.18, -0.08], align=[-0.52, 0, 0]) {
                    size: [2.5, 4.0, 6.5], material: azure_scale, rotate: [4, -14, 8], blend_with: [brow_ridge_l, neck_3_core, hood_rib_upper]
                  }
                  box cheek_jowl_r place(base_box=skull_core, anchor=[-0.98, -0.18, -0.08], align=[0.52, 0, 0]) {
                    size: [2.5, 4.0, 6.5], material: azure_scale, rotate: [4, 14, -8], blend_with: [brow_ridge_r, neck_3_core, hood_r__hood_rib_upper]
                  }
                  box eye_slit_l place(base_box=skull_core, anchor=[0.98, 0.44, 0.54], align=[-0.72, 0, 0]) {
                    size: [1.0, 1.5, 2.5], material: eye_amber, rotate: [6, -10, 0], blend_with: [brow_ridge_l, cheek_jowl_l]
                  }
                  box eye_slit_r place(base_box=skull_core, anchor=[-0.98, 0.44, 0.54], align=[0.72, 0, 0]) {
                    size: [1.0, 1.5, 2.5], material: eye_amber, rotate: [6, 10, 0], blend_with: [brow_ridge_r, cheek_jowl_r]
                  }

                  // Elongated 2-Stage Wedged Crocodilian U-Snout (`snout_taper_ratio < 0.36`)
                  box snout_base place(base_box=skull_core, anchor=[0, -0.10, 1], align=[0, 0, -0.80]) {
                    size: [5.5, 3.5, 6.5], material: sapphire_hide, rotate: [4, 0, 0], blend_with: [brow_ridge_l, brow_ridge_r, eye_slit_l, eye_slit_r]
                  }
                  box nasal_bridge_1 place(base_box=snout_base, anchor=[0, 0.92, 0.0], align=[0, -0.58, 0]) {
                    size: [3.5, 1.5, 6.5], material: azure_scale, rotate: [3, 0, 0], blend_with: [skull_core, skull_crown, brow_ridge_l, brow_ridge_r]
                  }
                  box maxilla_wedge_1_l place(base_box=snout_base, anchor=[0.96, -0.06, -0.08], align=[-0.52, 0, 0]) {
                    size: [2.0, 3.0, 6.0], material: sapphire_hide, rotate: [4, -16, 6], blend_with: [skull_core, cheek_jowl_l, eye_slit_l, nasal_bridge_1]
                  }
                  box maxilla_wedge_1_r place(base_box=snout_base, anchor=[-0.96, -0.06, -0.08], align=[0.52, 0, 0]) {
                    size: [2.0, 3.0, 6.0], material: sapphire_hide, rotate: [4, 16, -6], blend_with: [skull_core, cheek_jowl_r, eye_slit_r, nasal_bridge_1]
                  }
                  box snout_distal place(base_box=snout_base, anchor=[0, -0.04, 1], align=[0, 0, -0.82]) {
                    size: [3.5, 3.0, 6.0], material: sapphire_hide, rotate: [2, 0, 0], blend_with: [nasal_bridge_1, maxilla_wedge_1_l, maxilla_wedge_1_r]
                  }
                  box nose_tip place(base_box=snout_distal, anchor=[0, 0.16, 0.96], align=[0, 0, -0.62]) {
                    size: [3.0, 2.5, 2.5], material: nose_dark, rotate: [4, 0, 0]
                  }

                  // 3-Segment Swept Plated Crown Horns
                  bone horn_l attach(parent_box=skull_core, anchor=[0.56, 0.90, -0.10], align=[0, -0.25, 0.90], seat=0.14) mirror_x(horn_r) {
                    rest_euler: [36, -14, -12]
                    box horn_seg_1 { size: [3.0, 2.5, 5.0], material: azure_scale, blend_with: [skull_crown, brow_ridge_l] }
                    bone horn_mid_l attach(parent_box=horn_seg_1, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.22) {
                      rest_euler: [12, -4, 0]
                      box horn_seg_2 { size: [2.5, 2.0, 4.5], material: shock_orange }
                      bone horn_tip_l attach(parent_box=horn_seg_2, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.22) {
                        rest_euler: [14, -4, 0]
                        box horn_seg_3 { size: [1.5, 1.5, 4.5], material: terracotta_shell }
                      }
                    }
                  }

                  // Two-Stage Tapering Crocodilian Jaw
                  bone jaw attach(parent_box=skull_core, anchor=[0, -0.44, 0.30], align=[0, 0, -1], seat=0.18) {
                    rest_euler: [14, 0, 0]
                    box jaw_base { size: [5.0, 2.5, 6.5], material: ventral_cream, blend_with: [cheek_jowl_l, cheek_jowl_r, snout_base, neck_3_core, neck_3_scute] }
                    box jaw_distal place(base_box=jaw_base, anchor=[0, 0.04, 1], align=[0, 0, -0.82]) {
                      size: [3.0, 2.0, 6.5], material: ventral_cream, rotate: [-2, 0, 0], blend_with: [snout_base, snout_distal]
                    }
                    box chin_keel place(base_box=jaw_base, anchor=[0, -0.92, 0.05], align=[0, 0.55, 0]) {
                      size: [3.5, 1.5, 5.5], material: azure_scale, rotate: [-6, 0, 0], blend_with: [neck_3_core, neck_3_scute]
                    }
                  }
                }
              }
            }
          }

          // Wide-sprawled marine crocodilian forelimbs
          bone fore_shoulder_l attach(parent_box=chest_core, anchor=[0.94, -0.20, 0.34], align=[-0.30, 0.86, 0], seat=0.14) mirror_x(fore_shoulder_r) {
            rest_euler: [12, 10, 66]
            box fore_bicep { size: [5.5, 9.5, 6.5], material: sapphire_hide }
            box pauldron_plate place(base_box=fore_bicep, anchor=[0.96, 0.28, 0.06], align=[-0.55, 0, 0]) {
              size: [2.0, 6.0, 5.5], material: azure_scale, rotate: [-6, 8, -12], blend_with: [chest_core, shoulder_mass_l]
            }
            box elbow_fin_spur place(base_box=fore_bicep, anchor=[0.20, -0.78, -0.94], align=[0, 0, 0.72]) {
              size: [2.5, 3.0, 4.5], material: shock_orange, rotate: [18, 0, 0], blend_with: [fore_bracer]
            }

            bone fore_arm_l attach(parent_box=fore_bicep, anchor=[0.05, -1, 0], align=[0, 0.86, 0], seat=0.18) {
              rest_euler: [-22, 0, -48]
              box fore_bracer { size: [5.0, 6.5, 5.5], material: deep_cobalt, blend_with: [chest_core] }
              box bracer_shield place(base_box=fore_bracer, anchor=[0.94, 0.10, 0.12], align=[-0.62, 0, 0]) {
                size: [2.0, 5.0, 4.5], material: azure_scale, rotate: [6, 10, -10], blend_with: [fore_bicep, fore_paddle_pad]
              }

              bone fore_paddle_l attach(parent_box=fore_bracer, anchor=[0, -1, 0.14], align=[0, 0.86, -0.45], seat=0.16) {
                rest_euler: [13, -14, -18]
                box fore_paddle_pad { size: [8.0, 2.0, 8.5], material: deep_cobalt }
                box f_toe_1 place(base_box=fore_paddle_pad, anchor=[-0.68, 0.05, 0.92], align=[0, 0, -0.78]) {
                  size: [1.5, 1.5, 4.0], material: azure_scale, rotate: [0, 18, 0]
                }
                box f_toe_2 place(base_box=fore_paddle_pad, anchor=[-0.22, 0.05, 0.96], align=[0, 0, -0.80]) {
                  size: [1.5, 1.5, 4.5], material: azure_scale, rotate: [0, 5, 0], blend_with: [f_toe_1]
                }
                box f_toe_3 place(base_box=fore_paddle_pad, anchor=[0.24, 0.05, 0.96], align=[0, 0, -0.80]) {
                  size: [1.5, 1.5, 4.5], material: azure_scale, rotate: [0, -6, 0], blend_with: [f_toe_2]
                }
                box f_toe_4 place(base_box=fore_paddle_pad, anchor=[0.70, 0.05, 0.90], align=[0, 0, -0.78]) {
                  size: [1.5, 1.5, 4.0], material: azure_scale, rotate: [0, -20, 0], blend_with: [f_toe_3]
                }
                plane f_paddle_web place(base_box=fore_paddle_pad, anchor=[0, 0.20, 0.92], align=[0, 0, -0.78]) {
                  size: [8.5, 4.5], normal: y, material: hood_membrane,
                  edge: scallop(bays=3, depth=3, side=bottom, seed=31), layer: 1,
                  blend_with: [f_toe_1, f_toe_2, f_toe_3, f_toe_4]
                }
              }
            }
          }
        }
      }

      // Wide-sprawled marine crocodilian hindlimbs
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.94, -0.16, -0.05], align=[-0.30, 0.86, 0], seat=0.14) mirror_x(hind_thigh_r) {
        rest_euler: [18, -12, 64]
        box thigh_mass { size: [5.5, 9.0, 6.5], material: sapphire_hide, blend_with: [waist_core, tail_1_tail_seg] }
        box thigh_plate place(base_box=thigh_mass, anchor=[0.96, 0.24, 0.05], align=[-0.55, 0, 0]) {
          size: [2.0, 5.5, 5.5], material: azure_scale, rotate: [6, -8, -10], blend_with: [pelvis_core, haunch_mass_l]
        }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.05], align=[0, 0.86, 0], seat=0.18) {
          rest_euler: [-24, 0, -46]
          box shin_mass { size: [4.5, 6.0, 5.0], material: deep_cobalt }
          box shin_shield place(base_box=shin_mass, anchor=[0.92, 0.08, 0.12], align=[-0.62, 0, 0]) {
            size: [1.5, 4.5, 4.0], material: azure_scale, rotate: [4, 8, -8], blend_with: [thigh_mass, hind_paddle_pad]
          }

          bone hind_paddle_l attach(parent_box=shin_mass, anchor=[0, -1, 0.14], align=[0, 0.86, -0.45], seat=0.16) {
            rest_euler: [4, 14, -18]
            box hind_paddle_pad { size: [7.5, 2.0, 8.5], material: deep_cobalt }
            box h_toe_1 place(base_box=hind_paddle_pad, anchor=[-0.62, 0.05, 0.92], align=[0, 0, -0.78]) {
              size: [1.5, 1.5, 4.0], material: azure_scale, rotate: [0, 16, 0]
            }
            box h_toe_2 place(base_box=hind_paddle_pad, anchor=[0.0, 0.05, 0.96], align=[0, 0, -0.80]) {
              size: [1.5, 1.5, 4.5], material: azure_scale, rotate: [0, 0, 0], blend_with: [h_toe_1]
            }
            box h_toe_3 place(base_box=hind_paddle_pad, anchor=[0.62, 0.05, 0.92], align=[0, 0, -0.78]) {
              size: [1.5, 1.5, 4.0], material: azure_scale, rotate: [0, -16, 0], blend_with: [h_toe_2]
            }
            plane h_paddle_web place(base_box=hind_paddle_pad, anchor=[0, 0.20, 0.92], align=[0, 0, -0.78]) {
              size: [7.5, 4.5], normal: y, material: hood_membrane,
              edge: scallop(bays=2, depth=3, side=bottom, seed=37), layer: 1,
              blend_with: [h_toe_1, h_toe_2, h_toe_3]
            }
          }
        }
      }

      // Long undulating S-coiled marine Leviathan ribbon-fin paddle tail (`tail_1..tail_6`)
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.25) {
        rest_euler: [-2, -18, 0]
        box tail_1_tail_seg { size: [10.5, 8.5, 11.5], material: sapphire_hide }
        box tail_1_scute place(base_box=tail_1_tail_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
          size: [7.5, 1.5, 10.0], material: ventral_cream, blend_with: [pelvis_scute, pelvis_core]
        }
        box tail_1_keel_l place(base_box=tail_1_tail_seg, anchor=[0.96, 0.12, -0.10], align=[-0.62, 0, 0.35]) {
          size: [2.5, 3.0, 8.5], material: azure_scale, rotate: [6, 16, -10], blend_with: [pelvis_core, haunch_mass_l, tail_2_seg]
        }
        box tail_1_keel_r place(base_box=tail_1_tail_seg, anchor=[-0.96, 0.12, -0.10], align=[0.62, 0, 0.35]) {
          size: [2.5, 3.0, 8.5], material: azure_scale, rotate: [6, -16, 10], blend_with: [pelvis_core, haunch_mass_r, tail_2_seg]
        }

        bone tail_2 attach(parent_box=tail_1_tail_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.25) {
          rest_euler: [3, -22, 0]
          box tail_2_seg { size: [9.0, 8.0, 11.5], material: sapphire_hide }
          box tail_2_scute place(base_box=tail_2_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
            size: [6.0, 1.5, 10.0], material: ventral_cream, blend_with: [tail_1_scute, tail_1_tail_seg]
          }
          box tail_2_keel_l place(base_box=tail_2_seg, anchor=[0.96, 0.12, -0.10], align=[-0.62, 0, 0.35]) {
            size: [2.0, 3.0, 8.5], material: azure_scale, rotate: [6, 16, -10], blend_with: [tail_1_tail_seg, tail_1_keel_l, tail_3_seg]
          }
          box tail_2_keel_r place(base_box=tail_2_seg, anchor=[-0.96, 0.12, -0.10], align=[0.62, 0, 0.35]) {
            size: [2.0, 3.0, 8.5], material: azure_scale, rotate: [6, -16, 10], blend_with: [tail_1_tail_seg, tail_1_keel_r, tail_3_seg]
          }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.25) {
            rest_euler: [6, -14, 0]
            box tail_3_seg { size: [7.5, 7.0, 11.5], material: sapphire_hide }
            box tail_3_scute place(base_box=tail_3_seg, anchor=[0, -0.96, 0], align=[0, 0.45, 0]) {
              size: [5.0, 1.5, 10.0], material: ventral_cream, blend_with: [tail_2_scute, tail_2_seg]
            }
            plane caudal_dorsal_3 place(base_box=tail_3_seg, anchor=[0, 0.96, -0.10], align=[0, -0.82, 0]) {
              size: [4.5, 10.0], normal: x, material: hood_membrane, rotate: [6, 0, 0],
              edge: spikes(width=2, min_len=3, max_len=6, side=top, seed=41), layer: 1,
              blend_with: [tail_2_seg, tail_4_seg, caudal_dorsal_4]
            }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
              rest_euler: [8, 22, 0]
              box tail_4_seg { size: [5.0, 7.0, 11.5], material: deep_cobalt }
              plane caudal_dorsal_4 place(base_box=tail_4_seg, anchor=[0, 0.96, 0], align=[0, -0.84, 0]) {
                size: [7.0, 11.5], normal: x, material: hood_membrane, rotate: [4, 0, 0],
                edge: spikes(width=2, min_len=3, max_len=7, side=top, seed=43), layer: 2,
                blend_with: [tail_3_seg, caudal_dorsal_3, tail_5_seg, caudal_dorsal_5]
              }
              plane caudal_ventral_4 place(base_box=tail_4_seg, anchor=[0, -0.96, 0], align=[0, 0.84, 0]) {
                size: [4.5, 10.5], normal: x, material: hood_membrane, rotate: [-4, 0, 0],
                edge: scallop(bays=3, depth=3, side=bottom, seed=47), layer: 1,
                blend_with: [tail_3_seg, tail_3_scute, tail_5_seg, caudal_ventral_5]
              }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
                rest_euler: [9, 26, 0]
                box tail_5_seg { size: [3.5, 6.5, 11.5], material: deep_cobalt }
                plane caudal_dorsal_5 place(base_box=tail_5_seg, anchor=[0, 0.96, 0], align=[0, -0.85, 0]) {
                  size: [8.5, 11.5], normal: x, material: shock_orange, rotate: [-4, 0, 0],
                  edge: spikes(width=2, min_len=4, max_len=8, side=top, seed=53), layer: 1,
                  blend_with: [tail_4_seg, caudal_dorsal_4, tail_6_tip, caudal_dorsal_6]
                }
                plane caudal_ventral_5 place(base_box=tail_5_seg, anchor=[0, -0.96, 0], align=[0, 0.85, 0]) {
                  size: [6.0, 11.0], normal: x, material: hood_membrane, rotate: [4, 0, 0],
                  edge: scallop(bays=3, depth=4, side=bottom, seed=59), layer: 2,
                  blend_with: [tail_4_seg, caudal_ventral_4, tail_6_tip, caudal_ventral_6]
                }

                bone tail_6 attach(parent_box=tail_5_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.22) {
                  rest_euler: [6, 18, 0]
                  box tail_6_tip { size: [2.5, 5.0, 11.0], material: deep_cobalt }
                  box tail_spear_end place(base_box=tail_6_tip, anchor=[0, 0.02, -0.95], align=[0, 0, 0.78]) {
                    size: [1.5, 3.0, 7.5], material: shock_orange, rotate: [2, 0, 0]
                  }
                  plane caudal_dorsal_6 place(base_box=tail_6_tip, anchor=[0, 0.96, -0.10], align=[0, -0.85, 0]) {
                    size: [7.5, 13.0], normal: x, material: shock_orange, rotate: [-14, 0, 0],
                    edge: ragged(depth=5, holes=2, side=top, seed=61), layer: 2,
                    blend_with: [tail_5_seg, caudal_dorsal_5, tail_spear_end, caudal_ventral_6]
                  }
                  plane caudal_ventral_6 place(base_box=tail_6_tip, anchor=[0, -0.96, -0.10], align=[0, 0.85, 0]) {
                    size: [6.0, 12.5], normal: x, material: hood_membrane, rotate: [14, 0, 0],
                    edge: ragged(depth=4, holes=1, side=bottom, seed=67), layer: 1,
                    blend_with: [tail_5_seg, caudal_ventral_5, tail_spear_end, caudal_dorsal_6]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
