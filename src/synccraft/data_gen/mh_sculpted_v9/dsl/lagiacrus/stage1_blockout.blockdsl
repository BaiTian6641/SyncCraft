// Lagiacrus (Lord of the Seas) — Stage 1 Primary Masses & Marine Leviathan S-Curve Blockout
// Verified right-handed SE(3): low-slung belly (Y ~ 9.8u), +Rz splays +X amphibious paddles wide outward onto Y = 0.
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 128
  budget max_bones = 64
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  sapphire_hide: ramp(base_lch=[0.46, 0.128, 244], steps=6, hue_shift=[22, -16])
  deep_cobalt: ramp(base_lch=[0.32, 0.105, 252], steps=6, hue_shift=[20, -14])
  shock_orange: ramp(base_lch=[0.62, 0.158, 44], steps=6, hue_shift=[18, -14])
  ventral_cream: ramp(base_lch=[0.83, 0.056, 86], steps=6, hue_shift=[18, -10])
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    // Low-slung Leviathan pelvis hovering low over the surf, yawed into an organic marine S-coil
    bone pelvis joint(parent=ground_origin, at=[0, 10.49, -11.5]) {
      rest_euler: [2, -12, 0]
      box pelvis_core { size: [12.5, 9.5, 14.0], material: sapphire_hide }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.02, 1], align=[0, 0, -1], seat=0.26) {
        rest_euler: [-2, 16, 0]
        box waist_core { size: [14.0, 10.5, 14.0], material: sapphire_hide }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.05, 1], align=[0, 0, -1], seat=0.26) {
          rest_euler: [-3, 10, 0]
          box chest_core { size: [16.5, 12.0, 16.0], material: sapphire_hide }

          // Primary thoracic dorsal bio-electric shock-spire blockout pair (-Rx sweeps upward & backward!)
          bone shock_spire_2_l attach(parent_box=chest_core, anchor=[0.46, 0.96, -0.18], align=[0, -0.88, 0]) mirror_x(shock_spire_2_r) {
            rest_euler: [-26, -12, -20]
            box spire_2_shaft { size: [3.0, 11.5, 4.5], material: shock_orange }
          }

          // Rising 3-segment plesiosaur-cobra S-neck sweeping proudly skyward then arching forward
          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.24, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-42, -10, 0]
            box neck_1_core { size: [12.0, 10.5, 11.0], material: sapphire_hide }

            bone neck_2 attach(parent_box=neck_1_core, anchor=[0, 0.08, 1], align=[0, 0, -1], seat=0.25) {
              rest_euler: [-26, -8, 0]
              box neck_2_core { size: [10.0, 9.0, 10.5], material: sapphire_hide }

              bone neck_3 attach(parent_box=neck_2_core, anchor=[0, 0.06, 1], align=[0, 0, -1], seat=0.25) {
                rest_euler: [22, -4, 0]
                box neck_3_core { size: [8.5, 8.0, 9.5], material: sapphire_hide }

                bone head attach(parent_box=neck_3_core, anchor=[0, 0.06, 1], align=[0, 0, -1], seat=0.24) {
                  rest_euler: [50, 0, 0]
                  box skull_core { size: [9.5, 6.0, 8.5], material: sapphire_hide }
                  box snout_base place(base_box=skull_core, anchor=[0, -0.10, 1], align=[0, 0, -0.80]) {
                    size: [6.0, 3.5, 6.5], material: sapphire_hide, rotate: [4, 0, 0]
                  }
                  box snout_distal place(base_box=snout_base, anchor=[0, -0.04, 1], align=[0, 0, -0.82]) {
                    size: [3.5, 3.0, 6.0], material: sapphire_hide, rotate: [2, 0, 0]
                  }

                  // Swept-back plated crown horns rising prominently behind the brows
                  bone horn_l attach(parent_box=skull_core, anchor=[0.56, 0.90, -0.10], align=[0, -0.25, 0.90], seat=0.14) mirror_x(horn_r) {
                    rest_euler: [38, -14, -12]
                    box horn_seg_1 { size: [2.5, 2.5, 10.5], material: shock_orange }
                  }

                  // Articulated cobra gill-hood fanning wide outward & down along upper neck
                  bone hood_l attach(parent_box=skull_core, anchor=[0.95, 0.15, -0.35], align=[-0.88, 0.15, 0.35], seat=0.12) mirror_x(hood_r) {
                    rest_euler: [-18, 22, -28]
                    box hood_rib_main { size: [8.5, 2.0, 10.0], material: deep_cobalt, blend_with: [neck_3_core, neck_2_core] }
                  }

                  // Tightly hinged crocodilian mandible (zero floating gap!)
                  bone jaw attach(parent_box=skull_core, anchor=[0, -0.44, 0.30], align=[0, 0, -1], seat=0.18) {
                    rest_euler: [14, 0, 0]
                    box jaw_base { size: [5.0, 2.5, 12.5], material: ventral_cream, blend_with: [snout_base, neck_3_core] }
                  }
                }
              }
            }
          }

          // Wide-sprawled marine crocodilian forelimbs (+Rz = +66 deg splays elbow wide laterally!)
          bone fore_shoulder_l attach(parent_box=chest_core, anchor=[0.94, -0.20, 0.34], align=[-0.30, 0.86, 0], seat=0.14) mirror_x(fore_shoulder_r) {
            rest_euler: [12, 10, 66]
            box fore_bicep { size: [5.5, 9.5, 6.5], material: sapphire_hide }

            bone fore_arm_l attach(parent_box=fore_bicep, anchor=[0.05, -1, 0], align=[0, 0.86, 0], seat=0.18) {
              rest_euler: [-22, 0, -48]
              box fore_bracer { size: [5.0, 6.5, 5.5], material: deep_cobalt, blend_with: [chest_core] }

              bone fore_paddle_l attach(parent_box=fore_bracer, anchor=[0, -1, 0.14], align=[0, 0.86, -0.45], seat=0.16) {
                rest_euler: [13, -14, -18]
                box fore_paddle_pad { size: [8.0, 2.0, 9.0], material: deep_cobalt }
              }
            }
          }
        }
      }

      // Wide-sprawled marine crocodilian hindlimbs (+Rz = +64 deg splays knee wide laterally!)
      bone hind_thigh_l attach(parent_box=pelvis_core, anchor=[0.94, -0.16, -0.05], align=[-0.30, 0.86, 0], seat=0.14) mirror_x(hind_thigh_r) {
        rest_euler: [18, -12, 64]
        box thigh_mass { size: [5.5, 9.0, 6.5], material: sapphire_hide, blend_with: [waist_core, tail_1_tail_seg] }

        bone hind_shin_l attach(parent_box=thigh_mass, anchor=[0.05, -1, -0.05], align=[0, 0.86, 0], seat=0.18) {
          rest_euler: [-24, 0, -46]
          box shin_mass { size: [4.5, 6.0, 5.0], material: deep_cobalt }

          bone hind_paddle_l attach(parent_box=shin_mass, anchor=[0, -1, 0.14], align=[0, 0.86, -0.45], seat=0.16) {
            rest_euler: [4, 14, -18]
            box hind_paddle_pad { size: [7.5, 2.0, 9.0], material: deep_cobalt }
          }
        }
      }

      // Long undulating S-coiled marine Leviathan tail (`tail_1..tail_6`)
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.25) {
        rest_euler: [-2, -18, 0]
        box tail_1_tail_seg { size: [10.5, 8.5, 11.5], material: sapphire_hide }

        bone tail_2 attach(parent_box=tail_1_tail_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.25) {
          rest_euler: [3, -22, 0]
          box tail_2_seg { size: [9.0, 8.0, 11.5], material: sapphire_hide }

          bone tail_3 attach(parent_box=tail_2_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.25) {
            rest_euler: [6, -14, 0]
            box tail_3_seg { size: [7.5, 7.5, 11.5], material: sapphire_hide }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
              rest_euler: [8, 22, 0]
              box tail_4_seg { size: [5.0, 8.5, 11.5], material: deep_cobalt }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.24) {
                rest_euler: [9, 26, 0]
                box tail_5_seg { size: [3.5, 9.0, 11.5], material: deep_cobalt }

                bone tail_6 attach(parent_box=tail_5_seg, anchor=[0, 0.04, -1], align=[0, 0, 1], seat=0.22) {
                  rest_euler: [6, 18, 0]
                  box tail_6_tip { size: [2.5, 8.0, 12.0], material: shock_orange }
                }
              }
            }
          }
        }
      }
    }
  }
}
