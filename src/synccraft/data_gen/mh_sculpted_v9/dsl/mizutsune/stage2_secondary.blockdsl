              size: [1.5, 2.0, 3.5], material: pearl_cream, rotate: [3, 14, 0]
            }
            box h_toe_2 place(base_box=hind_paw_pad, anchor=[0.0, -0.10, 0.96], align=[0, 0, -0.80]) {
              size: [1.5, 2.0, 4.0], material: pearl_cream, rotate: [3, 0, 0], blend_with: [h_toe_1]
            }
            box h_toe_3 place(base_box=hind_paw_pad, anchor=[0.62, -0.10, 0.94], align=[0, 0, -0.78]) {
              size: [1.5, 2.0, 3.5], material: pearl_cream, rotate: [3, -14, 0], blend_with: [h_toe_2]
            }
          }
        }
      }

      // Signature HUGE, Voluminous Upward-Sweeping & Curling Fox-Brush Tail (`tail_1..tail_6`)
      bone tail_1 attach(parent_box=pelvis_core, anchor=[0, 0.16, -1], align=[0, 0, 1], seat=0.24) {
        rest_euler: [14, 10, 0]
        box tail_1_seg { size: [9.0, 8.0, 9.5], material: pearl_cream }
        box tail_1_ventral_fur place(base_box=tail_1_seg, anchor=[0, -0.96, 0], align=[0, 0.48, 0]) {
          size: [7.5, 2.5, 8.5], material: plum_fur, blend_with: [pelvis_core, pelvis_belly_fur, tail_2_seg, tail_2_ventral_fur]
        }
        box tail_1_dorsal_fin place(base_box=tail_1_seg, anchor=[0, 0.96, -0.05], align=[0, -0.82, 0.30]) {
          size: [1.5, 5.5, 6.5], material: sakura_pink, rotate: [24, 0, 0], blend_with: [pelvis_core, sacrum_scale_ridge, pelvis_petal_spine, tail_2_seg]
        }

        bone tail_2 attach(parent_box=tail_1_seg, anchor=[0, 0.10, -1], align=[0, 0, 1], seat=0.24) {
          rest_euler: [24, 12, 0]
