              size: [9.5, 4.5, 10.5], material: plum_fur, rotate: [-10, 0, 0], blend_with: [tail_2_seg, tail_2_ventral_fur, tail_4_seg, tail_4_ventral_fur]
            }
            box tail_3_fur_l place(base_box=tail_3_seg, anchor=[0.96, -0.05, -0.18], align=[-0.52, 0, 0.48]) {
              size: [4.5, 7.5, 11.0], material: violet_silk, rotate: [12, 26, -16], blend_with: [tail_2_seg, tail_2_fur_l, tail_4_seg, tail_4_fur_l]
            }
            box tail_3_fur_r place(base_box=tail_3_seg, anchor=[-0.96, -0.05, -0.18], align=[0.52, 0, 0.48]) {
              size: [4.5, 7.5, 11.0], material: violet_silk, rotate: [12, -26, 16], blend_with: [tail_2_seg, tail_2_fur_r, tail_4_seg, tail_4_fur_r]
            }
            box tail_3_dorsal_fin place(base_box=tail_3_seg, anchor=[0, 0.96, -0.05], align=[0, -0.82, 0.30]) {
