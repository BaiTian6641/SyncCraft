          box tail_2_ventral_fur place(base_box=tail_2_seg, anchor=[0, -0.96, -0.05], align=[0, 0.45, 0]) {
            size: [8.5, 3.5, 9.5], material: plum_fur, rotate: [-8, 0, 0], blend_with: [tail_1_seg, tail_1_ventral_fur, tail_3_seg, tail_3_ventral_fur]
