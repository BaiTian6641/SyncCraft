// Mizutsune (Bewitching Bubblefox Leviathan) — Stage 3 Sculpted Blockbench Masterwork (V9)
// Hand-authored progressive Block-DSL v4.1 modeled from official Monster Hunter anatomy & @zyhfisme
// sculpted Blockbench style anchors: ultra-slender 3D wedged pearl-cream fox rostrum (<0.30 taper),
// golden-amber slit eyes, trailing carp-fox whisker barbels, 6 blooming orchid/iris-petal head-fin
// crests with violet-and-gold eye-spot ocelli, lush royal-violet throat/chest silky fur ruffs,
// undulating dorsal sakura-pink petal sails, agile low-slung fox-leviathan paws on Y=0, and
// Mizutsune's colossal upward-curling dark-violet & sakura fox-brush tail!
@meta {
  dsl_version: "4.1",
  archetype: entity,
  target_profile: bbmodel_5,
  texel_density: 32,
  size_step: 0.5,
  audit_profile: sculpted
}
@layout {
  budget max_boxes = 420
  budget max_bones = 96
  envelope grounded = true
  envelope ground_y = 0.0
  envelope ground_tol = 0.25
}
@palette {
  pearl_cream: ramp(base_lch=[0.89, 0.038, 74], steps=6, hue_shift=[22, -12])
  sakura_scale: ramp(base_lch=[0.78, 0.114, 358], steps=6, hue_shift=[20, -14])
  sakura_pink: ramp(base_lch=[0.69, 0.160, 350], steps=6, hue_shift=[22, -14])
  orchid_magenta: ramp(base_lch=[0.54, 0.175, 342], steps=6, hue_shift=[18, -14])
  plum_fur: ramp(base_lch=[0.29, 0.118, 308], steps=6, hue_shift=[18, -14])
  violet_silk: ramp(base_lch=[0.41, 0.134, 316], steps=6, hue_shift=[20, -14])
  iris_gold: ramp(base_lch=[0.80, 0.146, 84], steps=6, hue_shift=[18, -12])
  ivory_claw: ramp(base_lch=[0.87, 0.052, 84], steps=6, hue_shift=[18, -10])
  mouth_rose: ramp(base_lch=[0.42, 0.132, 12], steps=6, hue_shift=[16, -10])
  nose_rose: ramp(base_lch=[0.28, 0.068, 345], steps=6, hue_shift=[14, -10])
  amber_glow: ramp(base_lch=[0.85, 0.168, 78], steps=6, hue_shift=[12, -16], emissive=true)
  bubble_aqua: ramp(base_lch=[0.86, 0.128, 214], steps=6, hue_shift=[16, -14], emissive=true)
}
@rig {
  root bone root {
    pivot_local: [0, 0, 0]
    locator ground_origin { offset: [0, 0, 0] }

    bone pelvis joint(parent=ground_origin, at=[0, 15.17, -12.5]) {
      rest_euler: [7, -6, 0]
      box pelvis_core { size: [10.5, 9.0, 12.5], material: pearl_cream }
      box pelvis_belly_fur place(base_box=pelvis_core, anchor=[0, -0.96, 0], align=[0, 0.42, 0]) {
        size: [8.5, 2.0, 10.5], material: plum_fur, blend_with: [waist_belly_fur, tail_1_seg, tail_1_ventral_fur]
      }
      box sacrum_scale_ridge place(base_box=pelvis_core, anchor=[0, 0.96, -0.05], align=[0, -0.58, 0]) {
        size: [6.0, 2.0, 10.0], material: sakura_scale, rotate: [6, 0, 0], blend_with: [waist_core, lumbar_ridge, tail_1_seg]
      }
      box pelvis_petal_spine place(base_box=sacrum_scale_ridge, anchor=[0, 0.96, -0.15], align=[0, -0.82, 0.30]) {
        size: [1.5, 5.0, 6.5], material: sakura_pink, rotate: [28, 0, 0], blend_with: [pelvis_core, tail_1_seg, tail_1_dorsal_fin]
      }
      box pelvis_fin_tip place(base_box=pelvis_petal_spine, anchor=[0, 0.96, -0.22], align=[0, -0.82, 0.35]) {
        size: [1.0, 2.5, 3.5], material: iris_gold, rotate: [12, 0, 0]
      }
      plane pelvis_petal_fin_l place(base_box=sacrum_scale_ridge, anchor=[0.24, 0.96, -0.15], align=[0, -0.88, 0.25]) {
        size: [5.5, 7.0], normal: x, material: sakura_pink, rotate: [16, 0, -12],
        edge: scallop(bays=2, depth=3, side=top, seed=11), layer: 1,
        blend_with: [pelvis_petal_spine, pelvis_fin_tip, pelvis_core, tail_1_dorsal_fin, waist_fin_spar_2]
      }
      plane pelvis_petal_fin_r place(base_box=sacrum_scale_ridge, anchor=[-0.24, 0.96, -0.15], align=[0, -0.88, 0.25]) {
        size: [5.5, 7.0], normal: x, material: sakura_pink, rotate: [16, 0, 12],
        edge: scallop(bays=2, depth=3, side=top, seed=11), layer: 2,
        blend_with: [pelvis_petal_spine, pelvis_fin_tip, pelvis_core, tail_1_dorsal_fin, waist_fin_spar_2, pelvis_petal_fin_l]
      }
      box haunch_muscle_l place(base_box=pelvis_core, anchor=[0.96, 0.18, -0.05], align=[-0.52, 0, 0]) {
        size: [3.0, 6.5, 8.5], material: sakura_scale, rotate: [5, 8, -12], blend_with: [thigh_mass, waist_core]
      }
      box haunch_muscle_r place(base_box=pelvis_core, anchor=[-0.96, 0.18, -0.05], align=[0.52, 0, 0]) {
        size: [3.0, 6.5, 8.5], material: sakura_scale, rotate: [5, -8, 12], blend_with: [hind_thigh_r__thigh_mass, waist_core]
      }
      box hip_shingle_l place(base_box=haunch_muscle_l, anchor=[0.94, 0.38, -0.28], align=[-0.72, 0, 0.35]) {
        size: [1.5, 3.0, 5.5], material: sakura_pink, rotate: [12, 20, -14], blend_with: [pelvis_core, thigh_mass, thigh_fur_wedge, tail_1_seg]
      }
      box hip_shingle_r place(base_box=haunch_muscle_r, anchor=[-0.94, 0.38, -0.28], align=[0.72, 0, 0.35]) {
        size: [1.5, 3.0, 5.5], material: sakura_pink, rotate: [12, -20, 14], blend_with: [pelvis_core, hind_thigh_r__thigh_mass, hind_thigh_r__thigh_fur_wedge, tail_1_seg]
      }

      bone waist attach(parent_box=pelvis_core, anchor=[0, 0.04, 1], align=[0, 0, -1], seat=0.26) {
        rest_euler: [-9, 8, 0]
        box waist_core { size: [10.0, 8.5, 13.0], material: pearl_cream }
        box waist_belly_fur place(base_box=waist_core, anchor=[0, -0.96, 0], align=[0, 0.42, 0]) {
          size: [8.0, 2.0, 11.0], material: plum_fur, blend_with: [pelvis_belly_fur, pelvis_core, chest_fur_rear, thigh_mass, hind_thigh_r__thigh_mass]
        }
        box lumbar_ridge place(base_box=waist_core, anchor=[0, 0.96, 0], align=[0, -0.55, 0]) {
          size: [6.0, 2.0, 11.0], material: sakura_scale, rotate: [-5, 0, 0], blend_with: [pelvis_core, chest_core, withers_scale_cap]
        }
        box waist_scale_l_1 place(base_box=waist_core, anchor=[0.98, 0.28, 0.24], align=[-0.68, 0, 0]) {
          size: [1.5, 3.5, 5.0], material: sakura_scale, rotate: [6, 12, -12], blend_with: [chest_core, lumbar_ridge]
        }
        box waist_scale_r_1 place(base_box=waist_core, anchor=[-0.98, 0.28, 0.24], align=[0.68, 0, 0]) {
          size: [1.5, 3.5, 5.0], material: sakura_scale, rotate: [6, -12, 12], blend_with: [chest_core, lumbar_ridge]
        }
        box waist_scale_l_2 place(base_box=waist_core, anchor=[0.98, 0.22, -0.26], align=[-0.68, 0, 0]) {
          size: [1.5, 3.5, 5.0], material: pearl_cream, rotate: [8, 14, -10], blend_with: [waist_scale_l_1, pelvis_core, haunch_muscle_l]
        }
        box waist_scale_r_2 place(base_box=waist_core, anchor=[-0.98, 0.22, -0.26], align=[0.68, 0, 0]) {
          size: [1.5, 3.5, 5.0], material: pearl_cream, rotate: [8, -14, 10], blend_with: [waist_scale_r_1, pelvis_core, haunch_muscle_r]
        }
        box waist_fur_fringe_l place(base_box=waist_core, anchor=[0.96, -0.45, -0.05], align=[-0.62, 0.25, 0]) {
          size: [2.5, 3.5, 9.5], material: violet_silk, rotate: [6, 10, -18], blend_with: [waist_belly_fur, waist_scale_l_1, waist_scale_l_2, pelvis_core, chest_core, thigh_mass]
        }
        box waist_fur_fringe_r place(base_box=waist_core, anchor=[-0.96, -0.45, -0.05], align=[0.62, 0.25, 0]) {
          size: [2.5, 3.5, 9.5], material: violet_silk, rotate: [6, -10, 18], blend_with: [waist_belly_fur, waist_scale_r_1, waist_scale_r_2, pelvis_core, chest_core, hind_thigh_r__thigh_mass]
        }
        plane waist_fur_ruff_l place(base_box=waist_core, anchor=[0.84, -0.78, -0.05], align=[0, 0.78, 0]) {
          size: [4.0, 9.0], normal: x, material: plum_fur, rotate: [4, 12, -22],
          edge: spikes(width=2, min_len=3, max_len=6, side=bottom, seed=17), layer: 1,
          blend_with: [waist_fur_fringe_l, waist_belly_fur, chest_core, pelvis_core, thigh_mass, knee_scale_cap]
        }
        plane waist_fur_ruff_r place(base_box=waist_core, anchor=[-0.88, -0.78, -0.05], align=[0, 0.78, 0]) {
          size: [4.0, 9.0], normal: x, material: plum_fur, rotate: [4, -12, 22],
          edge: spikes(width=2, min_len=3, max_len=6, side=bottom, seed=17), layer: 1,
          blend_with: [waist_fur_fringe_r, waist_belly_fur, chest_core, pelvis_core, hind_thigh_r__thigh_mass, hind_thigh_r__knee_scale_cap]
        }

        bone dorsal_fin_2 attach(parent_box=waist_core, anchor=[0, 0.98, 0.05], align=[0, -0.88, 0.25]) {
          rest_euler: [28, 0, 0]
          box waist_fin_spar_1 { size: [1.5, 7.5, 4.5], material: sakura_pink, blend_with: [lumbar_ridge, chest_core, withers_scale_cap] }
          box waist_fin_tip_1 place(base_box=waist_fin_spar_1, anchor=[0, 0.96, -0.12], align=[0, -0.82, 0]) {
            size: [1.0, 3.0, 2.5], material: iris_gold, rotate: [10, 0, 0]
          }
          box waist_fin_spar_2 place(base_box=waist_fin_spar_1, anchor=[0, -0.15, -0.94], align=[0, 0, 0.55]) {
            size: [1.5, 6.0, 4.5], material: orchid_magenta, rotate: [12, 0, 0], blend_with: [waist_core, lumbar_ridge, pelvis_core, sacrum_scale_ridge]
          }
          box waist_fin_tip_2 place(base_box=waist_fin_spar_2, anchor=[0, 0.96, -0.15], align=[0, -0.82, 0]) {
            size: [1.0, 2.5, 2.5], material: iris_gold, rotate: [12, 0, 0], blend_with: [waist_fin_spar_1]
          }
          plane waist_petal_fin_l place(base_box=waist_fin_spar_1, anchor=[0.85, 0.15, -0.45], align=[-0.85, 0, 0.35]) {
            size: [7.5, 10.0], normal: x, material: sakura_pink, rotate: [14, 0, -12],
            edge: scallop(bays=3, depth=4, side=top, seed=23), layer: 1,
            blend_with: [waist_fin_spar_2, waist_fin_tip_1, waist_fin_tip_2, waist_core, lumbar_ridge, chest_core, pelvis_core, pelvis_petal_spine, pelvis_petal_fin_l]
          }
          plane waist_petal_fin_r place(base_box=waist_fin_spar_1, anchor=[-0.85, 0.15, -0.45], align=[0.85, 0, 0.35]) {
            size: [7.5, 10.0], normal: x, material: sakura_pink, rotate: [14, 0, 12],
            edge: scallop(bays=3, depth=4, side=top, seed=23), layer: 2,
            blend_with: [waist_fin_spar_2, waist_fin_tip_1, waist_fin_tip_2, waist_core, lumbar_ridge, chest_core, pelvis_core, pelvis_petal_spine, pelvis_petal_fin_r, waist_petal_fin_l]
          }
        }

        bone chest attach(parent_box=waist_core, anchor=[0, 0.14, 1], align=[0, 0, -1], seat=0.26) {
          rest_euler: [-10, -6, 0]
          box chest_core { size: [13.0, 11.0, 14.5], material: pearl_cream }
          box withers_scale_cap place(base_box=chest_core, anchor=[0, 0.96, 0.08], align=[0, -0.55, 0]) {
            size: [8.5, 2.5, 12.0], material: sakura_scale, rotate: [-8, 0, 0], blend_with: [neck_base, lumbar_ridge, waist_core]
          }
          box chest_scale_l_1 place(base_box=chest_core, anchor=[0.98, 0.32, 0.18], align=[-0.70, 0, 0]) {
            size: [1.5, 4.5, 5.5], material: sakura_scale, rotate: [-4, 12, -12], blend_with: [withers_scale_cap, neck_base, fore_bicep, shoulder_pauldron]
          }
          box chest_scale_r_1 place(base_box=chest_core, anchor=[-0.98, 0.32, 0.18], align=[0.70, 0, 0]) {
            size: [1.5, 4.5, 5.5], material: sakura_scale, rotate: [-4, -12, 12], blend_with: [withers_scale_cap, neck_base, fore_shoulder_r__fore_bicep, fore_shoulder_r__shoulder_pauldron]
          }
          box chest_scale_l_2 place(base_box=chest_core, anchor=[0.98, 0.22, -0.28], align=[-0.70, 0, 0]) {
            size: [1.5, 4.5, 5.5], material: pearl_cream, rotate: [4, 14, -10], blend_with: [chest_scale_l_1, waist_core, waist_scale_l_1, fore_bicep]
          }
          box chest_scale_r_2 place(base_box=chest_core, anchor=[-0.98, 0.22, -0.28], align=[0.70, 0, 0]) {
            size: [1.5, 4.5, 5.5], material: pearl_cream, rotate: [4, -14, 10], blend_with: [chest_scale_r_1, waist_core, waist_scale_r_1, fore_shoulder_r__fore_bicep]
          }
          box chest_fur_rear place(base_box=chest_core, anchor=[0, -0.95, -0.30], align=[0, 0.42, 0]) {
            size: [10.0, 2.5, 7.5], material: plum_fur, rotate: [4, 0, 0], blend_with: [waist_belly_fur, waist_core]
          }
          box chest_fur_keel place(base_box=chest_core, anchor=[0, -0.95, 0.48], align=[0, 0.48, -0.20]) {
            size: [9.5, 3.0, 8.0], material: plum_fur, rotate: [-16, 0, 0], blend_with: [chest_fur_rear, neck_base, neck_throat_fur_1, fore_bicep, fore_shoulder_r__fore_bicep]
          }
          box sternum_plum_crest place(base_box=chest_fur_keel, anchor=[0, -0.96, 0.30], align=[0, 0.72, 0]) {
            size: [5.5, 2.0, 5.5], material: violet_silk, rotate: [-10, 0, 0], blend_with: [chest_core, neck_throat_fur_1]
          }
          box chest_plum_ruff_l place(base_box=chest_core, anchor=[0.88, -0.58, 0.36], align=[-0.52, 0.35, -0.25]) {
            size: [3.5, 4.5, 8.0], material: violet_silk, rotate: [-12, 16, -24], blend_with: [chest_fur_keel, chest_fur_rear, sternum_plum_crest, neck_base, fore_bicep]
          }
          box chest_plum_ruff_r place(base_box=chest_core, anchor=[-0.88, -0.58, 0.36], align=[0.52, 0.35, -0.25]) {
            size: [3.5, 4.5, 8.0], material: violet_silk, rotate: [-12, -16, 24], blend_with: [chest_fur_keel, chest_fur_rear, sternum_plum_crest, neck_base, fore_shoulder_r__fore_bicep]
          }
          plane chest_fur_ruff_l place(base_box=chest_core, anchor=[0.82, -0.78, 0.35], align=[0, 0.78, 0]) {
            size: [5.5, 7.5], normal: x, material: plum_fur, rotate: [-10, 18, -24],
            edge: spikes(width=2, min_len=3, max_len=7, side=bottom, seed=29), layer: 1,
            blend_with: [chest_plum_ruff_l, chest_fur_keel, chest_fur_rear, sternum_plum_crest, neck_throat_fur_1, fore_bicep]
          }
          plane chest_fur_ruff_r place(base_box=chest_core, anchor=[-0.86, -0.78, 0.35], align=[0, 0.78, 0]) {
            size: [5.5, 7.5], normal: x, material: plum_fur, rotate: [-10, -18, 24],
            edge: spikes(width=2, min_len=3, max_len=7, side=bottom, seed=29), layer: 1,
            blend_with: [chest_plum_ruff_r, chest_fur_keel, chest_fur_rear, sternum_plum_crest, neck_throat_fur_1, fore_shoulder_r__fore_bicep]
          }
          plane sternum_ruff_fan_l place(base_box=chest_core, anchor=[0.48, -0.82, 0.96], align=[0, 0.72, -0.88]) {
            size: [5.5, 5.0], normal: z, material: violet_silk, rotate: [-24, -18, -12],
            edge: spikes(width=2, min_len=3, max_len=7, side=bottom, seed=31), layer: 2,
            blend_with: [chest_fur_keel, sternum_plum_crest, chest_plum_ruff_l, neck_throat_fur_1, fore_bicep]
          }
          plane sternum_ruff_fan_r place(base_box=chest_core, anchor=[-0.48, -0.82, 0.96], align=[0, 0.72, -0.88]) {
            size: [5.5, 5.0], normal: z, material: violet_silk, rotate: [-24, 18, 12],
            edge: spikes(width=2, min_len=3, max_len=7, side=bottom, seed=31), layer: 1,
            blend_with: [chest_fur_keel, sternum_plum_crest, chest_plum_ruff_r, neck_throat_fur_1, fore_shoulder_r__fore_bicep, sternum_ruff_fan_l]
          }

          bone dorsal_fin_1 attach(parent_box=chest_core, anchor=[0, 0.98, -0.05], align=[0, -0.88, 0.25]) {
            rest_euler: [26, 0, 0]
            box chest_fin_spar_1 { size: [1.5, 10.5, 4.5], material: sakura_pink, blend_with: [withers_scale_cap, neck_base, neck_1_fin] }
            box chest_fin_gold_tip place(base_box=chest_fin_spar_1, anchor=[0, 0.96, -0.15], align=[0, -0.82, 0]) {
              size: [1.0, 3.5, 2.5], material: iris_gold, rotate: [10, 0, 0], blend_with: [neck_1_fin, neck_1_fin_tip]
            }
            box chest_fin_spar_2 place(base_box=chest_fin_spar_1, anchor=[0, -0.10, -0.94], align=[0, 0, 0.55]) {
              size: [1.5, 9.0, 4.5], material: orchid_magenta, rotate: [10, 0, 0], blend_with: [chest_core, withers_scale_cap, neck_1_fin, waist_core, waist_fin_spar_1, waist_petal_fin_l, waist_petal_fin_r]
            }
            box chest_fin_tip_2 place(base_box=chest_fin_spar_2, anchor=[0, 0.96, -0.15], align=[0, -0.82, 0]) {
              size: [1.0, 3.0, 2.5], material: iris_gold, rotate: [12, 0, 0], blend_with: [chest_fin_spar_1, chest_fin_gold_tip, waist_fin_tip_1]
            }
            plane chest_petal_fin_l place(base_box=chest_fin_spar_1, anchor=[0.85, 0.15, -0.45], align=[-0.85, 0, 0.35]) {
              size: [9.5, 11.5], normal: x, material: sakura_pink, rotate: [14, 0, -14],
              edge: scallop(bays=3, depth=4, side=top, seed=37), layer: 1,
              blend_with: [chest_fin_spar_2, chest_fin_gold_tip, chest_fin_tip_2, chest_core, withers_scale_cap, neck_1_fin, neck_1_fin_tip, neck_1_petal_fin_l, neck_1_petal_fin_r, neck_2_petal_fin_l, neck_2_petal_fin_r, waist_core, lumbar_ridge, waist_fin_spar_1, waist_fin_spar_2, waist_fin_tip_1, waist_fin_tip_2, waist_petal_fin_l, waist_petal_fin_r]
            }
            plane chest_petal_fin_r place(base_box=chest_fin_spar_1, anchor=[-0.85, 0.15, -0.45], align=[0.85, 0, 0.35]) {
              size: [9.5, 11.5], normal: x, material: sakura_pink, rotate: [14, 0, 14],
              edge: scallop(bays=3, depth=4, side=top, seed=37), layer: 2,
              blend_with: [chest_fin_spar_2, chest_fin_gold_tip, chest_fin_tip_2, chest_core, withers_scale_cap, neck_1_fin, neck_1_fin_tip, neck_1_petal_fin_l, neck_1_petal_fin_r, neck_2_petal_fin_l, neck_2_petal_fin_r, waist_core, lumbar_ridge, waist_fin_spar_1, waist_fin_spar_2, waist_fin_tip_1, waist_fin_tip_2, waist_petal_fin_l, waist_petal_fin_r, chest_petal_fin_l]
            }
          }

          bone neck_1 attach(parent_box=chest_core, anchor=[0, 0.30, 1], align=[0, 0, -1], seat=0.26) {
            rest_euler: [-34, 6, 0]
            box neck_base { size: [9.5, 8.5, 9.5], material: pearl_cream }
            box neck_throat_fur_1 place(base_box=neck_base, anchor=[0, -0.96, 0.08], align=[0, 0.45, 0]) {
              size: [7.5, 3.0, 8.5], material: plum_fur, rotate: [-8, 0, 0], blend_with: [chest_core, chest_fur_keel, neck_mid, neck_throat_fur_2]
            }
            box neck_ruff_wedge_l place(base_box=neck_base, anchor=[0.94, -0.38, 0.05], align=[-0.58, 0.25, 0]) {
              size: [3.0, 4.0, 7.5], material: violet_silk, rotate: [-8, 18, -22], blend_with: [neck_throat_fur_1, chest_core, chest_plum_ruff_l, neck_mid]
            }
            box neck_ruff_wedge_r place(base_box=neck_base, anchor=[-0.94, -0.38, 0.05], align=[0.58, 0.25, 0]) {
              size: [3.0, 4.0, 7.5], material: violet_silk, rotate: [-8, -18, 22], blend_with: [neck_throat_fur_1, chest_core, chest_plum_ruff_r, neck_mid]
            }
            box neck_scale_l_1 place(base_box=neck_base, anchor=[0.96, 0.34, 0.05], align=[-0.72, 0, 0]) {
              size: [1.5, 3.5, 6.5], material: sakura_scale, rotate: [6, 12, -14], blend_with: [chest_core, withers_scale_cap, neck_mid]
            }
            box neck_scale_r_1 place(base_box=neck_base, anchor=[-0.96, 0.34, 0.05], align=[0.72, 0, 0]) {
