  // 12. Serene Vulpine Brush-Grooming Taunt (coils lush fox-brush beside flank & preens!)
  clip grooming_taunt_pose {
    duration_s: 2.4, loop: false
    key root.position { 0.0: [0, 0, 0], 0.65: [1.5, -1.2, 0], 1.65: [1.5, -1.0, 0], 2.4: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, 0, 0], 0.65: [6, 22, -4], 1.65: [6, 22, -4], 2.4: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.65: [6, 28, -8], 1.65: [6, 26, -8], 2.4: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.65: [8, 34, 6], 1.15: [12, 36, 8], 1.65: [8, 32, 6], 2.4: [0, 0, 0], catmullrom }
    key neck_2.rotation { 0.0: [0, 0, 0], 0.65: [10, 28, 0], 1.15: [14, 30, 0], 1.65: [10, 26, 0], 2.4: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.65: [14, 24, -18], 1.00: [22, 26, -22], 1.35: [12, 22, -16], 1.70: [20, 26, -20], 2.4: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 1.00: [16, 0, 0], 1.35: [4, 0, 0], 1.70: [14, 0, 0], 2.4: [0, 0, 0], catmullrom }
    key tail_1.rotation { 0.0: [0, 0, 0], 0.65: [-14, 36, 0], 1.65: [-14, 36, 0], 2.4: [0, 0, 0], catmullrom }
    key tail_2.rotation { 0.0: [0, 0, 0], 0.65: [-12, 38, 0], 1.65: [-12, 38, 0], 2.4: [0, 0, 0], catmullrom }
    key tail_3.rotation { 0.0: [0, 0, 0], 0.65: [-8, 36, 0], 1.65: [-8, 36, 0], 2.4: [0, 0, 0], catmullrom }
    key tail_4.rotation { 0.0: [0, 0, 0], 0.65: [-6, 30, 0], 1.65: [-6, 30, 0], 2.4: [0, 0, 0], catmullrom }
  }
}
@controller {
  initial: idle
  idle -> walk when speed > 0.15, blend 0.22
  walk -> run when speed > 0.55, blend 0.18
  run -> walk when speed <= 0.45, blend 0.22
  walk -> idle when speed <= 0.08, blend 0.25
  idle -> roar when enraged > 0.5, blend 0.16
  roar -> idle when enraged <= 0.5, blend 0.25
}
