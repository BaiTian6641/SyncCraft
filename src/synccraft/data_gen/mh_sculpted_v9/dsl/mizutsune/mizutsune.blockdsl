              size: [1.5, 7.0, 8.0], material: orchid_magenta, rotate: [20, 0, 0], blend_with: [tail_2_seg, tail_2_dorsal_fin, tail_4_seg, tail_4_dorsal_fin]
            }
            box tail_3_fin_tip place(base_box=tail_3_dorsal_fin, anchor=[0, 0.96, -0.18], align=[0, -0.82, 0]) {
              size: [1.0, 2.5, 4.0], material: iris_gold, rotate: [10, 0, 0]
            }
            plane tail_3_petal_fin_l place(base_box=tail_3_dorsal_fin, anchor=[0.85, 0.15, -0.15], align=[-0.85, 0, 0.25]) {
              size: [7.0, 8.0], normal: x, material: sakura_pink, rotate: [6, 0, -16],
              edge: scallop(bays=2, depth=4, side=top, seed=127), layer: 2,
              blend_with: [tail_3_fin_tip, tail_3_seg, tail_2_dorsal_fin, tail_2_petal_fin_l, tail_4_dorsal_fin]
            }
            plane tail_3_petal_fin_r place(base_box=tail_3_dorsal_fin, anchor=[-0.85, 0.15, -0.15], align=[0.85, 0, 0.25]) {
              size: [7.0, 8.0], normal: x, material: sakura_pink, rotate: [6, 0, 16],
              edge: scallop(bays=2, depth=4, side=top, seed=127), layer: 1,
              blend_with: [tail_3_fin_tip, tail_3_seg, tail_2_dorsal_fin, tail_2_petal_fin_r, tail_4_dorsal_fin, tail_3_petal_fin_l]
            }
            plane tail_3_brush_plume_l place(base_box=tail_3_seg, anchor=[0.80, -0.74, -0.15], align=[0, 0.72, 0]) {
              size: [7.5, 10.5], normal: x, material: plum_fur, rotate: [-10, 26, -26],
              edge: spikes(width=2, min_len=4, max_len=9, side=bottom, seed=131), layer: 2,
              blend_with: [tail_3_fur_l, tail_3_ventral_fur, tail_2_seg, tail_2_fur_l, tail_2_brush_plume_l, tail_4_seg, tail_4_fur_l]
            }
            plane tail_3_brush_plume_r place(base_box=tail_3_seg, anchor=[-0.88, -0.74, -0.15], align=[0, 0.72, 0]) {
              size: [7.5, 10.5], normal: x, material: plum_fur, rotate: [-10, -26, 26],
              edge: spikes(width=2, min_len=4, max_len=9, side=bottom, seed=131), layer: 2,
              blend_with: [tail_3_fur_r, tail_3_ventral_fur, tail_2_seg, tail_2_fur_r, tail_2_brush_plume_r, tail_4_seg, tail_4_fur_r]
            }

            bone tail_4 attach(parent_box=tail_3_seg, anchor=[0, 0.10, -1], align=[0, 0, 1], seat=0.24) {
              rest_euler: [24, -10, 0]
              box tail_4_seg { size: [11.0, 10.5, 11.0], material: plum_fur }
              box tail_4_ventral_fur place(base_box=tail_4_seg, anchor=[0, -0.96, -0.12], align=[0, 0.48, 0.25]) {
                size: [9.0, 4.5, 10.0], material: plum_fur, rotate: [-12, 0, 0], blend_with: [tail_3_seg, tail_3_ventral_fur, tail_5_seg, tail_5_ventral_fur]
              }
              box tail_4_fur_l place(base_box=tail_4_seg, anchor=[0.96, -0.05, -0.20], align=[-0.52, 0, 0.52]) {
                size: [4.5, 7.5, 11.0], material: violet_silk, rotate: [14, 28, -16], blend_with: [tail_3_seg, tail_3_fur_l, tail_5_seg, tail_5_fur_l]
              }
              box tail_4_fur_r place(base_box=tail_4_seg, anchor=[-0.96, -0.05, -0.20], align=[0.52, 0, 0.52]) {
                size: [4.5, 7.5, 11.0], material: violet_silk, rotate: [14, -28, 16], blend_with: [tail_3_seg, tail_3_fur_r, tail_5_seg, tail_5_fur_r]
              }
              box tail_4_upper_fur_l place(base_box=tail_4_seg, anchor=[0.84, 0.74, -0.18], align=[-0.58, -0.58, 0.42]) {
                size: [3.0, 4.0, 9.0], material: sakura_pink, rotate: [14, 24, -24], blend_with: [tail_4_fur_l, tail_3_seg, tail_3_upper_fur_l, tail_5_seg]
              }
              box tail_4_upper_fur_r place(base_box=tail_4_seg, anchor=[-0.84, 0.74, -0.18], align=[0.58, -0.58, 0.42]) {
                size: [3.0, 4.0, 9.0], material: sakura_pink, rotate: [14, -24, 24], blend_with: [tail_4_fur_r, tail_3_seg, tail_3_upper_fur_r, tail_5_seg]
              }
              box tail_4_dorsal_fin place(base_box=tail_4_seg, anchor=[0, 0.96, -0.05], align=[0, -0.82, 0.30]) {
                size: [1.5, 6.5, 7.5], material: sakura_pink, rotate: [18, 0, 0], blend_with: [tail_3_seg, tail_3_dorsal_fin, tail_5_seg, tail_5_dorsal_fin]
              }
              box tail_4_fin_tip place(base_box=tail_4_dorsal_fin, anchor=[0, 0.96, -0.18], align=[0, -0.82, 0]) {
                size: [1.0, 2.5, 3.5], material: iris_gold, rotate: [10, 0, 0]
              }
              plane tail_4_petal_fin_l place(base_box=tail_4_dorsal_fin, anchor=[0.85, 0.15, -0.15], align=[-0.85, 0, 0.25]) {
                size: [6.5, 7.5], normal: x, material: orchid_magenta, rotate: [6, 0, -16],
                edge: scallop(bays=2, depth=3, side=top, seed=137), layer: 1,
                blend_with: [tail_4_fin_tip, tail_4_seg, tail_3_dorsal_fin, tail_3_petal_fin_l, tail_5_dorsal_fin]
              }
              plane tail_4_petal_fin_r place(base_box=tail_4_dorsal_fin, anchor=[-0.85, 0.15, -0.15], align=[0.85, 0, 0.25]) {
                size: [6.5, 7.5], normal: x, material: orchid_magenta, rotate: [6, 0, 16],
                edge: scallop(bays=2, depth=3, side=top, seed=137), layer: 2,
                blend_with: [tail_4_fin_tip, tail_4_seg, tail_3_dorsal_fin, tail_3_petal_fin_r, tail_5_dorsal_fin, tail_4_petal_fin_l]
              }

              // Articulated Lateral Fox-Brush Plume Fans on `tail_4`
              bone tail_plume_l attach(parent_box=tail_4_seg, anchor=[0.96, -0.68, -0.38], align=[-0.78, 0.58, 0.78]) mirror_x(tail_plume_r) {
                rest_euler: [-18, 36, 24]
                box brush_plume_lobe { size: [3.0, 4.0, 9.0], material: plum_fur, blend_with: [tail_4_ventral_fur, tail_4_fur_l, tail_3_seg, tail_5_seg, tail_5_ventral_fur, tail_5_fur_l] }
                plane brush_plume_plane place(base_box=brush_plume_lobe, anchor=[0.55, -0.68, -0.15], align=[0, 0.75, 0.25]) {
                  size: [6.5, 9.5], normal: x, material: violet_silk, rotate: [-8, 16, -20],
                  edge: spikes(width=2, min_len=4, max_len=9, side=bottom, seed=139), layer: 1,
                  blend_with: [tail_4_seg, tail_4_fur_l, tail_4_ventral_fur, tail_3_brush_plume_l, tail_5_seg, tail_5_fur_l, tail_5_brush_plume_l]
                }
              }

              bone tail_5 attach(parent_box=tail_4_seg, anchor=[0, 0.08, -1], align=[0, 0, 1], seat=0.24) {
                rest_euler: [22, -12, 0]
                box tail_5_seg { size: [8.5, 8.0, 9.5], material: violet_silk }
                box tail_5_ventral_fur place(base_box=tail_5_seg, anchor=[0, -0.96, -0.10], align=[0, 0.55, 0.25]) {
                  size: [6.5, 3.5, 8.5], material: plum_fur, rotate: [-10, 0, 0], blend_with: [tail_4_seg, tail_4_ventral_fur, tail_6_tip]
                }
                box tail_5_fur_l place(base_box=tail_5_seg, anchor=[0.95, 0.0, -0.20], align=[-0.55, 0, 0.50]) {
                  size: [3.5, 5.5, 9.5], material: sakura_pink, rotate: [12, 24, -14], blend_with: [tail_4_seg, tail_4_fur_l, tail_6_tip, tail_6_fur_l]
                }
                box tail_5_fur_r place(base_box=tail_5_seg, anchor=[-0.95, 0.0, -0.20], align=[0.55, 0, 0.50]) {
                  size: [3.5, 5.5, 9.5], material: sakura_pink, rotate: [12, -24, 14], blend_with: [tail_4_seg, tail_4_fur_r, tail_6_tip, tail_6_fur_r]
                }
                box tail_5_dorsal_fin place(base_box=tail_5_seg, anchor=[0, 0.96, -0.05], align=[0, -0.82, 0.30]) {
                  size: [1.5, 5.0, 6.5], material: iris_gold, rotate: [16, 0, 0], blend_with: [tail_4_seg, tail_4_dorsal_fin, tail_6_tip]
                }
                plane tail_5_brush_plume_l place(base_box=tail_5_seg, anchor=[0.78, -0.72, -0.15], align=[0, 0.72, 0]) {
                  size: [6.0, 8.5], normal: x, material: violet_silk, rotate: [-8, 22, -22],
                  edge: spikes(width=2, min_len=3, max_len=8, side=bottom, seed=149), layer: 2,
                  blend_with: [tail_5_fur_l, tail_5_ventral_fur, tail_4_seg, tail_4_fur_l, brush_plume_lobe, tail_6_tip, tail_6_fur_l]
                }
                plane tail_5_brush_plume_r place(base_box=tail_5_seg, anchor=[-0.88, -0.72, -0.15], align=[0, 0.72, 0]) {
                  size: [6.0, 8.5], normal: x, material: violet_silk, rotate: [-8, -22, 22],
                  edge: spikes(width=2, min_len=3, max_len=8, side=bottom, seed=149), layer: 2,
                  blend_with: [tail_5_fur_r, tail_5_ventral_fur, tail_4_seg, tail_4_fur_r, tail_plume_r__brush_plume_lobe, tail_6_tip, tail_6_fur_r]
                }

                bone tail_6 attach(parent_box=tail_5_seg, anchor=[0, 0.06, -1], align=[0, 0, 1], seat=0.22) {
                  rest_euler: [20, -10, 0]
                  box tail_6_tip { size: [5.5, 5.5, 8.5], material: sakura_pink }
                  box tail_6_ventral_fur place(base_box=tail_6_tip, anchor=[0, -0.96, -0.10], align=[0, 0.65, 0.25]) {
                    size: [4.5, 2.5, 7.5], material: plum_fur, rotate: [-8, 0, 0], blend_with: [tail_5_seg, tail_5_ventral_fur, tail_brush_spear]
                  }
                  box tail_6_fur_l place(base_box=tail_6_tip, anchor=[0.94, 0.0, -0.18], align=[-0.62, 0, 0.48]) {
                    size: [2.5, 3.5, 7.5], material: orchid_magenta, rotate: [10, 20, -10], blend_with: [tail_5_seg, tail_5_fur_l, tail_brush_spear]
                  }
                  box tail_6_fur_r place(base_box=tail_6_tip, anchor=[-0.94, 0.0, -0.18], align=[0.62, 0, 0.48]) {
                    size: [2.5, 3.5, 7.5], material: orchid_magenta, rotate: [10, -20, 10], blend_with: [tail_5_seg, tail_5_fur_r, tail_brush_spear]
                  }
                  box tail_brush_spear place(base_box=tail_6_tip, anchor=[0, 0.06, -0.94], align=[0, 0, 0.72]) {
                    size: [3.5, 3.5, 7.0], material: iris_gold, rotate: [12, 0, 0]
                  }
                  box tail_tip_lock place(base_box=tail_brush_spear, anchor=[0, 0.15, -0.96], align=[0, 0, 0.82]) {
                    size: [2.0, 2.0, 4.5], material: sakura_pink, rotate: [14, 0, 0]
                  }
                  plane tail_6_brush_plume_l place(base_box=tail_6_tip, anchor=[0.42, 0.20, -0.85], align=[0, 0, 0.65]) {
                    size: [6.0, 8.0], normal: x, material: sakura_pink, rotate: [10, 18, -14],
                    edge: spikes(width=2, min_len=3, max_len=8, side=right, seed=157), layer: 1,
                    blend_with: [tail_6_fur_l, tail_brush_spear, tail_tip_lock, tail_5_fur_l, tail_5_brush_plume_l]
                  }
                  plane tail_6_brush_plume_r place(base_box=tail_6_tip, anchor=[-0.42, 0.20, -0.85], align=[0, 0, 0.65]) {
                    size: [6.0, 8.0], normal: x, material: sakura_pink, rotate: [10, -18, 14],
                    edge: spikes(width=2, min_len=3, max_len=8, side=right, seed=157), layer: 2,
                    blend_with: [tail_6_fur_r, tail_brush_spear, tail_tip_lock, tail_5_fur_r, tail_5_brush_plume_r, tail_6_brush_plume_l]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
@materials {
  pearl_cream: process(family=keratin_scales, coat=scale_rows, roughness=0.38)
  sakura_scale: process(family=keratin_scales, coat=scale_rows, roughness=0.40)
  sakura_pink: process(family=thin_film_iridescence, coat=striped, roughness=0.32)
  orchid_magenta: process(family=thin_film_iridescence, coat=striped, roughness=0.34)
  plum_fur: process(family=woven_fabric, coat=striped, roughness=0.74)
  violet_silk: process(family=woven_fabric, coat=striped, roughness=0.68)
  iris_gold: process(family=painted_metal, coat=striped, roughness=0.30)
  ivory_claw: process(family=polymer_dielectric, coat=plain, roughness=0.26)
  mouth_rose: process(family=patterned_skin, coat=plain, roughness=0.45)
  nose_rose: process(family=patterned_skin, coat=plain, roughness=0.48)
  amber_glow: process(family=thin_film_iridescence, coat=plain, roughness=0.16, emissive=0.95)
  bubble_aqua: process(family=thin_film_iridescence, coat=plain, roughness=0.14, emissive=0.92)
}
@style {
  target_encoding: vanilla,
  shade: banded(steps=5, direction=down, cluster=diagonal),
  glow_bleed: 2
}
@stamps {
  stamp fox_eye_glint on skull_core.east { at: [0.74, 0.36], size: [1.5, 1.0], color: amber_glow, emissive: 0.95, mirror: true }
  stamp crest_ocellus_spark on crest_spar_1.south { at: [0.50, 0.42], size: [1.5, 2.0], color: iris_gold, emissive: 0.85, mirror: true }
  stamp chest_bubble_sheen on sternum_plum_crest.down { at: [0.50, 0.50], size: [2.0, 1.5], color: bubble_aqua, emissive: 0.82 }
}
@behavior {
  spring whisker_l { stiffness: 36, damping: 5 }
  spring whisker_r { stiffness: 36, damping: 5 }
  spring crest_fin_1_l { stiffness: 46, damping: 6 }
  spring crest_fin_1_r { stiffness: 46, damping: 6 }
  spring crest_fin_2_l { stiffness: 42, damping: 6 }
  spring crest_fin_2_r { stiffness: 42, damping: 6 }
  spring tail_plume_l { stiffness: 38, damping: 5 }
  spring tail_plume_r { stiffness: 38, damping: 5 }
  spring tail_6 { stiffness: 32, damping: 5 }

  // 1. Serene Bewitching Fox-Leviathan Breathing, Blooming Crest Pulse & Hypnotic Brush Sway
  clip idle {
    duration_s: 3.6, loop: true
    key root.position { 0.0: [0, 0, 0], 0.9: [0, -0.35, 0], 1.8: [0, 0.35, 0], 2.7: [0, -0.35, 0], 3.6: [0, 0, 0], catmullrom }
    key chest.rotation { 0.0: [0, 0, 0], 0.9: [2, 3, 0], 1.8: [-2, 0, 0], 2.7: [2, -3, 0], 3.6: [0, 0, 0], catmullrom }
    key neck_1.rotation { 0.0: [0, 0, 0], 0.9: [-3, 6, 2], 1.8: [2, 0, 0], 2.7: [-3, -6, -2], 3.6: [0, 0, 0], catmullrom }
    key neck_2.rotation { 0.0: [0, 0, 0], 0.9: [-2, 5, 0], 1.8: [2, 0, 0], 2.7: [-2, -5, 0], 3.6: [0, 0, 0], catmullrom }
    key head.rotation { 0.0: [0, 0, 0], 0.9: [4, 8, -4], 1.8: [-3, 0, 0], 2.7: [4, -8, 4], 3.6: [0, 0, 0], catmullrom }
    key jaw.rotation { 0.0: [0, 0, 0], 1.8: [6, 0, 0], 3.6: [0, 0, 0], catmullrom }
    key crest_fin_1_l.rotation { 0.0: [0, 0, 0], 1.8: [-6, -4, -6], 3.6: [0, 0, 0], catmullrom }
    key crest_fin_1_r.rotation { 0.0: [0, 0, 0], 1.8: [-6, -4, -6], 3.6: [0, 0, 0], catmullrom }
    key crest_fin_2_l.rotation { 0.0: [0, 0, 0], 1.8: [-5, -6, -8], 3.6: [0, 0, 0], catmullrom }
    key crest_fin_2_r.rotation { 0.0: [0, 0, 0], 1.8: [-5, -6, -8], 3.6: [0, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=9, freq_hz=0.2778, phase_deg=0)
    track tail_2: wave(axis=y, amp_deg=12, freq_hz=0.2778, phase_deg=-36)
    track tail_3: wave(axis=y, amp_deg=15, freq_hz=0.2778, phase_deg=-72)
    track tail_4: wave(axis=y, amp_deg=18, freq_hz=0.2778, phase_deg=-108)
    track tail_5: wave(axis=y, amp_deg=20, freq_hz=0.2778, phase_deg=-144)
  }

  // 2. Sinuous Serpentine Vulpine Leviathan Prowl
  clip walk {
    duration_s: 1.6, loop: true
    key root.position { 0.0: [0, 0, 0], 0.4: [0.6, 0.8, 0], 0.8: [0, 0, 0], 1.2: [-0.6, 0.8, 0], 1.6: [0, 0, 0], catmullrom }
    key pelvis.rotation { 0.0: [0, -10, 3], 0.4: [2, 0, 0], 0.8: [0, 10, -3], 1.2: [2, 0, 0], 1.6: [0, -10, 3], catmullrom }
    key waist.rotation { 0.0: [0, 12, -2], 0.8: [0, -12, 2], 1.6: [0, 12, -2], catmullrom }
    key chest.rotation { 0.0: [0, 10, -4], 0.4: [-2, 0, 0], 0.8: [0, -10, 4], 1.2: [-2, 0, 0], 1.6: [0, 10, -4], catmullrom }
    key neck_1.rotation { 0.0: [0, -10, 3], 0.8: [0, 10, -3], 1.6: [0, -10, 3], catmullrom }
    key head.rotation { 0.0: [2, -8, 3], 0.8: [2, 8, -3], 1.6: [2, -8, 3], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [-24, 0, 0], 0.4: [6, 0, 4], 0.8: [22, 0, 0], 1.2: [-8, 0, 8], 1.6: [-24, 0, 0], catmullrom }
    key fore_arm_l.rotation { 0.0: [10, 0, 0], 0.4: [4, 0, 0], 0.8: [16, 0, 0], 1.2: [-22, 0, 0], 1.6: [10, 0, 0], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [22, 0, 0], 0.4: [-8, 0, 8], 0.8: [-24, 0, 0], 1.2: [6, 0, 4], 1.6: [22, 0, 0], catmullrom }
    key fore_shoulder_r__fore_arm_l.rotation { 0.0: [16, 0, 0], 0.4: [-22, 0, 0], 0.8: [10, 0, 0], 1.2: [4, 0, 0], 1.6: [16, 0, 0], catmullrom }
    key hind_thigh_l.rotation { 0.0: [20, 0, 0], 0.4: [-10, 0, 6], 0.8: [-22, 0, 0], 1.2: [6, 0, 0], 1.6: [20, 0, 0], catmullrom }
    key hind_shin_l.rotation { 0.0: [-14, 0, 0], 0.4: [22, 0, 0], 0.8: [8, 0, 0], 1.2: [-6, 0, 0], 1.6: [-14, 0, 0], catmullrom }
    key hind_thigh_r.rotation { 0.0: [-22, 0, 0], 0.4: [6, 0, 0], 0.8: [20, 0, 0], 1.2: [-10, 0, 6], 1.6: [-22, 0, 0], catmullrom }
    key hind_thigh_r__hind_shin_l.rotation { 0.0: [8, 0, 0], 0.4: [-6, 0, 0], 0.8: [-14, 0, 0], 1.2: [22, 0, 0], 1.6: [8, 0, 0], catmullrom }
    track tail_1: wave(axis=y, amp_deg=14, freq_hz=0.625, phase_deg=0)
    track tail_3: wave(axis=y, amp_deg=20, freq_hz=0.625, phase_deg=-60)
    track tail_5: wave(axis=y, amp_deg=26, freq_hz=0.625, phase_deg=-120)
  }

  // 3. Hydro-Bubble Slither Sprint — low skating glide + bounding vulpine leaps!
  clip run {
    duration_s: 1.0, loop: true
    key root.position { 0.0: [-2.0, -0.8, 0], 0.25: [0, 3.8, 2.5], 0.50: [2.0, -0.8, 0], 0.75: [0, 3.8, 2.5], 1.0: [-2.0, -0.8, 0], catmullrom }
    key pelvis.rotation { 0.0: [4, -18, 6], 0.25: [-12, 0, 0], 0.50: [4, 18, -6], 0.75: [-12, 0, 0], 1.0: [4, -18, 6], catmullrom }
    key waist.rotation { 0.0: [0, 22, -6], 0.25: [-8, 0, 0], 0.50: [0, -22, 6], 0.75: [-8, 0, 0], 1.0: [0, 22, -6], catmullrom }
    key chest.rotation { 0.0: [6, 18, -8], 0.25: [-10, 0, 0], 0.50: [6, -18, 8], 0.75: [-10, 0, 0], 1.0: [6, 18, -8], catmullrom }
    key neck_1.rotation { 0.0: [-8, -16, 4], 0.50: [-8, 16, -4], 1.0: [-8, -16, 4], catmullrom }
    key head.rotation { 0.0: [6, -12, 4], 0.50: [6, 12, -4], 1.0: [6, -12, 4], catmullrom }
    key fore_shoulder_l.rotation { 0.0: [-38, 0, 10], 0.50: [34, 0, 6], 1.0: [-38, 0, 10], catmullrom }
    key fore_shoulder_r.rotation { 0.0: [34, 0, 6], 0.50: [-38, 0, 10], 1.0: [34, 0, 6], catmullrom }
    key hind_thigh_l.rotation { 0.0: [34, 0, 6], 0.50: [-36, 0, 10], 1.0: [34, 0, 6], catmullrom }
    key hind_thigh_r.rotation { 0.0: [-36, 0, 10], 0.50: [34, 0, 6], 1.0: [-36, 0, 10], catmullrom }
    track tail_1: wave(axis=y, amp_deg=22, freq_hz=1.0, phase_deg=0)
    track tail_3: wave(axis=y, amp_deg=28, freq_hz=1.0, phase_deg=-65)
    track tail_5: wave(axis=y, amp_deg=34, freq_hz=1.0, phase_deg=-130)
