@meta { archetype: block_multipart, target_profile: bbmodel_5, texel_density: 16 }
@palette {
  stone: ramp(base_lch=[0.65, 0.02, 250.0], steps=4, hue_shift=[0.0, 0.0], emissive=false)
  accent: ramp(base_lch=[0.75, 0.08, 150.0], steps=4, hue_shift=[0.0, 0.0], emissive=false)
}
@rig {
  root bone pedestal {
    pivot_local: [8.0, 4.0, 8.0]
    box base { size: [12, 4, 12], material: stone, inflate: 0.0 }
    box stem place(base_box=base, anchor=[0.0, 1.0, 0.0], align=[0.0, -1.0, 0.0], offset=[0.0, 0.0, 0.0]) { size: [6, 6, 6], material: accent, inflate: 0.0 }
    box cap place(base_box=stem, anchor=[0.0, 1.0, 0.0], align=[0.0, -1.0, 0.0], offset=[0.0, 0.0, 0.0]) { size: [10, 2, 10], material: stone, inflate: 0.0 }
  }
}
